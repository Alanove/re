<% const hasHeroImage = Boolean(page.heroImage); %>
<% const hasHeroVideo = Boolean(page.heroVideo); %>
<% const hasHeroMedia = hasHeroImage || hasHeroVideo; %>
<header class="page-hero<%= hasHeroMedia ? '' : ' page-hero--plain' %>">
	<% if (hasHeroMedia) { %>
		<div class="page-hero__media<%= hasHeroImage && !hasHeroVideo ? ' page-hero__media--still' : '' %>">
			<% if (page.heroImage) { %><img src="<%= page.heroImage %>" alt="" fetchpriority="high" /><% } %>
			<% if (page.heroVideo) { %>
				<video class="hero-video" src="<%= page.heroVideo %>" muted loop playsinline preload="metadata" aria-hidden="true" data-hero-video<% if (page.heroImage) { %> poster="<%= page.heroImage %>"<% } %>></video>
			<% } %>
		</div>
	<% } %>
	<div class="page-hero__inner">
		<%- include('breadcrumbs') %>
		<span class="divider" aria-hidden="true"></span>
		<h1 class="page-hero__title"><%= page.header || page.title %></h1>
		<% if (page.summary) { %><p class="page-hero__lead"><%= page.summary %></p><% } %>
	</div>
</header>
<%- include('page-bar') %>
