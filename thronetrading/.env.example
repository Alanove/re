NODE_ENV=development
PORT=3042
PUBLIC_BASE_URL=http://localhost:3042
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@thronetrading.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Site Administrator
TRUST_PROXY=0

# Optional. Contact inquiries are always stored; mail is sent only when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Image processing (sharp). Keep concurrency low on small Linux servers; 0 = one thread per CPU core.
SHARP_CONCURRENCY=1
SHARP_CACHE_MB=0
