<%
	const telHref = function (value) { return 'tel:' + String(value || '').replace(/[^+\d]/g, ''); };
	const copyright = (settings.copyright || ('© {year} ' + settings.siteName + '. All rights reserved.')).replace('{year}', year);
	const socials = [
		{ key: 'facebook', label: 'Facebook', path: 'M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8h3.3z' },
		{ key: 'instagram', label: 'Instagram', path: 'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM21.9 8c-.1-1.5-.4-2.8-1.5-3.9S17.9 2.7 16.4 2.6C14.9 2.5 9.1 2.5 7.6 2.6 6.1 2.7 4.8 3 3.7 4.1S2.3 6.5 2.2 8c-.1 1.5-.1 6.4 0 7.9.1 1.5.4 2.8 1.5 3.9s2.4 1.4 3.9 1.5c1.5.1 7.3.1 8.8 0 1.5-.1 2.8-.4 3.9-1.5s1.4-2.4 1.5-3.9c.1-1.5.1-6.4.1-7.9z' },
		{ key: 'linkedin', label: 'LinkedIn', path: 'M6.9 21H3.3V9h3.6v12zM5.1 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM21 21h-3.6v-5.8c0-1.4 0-3.2-1.9-3.2s-2.2 1.5-2.2 3.1V21H9.7V9h3.4v1.6h.1c.5-.9 1.7-1.9 3.4-1.9 3.6 0 4.3 2.4 4.3 5.5V21z' },
		{ key: 'youtube', label: 'YouTube', path: 'M23 7.2s-.2-1.6-.9-2.3c-.9-.9-1.9-.9-2.3-1C16.6 3.6 12 3.6 12 3.6s-4.6 0-7.8.3c-.4.1-1.4.1-2.3 1-.7.7-.9 2.3-.9 2.3S.7 9.1.7 11v1.8c0 1.9.3 3.8.3 3.8s.2 1.6.9 2.3c.9.9 2 .9 2.5 1 1.8.2 7.6.2 7.6.2s4.6 0 7.8-.3c.4-.1 1.4-.1 2.3-1 .7-.7.9-2.3.9-2.3s.3-1.9.3-3.8V11c0-1.9-.3-3.8-.3-3.8zM9.7 15.1V8.4l6.1 3.4-6.1 3.3z' }
	].filter(function (social) { return settings.social[social.key]; });
%>
<footer class="site-footer">
	<div class="site-footer__inner">
		<div class="site-footer__brand">
			<a class="brand brand--inverse" href="/" aria-label="<%= settings.siteName %> home">
				<% if (settings.logo) { %><img class="brand__logo brand__logo--inverse" src="<%= settings.logo %>" alt="<%= settings.siteName %>" width="201" height="60" loading="lazy" /><% } else { %><span class="brand__name"><%= settings.siteName %></span><% } %>
			</a>
			<% if (settings.footerText || settings.description) { %><p class="site-footer__text"><%= settings.footerText || settings.description %></p><% } %>
			<% if (socials.length) { %>
				<div class="site-footer__social">
					<% socials.forEach(function (social) { %>
						<a href="<%= settings.social[social.key] %>" target="_blank" rel="noopener noreferrer" aria-label="<%= settings.siteName %> on <%= social.label %>">
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="<%= social.path %>"/></svg>
						</a>
					<% }) %>
				</div>
			<% } %>
		</div>

		<% if (catalogNav.categories.length) { %>
			<div class="site-footer__links">
				<h2 class="site-footer__heading">Products</h2>
				<ul class="footer-links footer-links--single">
					<% catalogNav.categories.forEach(function (category) { %>
						<li><a href="<%= category.url %>"><%= category.name %></a></li>
					<% }) %>
				</ul>
			</div>
		<% } %>

		<div class="site-footer__links">
			<h2 class="site-footer__heading">Company</h2>
			<ul class="footer-links footer-links--single">
				<% (footerMenu.length ? footerMenu : mainMenu).forEach(function (item) { %>
					<li><a href="<%= item.url %>"><%= item.title %></a></li>
				<% }) %>
			</ul>
		</div>

		<div class="site-footer__offices">
			<h2 class="site-footer__heading">Contact</h2>
			<ul class="footer-offices">
				<% offices.forEach(function (office) { %>
					<li class="footer-office">
						<span class="footer-office__country"><%= office.role || office.country %></span>
						<% if (office.address) { %><span class="footer-office__address"><%= office.address %></span><% } %>
						<% office.phones.forEach(function (phone) { %><a class="footer-office__line" href="<%= telHref(phone) %>"><span class="material-symbols-outlined" aria-hidden="true">call</span><%= phone %></a><% }) %>
						<% office.emails.forEach(function (email) { %><a class="footer-office__line" href="mailto:<%= email %>"><span class="material-symbols-outlined" aria-hidden="true">mail</span><%= email %></a><% }) %>
					</li>
				<% }) %>
			</ul>
		</div>
	</div>
	<div class="site-footer__bottom">
		<p>
			<span><%= copyright %></span>
			<span class="site-footer__credit">by <a href="https://www.liteweb.info" target="_blank" rel="noopener noreferrer">www.liteweb.info</a></span>
		</p>
	</div>
</footer>
