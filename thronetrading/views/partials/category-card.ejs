<% const category = locals.category; %>
<a class="category-card" href="<%= category.url %>">
	<span class="category-card__media">
		<% if (category.coverThumb || category.cover) { %>
			<img src="<%= category.coverThumb || category.cover %>" alt="" loading="lazy" width="400" height="400" />
		<% } %>
	</span>
	<span class="category-card__body">
		<span class="category-card__icon material-symbols-outlined" aria-hidden="true"><%= category.icon || 'lock' %></span>
		<span class="category-card__title"><%= category.name %></span>
		<span class="category-card__count"><%= category.productCount %> product<%= category.productCount === 1 ? '' : 's' %></span>
		<% if (locals.withSummary && category.summary) { %><span class="category-card__text"><%= category.summary %></span><% } %>
	</span>
</a>
