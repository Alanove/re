<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">Products <span class="badge bg-light text-dark ms-1"><%= products.length %></span></h4>
		<div class="panel-heading-btn">
			<a href="/admin/products/create<%= filter.category ? '?category=' + filter.category : '' %>" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add product</a>
		</div>
	</div>
	<div class="panel-body">
		<form method="GET" action="/admin/products" class="row g-2 mb-3 align-items-end" role="search">
			<div class="col-md-4">
				<label class="form-label small" for="q">Search</label>
				<div class="input-group">
					<span class="input-group-text"><i class="fa fa-search"></i></span>
					<input type="search" class="form-control" id="q" name="q" value="<%= filter.q %>" placeholder="Name, model or slug" maxlength="120" />
				</div>
			</div>
			<div class="col-6 col-md-3">
				<label class="form-label small" for="filter-category">Category</label>
				<select class="form-select" id="filter-category" name="category">
					<option value="">All categories</option>
					<% options.categories.forEach(function (option) { %>
						<option value="<%= option.id %>" <%= filter.category === option.id ? 'selected' : '' %>><%= option.label %></option>
					<% }) %>
				</select>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small" for="filter-brand">Brand</label>
				<select class="form-select" id="filter-brand" name="brand">
					<option value="">All brands</option>
					<option value="none" <%= filter.brand === 'none' ? 'selected' : '' %>>No brand</option>
					<% options.brands.forEach(function (option) { %>
						<option value="<%= option.id %>" <%= filter.brand === option.id ? 'selected' : '' %>><%= option.label %></option>
					<% }) %>
				</select>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small" for="filter-status">Status</label>
				<select class="form-select" id="filter-status" name="status">
					<option value="">Any status</option>
					<option value="published" <%= filter.status === 'published' ? 'selected' : '' %>>Published</option>
					<option value="draft" <%= filter.status === 'draft' ? 'selected' : '' %>>Draft</option>
				</select>
			</div>
			<div class="col-6 col-md-1 d-flex gap-1">
				<button type="submit" class="btn btn-primary flex-fill" title="Apply filters"><i class="fa fa-filter"></i></button>
				<a href="/admin/products" class="btn btn-default" title="Clear filters"><i class="fa fa-times"></i></a>
			</div>
		</form>
		<div class="table-responsive">
			<table class="table table-striped table-bordered align-middle" id="products-table">
				<thead>
					<tr>
						<th style="width:56px">Image</th>
						<th>Name</th>
						<th>Category</th>
						<th>Brand</th>
						<th class="text-center">Images</th>
						<th>Status</th>
						<th>Updated</th>
						<th style="width:1%">Actions</th>
					</tr>
				</thead>
				<tbody>
					<% products.forEach(function (product) { const cover = product.images[0]; %>
						<tr>
							<td>
								<% if (cover) { %>
									<img src="<%= thumbUrl(cover.src) %>" alt="" class="rounded admin-thumb" loading="lazy" data-fallback-src="<%= cover.src %>" />
								<% } else { %>
									<div class="admin-thumb admin-thumb-empty rounded"><i class="fa fa-image text-muted"></i></div>
								<% } %>
							</td>
							<td>
								<a href="/admin/products/<%= product.id %>/edit" class="fw-bold"><%= product.name %></a>
								<% if (product.featured) { %><span class="badge bg-warning text-dark ms-1">Featured</span><% } %>
								<% if (product.model) { %><div class="small text-muted"><%= product.model %></div><% } %>
							</td>
							<td><a href="/admin/products?category=<%= product.categoryId %>"><%= product.categoryName %></a></td>
							<td><% if (product.brandName) { %><a href="/admin/products?brand=<%= product.brandId %>"><%= product.brandName %></a><% } else { %><span class="text-muted">—</span><% } %></td>
							<td class="text-center"><%= product.images.length %></td>
							<td><% if (product.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %></td>
							<td class="text-nowrap small"><%= new Date(product.updatedAt).toLocaleDateString('en-GB') %></td>
							<td class="text-nowrap">
								<a href="/admin/products/<%= product.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
								<% if (product.url && product.status === 'published') { %><a href="<%= product.url %>" target="_blank" rel="noopener" class="btn btn-sm btn-default" title="View on site"><i class="fa fa-external-link-alt"></i></a><% } %>
								<button type="button" class="btn btn-sm btn-danger" title="Delete"
									data-delete-url="/admin/products/<%= product.id %>"
									data-delete-title="Delete product"
									data-delete-message="Delete “<%= product.name %>” and its images?">
									<i class="fa fa-trash"></i>
								</button>
							</td>
						</tr>
					<% }) %>
					<% if (products.length === 0) { %>
						<tr><td colspan="8" class="text-center text-muted py-4">No products match. <a href="/admin/products/create">Add a product</a>.</td></tr>
					<% } %>
				</tbody>
			</table>
		</div>
	</div>
</div>
