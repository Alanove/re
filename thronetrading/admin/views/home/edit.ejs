<%
	const s = section;
	const val = function (v) { return v === undefined || v === null ? '' : v; };
	const fieldClass = function (name) { return errors[name] ? 'form-control is-invalid' : 'form-control'; };
	const hasIntro = ['categories', 'brands', 'featuredProducts', 'whyUs', 'contact'].indexOf(sectionKey) !== -1;
	const selectedCategories = s.categoryIds || [];
	const whyUsItems = s.items || [];
%>
<form method="POST" action="/admin/home/<%= sectionKey %>/edit?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" novalidate>
	<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
	<div class="row">
		<div class="col-xl-8">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title"><%= sectionLabel %></h4></div>
				<div class="panel-body">
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" id="enabled" name="enabled" value="1" <%= s.enabled ? 'checked' : '' %> />
						<label class="form-check-label" for="enabled">Show this section on the home page</label>
					</div>
					<% if (sectionKey !== 'hero') { %>
						<div class="mb-3">
							<label class="form-label" for="title">Heading <span class="text-danger">*</span></label>
							<input type="text" class="<%= fieldClass('title') %>" id="title" name="title" value="<%= val(s.title) %>" maxlength="120" required />
							<%- include('../partials/field-error', { name: 'title' }) %>
						</div>
					<% } %>

					<% if (sectionKey === 'hero') { %>
						<p class="text-muted small">Add up to <%= heroSlidesMax %> slides. Drag the handle or use the arrows to change the order, and use the trash button to remove a slide. Each slide needs a title and should have an image. A video is optional and plays muted behind the text. Zoom slowly moves the image while that slide is showing.</p>
						<div class="d-flex align-items-center gap-3 mb-3">
							<button type="button" class="btn btn-primary" data-hero-add <%= (s.slides || []).length >= heroSlidesMax ? 'disabled' : '' %>><i class="fa fa-plus me-1" aria-hidden="true"></i> Add slide</button>
							<span class="text-muted small" data-hero-count><%= (s.slides || []).length %> of <%= heroSlidesMax %> slides</span>
						</div>
						<p class="text-muted small" data-hero-empty<% if ((s.slides || []).length) { %> hidden<% } %>>No slides yet. Add a slide to show the hero.</p>
						<div id="hero-slides" data-hero-slides data-max="<%= heroSlidesMax %>">
							<% (s.slides || []).forEach(function (slide, i) { %>
								<%- include('slide', { slide: slide, i: i }) %>
							<% }) %>
						</div>
						<template id="hero-slide-template">
							<%- include('slide', { slide: { title: '', text: '', image: '', video: '', zoom: '', primaryCta: {}, secondaryCta: {} }, i: 99 }) %>
						</template>
						<% if (errors.slides) { %><div class="invalid-feedback d-block"><%= errors.slides %></div><% } %>
					<% } %>

					<% if (sectionKey === 'about') { %>
						<div class="mb-3">
							<label class="form-label" for="lead">Lead paragraph</label>
							<textarea class="<%= fieldClass('lead') %>" id="lead" name="lead" rows="3" maxlength="1200"><%= val(s.lead) %></textarea>
							<%- include('../partials/field-error', { name: 'lead' }) %>
						</div>
						<div class="mb-3">
							<label class="form-label" for="text">Second paragraph</label>
							<textarea class="<%= fieldClass('text') %>" id="text" name="text" rows="3" maxlength="1200"><%= val(s.text) %></textarea>
							<%- include('../partials/field-error', { name: 'text' }) %>
						</div>
						<div class="row g-2 mb-3">
							<div class="col-md-4">
								<label class="form-label" for="statValue">Highlight value</label>
								<input type="text" class="<%= fieldClass('statValue') %>" id="statValue" name="statValue" value="<%= val(s.statValue) %>" placeholder="2002" maxlength="20" />
							</div>
							<div class="col-md-8">
								<label class="form-label" for="statLabel">Highlight label</label>
								<input type="text" class="<%= fieldClass('statLabel') %>" id="statLabel" name="statLabel" value="<%= val(s.statLabel) %>" placeholder="In the market since" maxlength="60" />
							</div>
						</div>
					<% } %>

					<% if (hasIntro) { %>
						<div class="mb-3">
							<label class="form-label" for="intro">Introduction</label>
							<textarea class="<%= fieldClass('intro') %>" id="intro" name="intro" rows="3" maxlength="400"><%= val(s.intro) %></textarea>
							<%- include('../partials/field-error', { name: 'intro' }) %>
						</div>
					<% } %>

					<% if (sectionKey === 'about' || sectionKey === 'featuredProducts') { %>
						<div class="row g-2 mb-3">
							<div class="col-md-6"><label class="form-label" for="ctaLabel">Button label</label><input type="text" class="<%= fieldClass('ctaLabel') %>" id="ctaLabel" name="ctaLabel" value="<%= val(s.cta && s.cta.label) %>" maxlength="80" /></div>
							<div class="col-md-6"><label class="form-label" for="ctaUrl">Button link</label><input type="text" class="<%= fieldClass('ctaUrl') %>" id="ctaUrl" name="ctaUrl" value="<%= val(s.cta && s.cta.url) %>" placeholder="/products" /><%- include('../partials/field-error', { name: 'ctaUrl' }) %></div>
						</div>
					<% } %>

					<% if (sectionKey === 'featuredProducts') { %>
						<div class="mb-3" style="max-width:220px">
							<label class="form-label" for="limit">Products to show</label>
							<input type="number" class="<%= fieldClass('limit') %>" id="limit" name="limit" value="<%= val(s.limit) %>" min="1" max="<%= homeListMax %>" />
							<%- include('../partials/field-error', { name: 'limit' }) %>
						</div>
						<p class="text-muted small">Products marked <strong>Featured</strong> in the catalog are shown first, then the most recently updated products that have images.</p>
					<% } %>

					<% if (sectionKey === 'brands') { %>
						<p class="text-muted small">All published brands marked <strong>Show on home page</strong> are listed, in brand sort order. Manage them under <a href="/admin/brands">Brands</a>.</p>
					<% } %>

					<% if (sectionKey === 'categories') { %>
						<fieldset>
							<legend class="form-label fs-6">Categories to show</legend>
							<p class="text-muted small">Pick up to <%= homeListMax %>. Leave all unticked to show every published category.</p>
							<div class="row g-2">
								<% categoryOptions.forEach(function (category) { %>
									<div class="col-md-6">
										<div class="form-check">
											<input class="form-check-input" type="checkbox" name="categoryIds" value="<%= category.id %>" id="cat-<%= category.id %>" <%= selectedCategories.indexOf(category.id) !== -1 ? 'checked' : '' %> />
											<label class="form-check-label" for="cat-<%= category.id %>"><%= category.name %><% if (category.status !== 'published') { %> <span class="badge bg-secondary">Draft</span><% } %></label>
										</div>
									</div>
								<% }) %>
								<% if (categoryOptions.length === 0) { %><p class="text-muted">No categories yet. <a href="/admin/categories/create">Create one</a>.</p><% } %>
							</div>
							<%- include('../partials/field-error', { name: 'categoryIds' }) %>
						</fieldset>
					<% } %>

					<% if (sectionKey === 'whyUs') { %>
						<h5 class="mt-4">Reasons</h5>
						<p class="text-muted small">Up to <%= whyUsMax %>. Icons use <a href="https://fonts.google.com/icons" target="_blank" rel="noopener">Material Symbols</a> names such as <code>verified_user</code>.</p>
						<div data-repeater data-max="<%= whyUsMax %>" data-repeater-name="items">
							<div data-repeater-list>
								<% whyUsItems.forEach(function (item, i) { %>
									<%- include('../partials/why-us-row', { item: item, i: i }) %>
								<% }) %>
							</div>
							<template data-repeater-template><%- include('../partials/why-us-row', { item: { title: '', text: '', icon: '' }, i: 99 }) %></template>
							<button type="button" class="btn btn-default btn-sm" data-repeater-add><i class="fa fa-plus me-1" aria-hidden="true"></i> Add reason</button>
						</div>
					<% } %>
				</div>
			</div>
		</div>

		<div class="col-xl-4">
			<div class="panel panel-inverse admin-sticky">
				<div class="panel-heading"><h4 class="panel-title">Save</h4></div>
				<div class="panel-body">
					<% if (hasImage) { %>
						<label class="form-label" for="imageFile">Section image</label>
						<%- include('../partials/media-picker', { id: 'imageFile', field: 'imageFile', kind: 'image', current: s.image || '', valueName: 'image', label: 'section image' }) %>
						<%- include('../partials/field-error', { name: 'image' }) %>
						<div class="mb-3"></div>
					<% } %>
					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-success flex-fill"><i class="fa fa-save me-1"></i> Save section</button>
						<a href="/admin/home" class="btn btn-default">Back</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
