SITE_URL=https://www.liteweb.info
# Shown in the footer, contact page, and structured data.
PUBLIC_EMAIL=hello@liteweb.info
# SMTP From address used when sending form emails. Can be a Gmail mailbox.
MAIL_FROM=liteweb48@gmail.com
MAIL_FROM_NAME=Liteweb
MAIL_TO=hello@liteweb.info
# brevo (default) or gmail
MAIL_PROVIDER=brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Gmail SMTP: set MAIL_PROVIDER=gmail and fill these.
# Google will not accept your normal Gmail password. Create an App Password:
# 1. Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Open App passwords (only after 2FA is on): https://myaccount.google.com/apppasswords
# 3. App: Mail. Device: Other → name it LiteWeb
# 4. Paste the 16-character password below (spaces optional)
# 5. Restart the server. If App passwords is missing: 2FA is off, passkeys-only, or a Workspace policy blocks it.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Google reCAPTCHA v3 (score-based, no checkbox) — one key pair covers all four forms.
# Create keys at https://www.google.com/recaptcha/admin
# reCAPTCHA type: v3 / score based. Domains: www.liteweb.info, liteweb.info, localhost
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# true locally if this IP is not authorized in Brevo. false on production.
MAIL_DRY_RUN=true
PHONE=+96176653348
WHATSAPP=+96176653348
# Folder for saved submissions (default: ./mails)
MAIL_LOG_DIR=./mails
# Public social profile URLs. Leave empty to hide the icon.
FACEBOOK=https://www.facebook.com/liteweb
X=
INSTAGRAM=
