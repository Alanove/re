NODE_ENV=development
PORT=3046
PUBLIC_BASE_URL=http://localhost:3046
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@bypec-lb.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Site Administrator
TRUST_PROXY=0

# Optional. Contact inquiries are always stored; mail is sent only when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Image processing (sharp). Keep concurrency low on small Linux servers; 0 = one thread per CPU core.
SHARP_CONCURRENCY=1
SHARP_CACHE_MB=0

# Official fuel prices. The server reads the price block on the Ministry of Energy and Water home page.
# Set FUEL_PRICES_SYNC_ENABLED=false to stop all automatic fetching; editors can still set prices in admin.
FUEL_PRICES_SYNC_ENABLED=true
FUEL_PRICES_SOURCE_URL=https://energyandwater.gov.lb/ar/home
FUEL_PRICES_SYNC_MINUTES=180
