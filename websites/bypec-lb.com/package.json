{
  "name": "bypec-site",
  "version": "1.0.0",
  "private": true,
  "description": "Bypec - Byblos Petroleum Company website on the shared Node.js CMS",
  "type": "module",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "scss:once": "sass public/scss/main.scss:public/css/main.css admin/public/css/admin.scss:admin/public/css/admin.css --style=compressed --no-source-map",
    "scss:watch": "sass public/scss/main.scss:public/css/main.css admin/public/css/admin.scss:admin/public/css/admin.css --style=expanded --watch",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && npm run scss:once && tsc -p tsconfig.build.json",
    "cms:sync": "tsx scripts/sync-cms.ts",
    "editor:build": "node ../../packages/rich-text-editor/esbuild.config.mjs --out admin/public/editor",
    "table-sort:build": "node ../../packages/table-sort/esbuild.config.mjs --out admin/public/table-sort",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "download:assets": "tsx scripts/download-assets.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "media:check": "tsx scripts/check-media.ts",
    "media:check:prod": "node dist/scripts/check-media.js"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "memorystore": "^1.6.8",
    "multer": "^2.5.0",
    "node-html-parser": "^9.0.7",
    "nodemailer": "^10.3.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "sass": "^1.108.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
