NODE_ENV=production
PORT=3049
PUBLIC_BASE_URL=https://bypec-lb.com
SESSION_SECRET=u13_aIhV8hqiZcdeFed5-5Gsx4q-dhIj73VcU0W1vssyJimvTaUdbJMMBhN3UvqZ
ADMIN_NAME=Site Administrator
# aaPanel serves the site through an nginx reverse proxy; 1 trusts that one hop so secure cookies work.
TRUST_PROXY=1

# Contact inquiries are always stored; mail is sent only when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

SHARP_CONCURRENCY=1
SHARP_CACHE_MB=0

# Official fuel prices from the Ministry of Energy and Water (home page price block).
FUEL_PRICES_SYNC_ENABLED=true
FUEL_PRICES_SOURCE_URL=https://energyandwater.gov.lb/ar/home
FUEL_PRICES_SYNC_MINUTES=180
