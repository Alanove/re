<html lang="en">
<!--<![endif]-->

<head runat="server">
    <title></title>
    <lw:UserControl Control="MetaTags" runat="server" />
    <lw:UserControl Control="Analytics" runat="server" />
    <asp:ContentPlaceHolder ID="Header" runat="server" />
</head>
<body runat="server">
    <div class="wrapper">
        <lw:UserControl Control="Header" runat="server" />
        <asp:ContentPlaceHolder ID="HeaderImage" runat="server" Visible="false" />
        <asp:ContentPlaceHolder ID="Content" runat="server" />
        <lw:UserControl Control="Footer" runat="server" />
    </div>
	<lw:UserControl Control="CommonCssJs" runat="server" />
</body>
</html>
