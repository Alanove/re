<?xml version="1.0"?>
<configuration>
	<appSettings configSource="_app.config"/>
	<connectionStrings configSource="_connections.config"/>
	<system.net>
		<mailSettings> 
			<smtp configSource="_mail.config"/>
		</mailSettings>
	</system.net>
	<system.webServer>
		<handlers>
			<add verb="GET" path="ImageVerifier.axd" type="lw.SecurityControls.CaptchaImage, SecurityControls" name="ImageVerifier"/>
			<add verb="GET" path="ImageCropper.axd" type="lw.ImageControls.ImageCropper, ImageControls" name="ImageCropper"/>
			<add verb="GET" path="ImageResizer.axd" type="lw.ImageControls.ImageResizer, ImageControls" name="ImageResizer"/>
			<add verb="GET" path="download-file.axd" type="lw.Downloads.Handler.DownloadFile, Downloads" name="download-file"/>
			<add verb="GET" path="image-resizer.axd" type="lw.ImageControls.ImageResizer, ImageControls" name="image-resizer"/>
			<!-- Shopping Cart -->
			<add verb="POST,GET" path="ShoppingCartAdd.axd" type="lw.Tags.ShoppingCartAdd, Tags" name="shopping-cart-add"/>
			<add verb="POST,GET" path="ShoppingCartUpdate.axd" type="lw.Tags.ShoppingCartUpdate, Tags" name="shoppingcartupdate"/>
			<!-- Tiny MCE -->
			<add verb="GET,HEAD,POST" path="TinyMCE.ashx" type="Moxiecode.TinyMCE.Web.HttpHandler,Moxiecode.TinyMCE" name="tinymce"/>
			<add type="lw.dotlessHandler,lw.dotless" path="*.LESS" verb="*" name="Less"/>
			<add type="lw.js.Handler,lw.js" path="*.lwjs" verb="*" name="lw.js"/>
		</handlers>
		<modules runAllManagedModulesForAllRequests="true">
			<remove name="WindowsAuthentication"/>
			<remove name="FormsAuthentication"/>
			<remove name="PassportAuthentication"/>
			<remove name="UrlAuthorization"/>
			<remove name="FileAuthorization"/>
			<remove name="UrlRoutingModule"/>
			<add name="UrlRoutingModule" type="System.Web.Routing.UrlRoutingModule, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a"/>
		</modules>
		<httpErrors>
			<remove statusCode="404" subStatusCode="-1"/>
			<error statusCode="404" prefixLanguageFilePath="" path="/_error.htm" responseMode="ExecuteURL"/>
		</httpErrors>
		<staticContent>
			<remove fileExtension=".woff" />
			<mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
		</staticContent>
	</system.webServer>
	<!--
    For a description of web.config changes for .NET 4.5 see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
	<system.web>
		<httpRuntime maxRequestLength="500480" executionTimeout="7200" requestValidationMode="2.0"/>
		<customErrors mode="Off" defaultRedirect="_error.htm"/>
		<anonymousIdentification enabled="true"/>
		<profile enabled="true" defaultProvider="SqlProvider" automaticSaveEnabled="true" inherits="lw.WebTools.lwProfile">
			<providers>
				<add name="SqlProvider" type="lw.WebTools.SqlProvider" connectionStringName="SQL" applicationName="LW" description="LW"/>
			</providers>
		</profile>
    <roleManager enabled="true" defaultProvider="Customroles">
      <providers>
        <add type="lw.Members.Security.CustomRolesProvider" name="Customroles" applicationName="/" connectionStringName="SQL" />
      </providers>
    </roleManager>
		<pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" pageBaseType="Current_Page">
			<controls>
				<add tagPrefix="lw" namespace="lw.Base" assembly="Base"/>
				<add tagPrefix="lw" namespace="lw.DataControls" assembly="DataControls"/>
				<add tagPrefix="lw" namespace="lw.Forms.Controls" assembly="Forms"/>
				<add tagPrefix="lw" namespace="lw.ImageControls" assembly="ImageControls"/>
				<add tagPrefix="lw" namespace="lw.Content.Controls" assembly="Content"/>
				<add tagPrefix="lw" namespace="lw.Utilities" assembly="Utilities"/>
				<add tagPrefix="lw" namespace="lw.Downloads.Controls" assembly="Downloads"/>
				<add tagPrefix="lw" namespace="lw.Members.Controls" assembly="Members"/>
				<add tagPrefix="lw" namespace="lw.SecurityControls" assembly="SecurityControls"/>
				<add tagPrefix="lw" namespace="lw.Products.Controls" assembly="Products"/>
				<add tagPrefix="lw" namespace="lw.PhotoAlbums.Controls" assembly="PhotoAlbums"/>
				<add tagPrefix="lw" namespace="lw.ShoppingCart.Controls" assembly="Orders"/>
				<add tagPrefix="CKEditor" assembly="CKEditor.NET" namespace="CKEditor.NET"/>
				<add tagPrefix="lw" namespace="lw.Networking.Controls" assembly="Networking"/>
				<add tagPrefix="lw" namespace="lw.Operators.Controls" assembly="Operators"/>
				<add tagPrefix="lw" namespace="lw.Events.Controls" assembly="Events"/>
				<add tagPrefix="lw" namespace="lw.Pages.Controls" assembly="Pages"/>
				<add tagPrefix="lw" namespace="lw.Searcher.Controls" assembly="Searcher"/>
				<add tagPrefix="lw" namespace="lw.Comments.Controls" assembly="Comments"/>
				<add tagPrefix="lw" namespace="lw.Products.Controls" assembly="Products"/>
				<add tagPrefix="lw" namespace="lw.Orders.Controls" assembly="Orders"/>
				<add tagPrefix="lw" namespace="lw.VideoGallery.Controls" assembly="VideoGallery" />
			</controls>
			<namespaces>
				<add namespace="lw.Utils"/>
				<add namespace="lw.WebTools"/>
				<add namespace="lw.CTE"/>
			</namespaces>
		</pages>
		<compilation defaultLanguage="c#" debug="true" targetFramework="4.5">
			<assemblies>
				<add assembly="System.Data.Linq, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
				<add assembly="System.DirectoryServices, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
				<add assembly="System.DirectoryServices.AccountManagement, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
				<add assembly="System.DirectoryServices.Protocols, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
				<add assembly="System.Management, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
				<add assembly="System.Management.Instrumentation, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
			</assemblies>
		</compilation>
		<authentication mode="Windows"/>
		<authorization>
			<allow users="*"/>
			<allow users="?"/>
		</authorization>
		<sessionState mode="InProc" stateConnectionString="tcpip=127.0.0.1:42424" sqlConnectionString="data source=127.0.0.1;Trusted_Connection=yes" cookieless="false" timeout="20"/>
		<globalization requestEncoding="utf-8" responseEncoding="utf-8"/>
		<xhtmlConformance mode="Legacy"/>
		<machineKey decryptionKey="F3A6EE07F1F4A6BB5D996CA51CE2C3FEE4554F2FC8BFC7F2" validationKey="7BCFA94B47AF11EF0223E0148F00BDA3F6D34AEA742C345D7134882C631C371395D3107D14A8EA2FF1F94F1E126D197219E3FE287E46C94E638C2E1AB9E045DE"/>
	</system.web>
</configuration>