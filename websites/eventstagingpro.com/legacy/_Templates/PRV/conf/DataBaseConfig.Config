<?xml version="1.0" standalone="yes" ?>
<DataCData xmlns="http://www.tempuri.org/DataCData.xsd">
  <xs:schema id="DataCData" targetNamespace="http://www.tempuri.org/DataCData.xsd" xmlns:mstns="http://www.tempuri.org/DataCData.xsd"
		xmlns="http://www.tempuri.org/DataCData.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema"
		xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
    <xs:element name="DataCData" msdata:IsDataSet="true">
      <xs:complexType>
        <xs:choice maxOccurs="unbounded">
          <xs:element name="Configurations">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="ConfigurationId" msdata:ReadOnly="true" msdata:AutoIncrement="true" type="xs:int" />
                <xs:element name="ParamName" type="xs:string" minOccurs="0" />
                <xs:element name="ParamValue" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ClassLibraryApplication">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="ClassLibraryId" msdata:ReadOnly="true" msdata:AutoIncrement="true" type="xs:int" />
                <xs:element name="ClassLibraryName" type="xs:string" minOccurs="0" />
                <xs:element name="ConnectionName" type="xs:string" minOccurs="0" />
                <xs:element name="ComponentClass" type="xs:string" minOccurs="0" />
                <xs:element name="AssemblyName" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1" msdata:PrimaryKey="true">
        <xs:selector xpath=".//mstns:Configurations" />
        <xs:field xpath="mstns:ConfigurationId" />
      </xs:unique>
    </xs:element>
  </xs:schema>
