<?xml version="1.0" standalone="yes"?>
<SliderDS xmlns="http://tempuri.org/SliderDS.xsd">
  <xs:schema id="SliderDS" targetNamespace="http://tempuri.org/SliderDS.xsd" xmlns:mstns="http://tempuri.org/SliderDS.xsd" xmlns="http://tempuri.org/SliderDS.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
    <xs:element name="SliderDS" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
      <xs:complexType>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Slides">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Id" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="Title" type="xs:string" minOccurs="0" />
                <xs:element name="Description" type="xs:string" minOccurs="0" />
                <xs:element name="OrderNbr" type="xs:int" minOccurs="0" />
                <xs:element name="ImageUrl" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="SlidesKey11" msdata:PrimaryKey="true">
        <xs:selector xpath=".//mstns:Slides" />
        <xs:field xpath="mstns:Id" />
      </xs:unique>
    </xs:element>
  </xs:schema>
  <Slides>
    <Id>1</Id>
    <Title>Set in 148 Acres of Beautiful English Countryside</Title>
    <Description />
    <OrderNbr>300</OrderNbr>
    <ImageUrl>1</ImageUrl>
  </Slides>
  <Slides>
    <Id>2</Id>
    <Title>High Quality Education</Title>
    <Description />
    <OrderNbr>200</OrderNbr>
    <ImageUrl>2</ImageUrl>
  </Slides>
  <Slides>
    <Id>3</Id>
    <Title>Learning in an Inspirational Setting</Title>
    <Description />
    <OrderNbr>100</OrderNbr>
    <ImageUrl>3</ImageUrl>
  </Slides>
</SliderDS>