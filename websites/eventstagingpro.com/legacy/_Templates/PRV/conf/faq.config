<?xml version="1.0" standalone="yes"?>
<FaqDS xmlns="http://tempuri.org/FaqDS.xsd">
  <xs:schema id="FaqDS" targetNamespace="http://tempuri.org/FaqDS.xsd" xmlns:mstns="http://tempuri.org/FaqDS.xsd" xmlns="http://tempuri.org/FaqDS.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
    <xs:element name="FaqDS" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
      <xs:complexType>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Faq">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="FaqId" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="Question" type="xs:string" minOccurs="0" />
                <xs:element name="Answer" type="xs:string" minOccurs="0" />
                <xs:element name="GroupId" type="xs:int" minOccurs="0" />
                <xs:element name="Sort" type="xs:int" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="Groups">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="GroupId" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="GroupName" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1">
        <xs:selector xpath=".//mstns:Faq" />
        <xs:field xpath="mstns:FaqId" />
      </xs:unique>
      <xs:unique name="Groups_Constraint1" msdata:ConstraintName="Constraint1">
        <xs:selector xpath=".//mstns:Groups" />
        <xs:field xpath="mstns:GroupId" />
      </xs:unique>
    </xs:element>
  </xs:schema>
  <Faq>
    <FaqId>1</FaqId>
    <Question>Question Faq</Question>
    <Answer>Answer Faq</Answer>
    <GroupId>1</GroupId>
    <Sort>1</Sort>
  </Faq>
  <Faq>
    <FaqId>2</FaqId>
    <Question>Question..Question..Question..</Question>
    <Answer>​Answer..​Answer..​Answer..</Answer>
    <GroupId>1</GroupId>
    <Sort>1</Sort>
  </Faq>
  <Faq>
    <FaqId>3</FaqId>
    <Question>Question2..Question2..Question2..</Question>
    <Answer>​Answer2..​Answer2..​Answer2..</Answer>
    <GroupId>1</GroupId>
    <Sort>1</Sort>
  </Faq>
  <Groups>
    <GroupId>1</GroupId>
    <GroupName>test</GroupName>
  </Groups>
</FaqDS>