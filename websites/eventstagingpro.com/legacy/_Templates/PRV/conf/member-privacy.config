<?xml version="1.0" standalone="yes"?>
<config>
  <xs:schema id="config" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xs:element name="config" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
      <xs:complexType>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Privacy">
            <xs:complexType>
              <xs:sequence>
				  <xs:element name="Property" type="xs:string" minOccurs="0" />
				  <xs:element name="Value" type="xs:int" minOccurs="0" />
				  <xs:element name="Description" type="xs:string" minOccurs="0" />
			  </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
    </xs:element>
  </xs:schema>
	<Privacy>
		<Property>VisitorsAccess</Property>
		<Value>1</Value>
		<Description>Allow visitors to access my profile information</Description>
	</Privacy>
	<Privacy>
		<Property>BusinessPhone</Property>
		<Value>2</Value>
		<Description>Display my phone number</Description>
	</Privacy>
	<Privacy>
		<Property>ProfilePicture</Property>
		<Value>3</Value>
		<Description>Display my profile picture</Description>
	</Privacy>
	<Privacy>
		<Property>Email</Property>
		<Value>4</Value>
		<Description>Display my email address</Description>
	</Privacy>
	<Privacy>
		<Property>Facebook</Property>
		<Value>5</Value>
		<Description>Display my facebook link</Description>
	</Privacy>
	<Privacy>
		<Property>Twitter</Property>
		<Value>6</Value>
		<Description>Display my twitter link</Description>
	</Privacy>
	<Privacy>
		<Property>LinkedIn</Property>
		<Value>7</Value>
		<Description>Display my LinkedIn link</Description>
	</Privacy>
	<Privacy>
		<Property>Skype</Property>
		<Value>8</Value>
		<Description>Display my skype user</Description>
	</Privacy>
	<Privacy>
		<Property>MSN</Property>
		<Value>9</Value>
		<Description>Display my MSN address</Description>
	</Privacy>
	<Privacy>
		<Property>Yahoo</Property>
		<Value>10</Value>
		<Description>Display my Yahoo user</Description>
	</Privacy>
	<Privacy>
		<Property>ICQ</Property>
		<Value>11</Value>
		<Description>Display my ICQ number</Description>
	</Privacy>
</config>