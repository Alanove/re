<?xml version="1.0" standalone="yes"?>
<CustomShippingDS xmlns="http://tempuri.org/CustomShippingDS.xsd">
  <xs:schema id="CustomShippingDS" targetNamespace="http://tempuri.org/CustomShippingDS.xsd" xmlns:mstns="http://tempuri.org/CustomShippingDS.xsd" xmlns="http://tempuri.org/CustomShippingDS.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
    <xs:element name="CustomShippingDS" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
      <xs:complexType>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="ShippingCalculationWay">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Id" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="Name" type="xs:string" minOccurs="0" />
                <xs:element name="Default" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ShippingWeight">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="UpTo" type="xs:double" minOccurs="0" />
                <xs:element name="Value" type="xs:double" minOccurs="0" />
                <xs:element name="GroupId" type="xs:string" minOccurs="0" />
                <xs:element name="GroupType" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ShippingOrderCost">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="UpTo" type="xs:double" minOccurs="0" />
                <xs:element name="Value" type="xs:double" minOccurs="0" />
                <xs:element name="GroupId" type="xs:string" minOccurs="0" />
                <xs:element name="GroupType" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="Data">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Name" type="xs:string" minOccurs="0" />
                <xs:element name="Value" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="eCountries">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Name" type="xs:string" minOccurs="0" />
                <xs:element name="DisplayName" type="xs:string" minOccurs="0" />
                <xs:element name="GroupId" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="eRegions">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Name" type="xs:string" minOccurs="0" />
                <xs:element name="DisplayName" type="xs:string" minOccurs="0" />
                <xs:element name="GroupId" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="CountryGroups">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="GroupId" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="GroupName" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="RegionGroups">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="GroupId" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="GroupName" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="ShippingBasedOn">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Id" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="Name" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1">
        <xs:selector xpath=".//mstns:ShippingCalculationWay" />
        <xs:field xpath="mstns:Id" />
      </xs:unique>
      <xs:unique name="CountryGroups_Constraint1" msdata:ConstraintName="Constraint1">
        <xs:selector xpath=".//mstns:CountryGroups" />
        <xs:field xpath="mstns:GroupId" />
      </xs:unique>
      <xs:unique name="RegionGroups_Constraint1" msdata:ConstraintName="Constraint1">
        <xs:selector xpath=".//mstns:RegionGroups" />
        <xs:field xpath="mstns:GroupId" />
      </xs:unique>
      <xs:unique name="ShippingBasedOn_Constraint1" msdata:ConstraintName="Constraint1">
        <xs:selector xpath=".//mstns:ShippingBasedOn" />
        <xs:field xpath="mstns:Id" />
      </xs:unique>
    </xs:element>
  </xs:schema>
