<PagesDS xmlns="http://tempuri.org/PagesDS.xsd">
  <xs:schema id="PagesDS" targetNamespace="http://tempuri.org/PagesDS.xsd" xmlns:mstns="http://tempuri.org/PagesDS.xsd" xmlns="http://tempuri.org/PagesDS.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" attributeFormDefault="qualified" elementFormDefault="qualified">
    <xs:element name="PagesDS" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
      <xs:complexType>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="Pages">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="PageId" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="Name" type="xs:string" minOccurs="0" />
                <xs:element name="Title" type="xs:string" minOccurs="0" />
                <xs:element name="Description" type="xs:string" minOccurs="0" />
                <xs:element name="Virtual" type="xs:boolean" default="true" minOccurs="0" />
                <xs:element name="LastModified" type="xs:dateTime" minOccurs="0" />
                <xs:element name="Url" type="xs:string" minOccurs="0" />
                <xs:element name="GroupId" type="xs:int" minOccurs="0" />
                <xs:element name="Content" type="xs:string" minOccurs="0" />
                <xs:element name="Keywords" type="xs:string" minOccurs="0" />
                <xs:element name="FileName" type="xs:string" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="Groups">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="GroupId" msdata:ReadOnly="true" msdata:AutoIncrement="true" msdata:AutoIncrementSeed="1" type="xs:int" />
                <xs:element name="GroupName" type="xs:string" minOccurs="0" />
                <xs:element name="Path" type="xs:string" minOccurs="0" />
                <xs:element name="Parent" type="xs:int" minOccurs="0" />
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:choice>
      </xs:complexType>
      <xs:unique name="Constraint1">
        <xs:selector xpath=".//mstns:Pages" />
        <xs:field xpath="mstns:PageId" />
      </xs:unique>
      <xs:unique name="Groups_Constraint1" msdata:ConstraintName="Constraint1">
        <xs:selector xpath=".//mstns:Groups" />
        <xs:field xpath="mstns:GroupId" />
      </xs:unique>
    </xs:element>
  </xs:schema>
