<section id="content" class="main-container news-details">
	<div class="container">
		<article>
			<header class="row">
				<div class="col-sm-10"><h1><%= page.header || page.title %></h1></div>
				<div class="col-sm-2 back"><a href="<%= page.ancestors.length ? page.ancestors[page.ancestors.length - 1].url : '/news-events' %>">&laquo; Back</a></div>
			</header>
			<% if (page.heroImage) { %>
				<img src="<%= page.heroImage %>" class="img-responsive col-sm-6 newsdetails-img" alt="<%= page.title %>" />
			<% } %>
			<%- page.content %>
		</article>
	</div>
</section>
