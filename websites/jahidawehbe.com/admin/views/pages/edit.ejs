<%
	const isEntry = mode === 'entry';
	const isRoot = mode === 'root';
	const isEvent = isEntry && collection && collection.kind === 'events';
	const basePath = collection ? collection.basePath : '/admin/pages';
	const action = isCreate ? basePath + '/create' : basePath + '/' + page.id + '/edit';
	const seo = page.seo || { title: '', description: '', keywords: '' };
	const lockedKind = isRoot || page.kind === 'videos' && !isCreate;
	const noun = isEntry ? collection.singular : 'page';
	const parentId = isEntry && root ? root.id : '';
%>
<form method="POST" action="<%= action %>?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" id="page-form" novalidate
	data-slug-check="/admin/api/pages/check-slug" data-page-id="<%= page.id || '' %>">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
	<input type="hidden" name="key" value="<%= page.key || 'new-page' %>" />
	<% if (lockedKind) { %><input type="hidden" name="kind" value="<%= page.kind %>" /><% } %>
	<% if (isEntry) { %><input type="hidden" id="parentId" name="parentId" value="<%= parentId %>" /><% } %>
	<% if (isRoot) { %><input type="hidden" id="parentId" name="parentId" value="<%= page.parentId === null ? '' : page.parentId %>" /><% } %>
	<div class="row">
		<div class="col-xl-8">
			<% if (isEvent) { %>
				<div class="panel panel-inverse">
					<div class="panel-heading"><h4 class="panel-title">Event details</h4></div>
					<div class="panel-body">
						<div class="row g-3">
							<div class="col-md-4">
								<label class="form-label" for="eventDate">Date</label>
								<input type="date" class="form-control <%= errors.eventDate ? 'is-invalid' : '' %>" id="eventDate" name="eventDate" value="<%= page.eventDate %>" />
								<small class="text-muted">Upcoming events show first on the website.</small>
								<%- include('../partials/field-error', { name: 'eventDate' }) %>
							</div>
							<div class="col-md-8">
								<label class="form-label" for="venue">Venue and city</label>
								<input type="text" class="form-control <%= errors.venue ? 'is-invalid' : '' %>" id="venue" name="venue" value="<%= page.venue %>" maxlength="200" placeholder="Baalbeck International Festival, Lebanon" />
								<%- include('../partials/field-error', { name: 'venue' }) %>
							</div>
							<div class="col-md-8">
								<label class="form-label" for="linkUrl">Tickets or details link</label>
								<input type="url" class="form-control <%= errors.linkUrl ? 'is-invalid' : '' %>" id="linkUrl" name="linkUrl" value="<%= page.linkUrl %>" maxlength="500" placeholder="https://" />
								<%- include('../partials/field-error', { name: 'linkUrl' }) %>
							</div>
							<div class="col-md-4">
								<label class="form-label" for="linkLabel">Button text</label>
								<input type="text" class="form-control <%= errors.linkLabel ? 'is-invalid' : '' %>" id="linkLabel" name="linkLabel" value="<%= page.linkLabel %>" maxlength="80" placeholder="Get tickets" />
								<%- include('../partials/field-error', { name: 'linkLabel' }) %>
							</div>
						</div>
					</div>
				</div>
			<% } %>

			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title"><%= isRoot ? collection.label + ' page' : 'Content' %></h4></div>
				<div class="panel-body">
					<div class="mb-3">
						<label class="form-label" for="title">Title <span class="text-danger">*</span></label>
						<input type="text" class="form-control <%= errors.title ? 'is-invalid' : '' %>" id="title" name="title" value="<%= page.title %>" maxlength="200" required data-slug-source="#slug" dir="auto" />
						<%- include('../partials/field-error', { name: 'title' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="header">Page heading</label>
						<input type="text" class="form-control <%= errors.header ? 'is-invalid' : '' %>" id="header" name="header" value="<%= page.header %>" maxlength="200" dir="auto" />
						<small class="text-muted">Shown large at the top. Leave empty to use the title.</small>
						<%- include('../partials/field-error', { name: 'header' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="summary"><%= isEntry ? 'Short intro' : 'Summary' %></label>
						<textarea class="form-control <%= errors.summary ? 'is-invalid' : '' %>" id="summary" name="summary" rows="3" maxlength="2000" dir="auto"><%= page.summary %></textarea>
						<small class="text-muted"><%= isEntry ? 'Shown on the ' + collection.label + ' cards and as the description for Google and social shares.' : isRoot ? 'Shown under the heading on the ' + collection.label + ' page.' : 'Used as the description for Google and social shares.' %></small>
						<%- include('../partials/field-error', { name: 'summary' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="direction">Text direction</label>
						<select class="form-select" id="direction" name="direction">
							<% directions.forEach(function (option) { %>
								<option value="<%= option.value %>" <%= page.direction === option.value ? 'selected' : '' %>><%= option.label %></option>
							<% }) %>
						</select>
						<small class="text-muted">Choose right to left for Arabic text so punctuation and alignment display correctly.</small>
					</div>
					<div class="mb-1">
						<label class="form-label" for="content"><%= isRoot ? 'Text above the list (optional)' : 'Body' %></label>
						<textarea class="form-control rich-text" id="content" name="content" rows="14"><%= page.content %></textarea>
						<%- include('../partials/field-error', { name: 'content' }) %>
					</div>
				</div>
			</div>

			<% if (!isRoot) { %>
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Photo gallery</h4></div>
				<div class="panel-body">
					<% if (gallery.length > 0) { %>
						<div class="row g-3 mb-3" data-gallery-list>
							<% gallery.forEach(function (image, index) { %>
								<div class="col-6 col-md-4 col-xxl-3">
									<div class="card h-100 admin-gallery-card">
										<img src="<%= thumbUrl(image.src) %>" alt="" class="card-img-top" loading="lazy" data-fallback-src="<%= image.src %>" />
										<div class="card-body p-2">
											<input type="hidden" name="gallery[<%= index %>][id]" value="<%= image.id %>" />
											<input type="text" class="form-control form-control-sm mb-1" name="gallery[<%= index %>][caption]" value="<%= image.caption %>" placeholder="Caption" maxlength="300" aria-label="Caption" dir="auto" />
											<div class="d-flex align-items-center gap-2">
												<input type="number" class="form-control form-control-sm" name="gallery[<%= index %>][sort]" value="<%= image.sort %>" min="0" style="max-width:80px" aria-label="Sort order" />
												<div class="form-check mb-0">
													<input class="form-check-input" type="checkbox" name="gallery[<%= index %>][remove]" value="1" id="remove-<%= image.id %>" />
													<label class="form-check-label small text-danger" for="remove-<%= image.id %>">Remove</label>
												</div>
											</div>
										</div>
									</div>
								</div>
							<% }) %>
						</div>
					<% } else { %>
						<p class="text-muted">No gallery photos yet.</p>
					<% } %>
					<label class="form-label" for="galleryFiles">Add photos</label>
					<%- include('../partials/media-picker', { id: 'galleryFiles', field: 'galleryFiles', kind: 'image', multiple: true, label: 'gallery photos', hint: 'Up to 25 photos per save, 8 MB each. Converted to WebP and resized to 1600px. Visitors open them full screen.' }) %>
					<% Object.keys(errors).filter(function (key) { return key.indexOf('gallery') === 0; }).forEach(function (key) { %>
						<div class="invalid-feedback d-block"><%= errors[key] %></div>
					<% }) %>
				</div>
			</div>
			<% } %>

			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Google and social shares</h4></div>
				<div class="panel-body">
					<div class="mb-3">
						<label class="form-label" for="seoTitle">Meta title</label>
						<input type="text" class="form-control" id="seoTitle" name="seoTitle" value="<%= seo.title %>" maxlength="200" data-char-count="60" dir="auto" />
					</div>
					<div class="mb-3">
						<label class="form-label" for="seoDescription">Meta description</label>
						<textarea class="form-control" id="seoDescription" name="seoDescription" rows="2" maxlength="400" data-char-count="160" dir="auto"><%= seo.description %></textarea>
					</div>
					<div>
						<label class="form-label" for="seoKeywords">Keywords</label>
						<input type="text" class="form-control" id="seoKeywords" name="seoKeywords" value="<%= seo.keywords %>" maxlength="500" dir="auto" />
					</div>
				</div>
			</div>
		</div>

		<div class="col-xl-4 admin-sticky-stack">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Publish</h4></div>
				<div class="panel-body">
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" id="published" name="published" value="1" <%= page.status === 'published' ? 'checked' : '' %> />
						<label class="form-check-label" for="published">Published</label>
					</div>
					<% if (mode === 'page') { %>
						<div class="mb-3">
							<label class="form-label" for="parentId">Parent page</label>
							<% if (lockedKind) { %>
								<input type="hidden" id="parentId" name="parentId" value="<%= page.parentId === null ? '' : page.parentId %>" />
								<p class="form-control-plaintext py-0 text-muted">The videos page stays where it is.</p>
							<% } else { %>
								<select class="form-select <%= errors.parentId ? 'is-invalid' : '' %>" id="parentId" name="parentId">
									<option value="">— Top level —</option>
									<% parents.forEach(function (option) { %>
										<option value="<%= option.id %>" <%= page.parentId === option.id ? 'selected' : '' %>><%= option.label %></option>
									<% }) %>
								</select>
							<% } %>
							<%- include('../partials/field-error', { name: 'parentId' }) %>
						</div>
					<% } %>
					<div class="mb-3">
						<label class="form-label" for="slug">URL slug</label>
						<input type="text" class="form-control <%= errors.slug ? 'is-invalid' : '' %>" id="slug" name="slug" value="<%= page.slug %>" maxlength="80" pattern="[a-z0-9][a-z0-9_\-]*" />
						<div class="small mt-1" data-slug-status></div>
						<small class="text-muted d-block">English letters, numbers and dashes. Arabic titles need a slug typed here.</small>
						<% if (!isCreate && page.url) { %><small class="text-muted">Current address: <a href="<%= page.url %>" target="_blank" rel="noopener"><%= page.url %></a></small><% } %>
						<%- include('../partials/field-error', { name: 'slug' }) %>
					</div>
					<% if (mode === 'page') { %>
						<div class="mb-3">
							<label class="form-label" for="kind">Page type</label>
							<% if (lockedKind) { %>
								<p class="form-control-plaintext py-0">Videos library</p>
							<% } else { %>
								<select class="form-select <%= errors.kind ? 'is-invalid' : '' %>" id="kind" name="kind">
									<% kinds.forEach(function (kind) { %>
										<option value="<%= kind.value %>" <%= page.kind === kind.value ? 'selected' : '' %>><%= kind.label %></option>
									<% }) %>
								</select>
							<% } %>
							<%- include('../partials/field-error', { name: 'kind' }) %>
						</div>
					<% } %>
					<div class="mb-3">
						<label class="form-label" for="sort">Sort order</label>
						<input type="number" class="form-control <%= errors.sort ? 'is-invalid' : '' %>" id="sort" name="sort" value="<%= page.sort %>" min="0" />
						<small class="text-muted"><%= isEntry ? 'Not used for ordering: ' + collection.label + ' are ordered by date.' : 'Lower numbers come first among sibling pages.' %></small>
						<%- include('../partials/field-error', { name: 'sort' }) %>
					</div>
					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-success flex-fill"><i class="fa fa-save me-1"></i> <%= isCreate ? 'Create ' + noun : 'Save changes' %></button>
						<a href="<%= basePath %>" class="btn btn-default">Cancel</a>
					</div>
				</div>
			</div>

			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title"><%= isEntry ? 'Main photo' : 'Header image' %></h4></div>
				<div class="panel-body">
					<%- include('../partials/media-picker', { id: 'heroImageFile', field: 'heroImageFile', kind: 'image', current: page.heroImage, valueName: 'heroImage', removeName: 'removeHeroImage', label: isEntry ? 'main photo' : 'header image', hint: 'JPEG, PNG, GIF or WebP up to 8 MB. Converted to WebP and resized to 2000px.' + (isEntry ? ' Also used on the ' + collection.label + ' cards.' : '') }) %>
					<%- include('../partials/field-error', { name: 'heroImage' }) %>
				</div>
			</div>

			<% if (!isEntry) { %>
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Header video</h4></div>
				<div class="panel-body">
					<%- include('../partials/media-picker', { id: 'heroVideoFile', field: 'heroVideoFile', kind: 'video', current: page.heroVideo, valueName: 'heroVideo', removeName: 'removeHeroVideo', label: 'header video', hint: 'MP4 or WebM up to 25 MB. Plays muted and looping behind the page heading; the header image shows while it loads.' }) %>
					<%- include('../partials/field-error', { name: 'heroVideo' }) %>
				</div>
			</div>
			<% } %>
		</div>
	</div>
</form>
