# aaPanel serves the site through an nginx reverse proxy; 1 trusts that one hop so secure cookies work.
TRUST_PROXY=1

SHARP_CONCURRENCY=1
SHARP_CACHE_MB=0

# YouTube videos are read from the channel's public feed (no API key). The channel id is set under Admin > Videos.
YOUTUBE_SYNC_ENABLED=true
YOUTUBE_SYNC_MINUTES=180

# Self-hosted captcha (packages/captcha). Random secret, at least 32 characters; no external account needed.
CAPTCHA_SECRET=de59f9ed135cee77fc13d0500fbadb34fdf24111a4926567219e3a9620e5dda4
# Optional. Proof-of-work size; higher is harder for bots and slower for people (default 100000).
CAPTCHA_DIFFICULTY=100000
