<%# Click-to-play player: shows the YouTube thumbnail and loads the privacy-enhanced player only when a visitor presses play. %>
<div class="video-stage" data-video-stage>
	<div class="video-frame" data-video-frame data-embed="<%= video.embedUrl %>" data-title="<%= video.title %>">
		<img class="video-frame__poster" src="<%= video.thumbnailLarge %>" data-fallback-src="<%= video.thumbnail %>" alt="" width="1280" height="720" loading="<%= locals.eager ? 'eager' : 'lazy' %>" decoding="async" data-video-poster />
		<button class="video-play" type="button" data-video-play aria-label="Play “<%= video.title %>”">
			<span class="video-play__disc"><%- include('icon', { name: 'play' }) %></span>
		</button>
		<noscript><a class="video-frame__fallback" href="<%= video.watchUrl %>" rel="noopener">Watch on YouTube</a></noscript>
	</div>
	<div class="video-stage__meta">
		<h3 class="video-stage__title" dir="auto" data-video-title><%= video.title %></h3>
		<p class="video-stage__date" data-video-date><%= video.dateLabel %></p>
		<a class="text-link" href="<%= video.watchUrl %>" target="_blank" rel="noopener" data-video-link>Watch on YouTube <%- include('icon', { name: 'external' }) %></a>
	</div>
</div>
