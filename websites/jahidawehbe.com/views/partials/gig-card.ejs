<%
	const external = /^https?:\/\//i.test(entry.linkUrl);
%>
<li class="gig<%= entry.image ? '' : ' gig--no-image' %>">
	<% if (entry.image) { %>
		<a class="gig__poster" href="<%= entry.url %>" tabindex="-1" aria-hidden="true">
			<img src="<%= thumbUrl(entry.image) %>" data-fallback-src="<%= entry.image %>" alt="" loading="lazy" decoding="async" />
		</a>
	<% } %>
	<div class="gig__date" aria-hidden="true">
		<span class="gig__day"><%= entry.day %></span>
		<span class="gig__month"><%= entry.month %></span>
		<span class="gig__year"><%= entry.year %></span>
	</div>
	<div class="gig__body">
		<p class="gig__when"><%- include('icon', { name: 'calendar' }) %> <time datetime="<%= entry.date.slice(0, 10) %>"><%= entry.weekday %>, <%= entry.dateLabel %></time></p>
		<h3 class="gig__title" dir="<%= entry.direction %>"><a href="<%= entry.url %>"><%= entry.title %></a></h3>
		<% if (entry.venue) { %><p class="gig__venue" dir="auto"><%- include('icon', { name: 'pin' }) %> <%= entry.venue %></p><% } %>
		<div class="gig__actions">
			<% if (entry.linkUrl) { %>
				<a class="btn btn--primary btn--sm" href="<%= entry.linkUrl %>"<% if (external) { %> target="_blank" rel="noopener"<% } %>><%- include('icon', { name: 'ticket' }) %><span><%= entry.linkLabel || 'Tickets' %></span></a>
			<% } %>
			<a class="text-link" href="<%= entry.url %>">Details <%- include('icon', { name: 'arrow', cls: 'icon-flip' }) %></a>
		</div>
	</div>
</li>
