<article class="news-card">
	<a class="news-card__link" href="<%= entry.url %>">
		<span class="news-card__image<%= entry.image ? '' : ' news-card__image--empty' %>">
			<% if (entry.image) { %>
				<img src="<%= thumbUrl(entry.image) %>" data-fallback-src="<%= entry.image %>" alt="" loading="lazy" decoding="async" />
			<% } else { %>
				<span class="news-card__glyph" aria-hidden="true">“</span>
			<% } %>
		</span>
		<span class="news-card__meta"><time datetime="<%= entry.date.slice(0, 10) %>"><%= entry.dateLabel %></time> · <%= entry.readingMinutes %> min read</span>
		<h3 class="news-card__title" dir="<%= entry.direction %>"><%= entry.title %></h3>
		<% if (entry.summary) { %><p class="news-card__summary" dir="<%= entry.direction %>"><%= entry.summary %></p><% } %>
	</a>
</article>
