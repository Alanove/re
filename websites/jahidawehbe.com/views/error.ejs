<section class="error-page">
	<div class="container error-page__inner">
		<p class="error-page__code" aria-hidden="true"><%= status %></p>
		<h1 class="error-page__title"><%= title %></h1>
		<p class="error-page__message"><%= status === 404 ? 'This page has moved or no longer exists.' : message %></p>
		<div class="error-page__actions">
			<a class="btn btn--primary" href="/"><span>Back to the home page</span></a>
			<% if (status === 404) { %><a class="btn btn--ghost" href="/videos"><%- include('partials/icon', { name: 'play' }) %><span>Watch the videos</span></a><% } %>
		</div>
		<% if (detail) { %><pre class="error-page__detail"><%= detail %></pre><% } %>
	</div>
</section>
