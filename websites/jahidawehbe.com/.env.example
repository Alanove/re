NODE_ENV=development
PORT=3048
PUBLIC_BASE_URL=http://localhost:3048
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@jahidawehbe.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Site Administrator
TRUST_PROXY=0

# Image processing (sharp). Keep concurrency low on small Linux servers; 0 = one thread per CPU core.
SHARP_CONCURRENCY=1
SHARP_CACHE_MB=0

# YouTube videos are read from the channel's public RSS feed, so no API key is needed.
# Set YOUTUBE_SYNC_ENABLED=false to stop automatic fetching; editors can still add videos by URL in admin.
YOUTUBE_SYNC_ENABLED=true
YOUTUBE_SYNC_MINUTES=180
