<% if (page.heroImage) { %>
	<div class="header-img">
		<div class="imgHeader" style="background-image: url('<%= page.heroImage %>')"></div>
	</div>
<% } %>
<div id="content">
	<div class="container">
		<div class="row">
			<div class="col-lg-8">
				<div class="content-text">
					<div class="title d-flex">
						<h1><%= page.header || page.title %></h1>
						<a href="/actualites" class="ml-auto align-self-start mt-8px"><i class="fal fa-angle-double-left mr-1"></i>Actualités</a>
					</div>
					<div class="text rte-content">
						<% if (page.heroImage) { %>
							<figure><img src="<%= page.heroImage %>" class="img-fluid" alt="<%= page.title %>" /></figure>
						<% } %>
						<%- page.content %>
						<% if (gallery && gallery.length) { %>
							<div class="galleryContainer">
								<div id="grid-container" class="cbp-l-grid-masonry-projects">
									<% gallery.forEach(function (image) { %>
										<div class="cbp-item">
											<div class="cbp-caption">
												<div class="cbp-item-wrapper details">
													<a href="<%= image.src %>" class="cbp-lightbox zoomer">
														<span class="overlay-zoom">
															<img src="<%= thumbUrl(image.src) || image.src %>" alt="<%= image.caption || page.title %>" />
															<span class="zoom-icon"></span>
														</span>
													</a>
												</div>
											</div>
										</div>
									<% }) %>
								</div>
							</div>
						<% } %>
					</div>
				</div>
			</div>
			<div class="col-lg-4 mt-4 mt-lg-0">
				<%- include('partials/sidebar', { sideTitle: 'Les Dernières Actualités', sideItems: latestNews || [] }) %>
			</div>
		</div>
	</div>
</div>
