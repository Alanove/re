<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">Products <span class="badge bg-light text-dark ms-1"><%= products.length %></span></h4>
		<div class="panel-heading-btn">
			<% if (root) { %>
				<a href="/admin/products/<%= root.id %>/edit" class="btn btn-xs btn-default me-1"><i class="fa fa-cog"></i> Page settings</a>
			<% } %>
			<a href="/admin/products/create<%= filter.category ? '?category=' + filter.category : '' %>" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add product</a>
		</div>
	</div>
	<div class="panel-body">
		<% if (!root) { %>
			<div class="alert alert-warning mb-0">The Products page does not exist yet.</div>
		<% } else { %>
			<form method="GET" action="/admin/products" class="row g-2 mb-3 align-items-end" role="search">
				<div class="col-md-4">
					<label class="form-label small" for="filter-category">Category</label>
					<select class="form-select" id="filter-category" name="category">
						<option value="">All categories</option>
						<% categories.forEach(function (category) { %>
							<option value="<%= category.id %>" <%= filter.category === category.id ? 'selected' : '' %>><%= category.title %></option>
						<% }) %>
					</select>
				</div>
				<div class="col-md-4">
					<label class="form-label small" for="q">Search</label>
					<div class="input-group">
						<span class="input-group-text"><i class="fa fa-search"></i></span>
						<input type="search" class="form-control" id="q" placeholder="Filter by title" data-table-filter="#products-table" aria-label="Filter products" />
					</div>
				</div>
				<div class="col-auto d-flex gap-1">
					<button type="submit" class="btn btn-primary" title="Apply filters"><i class="fa fa-filter"></i></button>
					<a href="/admin/products" class="btn btn-default" title="Clear filters"><i class="fa fa-times"></i></a>
				</div>
			</form>
			<div class="table-responsive">
				<table class="table table-striped table-bordered align-middle" id="products-table">
					<thead>
						<tr>
							<th style="width:56px" data-sort="off">Image</th>
							<th>Name</th>
							<th>Category</th>
							<th>Status</th>
							<th class="text-center">Gallery</th>
							<th style="width:1%" data-sort="off">Actions</th>
						</tr>
					</thead>
					<tbody>
						<% products.forEach(function (product) { %>
							<tr data-filter-text="<%= (product.title + ' ' + product.categoryName).toLowerCase() %>">
								<td>
									<% if (product.heroImage) { %>
										<img src="<%= thumbUrl(product.heroImage) %>" alt="" class="rounded admin-thumb" loading="lazy" data-fallback-src="<%= product.heroImage %>" />
									<% } else { %>
										<div class="admin-thumb admin-thumb-empty rounded"><i class="fa fa-image text-muted"></i></div>
									<% } %>
								</td>
								<td data-sort-value="<%= product.title %>">
									<a href="/admin/products/<%= product.id %>/edit" class="fw-bold"><%= product.title %></a>
									<div class="small"><a href="<%= product.url %>" target="_blank" rel="noopener" class="text-muted"><%= product.url %></a></div>
								</td>
								<td><a href="/admin/products?category=<%= product.parentId %>"><%= product.categoryName %></a></td>
								<td><% if (product.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %></td>
								<td class="text-center"><%= product.imageCount %></td>
								<td class="text-nowrap">
									<a href="/admin/products/<%= product.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
									<button type="button" class="btn btn-sm btn-danger" title="Delete"
										data-delete-url="/admin/products/<%= product.id %>"
										data-delete-title="Delete product"
										data-delete-message="Delete “<%= product.title %>” and its gallery?">
										<i class="fa fa-trash"></i>
									</button>
								</td>
							</tr>
						<% }) %>
						<% if (products.length === 0) { %>
							<tr><td colspan="6" class="text-center text-muted py-4">No products yet. <a href="/admin/products/create">Add a product</a>.</td></tr>
						<% } %>
					</tbody>
				</table>
			</div>
		<% } %>
	</div>
</div>
