<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">Videos <span class="badge bg-light text-dark ms-1"><%= videos.length %></span></h4>
		<div class="panel-heading-btn">
			<a href="/admin/videos/create" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add video</a>
		</div>
	</div>
	<div class="panel-body">
		<p class="text-muted">Videos appear on the home page and at <a href="/media-gallery/videos" target="_blank" rel="noopener">/media-gallery/videos</a>.</p>
		<div class="table-responsive">
			<table class="table table-striped table-bordered align-middle">
				<thead>
					<tr>
						<th style="width:56px">Photo</th>
						<th>Title</th>
						<th>Source</th>
						<th>Status</th>
						<th style="width:1%">Actions</th>
					</tr>
				</thead>
				<tbody>
					<% videos.forEach(function (video) { %>
						<tr>
							<td>
								<% if (video.thumb) { %>
									<img src="<%= thumbUrl(video.thumb) %>" alt="" class="rounded admin-thumb" loading="lazy" data-fallback-src="<%= video.thumb %>" />
								<% } else { %>
									<div class="admin-thumb admin-thumb-empty rounded"><i class="fa fa-film text-muted"></i></div>
								<% } %>
							</td>
							<td>
								<a href="/admin/videos/<%= video.id %>/edit" class="fw-bold"><%= video.title %></a>
								<div class="small text-muted">/media-gallery/videos/<%= video.key %></div>
							</td>
							<td class="text-capitalize"><%= video.provider %></td>
							<td>
								<% if (video.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %>
							</td>
							<td class="text-nowrap">
								<a href="/admin/videos/<%= video.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
								<button type="button" class="btn btn-sm btn-danger" title="Delete"
									data-delete-url="/admin/videos/<%= video.id %>"
									data-delete-title="Delete video"
									data-delete-message="Delete “<%= video.title %>”?">
									<i class="fa fa-trash"></i>
								</button>
							</td>
						</tr>
					<% }) %>
					<% if (videos.length === 0) { %>
						<tr><td colspan="5" class="text-center text-muted py-4">No videos yet. <a href="/admin/videos/create">Add the first video</a>.</td></tr>
					<% } %>
				</tbody>
			</table>
		</div>
	</div>
</div>
