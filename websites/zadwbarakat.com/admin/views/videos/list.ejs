<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">Videos</h4>
		<div class="panel-heading-btn">
			<a href="<%= basePath %>/create" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add video</a>
		</div>
	</div>
	<div class="panel-body">
		<% if (!videosPage) { %><p class="alert alert-warning">No published page uses the “Videos” type, so videos are not visible on the site.</p><% } %>
		<div class="table-responsive">
			<table class="table table-striped table-bordered align-middle">
				<thead>
					<tr><th style="width:80px">Poster</th><th>Title</th><th>YouTube</th><th>Status</th><th>Date</th><th style="width:1%">Actions</th></tr>
				</thead>
				<tbody>
					<% rows.forEach(function (row) { const poster = row.image ? thumbUrl(row.image.src) : 'https://i.ytimg.com/vi/' + row.youtubeId + '/mqdefault.jpg'; %>
						<tr>
							<td><img src="<%= poster %>" alt="" class="rounded" style="width:72px;height:40px;object-fit:cover" loading="lazy" /></td>
							<td dir="auto"><a href="<%= basePath %>/<%= row.id %>/edit" class="fw-bold"><%= row.title %></a></td>
							<td class="small"><a href="https://www.youtube.com/watch?v=<%= row.youtubeId %>" target="_blank" rel="noopener noreferrer"><%= row.youtubeId %></a></td>
							<td><% if (row.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %></td>
							<td class="small text-nowrap"><%= row.publishedAt.slice(0, 10) %></td>
							<td class="text-nowrap">
								<% if (videosPage && row.status === 'published') { %><a href="<%= encodePath(videosPage.url + '/' + row.slug) %>" target="_blank" rel="noopener" class="btn btn-sm btn-default" title="View"><i class="fa fa-external-link-alt"></i></a><% } %>
								<a href="<%= basePath %>/<%= row.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
								<button type="button" class="btn btn-sm btn-danger" title="Delete" data-delete-url="<%= basePath %>/<%= row.id %>" data-delete-title="Delete video" data-delete-message="Remove “<%= row.title %>” from the site? The YouTube video itself is not affected."><i class="fa fa-trash"></i></button>
							</td>
						</tr>
					<% }) %>
					<% if (rows.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No videos yet.</td></tr><% } %>
				</tbody>
			</table>
		</div>
	</div>
</div>
