<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">Photo albums</h4>
		<div class="panel-heading-btn">
			<a href="<%= basePath %>/create" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add album</a>
		</div>
	</div>
	<div class="panel-body">
		<% if (!albumsPage) { %><p class="alert alert-warning">No published page uses the “Photo albums” type, so albums are not visible on the site.</p><% } %>
		<div class="table-responsive">
			<table class="table table-striped table-bordered align-middle">
				<thead>
					<tr><th style="width:56px">Cover</th><th>Title</th><th class="text-center">Photos</th><th>Status</th><th>Date</th><th style="width:1%">Actions</th></tr>
				</thead>
				<tbody>
					<% rows.forEach(function (row) { const cover = row.images[0]; %>
						<tr>
							<td><% if (cover) { %><img src="<%= thumbUrl(cover.src) %>" alt="" class="rounded admin-thumb" loading="lazy" data-fallback-src="<%= cover.src %>" /><% } else { %><div class="admin-thumb admin-thumb-empty rounded"><i class="fa fa-image text-muted"></i></div><% } %></td>
							<td dir="auto"><a href="<%= basePath %>/<%= row.id %>/edit" class="fw-bold"><%= row.title %></a></td>
							<td class="text-center"><%= row.images.length %></td>
							<td><% if (row.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %></td>
							<td class="small text-nowrap"><%= row.publishedAt.slice(0, 10) %></td>
							<td class="text-nowrap">
								<% if (albumsPage && row.status === 'published' && row.images.length) { %><a href="<%= encodePath(albumsPage.url + '/' + row.slug) %>" target="_blank" rel="noopener" class="btn btn-sm btn-default" title="View"><i class="fa fa-external-link-alt"></i></a><% } %>
								<a href="<%= basePath %>/<%= row.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
								<button type="button" class="btn btn-sm btn-danger" title="Delete" data-delete-url="<%= basePath %>/<%= row.id %>" data-delete-title="Delete album" data-delete-message="Delete “<%= row.title %>” and all its photos?"><i class="fa fa-trash"></i></button>
							</td>
						</tr>
					<% }) %>
					<% if (rows.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No albums yet.</td></tr><% } %>
				</tbody>
			</table>
		</div>
	</div>
</div>
