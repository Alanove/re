<%
	const action = isCreate ? basePath + '/create' : basePath + '/' + item.id + '/edit';
	const imageSrc = item.image && typeof item.image === 'object' ? item.image.src : (typeof item.image === 'string' ? item.image : '');
%>
<form method="POST" action="<%= action %>?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" novalidate>
	<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
	<datalist id="category-options"><% categories.forEach(function (category) { %><option value="<%= category %>"></option><% }) %></datalist>
	<div class="row">
		<div class="col-xl-8">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Item</h4></div>
				<div class="panel-body">
					<div class="mb-3">
						<label class="form-label" for="title">Title <span class="text-danger">*</span></label>
						<input type="text" class="form-control <%= errors.title ? 'is-invalid' : '' %>" id="title" name="title" value="<%= item.title %>" maxlength="250" required dir="auto" data-slug-source="#slug" />
						<%- include('../partials/field-error', { name: 'title' }) %>
					</div>
					<div class="row">
						<div class="col-md-4 mb-3">
							<label class="form-label" for="category">Category <span class="text-danger">*</span></label>
							<input type="text" class="form-control <%= errors.category ? 'is-invalid' : '' %>" id="category" name="category" value="<%= item.category %>" maxlength="120" required dir="auto" list="category-options" />
							<%- include('../partials/field-error', { name: 'category' }) %>
						</div>
						<div class="col-md-4 mb-3">
							<label class="form-label" for="author">Author</label>
							<input type="text" class="form-control <%= errors.author ? 'is-invalid' : '' %>" id="author" name="author" value="<%= item.author %>" maxlength="250" dir="auto" />
							<%- include('../partials/field-error', { name: 'author' }) %>
						</div>
						<div class="col-md-4 mb-3">
							<label class="form-label" for="price">Price</label>
							<input type="text" class="form-control <%= errors.price ? 'is-invalid' : '' %>" id="price" name="price" value="<%= item.price %>" maxlength="60" dir="auto" placeholder="10$" />
							<%- include('../partials/field-error', { name: 'price' }) %>
						</div>
					</div>
					<div class="mb-3">
						<label class="form-label" for="summary">Summary</label>
						<textarea class="form-control <%= errors.summary ? 'is-invalid' : '' %>" id="summary" name="summary" rows="3" maxlength="2000" dir="auto"><%= item.summary %></textarea>
						<%- include('../partials/field-error', { name: 'summary' }) %>
					</div>
					<div class="mb-1">
						<label class="form-label" for="content">Description</label>
						<textarea class="form-control rich-text" id="content" name="content" rows="10"><%= item.content %></textarea>
						<%- include('../partials/field-error', { name: 'content' }) %>
					</div>
				</div>
			</div>
		</div>
		<div class="col-xl-4 admin-sticky-stack">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Publish</h4></div>
				<div class="panel-body">
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" id="published" name="published" value="1" <%= item.status === 'published' ? 'checked' : '' %> />
						<label class="form-check-label" for="published">Published</label>
					</div>
					<div class="mb-3">
						<label class="form-label" for="slug">URL slug</label>
						<input type="text" class="form-control <%= errors.slug ? 'is-invalid' : '' %>" id="slug" name="slug" value="<%= item.slug %>" maxlength="120" dir="auto" />
						<%- include('../partials/field-error', { name: 'slug' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="sort">Sort order</label>
						<input type="number" class="form-control <%= errors.sort ? 'is-invalid' : '' %>" id="sort" name="sort" value="<%= item.sort %>" min="0" />
						<%- include('../partials/field-error', { name: 'sort' }) %>
					</div>
					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-success flex-fill"><i class="fa fa-save me-1"></i> <%= isCreate ? 'Add item' : 'Save changes' %></button>
						<a href="<%= basePath %>" class="btn btn-default">Cancel</a>
					</div>
				</div>
			</div>
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Cover image</h4></div>
				<div class="panel-body">
					<%- include('../partials/media-picker', { id: 'imageFile', field: 'imageFile', kind: 'image', current: imageSrc, valueName: 'image', removeName: 'removeImage', label: 'cover', hint: 'JPEG, PNG, GIF or WebP up to 8 MB. Converted to WebP and resized automatically.' }) %>
					<%- include('../partials/field-error', { name: 'image' }) %>
				</div>
			</div>
		</div>
	</div>
</form>
