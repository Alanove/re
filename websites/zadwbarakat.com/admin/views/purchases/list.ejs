<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">Purchases</h4>
		<div class="panel-heading-btn">
			<a href="<%= basePath %>/create" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add item</a>
		</div>
	</div>
	<div class="panel-body">
		<% if (!purchasesPage) { %><p class="alert alert-warning">No published page uses the “Purchases” type, so these items are not visible on the site.</p><% } %>
		<p class="text-muted">Visitors order an item through the contact form; orders appear under <a href="/admin/inquiries?type=purchase">Inquiries</a>.</p>
		<div class="row g-2 mb-3">
			<div class="col-md-6">
				<div class="input-group">
					<span class="input-group-text"><i class="fa fa-search"></i></span>
					<input type="search" class="form-control" placeholder="Filter by title, author or category" data-table-filter="#purchases-table" aria-label="Filter items" dir="auto" />
				</div>
			</div>
		</div>
		<div class="table-responsive">
			<table class="table table-striped table-bordered align-middle" id="purchases-table">
				<thead>
					<tr><th style="width:56px" data-sort="off">Image</th><th>Title</th><th>Category</th><th>Price</th><th>Status</th><th style="width:1%" data-sort="off">Actions</th></tr>
				</thead>
				<tbody>
					<% rows.forEach(function (row) { %>
						<tr data-filter-text="<%= (row.title + ' ' + row.author + ' ' + row.category).toLowerCase() %>">
							<td><% if (row.image) { %><img src="<%= thumbUrl(row.image.src) %>" alt="" class="rounded admin-thumb" loading="lazy" data-fallback-src="<%= row.image.src %>" /><% } else { %><div class="admin-thumb admin-thumb-empty rounded"><i class="fa fa-image text-muted"></i></div><% } %></td>
							<td dir="auto"><a href="<%= basePath %>/<%= row.id %>/edit" class="fw-bold"><%= row.title %></a><% if (row.author) { %><div class="small text-muted"><%= row.author %></div><% } %></td>
							<td dir="auto" class="small"><%= row.category %></td>
							<td class="small"><%= row.price %></td>
							<td><% if (row.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %></td>
							<td class="text-nowrap">
								<% if (purchasesPage && row.status === 'published') { %><a href="<%= encodePath(purchasesPage.url + '/' + row.slug) %>" target="_blank" rel="noopener" class="btn btn-sm btn-default" title="View"><i class="fa fa-external-link-alt"></i></a><% } %>
								<a href="<%= basePath %>/<%= row.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
								<button type="button" class="btn btn-sm btn-danger" title="Delete" data-delete-url="<%= basePath %>/<%= row.id %>" data-delete-title="Delete item" data-delete-message="Delete “<%= row.title %>”?"><i class="fa fa-trash"></i></button>
							</td>
						</tr>
					<% }) %>
					<% if (rows.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No items yet.</td></tr><% } %>
				</tbody>
			</table>
		</div>
	</div>
</div>
