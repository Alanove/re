<%
	const action = isCreate ? '/admin/pages/create' : '/admin/pages/' + page.id + '/edit';
	const seo = page.seo || { title: '', description: '', keywords: '' };
	const moduleKinds = ['library', 'hymns', 'purchases', 'albums', 'videos'];
%>
<form method="POST" action="<%= action %>?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" id="page-form" novalidate
	data-slug-check="/admin/api/pages/check-slug" data-page-id="<%= page.id || '' %>">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
	<div class="row">
		<div class="col-xl-8">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Content</h4></div>
				<div class="panel-body">
					<div class="mb-3">
						<label class="form-label" for="title">Title <span class="text-danger">*</span></label>
						<input type="text" class="form-control <%= errors.title ? 'is-invalid' : '' %>" id="title" name="title" value="<%= page.title %>" maxlength="200" required dir="auto" data-slug-source="#slug" />
						<%- include('../partials/field-error', { name: 'title' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="header">Page heading</label>
						<input type="text" class="form-control <%= errors.header ? 'is-invalid' : '' %>" id="header" name="header" value="<%= page.header %>" maxlength="200" dir="auto" />
						<small class="text-muted">Shown at the top of the page. Leave empty to use the title.</small>
						<%- include('../partials/field-error', { name: 'header' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="summary">Summary</label>
						<textarea class="form-control <%= errors.summary ? 'is-invalid' : '' %>" id="summary" name="summary" rows="3" maxlength="2000" dir="auto"><%= page.summary %></textarea>
						<small class="text-muted">Shown under the heading, on hub cards and as the default description for Google and social shares.</small>
						<%- include('../partials/field-error', { name: 'summary' }) %>
					</div>
					<div class="mb-1">
						<label class="form-label" for="content"><%= moduleKinds.indexOf(page.kind) !== -1 ? 'Text above the list (optional)' : 'Body' %></label>
						<textarea class="form-control rich-text" id="content" name="content" rows="14"><%= page.content %></textarea>
						<%- include('../partials/field-error', { name: 'content' }) %>
					</div>
				</div>
			</div>

			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Gallery</h4></div>
				<div class="panel-body">
					<% if (gallery.length > 0) { %>
						<div class="row g-3 mb-3" data-gallery-list>
							<% gallery.forEach(function (image, index) { %>
								<div class="col-6 col-md-4 col-xxl-3">
									<div class="card h-100 admin-gallery-card">
										<img src="<%= thumbUrl(image.src) %>" alt="" class="card-img-top" loading="lazy" data-fallback-src="<%= image.src %>" />
										<div class="card-body p-2">
											<input type="hidden" name="gallery[<%= index %>][id]" value="<%= image.id %>" />
											<input type="text" class="form-control form-control-sm mb-1" name="gallery[<%= index %>][caption]" value="<%= image.caption %>" placeholder="Caption" maxlength="300" aria-label="Caption" dir="auto" />
											<div class="d-flex align-items-center gap-2">
												<input type="number" class="form-control form-control-sm" name="gallery[<%= index %>][sort]" value="<%= image.sort %>" min="0" style="max-width:80px" aria-label="Sort order" />
												<div class="form-check mb-0">
													<input class="form-check-input" type="checkbox" name="gallery[<%= index %>][remove]" value="1" id="remove-<%= image.id %>" />
													<label class="form-check-label small text-danger" for="remove-<%= image.id %>">Remove</label>
												</div>
											</div>
										</div>
									</div>
								</div>
							<% }) %>
						</div>
					<% } else { %>
						<p class="text-muted">No gallery images yet.</p>
					<% } %>
					<label class="form-label" for="galleryFiles">Add images</label>
					<%- include('../partials/media-picker', { id: 'galleryFiles', field: 'galleryFiles', kind: 'image', multiple: true, label: 'gallery images', hint: 'Up to 25 images per save, 8 MB each. Converted to WebP and resized automatically. Visitors open them in a lightbox.' }) %>
					<% Object.keys(errors).filter(function (key) { return key.indexOf('gallery') === 0; }).forEach(function (key) { %>
						<div class="invalid-feedback d-block"><%= errors[key] %></div>
					<% }) %>
				</div>
			</div>

			<%- include('../partials/seo-fields', { seo: seo }) %>
		</div>

		<div class="col-xl-4 admin-sticky-stack">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Publish</h4></div>
				<div class="panel-body">
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" id="published" name="published" value="1" <%= page.status === 'published' ? 'checked' : '' %> />
						<label class="form-check-label" for="published">Published</label>
					</div>
					<div class="mb-3">
						<label class="form-label" for="parentId">Parent page</label>
						<select class="form-select <%= errors.parentId ? 'is-invalid' : '' %>" id="parentId" name="parentId">
							<option value="">— Top level —</option>
							<% parents.forEach(function (option) { %>
								<option value="<%= option.id %>" <%= page.parentId === option.id ? 'selected' : '' %>><%= option.label %></option>
							<% }) %>
						</select>
						<%- include('../partials/field-error', { name: 'parentId' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="slug">URL slug</label>
						<input type="text" class="form-control <%= errors.slug ? 'is-invalid' : '' %>" id="slug" name="slug" value="<%= page.slug %>" maxlength="120" dir="auto" />
						<div class="small mt-1" data-slug-status></div>
						<small class="text-muted d-block">Arabic or Latin letters, numbers and dashes. Leave empty to build it from the title.</small>
						<% if (!isCreate && page.url) { %><small class="text-muted">Current address: <a href="<%= encodePath(page.url) %>" target="_blank" rel="noopener" dir="auto"><%= page.url %></a></small><% } %>
						<%- include('../partials/field-error', { name: 'slug' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="kind">Page type</label>
						<select class="form-select <%= errors.kind ? 'is-invalid' : '' %>" id="kind" name="kind">
							<% kinds.forEach(function (kind) { %>
								<option value="<%= kind.value %>" <%= page.kind === kind.value ? 'selected' : '' %>><%= kind.label %></option>
							<% }) %>
						</select>
						<small class="text-muted">Library, hymns, purchases, albums and videos can each be used by one page only.</small>
						<%- include('../partials/field-error', { name: 'kind' }) %>
					</div>
					<div class="mb-3">
						<label class="form-label" for="direction">Text direction</label>
						<select class="form-select <%= errors.direction ? 'is-invalid' : '' %>" id="direction" name="direction">
							<% directions.forEach(function (option) { %>
								<option value="<%= option.value %>" <%= (page.direction || 'auto') === option.value ? 'selected' : '' %>><%= option.label %></option>
							<% }) %>
						</select>
						<small class="text-muted">French or English pages read left to right; the menus stay right to left.</small>
					</div>
					<div class="row g-2 mb-3">
						<div class="col-6">
							<label class="form-label" for="sort">Sort order</label>
							<input type="number" class="form-control <%= errors.sort ? 'is-invalid' : '' %>" id="sort" name="sort" value="<%= page.sort %>" min="0" />
							<%- include('../partials/field-error', { name: 'sort' }) %>
						</div>
						<div class="col-6">
							<label class="form-label" for="icon">Icon</label>
							<input type="text" class="form-control <%= errors.icon ? 'is-invalid' : '' %>" id="icon" name="icon" value="<%= page.icon %>" maxlength="60" />
							<%- include('../partials/field-error', { name: 'icon' }) %>
						</div>
					</div>
					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-success flex-fill"><i class="fa fa-save me-1"></i> <%= isCreate ? 'Create page' : 'Save changes' %></button>
						<a href="/admin/pages" class="btn btn-default">Cancel</a>
					</div>
				</div>
			</div>

			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Header image</h4></div>
				<div class="panel-body">
					<%- include('../partials/media-picker', { id: 'heroImageFile', field: 'heroImageFile', kind: 'image', current: page.heroImage, valueName: 'heroImage', removeName: 'removeHeroImage', label: 'header image', hint: 'JPEG, PNG, GIF or WebP up to 8 MB. Converted to WebP and resized automatically. Child pages inherit it.' }) %>
					<%- include('../partials/field-error', { name: 'heroImage' }) %>
				</div>
			</div>
			<input type="hidden" name="heroVideo" value="<%= page.heroVideo || '' %>" />
		</div>
	</div>
</form>
