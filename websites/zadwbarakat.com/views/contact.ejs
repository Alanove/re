<%
	const telHref = function (value) { return 'tel:' + String(value || '').replace(/[^+\d]/g, ''); };
	const values = contactForm.values;
	const errors = contactForm.errors;
	const fieldAttrs = function (name) { return errors[name] ? ' aria-invalid="true" aria-describedby="error-' + name + '"' : ''; };
	const mapSrc = settings.mapQuery ? 'https://www.google.com/maps?q=' + encodeURIComponent(settings.mapQuery) + '&output=embed' : '';
%>
<%- include('partials/page-head', { title: page.header || page.title, lead: page.summary }) %>
<div class="container page-body">
	<div class="contact-layout">
		<div class="contact-card" id="contact-form">
			<h2><%= purchase ? 'طلب شراء' : 'أرسل لنا رسالة' %></h2>
			<% if (purchase) { %><p class="alert">أنت تطلب: <strong><%= purchase.title %></strong><% if (purchase.price) { %> (<%= purchase.price %>)<% } %></p><% } %>
			<% if (contactForm.sent) { %>
				<p class="alert alert--success" role="status"><%= settings.thankYouMessage %></p>
			<% } %>
			<% if (contactForm.message) { %><p class="alert alert--danger" role="alert"><%= contactForm.message %></p><% } %>
			<form class="form" method="post" action="/contact" novalidate data-contact-form>
				<% if (purchase) { %><input type="hidden" name="purchaseId" value="<%= purchase.id %>" /><% } %>
				<div class="form__row">
					<div class="field">
						<label for="contact-name">الاسم</label>
						<input class="input" id="contact-name" name="name" type="text" required maxlength="120" autocomplete="name" value="<%= values.name || '' %>"<%- fieldAttrs('name') %> />
						<% if (errors.name) { %><span class="field__error" id="error-name"><%= errors.name %></span><% } %>
					</div>
					<div class="field">
						<label for="contact-email">البريد الإلكتروني</label>
						<input class="input" id="contact-email" name="email" type="email" required maxlength="200" autocomplete="email" dir="ltr" value="<%= values.email || '' %>"<%- fieldAttrs('email') %> />
						<% if (errors.email) { %><span class="field__error" id="error-email"><%= errors.email %></span><% } %>
					</div>
				</div>
				<div class="form__row">
					<div class="field">
						<label for="contact-phone">الهاتف (اختياري)</label>
						<input class="input" id="contact-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" dir="ltr" value="<%= values.phone || '' %>"<%- fieldAttrs('phone') %> />
						<% if (errors.phone) { %><span class="field__error" id="error-phone"><%= errors.phone %></span><% } %>
					</div>
					<div class="field">
						<label for="contact-topic">الموضوع</label>
						<select class="select" id="contact-topic" name="topic"<%- fieldAttrs('topic') %>>
							<% settings.inquiryTopics.forEach(function (topic) { %><option value="<%= topic %>"<%= values.topic === topic ? ' selected' : '' %>><%= topic %></option><% }) %>
						</select>
						<% if (errors.topic) { %><span class="field__error" id="error-topic"><%= errors.topic %></span><% } %>
					</div>
				</div>
				<div class="field">
					<label for="contact-message">الرسالة</label>
					<textarea class="textarea" id="contact-message" name="message" required maxlength="5000"<%- fieldAttrs('message') %>><%= values.message || '' %></textarea>
					<% if (errors.message) { %><span class="field__error" id="error-message"><%= errors.message %></span><% } %>
				</div>
				<span class="hp-field" aria-hidden="true"><label for="contact-website">الموقع</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" /></span>
				<div><button class="btn btn--primary" type="submit"><svg class="icon icon-flip" aria-hidden="true"><use href="#i-arrow"/></svg>إرسال</button></div>
			</form>
		</div>

		<aside class="contact-card" aria-labelledby="contact-details">
			<h2 id="contact-details">معلومات الاتصال</h2>
			<% if (page.content.trim()) { %><div class="prose rte-content" style="font-size:1rem"><%- page.content %></div><% } %>
			<ul class="contact-list">
				<% if (settings.address) { %><li><span class="hub-card__icon"><svg class="icon" aria-hidden="true"><use href="#i-pin"/></svg></span><span><%= settings.address %></span></li><% } %>
				<% if (settings.contactPhone) { %><li><span class="hub-card__icon"><svg class="icon" aria-hidden="true"><use href="#i-phone"/></svg></span><a href="<%= telHref(settings.contactPhone) %>" dir="ltr"><%= settings.contactPhone %></a></li><% } %>
				<% if (settings.contactEmail) { %><li><span class="hub-card__icon"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg></span><a href="mailto:<%= settings.contactEmail %>" dir="ltr"><%- include('partials/email-text', { email: settings.contactEmail }) %></a></li><% } %>
			</ul>
			<% if (mapSrc) { %>
				<iframe class="map-frame" src="<%= mapSrc %>" title="خريطة الموقع" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
			<% } %>
		</aside>
	</div>
</div>
