<%- include('partials/page-head', { title: page.header || page.title, lead: page.summary }) %>
<div class="container page-body">
	<% if (page.content.trim()) { %>
		<div class="prose rte-content" dir="<%= contentDir %>" lang="<%= contentLang %>"><%- page.content %></div>
	<% } %>
	<% if (childSections.length || childPages.length) { %>
		<div class="hub-grid">
			<% childSections.forEach(function (child) { %>
				<a class="hub-card" href="<%= encodePath(child.path) %>">
					<span class="hub-card__icon"><svg class="icon" aria-hidden="true"><use href="#i-book"/></svg></span>
					<span><strong><%= child.title %></strong><% if (child.intro) { %><small><%= child.intro.length > 90 ? child.intro.slice(0, 90) + '…' : child.intro %></small><% } %></span>
					<svg class="icon icon-flip hub-card__arrow" aria-hidden="true"><use href="#i-chevron"/></svg>
				</a>
			<% }) %>
			<% childPages.forEach(function (child) { %>
				<a class="hub-card" href="<%= encodePath(child.url) %>">
					<span class="hub-card__icon"><svg class="icon" aria-hidden="true"><use href="#i-<%= child.icon || 'folder' %>"/></svg></span>
					<span><strong><%= child.title %></strong><% if (child.summary) { %><small><%= child.summary.length > 90 ? child.summary.slice(0, 90) + '…' : child.summary %></small><% } %></span>
					<svg class="icon icon-flip hub-card__arrow" aria-hidden="true"><use href="#i-chevron"/></svg>
				</a>
			<% }) %>
		</div>
	<% } else if (!page.content.trim()) { %>
		<p class="empty-state">لا يوجد محتوى في هذا القسم بعد.</p>
	<% } %>
</div>
