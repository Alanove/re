<%
	const hero = home.hero;
	const about = home.about;
	const clients = home.clients;
	const clientImages = typeof clientBoards !== 'undefined' ? clientBoards : [];
%>
<% if (hero.enabled && hero.slides.length) { %>
<section class="home-slider owl-carousel" aria-label="Featured slides">
	<% hero.slides.forEach(function (slide) { %>
		<div class="slider-item" style="background-image: url('<%= slide.image %>');">
			<div class="container">
				<div class="row slider-text align-items-center justify-content-center text-center">
					<div class="col-md-7 col-sm-12 element-animate">
						<h1 class="mb-4"><%= slide.title %></h1>
						<% if (slide.label && slide.url) { %>
							<p class="mb-0"><a href="<%= slide.url %>" class="btn btn-primary"><%= slide.label %></a></p>
						<% } %>
					</div>
				</div>
			</div>
		</div>
	<% }) %>
</section>
<% } %>

<% if (about.enabled) { %>
<section class="section home-about">
	<div class="container">
		<div class="row align-items-center">
			<% if (about.image) { %>
				<div class="col-md-6 pr-lg-5 mb-4 mb-md-0 element-animate">
					<div class="home-about__media">
						<img src="<%= about.image %>" alt="" class="img-fluid" loading="lazy" />
					</div>
				</div>
			<% } %>
			<div class="col-md-<%= about.image ? '6' : '12' %> element-animate">
				<h2 class="text-uppercase heading border-bottom mb-4 text-left"><%= about.title %></h2>
				<div class="prose"><%- about.content %></div>
			</div>
		</div>
	</div>
</section>
<% } %>

<% if (clients.enabled && clientImages.length) { %>
<section class="section section-clients">
	<div class="container">
		<% if (clients.title) { %>
			<div class="row justify-content-center mb-4 element-animate">
				<div class="col-md-8 text-center">
					<h2 class="text-uppercase heading border-bottom mb-4"><%= clients.title %></h2>
				</div>
			</div>
		<% } %>
		<div class="clients-carousel owl-carousel owl-theme clients" id="clients">
			<% clientImages.forEach(function (image) { %>
				<div class="item"><img src="<%= image.src %>" alt="<%= image.caption || 'Client logo' %>" loading="lazy" width="<%= image.width || '' %>" height="<%= image.height || '' %>" /></div>
			<% }) %>
		</div>
	</div>
</section>
<% } %>
