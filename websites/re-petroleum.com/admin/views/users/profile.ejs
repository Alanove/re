<% const fieldClass = function (name) { return errors[name] ? 'form-control is-invalid' : 'form-control'; }; %>
<div class="row">
	<div class="col-xl-6">
		<form method="POST" action="/admin/profile" class="panel panel-inverse" novalidate>
			<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
			<div class="panel-heading"><h4 class="panel-title">My profile</h4></div>
			<div class="panel-body">
				<div class="mb-3">
					<label class="form-label" for="email">Email</label>
					<input type="email" class="form-control" id="email" value="<%= user.email %>" disabled />
					<small class="text-muted">Ask an administrator to change your email address.</small>
				</div>
				<div class="mb-3">
					<label class="form-label" for="name">Name</label>
					<input type="text" class="<%= fieldClass('name') %>" id="name" name="name" value="<%= user.name %>" required />
					<%- include('../partials/field-error', { name: 'name' }) %>
				</div>
				<hr />
				<h5>Change password</h5>
				<div class="mb-3">
					<label class="form-label" for="currentPassword">Current password</label>
					<input type="password" class="<%= fieldClass('currentPassword') %>" id="currentPassword" name="currentPassword" autocomplete="current-password" />
					<%- include('../partials/field-error', { name: 'currentPassword' }) %>
				</div>
				<div class="mb-3">
					<label class="form-label" for="password">New password</label>
					<input type="password" class="<%= fieldClass('password') %>" id="password" name="password" autocomplete="new-password" />
					<small class="text-muted">At least 12 characters with upper and lower case letters and a number.</small>
					<%- include('../partials/field-error', { name: 'password' }) %>
				</div>
				<div class="mb-3">
					<label class="form-label" for="confirmPassword">Confirm new password</label>
					<input type="password" class="<%= fieldClass('confirmPassword') %>" id="confirmPassword" name="confirmPassword" autocomplete="new-password" />
					<%- include('../partials/field-error', { name: 'confirmPassword' }) %>
				</div>
				<button type="submit" class="btn btn-success"><i class="fa fa-save me-1"></i> Save profile</button>
			</div>
		</form>
	</div>
</div>
