NODE_ENV=development
PORT=3040
PUBLIC_BASE_URL=http://localhost:3040
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@re-petroleum.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Site Administrator
TRUST_PROXY=0

# Optional. Contact inquiries are always stored; mail is sent only when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Self-hosted captcha (packages/captcha). Random secret, at least 32 characters; no external account needed.
CAPTCHA_SECRET=replace-with-at-least-32-random-characters
# Optional. Proof-of-work size; higher is harder for bots and slower for people (default 100000).
CAPTCHA_DIFFICULTY=100000
