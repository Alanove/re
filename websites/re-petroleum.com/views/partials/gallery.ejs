<% if (gallery.length) { %>
	<section class="gallery" aria-label="Photo gallery" data-gallery>
		<ul class="gallery__grid<%= gallery.length === 1 ? ' gallery__grid--single' : '' %>">
			<% gallery.forEach(function (image, index) { %>
				<li class="gallery__item">
					<a class="gallery__link" href="<%= image.src %>" data-gallery-item data-index="<%= index %>" data-caption="<%= image.caption %>">
						<img src="<%= image.src %>" alt="<%= image.caption || (page.title + ' photo ' + (index + 1)) %>" loading="lazy"<% if (image.width && image.height) { %> width="<%= image.width %>" height="<%= image.height %>"<% } %> />
					</a>
					<% if (image.caption) { %><p class="gallery__caption"><%= image.caption %></p><% } %>
				</li>
			<% }) %>
		</ul>
	</section>
	<dialog class="lightbox" data-lightbox aria-label="Image viewer">
		<button class="lightbox__close" type="button" data-lightbox-close aria-label="Close"><span class="material-symbols-outlined" aria-hidden="true">close</span></button>
		<button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous image"><span class="material-symbols-outlined" aria-hidden="true">chevron_left</span></button>
		<figure class="lightbox__figure">
			<img alt="" data-lightbox-image />
			<figcaption data-lightbox-caption></figcaption>
		</figure>
		<button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next image"><span class="material-symbols-outlined" aria-hidden="true">chevron_right</span></button>
	</dialog>
<% } %>
