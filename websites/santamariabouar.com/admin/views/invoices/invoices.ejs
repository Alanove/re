<div class="row mb-3">
    <div class="col-sm-6">
        <h1 class="page-header">Invoices</h1>
    </div>
    <div class="col-sm-6">
        <ol class="breadcrumb float-end">
            <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item active">Invoices</li>
        </ol>
    </div>
</div>

<% if (success) { %>
    <div class="alert alert-success alert-dismissible fade show">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title">All Invoices</h3>
                <a href="/admin/invoices/create" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Create Invoice
                </a>
            </div>
            <div class="card-body">
                <!-- BEGIN summary cards -->
                <div class="row mb-4">
                    <div class="col-lg-3 col-md-6">
                        <div class="widget widget-stats bg-info">
                            <div class="stats-icon"><i class="fa fa-file-invoice-dollar"></i></div>
                            <div class="stats-info">
                                <h5>Total Amount</h5>
                                <h3>$<%= (typeof summary !== 'undefined' && summary.totalAmount != null ? summary.totalAmount.toFixed(2) : '0.00') %></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="widget widget-stats bg-success">
                            <div class="stats-icon"><i class="fa fa-check-circle"></i></div>
                            <div class="stats-info">
                                <h5>Total Paid</h5>
                                <h3>$<%= (typeof summary !== 'undefined' && summary.totalPaid != null ? summary.totalPaid.toFixed(2) : '0.00') %></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="widget widget-stats" style="background-color: <%= (typeof summary !== 'undefined' && summary.totalBalance != null && summary.totalBalance >= 0) ? '#00acac' : '#ff5b57' %>;">
                            <div class="stats-icon"><i class="fa fa-balance-scale"></i></div>
                            <div class="stats-info">
                                <h5>Total Balance</h5>
                                <h3>$<%= (typeof summary !== 'undefined' && summary.totalBalance != null ? summary.totalBalance.toFixed(2) : '0.00') %></h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="widget widget-stats bg-primary">
                            <div class="stats-icon"><i class="fa fa-list"></i></div>
                            <div class="stats-info">
                                <h5>Total Invoices</h5>
                                <h3><%= (typeof summary !== 'undefined' ? summary.invoiceCount : 0) %></h3>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- END summary cards -->
                
                <!-- Filters -->
                <form method="GET" action="/admin/invoices" class="mb-3">
                    <div class="row g-3">
                        <div class="col-md-2">
                            <input type="text" name="search" class="form-control" placeholder="Search by unit, owner, or tenant..." value="<%= filters?.searchTerm || '' %>">
                        </div>
                        <div class="col-md-1">
                            <select name="block" class="form-select">
                                <option value="">Block</option>
                                <% availableBlocks.forEach(blk => { %>
                                    <option value="<%= blk %>" <%= filters?.block === blk ? 'selected' : '' %>>
                                        <%= blk %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="unitNumber" class="form-select">
                                <option value="">Number</option>
                                <!-- Populated by JS -->
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="categoryId" class="form-select">
                                <option value="">All Categories</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.id %>" <%= filters?.categoryId === cat.id ? 'selected' : '' %>>
                                        <%= cat.name %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select name="status" class="form-select">
                                <option value="">All Status</option>
                                <option value="partial-unpaid" <%= filters?.status === 'partial-unpaid' ? 'selected' : '' %>>Unpaid + Partial</option>
                                <option value="unpaid" <%= filters?.status === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
                                <option value="partial" <%= filters?.status === 'partial' ? 'selected' : '' %>>Partial</option>
                                <option value="paid" <%= filters?.status === 'paid' ? 'selected' : '' %>>Paid</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <input type="number" name="year" class="form-control" placeholder="Year" value="<%= filters?.year || '' %>">
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>
                    </div>
                </form>

                <!-- Invoices Table -->
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Apartment</th>
                                <th>Owner</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Paid</th>
                                <th>Balance</th>
                                <th>Due Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (invoices && invoices.length > 0) { %>
                                <% invoices.forEach(invoice => { %>
                                    <tr>
                                        <td><%= invoice.id %></td>
                                        <td>
                                            <% if (invoice.apartment) { %>
                                                Block <%= invoice.apartment.block %> <%= invoice.apartment.unitNumberOfficial %><% if (invoice.apartment.unitNumberUnofficial) { %> <small class="text-muted">(<%= invoice.apartment.unitNumberUnofficial %>)</small><% } %>
                                            <% } else { %>
                                                Apartment <%= invoice.apartmentId %>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (invoice.apartment && invoice.apartment.ownerName) { %>
                                                <%= invoice.apartment.ownerName %>
                                            <% } else { %>
                                                <span class="text-muted">-</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (invoice.category) { %>
                                                <span class="badge" style="background-color: <%= invoice.category.color %>">
                                                    <%= invoice.category.name %>
                                                </span>
                                            <% } else { %>
                                                Category <%= invoice.categoryId %>
                                            <% } %>
                                        </td>
                                        <td><%= invoice.description %></td>
                                        <td>$<%= invoice.amount.toFixed(2) %></td>
                                        <td>$<%= invoice.amountPaid.toFixed(2) %></td>
                                        <td>
                                            <% const balance = invoice.amount - invoice.amountPaid; %>
                                            <span class="<%= balance > 0 ? 'text-danger' : 'text-success' %>">
                                                $<%= balance.toFixed(2) %>
                                            </span>
                                        </td>
                                        <td><%= invoice.dueDate ? new Date(invoice.dueDate).toLocaleDateString() : '-' %></td>
                                        <td>
                                            <% if (invoice.status === 'paid') { %>
                                                <span class="badge bg-success">Paid</span>
                                            <% } else if (invoice.status === 'partial') { %>
                                                <span class="badge bg-warning">Partial</span>
                                            <% } else { %>
                                                <span class="badge bg-danger">Unpaid</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/admin/invoices/<%= invoice.id %>/pay" class="btn btn-sm btn-success" title="Pay">
                                                <i class="fa fa-money-bill"></i>
                                            </a>
                                            <% if (invoice.amountPaid > 0.001) { %>
                                            <button type="button" class="btn btn-sm btn-info invoice-receipt-btn"
                                                data-invoice-id="<%= invoice.id %>"
                                                title="Generate Receipt">
                                                <i class="fa fa-receipt"></i>
                                            </button>
                                            <% } %>
                                            <a href="/admin/invoices/<%= invoice.id %>/edit" class="btn btn-sm btn-primary" title="Edit">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <button class="btn btn-sm btn-danger" onclick="deleteInvoice(<%= invoice.id %>)" title="Delete">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="11" class="text-center">No invoices found</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('invoices/payment-receipt-modal') %>

<script>
const apartments = <%- JSON.stringify(apartments) %>;
const blockSelect = document.querySelector('select[name="block"]');
const numberSelect = document.querySelector('select[name="unitNumber"]');
const currentUnitNumber = "<%= filters?.unitNumber || '' %>";

function updateNumbers() {
    const selectedBlock = blockSelect.value;
    numberSelect.innerHTML = '<option value="">Number</option>';
    
    // If no block selected, show all numbers, or maybe just clear it?
    // The user said "block then number list", so if no block, maybe show all numbers from all blocks.
    const filteredApartments = selectedBlock 
        ? apartments.filter(a => a.block === selectedBlock)
        : apartments;

    // Unique official numbers with unofficial label for search help
    const byOfficial = new Map();
    filteredApartments.forEach(a => {
        if (!a.unitNumberOfficial) return;
        if (!byOfficial.has(a.unitNumberOfficial)) {
            byOfficial.set(a.unitNumberOfficial, a.unitNumberUnofficial || '');
        }
    });

    const numbers = [...byOfficial.keys()].sort((a, b) => {
        const nA = parseInt(a);
        const nB = parseInt(b);
        if (!isNaN(nA) && !isNaN(nB)) return nA - nB;
        return a.localeCompare(b);
    });

    numbers.forEach(num => {
        const unofficial = byOfficial.get(num);
        const option = document.createElement('option');
        option.value = num;
        option.textContent = unofficial ? `${num} (${unofficial})` : num;
        if (num === currentUnitNumber) option.selected = true;
        numberSelect.appendChild(option);
    });
}

blockSelect.addEventListener('change', updateNumbers);
updateNumbers(); // Initial call

function deleteInvoice(id) {
    if (confirm('Are you sure you want to delete this invoice?')) {
        fetch(`/admin/invoices/${id}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + (data.message || 'Failed to delete invoice'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error deleting invoice');
        });
    }
}
</script>

