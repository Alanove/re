<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title">Apartments Management</h4>
				<div class="panel-heading-btn">
					<a href="/admin/apartments/export" class="btn btn-xs btn-primary">
						<i class="fa fa-file-excel"></i> Export to Excel
					</a>
					<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
					<a href="/admin/apartments/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> Add New Apartment
					</a>
					<% } %>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong>Success!</strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
				<!-- Bulk Actions Toolbar -->
				<div class="mb-3" id="bulkActionsToolbar" style="display: none;">
					<div class="alert alert-info d-flex justify-content-between align-items-center">
						<div>
							<strong><span id="selectedCount">0</span> apartment(s) selected</strong>
						</div>
						<div>
							<button type="button" class="btn btn-primary btn-sm" onclick="openBulkInvoiceModal()">
								<i class="fa fa-file-invoice-dollar"></i> Create Bulk Invoices
							</button>
							<button type="button" class="btn btn-secondary btn-sm" onclick="clearSelection()">
								<i class="fa fa-times"></i> Clear Selection
							</button>
						</div>
					</div>
				</div>
				<% } %>

				<div class="mb-3">
					<div class="row g-2 align-items-end">
						<div class="col-md-4">
							<label class="form-label small text-muted mb-1" for="apartmentSearch">Search</label>
							<div class="input-group">
								<span class="input-group-text"><i class="fa fa-search"></i></span>
								<input type="text" class="form-control" id="apartmentSearch" placeholder="Search by unit, owner, or tenant..." />
							</div>
						</div>
						<div class="col-md-2">
							<label class="form-label small text-muted mb-1" for="blockFilter">Block</label>
							<select class="form-control" id="blockFilter">
								<option value="">All Blocks</option>
								<option value="A">Block A</option>
								<option value="B">Block B</option>
								<option value="C">Block C</option>
								<option value="D">Block D</option>
								<option value="E">Block E</option>
								<option value="F">Block F</option>
								<option value="G">Block G</option>
								<option value="H">Block H</option>
								<option value="I">Block I</option>
								<option value="J">Block J</option>
							</select>
						</div>
						<div class="col-md-2">
							<label class="form-label small text-muted mb-1" for="statusFilter">Status</label>
							<select class="form-control" id="statusFilter">
								<option value="">All Statuses</option>
								<option value="owned">Owned</option>
								<option value="rented">Rented</option>
								<option value="for_rent">For Rent</option>
								<option value="for_sale">For Sale</option>
								<option value="not_sold">Not Sold</option>
							</select>
						</div>
						<div class="col-md-2">
							<label class="form-label small text-muted mb-1" for="vacantFilter">Vacancy</label>
							<select class="form-control" id="vacantFilter">
								<option value="">All</option>
								<option value="vacant">Vacant</option>
								<option value="occupied">Occupied</option>
							</select>
						</div>
						<div class="col-md-2">
							<p class="mb-0 small text-muted" id="apartmentCountSummary">
								Showing <strong id="visibleApartmentCount"><%= apartments.length %></strong> of <strong id="totalApartmentCount"><%= apartments.length %></strong> apartments
							</p>
						</div>
					</div>
				</div>
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
								<th width="30">
									<input type="checkbox" id="selectAll" title="Select All">
								</th>
								<% } %>
								<th>Image</th>
								<th>Block</th>
								<th>Unit Number (Unofficial)</th>
								<th>Unit Number (Official)</th>
								<th>Owner</th>
								<th>Renter</th>
								<th>Area (m²)</th>
								<th class="text-end">Wallet</th>
								<th>Status</th>
								<th>Vacant</th>
								<th>Created</th>
								<th width="1%">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% apartments.forEach(function(apartment) { %>
							<%
								const tenantList = (apartment.tenants && apartment.tenants.length)
									? apartment.tenants
									: (apartment.renterName ? [{ name: apartment.renterName, email: apartment.renterEmail }] : []);
								const searchParts = [];
								if (apartment.ownerName) searchParts.push(apartment.ownerName);
								if (apartment.ownerEmail) searchParts.push(apartment.ownerEmail);
								if (apartment.unitNumberUnofficial) searchParts.push(apartment.unitNumberUnofficial);
								if (apartment.unitNumberOfficial) searchParts.push(apartment.unitNumberOfficial);
								tenantList.forEach(function(t) {
									if (t.name) searchParts.push(t.name);
									if (t.email) searchParts.push(t.email);
								});
								const searchAttr = searchParts.join(' ').toLowerCase();
							%>
							<tr data-block="<%= apartment.block %>" data-apartment-id="<%= apartment.id %>" data-status="<%= apartment.status || '' %>" data-vacant="<%= apartment.isVacant ? 'vacant' : 'occupied' %>" data-search="<%= searchAttr %>">
								<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
								<td>
									<input type="checkbox" class="apartment-checkbox" value="<%= apartment.id %>">
								</td>
								<% } %>
								<td>
									<% if (apartment.officialImage) { %>
										<div style="width:80px;height:60px;display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid #ddd;border-radius:4px;padding:2px;">
											<img src="/images/apartments/<%= apartment.id %>/<%= apartment.officialImage %>" alt="Apartment Image" style="max-width:100%;max-height:100%;object-fit:contain;" />
										</div>
									<% } else { %>
										<div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:80px;height:60px;border:1px solid #ddd;">
											<i class="fa fa-home text-muted"></i>
										</div>
									<% } %>
								</td>
								<td>
									<span class="badge bg-primary fs-6">Block <%= apartment.block %></span>
								</td>
								<td><%= apartment.unitNumberUnofficial %></td>
								<td><%= apartment.unitNumberOfficial %></td>
								<td>
									<% if (apartment.ownerName) { %>
										<div>
											<strong><%= apartment.ownerName %></strong><br>
											<small class="text-muted"><%= apartment.ownerEmail || 'No email' %></small>
										</div>
									<% } else { %>
										<span class="text-danger">Owner not found</span>
									<% } %>
								</td>
								<td>
									<% if (tenantList.length) { %>
										<% tenantList.forEach(function(tenant, tenantIndex) { %>
											<div<% if (tenantIndex < tenantList.length - 1) { %> class="mb-1"<% } %>>
												<strong><%= tenant.name %></strong>
												<% if (tenant.email) { %>
													<br><small class="text-muted"><%= tenant.email %></small>
												<% } %>
											</div>
										<% }); %>
									<% } else { %>
										<span class="text-muted">—</span>
									<% } %>
								</td>
								<td><%= apartment.areaInM2 %> m²</td>
								<td class="text-end">
									<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
										<% if (apartment.walletBalance && apartment.walletBalance > 0.001) { %>
											<a href="/admin/wallets/<%= apartment.id %>" class="badge bg-success fs-6 text-decoration-none" title="Manage wallet">
												$<%= apartment.walletBalance.toFixed(2) %>
											</a>
										<% } else { %>
											<a href="/admin/wallets/<%= apartment.id %>" class="text-muted text-decoration-none" title="Manage wallet">$0.00</a>
										<% } %>
									<% } else { %>
										<% if (apartment.walletBalance && apartment.walletBalance > 0.001) { %>
											<span class="badge bg-success fs-6">$<%= apartment.walletBalance.toFixed(2) %></span>
										<% } else { %>
											<span class="text-muted">$0.00</span>
										<% } %>
									<% } %>
								</td>
								<td>
                  <% if (apartment.status === 'owned') { %>
                    <span class="badge bg-success">Owned</span>
                  <% } else if (apartment.status === 'rented') { %>
                    <span class="badge bg-primary">Rented</span>
                  <% } else if (apartment.status === 'for_rent') { %>
                    <span class="badge bg-info">For Rent</span>
                  <% } else if (apartment.status === 'for_sale') { %>
                    <span class="badge bg-warning">For Sale</span>
                  <% } else if (apartment.status === 'not_sold') { %>
                    <span class="badge bg-danger">Not Sold</span>
                  <% } else { %>
                    <span class="badge bg-secondary">Unknown</span>
                  <% } %>
								</td>
								<td>
									<% if (apartment.isVacant) { %>
										<span class="badge bg-warning text-dark">Vacant</span>
									<% } else { %>
										<span class="badge bg-secondary">Occupied</span>
									<% } %>
								</td>
								<td>
									<small><%= new Date(apartment.createdAt).toLocaleDateString() %></small>
								</td>
								<td>
									<div class="btn-group" style="white-space: nowrap;">
										<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
										<a href="/admin/wallets/<%= apartment.id %>" class="btn btn-sm btn-warning" title="Wallet">
											<i class="fa fa-wallet"></i>
										</a>
										<% } %>
										<a href="/admin/apartments/<%= apartment.id %>/statement" class="btn btn-sm btn-info" title="View Statement" target="_blank">
											<i class="fa fa-file-text"></i>
										</a>
										<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
										<a href="/admin/transactions/create?apartmentId=<%= apartment.id %>" class="btn btn-sm btn-success" title="Add Payment">
											<i class="fa fa-plus"></i>
										</a>
										<a href="/admin/apartments/<%= apartment.id %>/edit" class="btn btn-sm btn-primary" title="Edit">
											<i class="fa fa-edit"></i>
										</a>
										<button type="button" class="btn btn-sm btn-danger" title="Delete" onclick="deleteItem('/admin/apartments/<%= apartment.id %>', this, 'Delete Apartment', 'Are you sure you want to delete this apartment?')">
											<i class="fa fa-trash"></i>
										</button>
										<% } else { %>
										<a href="/admin/apartments/<%= apartment.id %>/edit" class="btn btn-sm btn-info" title="View">
											<i class="fa fa-eye"></i>
										</a>
										<% } %>
									</div>
								</td>
							</tr>
							<% }); %>
							<% if (apartments.length === 0) { %>
							<tr>
								<td colspan="<%= typeof canEditAdmin !== 'undefined' && canEditAdmin ? 13 : 12 %>" class="text-center text-muted">
									<i class="fa fa-building fa-3x mb-3"></i><br>
									<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
									No apartments found. <a href="/admin/apartments/create">Add the first apartment</a>
									<% } else { %>
									No apartments found.
									<% } %>
								</td>
							</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- END content area -->

<!-- Bulk Invoice Modal -->
<div class="modal fade" id="bulkInvoiceModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Create Bulk Invoices</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form id="bulkInvoiceForm">
					<div class="mb-3">
						<label class="form-label">Category *</label>
						<select name="categoryId" class="form-select" required>
							<option value="">Select Category</option>
							<% if (typeof categories !== 'undefined' && categories) { %>
								<% categories.forEach(cat => { %>
									<option value="<%= cat.id %>"><%= cat.name %></option>
								<% }); %>
							<% } %>
						</select>
					</div>
					<div class="mb-3">
						<label class="form-label">Amount *</label>
						<input type="number" name="amount" class="form-control" step="0.01" min="0" required>
					</div>
					<div class="mb-3">
						<label class="form-label">Year</label>
						<input type="number" name="year" class="form-control" min="2000" max="2100" placeholder="e.g., 2025">
					</div>
					<div class="mb-3">
						<label class="form-label">Invoice Date *</label>
						<input type="date" name="invoiceDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
					</div>
					<div class="mb-3">
						<label class="form-label">Due Date</label>
						<input type="date" name="dueDate" class="form-control">
					</div>
					<div class="mb-3">
						<label class="form-label">Description</label>
						<textarea name="description" class="form-control" rows="3"></textarea>
					</div>
					<div class="mb-3">
						<label class="form-label">Notes</label>
						<textarea name="notes" class="form-control" rows="2"></textarea>
					</div>
					<div class="alert alert-info">
						<strong>Note:</strong> Invoices will be created for <span id="modalSelectedCount">0</span> selected apartment(s).
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary" onclick="submitBulkInvoices()">Create Invoices</button>
			</div>
		</div>
	</div>
</div>

<script>
(function(){
	const searchInput = document.getElementById('apartmentSearch');
	const blockFilter = document.getElementById('blockFilter');
	const statusFilter = document.getElementById('statusFilter');
	const vacantFilter = document.getElementById('vacantFilter');
	const visibleCountEl = document.getElementById('visibleApartmentCount');
	const totalCountEl = document.getElementById('totalApartmentCount');
	const selectAllCheckbox = document.getElementById('selectAll');
	const bulkActionsToolbar = document.getElementById('bulkActionsToolbar');
	const selectedCountSpan = document.getElementById('selectedCount');
	const apartmentCheckboxes = document.querySelectorAll('.apartment-checkbox');
	const apartmentRows = document.querySelectorAll('table tbody tr[data-block]');
	const totalApartments = apartmentRows.length;
	
	if (totalCountEl) {
		totalCountEl.textContent = totalApartments;
	}
	
	function filterTable() {
		const searchTerm = searchInput ? searchInput.value.toLowerCase() : '';
		const selectedBlock = blockFilter ? blockFilter.value : '';
		const selectedStatus = statusFilter ? statusFilter.value : '';
		const selectedVacant = vacantFilter ? vacantFilter.value : '';
		let visibleCount = 0;
		
		apartmentRows.forEach(tr => {
			const block = tr.getAttribute('data-block');
			const status = tr.getAttribute('data-status') || '';
			const vacant = tr.getAttribute('data-vacant') || '';
			const cells = tr.querySelectorAll('td');
			
			let searchText = tr.getAttribute('data-search') || '';
			cells.forEach(cell => {
				searchText += cell.textContent.toLowerCase() + ' ';
			});
			
			const matchesSearch = !searchTerm || searchText.includes(searchTerm);
			const matchesBlock = !selectedBlock || block === selectedBlock;
			const matchesStatus = !selectedStatus || status === selectedStatus;
			const matchesVacant = !selectedVacant || vacant === selectedVacant;
			const isVisible = matchesSearch && matchesBlock && matchesStatus && matchesVacant;
			
			tr.style.display = isVisible ? '' : 'none';
			if (isVisible) {
				visibleCount++;
			}
		});
		
		if (visibleCountEl) {
			visibleCountEl.textContent = visibleCount;
		}
		
		updateSelectionCount();
	}
	
	function updateSelectionCount() {
		const checked = document.querySelectorAll('.apartment-checkbox:checked').length;
		selectedCountSpan.textContent = checked;
		
		if (checked > 0) {
			bulkActionsToolbar.style.display = 'block';
		} else {
			bulkActionsToolbar.style.display = 'none';
		}
		
		// Update select all checkbox state
		const visibleCheckboxes = Array.from(document.querySelectorAll('.apartment-checkbox')).filter(cb => {
			const tr = cb.closest('tr');
			return tr && tr.style.display !== 'none';
		});
		const visibleChecked = visibleCheckboxes.filter(cb => cb.checked).length;
		selectAllCheckbox.checked = visibleCheckboxes.length > 0 && visibleChecked === visibleCheckboxes.length;
		selectAllCheckbox.indeterminate = visibleChecked > 0 && visibleChecked < visibleCheckboxes.length;
	}
	
	function clearSelection() {
		document.querySelectorAll('.apartment-checkbox').forEach(cb => cb.checked = false);
		selectAllCheckbox.checked = false;
		selectAllCheckbox.indeterminate = false;
		updateSelectionCount();
	}
	
	// Select all functionality
	if (selectAllCheckbox) {
		selectAllCheckbox.addEventListener('change', function() {
			document.querySelectorAll('.apartment-checkbox').forEach(cb => {
				const tr = cb.closest('tr');
				if (tr && tr.style.display !== 'none') {
					cb.checked = this.checked;
				}
			});
			updateSelectionCount();
		});
	}
	
	// Individual checkbox change
	apartmentCheckboxes.forEach(cb => {
		cb.addEventListener('change', updateSelectionCount);
	});
	
	// Make clearSelection available globally
	window.clearSelection = clearSelection;
	
	if (searchInput) {
		searchInput.addEventListener('input', filterTable);
	}
	
	if (blockFilter) {
		blockFilter.addEventListener('change', filterTable);
	}
	
	if (statusFilter) {
		statusFilter.addEventListener('change', filterTable);
	}
	
	if (vacantFilter) {
		vacantFilter.addEventListener('change', filterTable);
	}
	
	// Initialize
	filterTable();
	updateSelectionCount();
})();

function openBulkInvoiceModal() {
	const selectedIds = Array.from(document.querySelectorAll('.apartment-checkbox:checked')).map(cb => cb.value);
	if (selectedIds.length === 0) {
		alert('Please select at least one apartment');
		return;
	}
	
	document.getElementById('modalSelectedCount').textContent = selectedIds.length;
	const modal = new bootstrap.Modal(document.getElementById('bulkInvoiceModal'));
	modal.show();
}

function submitBulkInvoices() {
	const selectedIds = Array.from(document.querySelectorAll('.apartment-checkbox:checked')).map(cb => parseInt(cb.value));
	if (selectedIds.length === 0) {
		alert('Please select at least one apartment');
		return;
	}
	
	const form = document.getElementById('bulkInvoiceForm');
	const formData = new FormData(form);
	const data = Object.fromEntries(formData);
	data.apartmentIds = selectedIds;
	
	// Show loading state
	const submitBtn = event.target;
	const originalText = submitBtn.innerHTML;
	submitBtn.disabled = true;
	submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Creating...';
	
	fetch('/admin/apartments/bulk-create-invoices', {
		method: 'POST',
		headers: {
			'Content-Type': 'application/json'
		},
		body: JSON.stringify(data)
	})
	.then(response => response.json())
	.then(result => {
		if (result.success) {
			// Close modal
			const modal = bootstrap.Modal.getInstance(document.getElementById('bulkInvoiceModal'));
			modal.hide();
			
			// Clear selection
			clearSelection();
			
			// Show success message and reload
			alert(result.message || `Successfully created ${result.createdCount || selectedIds.length} invoice(s)`);
			window.location.reload();
		} else {
			alert('Error: ' + (result.message || 'Failed to create invoices'));
			submitBtn.disabled = false;
			submitBtn.innerHTML = originalText;
		}
	})
	.catch(error => {
		console.error('Error:', error);
		alert('Error creating invoices');
		submitBtn.disabled = false;
		submitBtn.innerHTML = originalText;
	});
}
</script>
