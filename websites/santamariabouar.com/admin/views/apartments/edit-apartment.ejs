</div>
<% } %>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" role="dialog" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">
                    <i class="fas fa-check-circle"></i> Success
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="opacity: 1; padding: 0.5rem; margin: -0.5rem -0.5rem -0.5rem auto; background: transparent; border: 0; cursor: pointer;">
                    <span aria-hidden="true" style="font-size: 1.5rem; font-weight: 300; text-shadow: none;">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="successModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" role="dialog" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">
                    <i class="fas fa-exclamation-circle"></i> Error
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="opacity: 1; padding: 0.5rem; margin: -0.5rem -0.5rem -0.5rem auto; background: transparent; border: 0; cursor: pointer;">
                    <span aria-hidden="true" style="font-size: 1.5rem; font-weight: 300; text-shadow: none;">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="errorModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
const gateAccessUsersData = <% if (apartment && apartment.gateAccessUsers) { %><%- JSON.stringify(apartment.gateAccessUsers) %><% } else { %>[]<% } %>;
let ownerRenterChangeConfirmed = false;

function confirmRevokeGateAccess(apartmentId, userId, userName) {
    const form = document.getElementById('revokeGateAccessForm');
    const nameEl = document.getElementById('revokeGateAccessUserName');
    if (form && nameEl) {
        form.action = `/admin/apartments/${apartmentId}/gate-access/${userId}/revoke`;
        nameEl.textContent = userName;
        const modal = new bootstrap.Modal(document.getElementById('revokeGateAccessModal'));
        modal.show();
    }
}

// Wait for DOM to be ready
document.addEventListener('DOMContentLoaded', function() {
    const statusSelect = document.getElementById('status');
    const renterSelect = document.getElementById('renterId');
    const renterRequiredMark = document.getElementById('renterRequiredMark');
    const renterHelpText = document.getElementById('renterHelpText');

    function updateRenterRequiredState() {
        const isRented = statusSelect && statusSelect.value === 'rented';
        if (renterSelect) {
            renterSelect.required = isRented;
        }
        if (renterRequiredMark) {
            renterRequiredMark.style.display = isRented ? 'inline' : 'none';
        }
        if (renterHelpText) {
            renterHelpText.textContent = isRented
                ? 'Required — select the person currently renting this apartment'
                : 'Optional — required when status is Rented';
        }
    }

    if (statusSelect) {
        statusSelect.addEventListener('change', updateRenterRequiredState);
        updateRenterRequiredState();
    }

    document.querySelectorAll('.revoke-gate-access-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            confirmRevokeGateAccess(
                btn.dataset.apartmentId,
                btn.dataset.userId,
                btn.dataset.userName
            );
        });
    });

    // Form validation and owner/renter change warning
    const apartmentForm = document.getElementById('apartmentForm');
    if (apartmentForm) {
        apartmentForm.addEventListener('submit', function(e) {
            const unitUnofficial = document.getElementById('unitNumberUnofficial').value.trim();
            const unitOfficial = document.getElementById('unitNumberOfficial').value.trim();
            
            if (!unitUnofficial || !unitOfficial) {
                e.preventDefault();
                showError('Both unit numbers are required.');
                return false;
            }

            const statusValue = document.getElementById('status')?.value;
            const renterValue = document.getElementById('renterId')?.value;
            if (statusValue === 'rented' && !renterValue) {
                e.preventDefault();
                showError('Renter is required when status is Rented.');
                return false;
            }

            if (ownerRenterChangeConfirmed || !apartmentForm.dataset.originalOwnerId) {
                return true;
            }

            const ownerId = document.getElementById('ownerId').value;
            const renterId = document.getElementById('renterId').value;
            const origOwnerId = apartmentForm.dataset.originalOwnerId;
            const origRenterId = apartmentForm.dataset.originalRenterId || '';
            const ownerChanged = ownerId !== origOwnerId;
            const renterChanged = renterId !== origRenterId;

            if (ownerChanged || renterChanged) {
                e.preventDefault();
                const namesToRevoke = new Set();

                if (ownerChanged && apartmentForm.dataset.originalOwnerName) {
                    namesToRevoke.add(apartmentForm.dataset.originalOwnerName + ' (previous owner)');
                }
                if (renterChanged && apartmentForm.dataset.originalRenterName) {
                    namesToRevoke.add(apartmentForm.dataset.originalRenterName + ' (previous renter)');
                }
                gateAccessUsersData.forEach(function(user) {
                    namesToRevoke.add(user.name + ' (' + user.relation + ')');
                });

                const listEl = document.getElementById('accessChangeWarningList');
                if (listEl) {
                    listEl.innerHTML = '';
                    namesToRevoke.forEach(function(name) {
                        const li = document.createElement('li');
                        li.textContent = name;
                        listEl.appendChild(li);
                    });
                }

                const warningModal = document.getElementById('accessChangeWarningModal');
                const confirmBtn = document.getElementById('accessChangeWarningConfirmBtn');
                if (warningModal && confirmBtn) {
                    confirmBtn.onclick = function() {
                        ownerRenterChangeConfirmed = true;
                        bootstrap.Modal.getInstance(warningModal).hide();
                        apartmentForm.submit();
                    };
                    new bootstrap.Modal(warningModal).show();
                }
                return false;
            }
        });
    }
});

// Auto-format area input
const areaInput = document.getElementById('areaInM2');
if (areaInput) {
    areaInput.addEventListener('input', function() {
        const value = parseFloat(this.value);
        if (!isNaN(value) && value < 0) {
            this.value = 0;
        }
    });
}

// Image upload handling
const additionalImageInput = document.getElementById('additionalImageFile');
if (additionalImageInput) {
    additionalImageInput.addEventListener('change', function() {
        const files = this.files;
        if (files.length > 0) {
            for (let i = 0; i < files.length; i++) {
                uploadAdditionalImage(<%= apartment ? apartment.id : 'null' %>, files[i]);
            }
            this.value = ''; // Reset input
        }
    });
}

// Upload official image
function uploadOfficialImage(apartmentId) {
    const fileInput = document.getElementById('officialImageFile');
    const file = fileInput.files[0];
    
    if (!file) {
        showError('Please select an image file first.');
        return;
    }
    
    const formData = new FormData();
    formData.append('officialImage', file);
    
    fetch(`/admin/apartments/${apartmentId}/upload-official-image`, {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSuccess(data.message || 'Official image uploaded successfully');
            // Reload immediately on success
            setTimeout(() => location.reload(), 800);
        } else {
            showError(data.message || 'Failed to upload image');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        showError('Failed to upload image');
    });
}

// Upload additional image
function uploadAdditionalImage(apartmentId, file) {
    if (!file) {
        showError('No file selected');
        return;
    }
    
    console.log('Uploading file:', file.name, 'for apartment:', apartmentId);
    
    const formData = new FormData();
    formData.append('image', file);
    
    fetch(`/admin/apartments/${apartmentId}/upload-image`, {
        method: 'POST',
        body: formData
    })
    .then(response => {
        console.log('Response status:', response.status);
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
    })
    .then(data => {
        console.log('Upload response:', data);
        if (data.success) {
            // Instead of adding to grid dynamically, just reload the page
            // This ensures the image is fetched from database
            console.log('Image uploaded successfully, reloading page...');
            setTimeout(() => location.reload(), 500);
        } else {
            showError(data.message || 'Failed to upload image');
        }
    })
    .catch(error => {
        console.error('Upload error:', error);
        showError('Failed to upload image: ' + error.message);
    });
}

// Add image to grid
function addImageToGrid(apartmentId, imageName) {
    const grid = document.getElementById('additionalImagesGrid');
    const emptyMessage = grid.querySelector('.text-muted');
    
    // Remove empty state message if exists
    if (emptyMessage) {
        const parent = emptyMessage.closest('.col-12');
        if (parent) parent.remove();
    }
    
    const imageHtml = `
        <div class="col-lg-3 col-md-4 col-sm-6 mb-3" data-image="${imageName}">
          <div class="card">
            <img src="/images/apartments/${apartmentId}/${imageName}" 
                 class="card-img-top" 
                 alt="Apartment Image" 
                 style="height: 200px; object-fit: cover;">
            <div class="card-body p-2">
              <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-sm btn-primary" onclick="setAsOfficial(${apartmentId}, '${imageName}')" title="Set as Official">
                  <i class="fa fa-star"></i>
                </button>
                <button type="button" class="btn btn-sm btn-danger" onclick="deleteApartmentImage(${apartmentId}, '${imageName}', false)" title="Delete">
                  <i class="fa fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
    `;
    
    grid.insertAdjacentHTML('beforeend', imageHtml);
}

// Delete apartment image with confirmation modal
function deleteApartmentImage(apartmentId, imageName, isOfficial) {
    showConfirm('Are you sure you want to delete this image?', function() {
        fetch(`/admin/apartments/${apartmentId}/images/${imageName}`, {
            method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showSuccess(data.message || 'Image deleted successfully');
                if (isOfficial) {
                    setTimeout(() => location.reload(), 1500);
                } else {
                    const imageElement = document.querySelector(`[data-image="${imageName}"]`);
                    if (imageElement) {
                        imageElement.remove();
                    }
                    
                    // Check if grid is empty
                    const grid = document.getElementById('additionalImagesGrid');
                    if (grid.children.length === 0) {
                        grid.innerHTML = `
                            <div class="col-12">
                                <div class="text-center p-4 border rounded bg-light">
                                  <i class="fa fa-images fa-3x text-muted mb-2"></i>
                                  <p class="text-muted mb-0">No additional images uploaded</p>
                                  <small class="text-muted">Click "Add Images" to upload photos</small>
                                </div>
                            </div>
                        `;
                    }
                }
            } else {
                showError(data.message || 'Failed to delete image');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showError('Failed to delete image');
        });
    });
}

// Set image as official with confirmation modal
function setAsOfficial(apartmentId, imageName) {
    showConfirm('Set this image as the official apartment image?', function() {
        fetch(`/admin/apartments/${apartmentId}/set-official/${imageName}`, {
            method: 'POST'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showSuccess(data.message || 'Image set as official successfully');
                setTimeout(() => location.reload(), 1500);
            } else {
                showError(data.message || 'Failed to set official image');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showError('Failed to set official image');
        });
    });
}

// Helper functions for modals (using vanilla JavaScript)
function showConfirm(message, onConfirm) {
    const modalBody = document.getElementById('confirmModalBody');
    const modal = document.getElementById('confirmModal');
    const confirmBtn = document.getElementById('confirmModalBtn');
    
    if (modalBody && modal && confirmBtn) {
        modalBody.textContent = message;
        
        // Remove old click handler and add new one
        confirmBtn.onclick = function() {
            const bootstrapModal = bootstrap.Modal.getInstance(modal);
            if (bootstrapModal) {
                bootstrapModal.hide();
            }
            if (onConfirm) onConfirm();
        };
        
        const bootstrapModal = new bootstrap.Modal(modal, {
            backdrop: true,
            keyboard: true,
            focus: true
        });
        bootstrapModal.show();
    }
}

function showSuccess(message) {
    const modalBody = document.getElementById('successModalBody');
    const modal = document.getElementById('successModal');
    if (modalBody && modal) {
        modalBody.textContent = message;
        const bootstrapModal = new bootstrap.Modal(modal, {
            backdrop: true,
            keyboard: true,
            focus: true
        });
        bootstrapModal.show();
    }
}

function showError(message) {
    const modalBody = document.getElementById('errorModalBody');
    const modal = document.getElementById('errorModal');
    if (modalBody && modal) {
        modalBody.textContent = message;
        const bootstrapModal = new bootstrap.Modal(modal, {
            backdrop: true,
            keyboard: true,
            focus: true
        });
        bootstrapModal.show();
    }
}
</script>
