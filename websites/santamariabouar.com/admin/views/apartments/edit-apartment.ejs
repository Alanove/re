<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1><%= apartment ? ((typeof canEditAdmin !== 'undefined' && canEditAdmin) ? 'Edit Apartment' : 'View Apartment') : 'Add Apartment' %></h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/admin/apartments">Apartments</a></li>
                        <li class="breadcrumb-item active"><%= apartment ? 'Edit' : 'Create' %></li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <% if (apartment) { %>
                        <div class="card-header p-0 border-bottom-0">
                            <ul class="nav nav-tabs card-header-tabs px-3 pt-2" id="apartmentEditTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link <%= (!activeTab || activeTab === 'details') ? 'active' : '' %>" id="tab-details-btn" data-bs-toggle="tab" data-bs-target="#tab-details" type="button" role="tab">Apartment Details</button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link <%= activeTab === 'gate-access' ? 'active' : '' %>" id="tab-gate-access-btn" data-bs-toggle="tab" data-bs-target="#tab-gate-access" type="button" role="tab">Main Gate Access</button>
                                </li>
                            </ul>
                        </div>
                        <% } else { %>
                        <div class="card-header">
                            <h3 class="card-title">Apartment Details</h3>
                        </div>
                        <% } %>

                        <div class="<%= apartment ? 'tab-content' : '' %>">
                        <div class="<%= apartment ? 'tab-pane fade' : '' %> <%= apartment && (!activeTab || activeTab === 'details') ? 'show active' : '' %>" id="tab-details" role="tabpanel">
                        <form id="apartmentForm"
                              action="<%= apartment ? ('/admin/apartments/' + apartment.id + '/edit') : '/admin/apartments/create' %>"
                              method="POST"
                              <%= typeof canEditAdmin === 'undefined' || !canEditAdmin ? 'onsubmit="return false;"' : '' %>
                              <% if (apartment) { %>
                              data-original-owner-id="<%= originalOwnerId %>"
                              data-original-renter-id="<%= originalRenterId || '' %>"
                              data-original-owner-name="<%= originalOwnerName %>"
                              data-original-renter-name="<%= originalRenterName || '' %>"
                              <% } %>>
                            <div class="card-body" <%= typeof canEditAdmin === 'undefined' || !canEditAdmin ? 'style="pointer-events:none;opacity:0.85;"' : '' %>>
                                <% if (typeof success !== 'undefined' && success) { %>
                                  <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <strong>Success!</strong> <%= success %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                  </div>
                                <% } %>
                                <% if (typeof error !== 'undefined' && error) { %>
                                  <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <strong>Error!</strong> <%= error %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                  </div>
                                <% } %>

                                <div class="form-group">
                                    <label for="ownerId">Owner <span class="text-danger">*</span></label>
                                    <select class="form-control" id="ownerId" name="ownerId" required>
                                        <option value="">Select an owner...</option>
                                        <% users.forEach(function(user) { %>
                                          <option value="<%= user.id %>" <%= apartment && apartment.ownerId === user.id ? 'selected' : '' %>>
                                            <%= user.name %><% if (user.email) { %> (<%= user.email %>)<% } %>
                                          </option>
                                        <% }); %>
                                    </select>
                                    <small class="form-text text-muted">Select the apartment owner from registered users</small>
                                </div>

                                <div class="form-group">
                                    <label for="status">Status</label>
                                    <select class="form-control" id="status" name="status">
                                        <option value="owned" <%= apartment && apartment.status === 'owned' ? 'selected' : '' %>>Owned</option>
                                        <option value="rented" <%= apartment && apartment.status === 'rented' ? 'selected' : '' %>>Rented</option>
                                        <option value="for_rent" <%= apartment && apartment.status === 'for_rent' ? 'selected' : '' %>>For Rent</option>
                                        <option value="for_sale" <%= apartment && apartment.status === 'for_sale' ? 'selected' : '' %>>For Sale</option>
                                        <option value="not_sold" <%= apartment && apartment.status === 'not_sold' ? 'selected' : '' %>>Not Sold</option>
                                    </select>
                                    <small class="form-text text-muted">Select the apartment availability status</small>
                                </div>

                                <% if (apartment) { %>
                                <div class="form-group">
                                    <label for="isVacant">Vacancy</label>
                                    <select class="form-control" id="isVacant" name="isVacant">
                                        <option value="0" <%= !apartment.isVacant ? 'selected' : '' %>>Occupied</option>
                                        <option value="1" <%= apartment.isVacant ? 'selected' : '' %>>Vacant</option>
                                    </select>
                                    <small class="form-text text-muted">Whether the apartment is currently vacant</small>
                                </div>
                                <% } %>

                                <div class="form-group">
                                    <label for="renterId">Renter <span class="text-danger" id="renterRequiredMark" style="display: none;">*</span></label>
                                    <select class="form-control" id="renterId" name="renterId">
                                        <option value="">No renter</option>
                                        <% users.forEach(function(user) { %>
                                          <option value="<%= user.id %>" <%= apartment && apartment.renterId === user.id ? 'selected' : '' %>>
                                            <%= user.name %><% if (user.email) { %> (<%= user.email %>)<% } %>
                                          </option>
                                        <% }); %>
                                    </select>
                                    <small class="form-text text-muted" id="renterHelpText">Optional — required when status is Rented</small>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="block">Block <span class="text-danger">*</span></label>
                                            <select class="form-control" id="block" name="block" required>
                                                <option value="">Select a block...</option>
                                                <% availableBlocks.forEach(function(blockOption) { %>
                                                  <option value="<%= blockOption %>" <%= apartment && apartment.block === blockOption ? 'selected' : '' %>>
                                                    Block <%= blockOption %>
                                                  </option>
                                                <% }); %>
                                            </select>
                                            <small class="form-text text-muted">Select the building block (A-J)</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="areaInM2">Area in m² <span class="text-danger">*</span></label>
                                            <input type="number" class="form-control" id="areaInM2" name="areaInM2" 
                                                   value="<%= apartment ? apartment.areaInM2 : '' %>" 
                                                   step="0.01" min="0" required />
                                            <small class="form-text text-muted">The apartment area in square meters</small>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="unitNumberUnofficial">Unit Number (Unofficial) <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="unitNumberUnofficial" name="unitNumberUnofficial" 
                                                   value="<%= apartment ? apartment.unitNumberUnofficial : '' %>" required />
                                            <small class="form-text text-muted">The unofficial unit number (internal reference)</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="unitNumberOfficial">Unit Number (Official) <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="unitNumberOfficial" name="unitNumberOfficial" 
                                                   value="<%= apartment ? apartment.unitNumberOfficial : '' %>" required />
                                            <small class="form-text text-muted">The official unit number (legal reference)</small>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="form-group">
                                    <label for="registrationDate">Registration Date <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" id="registrationDate" name="registrationDate" 
                                           value="<%= apartment ? (apartment.registrationDate ? new Date(apartment.registrationDate).toISOString().split('T')[0] : '') : '' %>" required />
                                    <small class="form-text text-muted">The date when the apartment was registered</small>
                                </div>
                                
                                <div class="form-group">
                                    <label for="notes">Notes</label>
                                    <textarea class="form-control" id="notes" name="notes" rows="3" placeholder="Optional notes about the apartment..."><%= apartment ? (apartment.notes || '') : '' %></textarea>
                                    <small class="form-text text-muted">Optional additional information about the apartment</small>
                                </div>
                                
                                <% if (apartment) { %>
                                  <div class="form-group">
                                    <label>Created</label>
                                    <p class="form-control-plaintext">
                                      <%= new Date(apartment.createdAt).toLocaleString() %>
                                      <% if (apartment.updatedAt) { %>
                                        <br><small class="text-muted">Last Updated: <%= new Date(apartment.updatedAt).toLocaleString() %></small>
                                      <% } %>
                                    </p>
                                  </div>
                                <% } %>

                                <% if (apartment) { %>
                                  <hr>
                                  <h5 class="mb-3">Linked Owners &amp; Tenants</h5>
                                  <p class="text-muted small">
                                    Multiple owners and tenants can be linked. Transactions and invoices use the
                                    <strong>primary</strong> owner. Additional owners get portal access without changing ownership.
                                  </p>
                                  <% if (typeof apartmentUsers !== 'undefined' && apartmentUsers && apartmentUsers.length > 0) { %>
                                    <div class="table-responsive mb-3">
                                      <table class="table table-sm table-bordered align-middle">
                                        <thead>
                                          <tr>
                                            <th>Name</th>
                                            <th>Role</th>
                                            <th>Actions</th>
                                          </tr>
                                        </thead>
                                        <tbody>
                                          <% apartmentUsers.forEach(function(m) { %>
                                            <tr>
                                              <td>
                                                <strong><%= m.name %></strong>
                                                <% if (m.email) { %><br><small class="text-muted"><%= m.email %></small><% } %>
                                                <% if (m.phone) { %><br><small class="text-muted"><%= m.phone %></small><% } %>
                                              </td>
                                              <td>
                                                <% if (m.role === 'tenant') { %>
                                                  <span class="badge bg-info">Tenant</span>
                                                <% } else if (m.isPrimary) { %>
                                                  <span class="badge bg-primary">Primary owner</span>
                                                <% } else { %>
                                                  <span class="badge bg-secondary">Additional owner</span>
                                                <% } %>
                                              </td>
                                              <td class="text-nowrap">
                                                <% if (m.role === 'owner' && !m.isPrimary) { %>
                                                  <form method="POST" action="/admin/apartments/<%= apartment.id %>/members/<%= m.userId %>/primary" class="d-inline"
                                                        onsubmit="return confirm('Make this member the primary owner? This updates the transactions Owner column.');">
                                                    <button type="submit" class="btn btn-xs btn-outline-primary">Make primary</button>
                                                  </form>
                                                <% } %>
                                                <form method="POST" action="/admin/apartments/<%= apartment.id %>/members/<%= m.userId %>/<%= m.role %>/remove" class="d-inline"
                                                      onsubmit="return confirm('Remove this member link from the apartment?');">
                                                  <button type="submit" class="btn btn-xs btn-outline-danger">Remove</button>
                                                </form>
                                              </td>
                                            </tr>
                                          <% }); %>
                                        </tbody>
                                      </table>
                                    </div>
                                  <% } else { %>
                                    <div class="text-muted mb-3">No linked members in apartment_users yet.</div>
                                  <% } %>

                                  <form method="POST" action="/admin/apartments/<%= apartment.id %>/members" class="border rounded p-3 bg-light">
                                    <div class="row g-2 align-items-end">
                                      <div class="col-md-5">
                                        <label class="form-label small mb-1" for="memberUserId">Add member</label>
                                        <select class="form-control" id="memberUserId" name="userId" required>
                                          <option value="">Select user...</option>
                                          <% users.forEach(function(user) { %>
                                            <option value="<%= user.id %>"><%= user.name %><% if (user.email) { %> (<%= user.email %>)<% } %></option>
                                          <% }); %>
                                        </select>
                                      </div>
                                      <div class="col-md-3">
                                        <label class="form-label small mb-1" for="memberRole">Role</label>
                                        <select class="form-control" id="memberRole" name="role">
                                          <option value="owner">Owner</option>
                                          <option value="tenant">Tenant</option>
                                        </select>
                                      </div>
                                      <div class="col-md-2">
                                        <div class="form-check mt-4">
                                          <input class="form-check-input" type="checkbox" name="makePrimary" value="1" id="memberMakePrimary" />
                                          <label class="form-check-label small" for="memberMakePrimary">Set as primary</label>
                                        </div>
                                      </div>
                                      <div class="col-md-2">
                                        <button type="submit" class="btn btn-primary w-100">Add</button>
                                      </div>
                                    </div>
                                  </form>
                                <% } %>

                                <% if (apartment && typeof ownerHistory !== 'undefined') { %>
                                  <hr>
                                  <h5 class="mb-3">Ownership History</h5>
                                  <% if (ownerHistory && ownerHistory.length > 0) { %>
                                    <div class="table-responsive">
                                      <table class="table table-striped table-bordered align-middle">
                                          <thead>
                                            <tr>
                                              <th>Owner</th>
                                              <th>From</th>
                                              <th>To</th>
                                              <th>Changed By</th>
                                            </tr>
                                          </thead>
                                          <tbody>
                                            <% ownerHistory.forEach(function(entry) { %>
                                            <tr>
                                              <td>
                                                <strong><%= entry.ownerName %></strong>
                                                <% if (entry.ownerEmail) { %>
                                                  <br><small class="text-muted"><%= entry.ownerEmail %></small>
                                                <% } %>
                                              </td>
                                              <td><%= entry.startDate ? new Date(entry.startDate).toLocaleDateString() : '—' %></td>
                                              <td>
                                                <% if (entry.endDate) { %>
                                                  <%= new Date(entry.endDate).toLocaleDateString() %>
                                                <% } else { %>
                                                  <span class="badge bg-success">Present</span>
                                                <% } %>
                                              </td>
                                              <td><%= entry.changedByName || '—' %></td>
                                            </tr>
                                            <% }); %>
                                          </tbody>
                                      </table>
                                    </div>
                                  <% } else { %>
                                    <div class="text-center p-4 border rounded bg-light">
                                      <i class="fa fa-history fa-2x text-muted mb-2"></i>
                                      <p class="text-muted mb-0">No ownership changes recorded yet</p>
                                    </div>
                                  <% } %>
                                <% } %>
                            </div>

                            <div class="card-footer">
                                <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-save"></i> <%= apartment ? 'Update' : 'Add' %> Apartment
                                </button>
                                <% } %>
                                <a href="/admin/apartments" class="btn btn-secondary ms-2">
                                    <i class="fa fa-<%= typeof canEditAdmin !== 'undefined' && canEditAdmin ? 'times' : 'arrow-left' %>"></i> <%= typeof canEditAdmin !== 'undefined' && canEditAdmin ? 'Cancel' : 'Back' %>
                                </a>
                            </div>
                        </form>
                        </div>

                        <% if (apartment) { %>
                        <div class="tab-pane fade <%= activeTab === 'gate-access' ? 'show active' : '' %>" id="tab-gate-access" role="tabpanel">
                            <div class="card-body">
                                <% if (typeof success !== 'undefined' && success && activeTab === 'gate-access') { %>
                                  <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <strong>Success!</strong> <%= success %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                  </div>
                                <% } %>
                                <% if (typeof error !== 'undefined' && error && activeTab === 'gate-access') { %>
                                  <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <strong>Error!</strong> <%= error %>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                  </div>
                                <% } %>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div>
                                        <h5 class="mb-1">Main Gate Access</h5>
                                        <small class="text-muted">Owner and renter are granted access automatically when saved on the Details tab.</small>
                                    </div>
                                    <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addGateAccessModal" <%= typeof canEditAdmin === 'undefined' || !canEditAdmin ? 'style="display:none"' : '' %>>
                                        <i class="fa fa-plus"></i> Add Access
                                    </button>
                                </div>

                                <% if (apartment.gateAccessUsers && apartment.gateAccessUsers.length > 0) { %>
                                  <div class="table-responsive">
                                    <table class="table table-striped table-bordered align-middle">
                                      <thead>
                                        <tr>
                                          <th>Name</th>
                                          <th>Contact</th>
                                          <th>Relation</th>
                                          <th>Expiry</th>
                                          <th width="120">Actions</th>
                                        </tr>
                                      </thead>
                                      <tbody>
                                        <%
                                          var todayStr = new Date().toISOString().slice(0, 10);
                                          apartment.gateAccessUsers.forEach(function(gateUser) {
                                            var expired = gateUser.expiryDate && gateUser.expiryDate < todayStr;
                                        %>
                                        <tr>
                                          <td><strong><%= gateUser.name %></strong></td>
                                          <td>
                                            <% if (gateUser.email) { %><%= gateUser.email %><br><% } %>
                                            <% if (gateUser.phone) { %><small class="text-muted"><%= gateUser.phone %></small><% } %>
                                            <% if (!gateUser.email && !gateUser.phone) { %><span class="text-muted">—</span><% } %>
                                          </td>
                                          <td><span class="badge bg-info"><%= gateUser.relation %></span></td>
                                          <td>
                                            <% if (gateUser.expiryDate) { %>
                                              <span class="<%= expired ? 'text-warning fw-bold' : '' %>"><%= gateUser.expiryDate %><%= expired ? ' (expired)' : '' %></span>
                                            <% } else { %>
                                              <span class="text-muted">—</span>
                                            <% } %>
                                          </td>
                                          <td>
                                            <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
                                            <button type="button" class="btn btn-sm btn-outline-danger revoke-gate-access-btn"
                                                    data-apartment-id="<%= apartment.id %>"
                                                    data-user-id="<%= gateUser.id %>"
                                                    data-user-name="<%= gateUser.name %>">
                                              <i class="fa fa-ban"></i> Revoke
                                            </button>
                                            <% } else { %>
                                            <span class="text-muted">—</span>
                                            <% } %>
                                          </td>
                                        </tr>
                                        <% }); %>
                                      </tbody>
                                    </table>
                                  </div>
                                <% } else { %>
                                  <div class="text-center p-4 border rounded bg-light">
                                    <i class="fa fa-door-open fa-2x text-muted mb-2"></i>
                                    <p class="text-muted mb-0">No gate access entries yet. Add access or save owner/renter on the Details tab.</p>
                                  </div>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                        </div>
                    </div>

                    <!-- Additional Images Panel (Edit Mode Only) -->
                    <% if (apartment) { %>
                      <div class="card mt-4">
                        <div class="card-header">
                            <h3 class="card-title">Additional Images</h3>
                            <div class="card-tools">
                                <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
                                <input type="file" id="additionalImageFile" accept="image/*" style="display: none;" multiple>
                                <button type="button" class="btn btn-sm btn-success" onclick="document.getElementById('additionalImageFile').click()">
                                    <i class="fa fa-plus"></i> Add Images
                                </button>
                                <% } %>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row" id="additionalImagesGrid">
                                <% if (apartment.images && apartment.images.length > 0) { %>
                                  <% apartment.images.forEach(function(image) { %>
                                    <div class="col-lg-3 col-md-4 col-sm-6 mb-3" data-image="<%= image %>">
                                      <div class="card">
                                        <img src="/images/apartments/<%= apartment.id %>/<%= image %>" 
                                             class="card-img-top" 
                                             alt="Apartment Image" 
                                             style="height: 200px; object-fit: cover;">
                                        <div class="card-body p-2">
                                          <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
                                          <div class="btn-group w-100" role="group">
                                            <button type="button" class="btn btn-sm btn-primary" onclick="setAsOfficial(<%= apartment.id %>, '<%= image %>')" title="Set as Official">
                                              <i class="fa fa-star"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteApartmentImage(<%= apartment.id %>, '<%= image %>', false)" title="Delete">
                                              <i class="fa fa-trash"></i>
                                            </button>
                                          </div>
                                          <% } %>
                                        </div>
                                      </div>
                                    </div>
                                  <% }); %>
                                <% } else { %>
                                  <div class="col-12">
                                    <div class="text-center p-4 border rounded bg-light">
                                      <i class="fa fa-images fa-3x text-muted mb-2"></i>
                                      <p class="text-muted mb-0">No additional images uploaded</p>
                                      <small class="text-muted">Click "Add Images" to upload photos</small>
                                    </div>
                                  </div>
                                <% } %>
                            </div>
                        </div>
                      </div>

                      <!-- Apartment Payments Panel -->
                      <div class="card mt-4">
                        <div class="card-header">
                            <h3 class="card-title">Apartment Payments</h3>
                        </div>
                        <div class="card-body">
                            <% if (apartmentPayments && apartmentPayments.length > 0) { %>
                              <div class="table-responsive">
                                <table class="table table-striped table-bordered align-middle">
                                    <thead>
                                      <tr>
                                        <th>Year</th>
                                        <th>Registration Date</th>
                                        <th>Area (m²)</th>
                                        <th>Price/m²</th>
                                        <th>Total Amount</th>
                                        <th>Amount Paid</th>
                                        <th>Outstanding</th>
                                        <th>Status</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <% apartmentPayments.forEach(function(payment) { %>
                                      <tr>
                                        <td>
                                          <span class="badge bg-primary"><%= payment.year %></span>
                                        </td>
                                        <td>
                                          <%= new Date(payment.startDate).toLocaleDateString() %>
                                        </td>
                                        <td>
                                          <%= payment.areaInM2 %>
                                        </td>
                                        <td>
                                          $<%= payment.pricePerM2.toFixed(2) %>
                                        </td>
                                        <td>
                                          <span class="font-weight-bold text-success">$<%= payment.totalAmount.toFixed(2) %></span>
                                        </td>
                                        <td>
                                          <span class="font-weight-bold text-info">$<%= payment.amountPaid.toFixed(2) %></span>
                                        </td>
                                        <td>
                                          <% const outstanding = payment.totalAmount - payment.amountPaid; %>
                                          <span class="font-weight-bold <%= outstanding > 0 ? 'text-danger' : 'text-success' %>">
                                            $<%= outstanding.toFixed(2) %>
                                          </span>
                                        </td>
                                        <td>
                                          <% if (payment.amountPaid >= payment.totalAmount) { %>
                                            <span class="badge bg-success">Paid</span>
                                          <% } else if (payment.amountPaid > 0) { %>
                                            <span class="badge bg-warning">Partial</span>
                                          <% } else { %>
                                            <span class="badge bg-danger">Unpaid</span>
                                          <% } %>
                                        </td>
                                      </tr>
                                      <% }); %>
                                    </tbody>
                                </table>
                              </div>
                              
                              <!-- Payment Statistics -->
                              <% if (paymentStats) { %>
                              <div class="row mt-3">
                                  <div class="col-md-3">
                                    <div class="card bg-light">
                                      <div class="card-body text-center">
                                        <h5 class="card-title text-primary"><%= paymentStats.totalPayments %></h5>
                                        <p class="card-text">Total Payments</p>
                                      </div>
                                    </div>
                                  </div>
                                  <div class="col-md-3">
                                    <div class="card bg-light">
                                      <div class="card-body text-center">
                                        <h5 class="card-title text-success">$<%= paymentStats.totalAmount.toFixed(2) %></h5>
                                        <p class="card-text">Total Amount</p>
                                      </div>
                                    </div>
                                  </div>
                                  <div class="col-md-3">
                                    <div class="card bg-light">
                                      <div class="card-body text-center">
                                        <h5 class="card-title text-info">$<%= paymentStats.totalPaid.toFixed(2) %></h5>
                                        <p class="card-text">Amount Paid</p>
                                      </div>
                                    </div>
                                  </div>
                                  <div class="col-md-3">
                                    <div class="card bg-light">
                                      <div class="card-body text-center">
                                        <h5 class="card-title <%= paymentStats.totalOutstanding > 0 ? 'text-danger' : 'text-success' %>">$<%= paymentStats.totalOutstanding.toFixed(2) %></h5>
                                        <p class="card-text">Outstanding</p>
                                      </div>
                                    </div>
                                  </div>
                              </div>
                              <% } %>
                            <% } else { %>
                              <div class="text-center p-4 border rounded bg-light">
                                <i class="fa fa-money-bill fa-3x text-muted mb-2"></i>
                                <p class="text-muted mb-0">No payment records found</p>
                                <small class="text-muted">Payments will appear here after they are generated from the Payments page</small>
                              </div>
                            <% } %>
                        </div>
                      </div>
                    <% } %>
                </div>

                <!-- Sidebar -->
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Apartment Details</h3>
                        </div>
                        <div class="card-body">
                            <% if (apartment) { %>
                              <!-- Official Image Section -->
                              <div class="mb-3">
                                <label class="form-label">Official Image</label>
                                
                                <!-- Image Display -->
                                <div id="currentImageContainer" class="mb-3">
                                  <% if (apartment.officialImage) { %>
                                    <div class="text-center">
                                      <img id="currentImage"
                                           src="/images/apartments/<%= apartment.id %>/<%= apartment.officialImage %>"
                                           alt="Official apartment image" 
                                           class="img-fluid rounded"
                                           style="max-width: 100%; max-height: 200px;" />
                                      <div class="mt-2">
                                        <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
                                        <button type="button" class="btn btn-sm btn-danger"
                                                onclick="deleteApartmentImage(<%= apartment.id %>, '<%= apartment.officialImage %>', true)">
                                          <i class="fa fa-trash me-1"></i> Delete Image
                                        </button>
                                        <% } %>
                                      </div>
                                    </div>
                                  <% } else { %>
                                    <div class="text-center p-4 border rounded bg-light">
                                      <i class="fa fa-home fa-3x text-muted mb-2"></i>
                                      <p class="text-muted mb-0">No official image</p>
                                    </div>
                                  <% } %>
                                </div>
                                
                                <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
                                <!-- Image Upload -->
                                <div class="mb-3">
                                  <label for="officialImageFile" class="form-label">Upload Official Image</label>
                                  <input type="file" class="form-control" id="officialImageFile" accept="image/*">
                                  <small class="form-text text-muted">This will be the main apartment image</small>
                                </div>
                                
                                <button type="button" class="btn btn-primary w-100" onclick="uploadOfficialImage(<%= apartment.id %>)">
                                  <i class="fa fa-upload"></i> Upload Official Image
                                </button>
                                <% } %>
                              </div>

                              <!-- Apartment Summary -->
                              <div class="mb-3">
                                <label class="form-label">Summary</label>
                                <div class="border rounded p-3 bg-light">
                                  <div class="mb-2">
                                    <strong>Block:</strong> <%= apartment.block %>
                                  </div>
                                  <div class="mb-2">
                                    <strong>Area:</strong> <%= apartment.areaInM2 %> m²
                                  </div>
                                  <div class="mb-2">
                                    <strong>Status:</strong>
                                    <% if (apartment.status === 'owned') { %>
                                      <span class="badge bg-success">Owned</span>
                                    <% } else if (apartment.status === 'for_rent') { %>
                                      <span class="badge bg-info">For Rent</span>
                                    <% } else if (apartment.status === 'for_sale') { %>
                                      <span class="badge bg-warning">For Sale</span>
                                    <% } else if (apartment.status === 'not_sold') { %>
                                      <span class="badge bg-danger">Not Sold</span>
                                    <% } else { %>
                                      <span class="badge bg-secondary">Unknown</span>
                                    <% } %>
                                  </div>
                                  <div class="mb-2">
                                    <strong>Images:</strong> <%= apartment.images ? apartment.images.length : 0 %> additional
                                  </div>
                                </div>
                              </div>
                            <% } else { %>
                              <div class="text-center p-4">
                                <i class="fa fa-info-circle fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">Apartment details will appear here after creation</p>
                              </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="confirmModalLabel">
                    <i class="fas fa-exclamation-triangle"></i> Confirm Action
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmModalBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

<% if (apartment) { %>
<div class="modal fade" id="accessChangeWarningModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Important: Revoke Main Gate Access</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="fw-bold">You are changing the owner or renter. Don't forget to revoke main gate access for:</p>
                <ul id="accessChangeWarningList" class="mb-3"></ul>
                <p class="text-muted mb-0">Go to the <strong>Main Gate Access</strong> tab after saving to revoke access for people who should no longer enter the building.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Go Back</button>
                <button type="button" class="btn btn-danger" id="accessChangeWarningConfirmBtn">I've noted this — Save Anyway</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addGateAccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/admin/apartments/<%= apartment.id %>/gate-access">
                <div class="modal-header">
                    <h5 class="modal-title">Add Main Gate Access</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="gateAccessUserId" class="form-label">User</label>
                        <select class="form-control" id="gateAccessUserId" name="userId" required>
                            <option value="">Select a user...</option>
                            <% users.forEach(function(user) { %>
                              <option value="<%= user.id %>"><%= user.name %><% if (user.email) { %> (<%= user.email %>)<% } %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="gateAccessRelation" class="form-label">Relation to Apartment</label>
                        <select class="form-control" id="gateAccessRelation" name="relation" required>
                            <% (gateAccessRelations || ['Owner','Tenant','Family','Staff','Guest','Other']).forEach(function(rel) { %>
                              <option value="<%= rel %>" <%= rel === 'Family' ? 'selected' : '' %>><%= rel %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="gateAccessExpiryDate" class="form-label">Expiry Date</label>
                        <input type="date" class="form-control" id="gateAccessExpiryDate" name="expiryDate" />
                        <small class="form-text text-muted">Optional. Leave blank for no expiry.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Access</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="revokeGateAccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="revokeGateAccessForm" method="POST" action="">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-ban"></i> Revoke Gate Access</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Revoke main gate access for <strong id="revokeGateAccessUserName"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Revoke Access</button>
