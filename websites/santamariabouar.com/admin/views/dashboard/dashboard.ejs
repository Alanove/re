						<div class="empty-icon">
							<i class="fa fa-building"></i>
						</div>
						<div class="empty-text">No projects found</div>
						<a href="/admin/projects/create" class="btn btn-success">Create Your First Project</a>
					</div>
				<% } %>
			</div>
		</div>
