<% if (typeof expiredGateAccess !== 'undefined' && expiredGateAccess && expiredGateAccess.length) { %>
<div class="row">
	<div class="col-12">
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			<h5 class="alert-heading mb-2">
				<i class="fas fa-exclamation-triangle me-1"></i>
				Expired main gate access (<%= expiredGateAccess.length %>)
			</h5>
			<p class="mb-2">The following people still have gate access records past their expiry date. Review and revoke if needed.</p>
			<ul class="mb-3">
				<% expiredGateAccess.forEach(function(item) { %>
					<li>
						<strong><%= item.userName %></strong>
						(<%= item.relation %>) — <%= item.apartmentLabel %> — expired <%= item.expiryDate %>
						<a href="/admin/apartments/<%= item.apartmentId %>/edit?tab=gate-access" class="ms-1">Manage</a>
					</li>
				<% }); %>
			</ul>
			<a href="/admin/main-gate-access" class="btn btn-sm btn-outline-danger">Open main gate access</a>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	</div>
</div>
<% } %>
