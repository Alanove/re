				<h4 class="panel-title">Recent Projects</h4>
			</div>
			<div class="panel-body">
				<% if (recentProjects && recentProjects.length > 0) { %>
					<div class="table-responsive recent-items-table">
						<table class="table table-hover">
							<thead>
								<tr>
									<th>Title</th>
									<th>Works</th>
									<th>Categories</th>
									<th>Actions</th>
								</tr>
							</thead>
							<tbody>
								<% recentProjects.forEach(function(project) { %>
									<tr>
										<td>
											<strong><%= project.title %></strong>
											<div class="text-muted small"><%= project.url %></div>
										</td>
										<td>
											<span class="badge bg-info"><%= project.works ? project.works.length : 0 %> works</span>
										</td>
										<td>
											<% if (project.categories && project.categories.length > 0) { %>
												<% project.categories.slice(0, 2).forEach(function(category) { %>
													<span class="badge bg-secondary me-1"><%= category %></span>
												<% }); %>
												<% if (project.categories.length > 2) { %>
													<span class="badge bg-secondary">+<%= project.categories.length - 2 %></span>
												<% } %>
											<% } else { %>
												<span class="text-muted small">No categories</span>
											<% } %>
										</td>
										<td>
											<a href="/admin/projects/<%= allProjects.indexOf(project) %>/edit" class="btn btn-sm btn-outline-success">
												<i class="fa fa-edit"></i>
											</a>
											<a href="/projects/<%= project.url %>" target="_blank" class="btn btn-sm btn-outline-secondary">
												<i class="fa fa-external-link"></i>
											</a>
										</td>
									</tr>
								<% }); %>
							</tbody>
						</table>
					</div>
					<div class="text-center mt-3">
						<a href="/admin/projects" class="btn btn-outline-success">View All Projects</a>
					</div>
				<% } else { %>
