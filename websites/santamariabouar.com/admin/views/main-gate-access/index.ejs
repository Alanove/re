<style>
        .report-header { text-align: center; margin-bottom: 30px; }
        @media print {
            @page { size: A4; margin: 0.1in 0.2in 0.2in 0.2in; }
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
            .no-print { display: none !important; }
            #loader, .app-loader,
            #header, #sidebar,
            .app-header, .app-sidebar,
            .navbar, .sidebar,
            .breadcrumb, .page-header,
            .navbar-header, .navbar-nav, .menu, .menu-header {
                display: none !important;
            }
            html, body {
                font-family: Arial, sans-serif;
                font-size: 10px;
                color: #000 !important;
                background: white !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            #app, #content, .app-content {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
            }
            .container-fluid {
                margin: 0 !important;
                padding: 0 !important;
                max-width: 100% !important;
            }
            .report-header { margin-bottom: 12px !important; }
            .card { border: none !important; box-shadow: none !important; }
            .table { font-size: 9px; }
            .badge { border: 1px solid #666 !important; color: #000 !important; background: #fff !important; }
        }

        @media print {
            #loader,
            #header,
            #sidebar,
            .app-header,
            .app-sidebar,
            .breadcrumb,
            .page-header,
            .btn-scroll-to-top,
            .no-print {
                display: none !important;
            }
            #app {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
            }
            #content.app-content {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                margin-left: 0 !important;
            }
        }
</style>

<div class="main-gate-access-page">
    <div class="report-header">
        <h1><i class="fas fa-door-open text-primary"></i> <%= pageTitle %></h1>
        <h4 class="text-muted"><%= pageSubtitle %></h4>
        <p class="text-muted small">Total entries: <%= totalEntries %></p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
            <strong>Success!</strong> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">
            <strong>Error!</strong> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <div class="no-print mb-3 d-flex flex-wrap gap-2">
        <button onclick="window.print()" class="btn btn-outline-primary">
            <i class="fas fa-print"></i> Print
        </button>
        <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addGateAccessModal">
            <i class="fas fa-plus"></i> Add Access
        </button>
        <% } %>
        <a href="/admin/apartments" class="btn btn-outline-secondary">
            <i class="fas fa-building"></i> Apartments
        </a>
    </div>

    <div class="no-print card mb-4">
        <div class="card-body">
            <form method="GET" action="/admin/main-gate-access" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Block</label>
                    <select name="block" class="form-select" id="filterBlock">
                        <option value="">All blocks</option>
                        <% (availableBlocks || []).forEach(function(blk) { %>
                          <option value="<%= blk %>" <%= filters.block === blk ? 'selected' : '' %>><%= blk %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Number</label>
                    <select name="unitNumber" class="form-select" id="filterUnitNumber">
                        <option value="">All numbers</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Relation</label>
                    <select name="relation" class="form-control">
                        <option value="">All relations</option>
                        <% (gateAccessRelations || ['Owner','Tenant','Family','Staff','Guest','Other']).forEach(function(rel) { %>
                          <option value="<%= rel %>" <%= filters.relation === rel ? 'selected' : '' %>><%= rel %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" name="search" class="form-control" placeholder="Name, email, phone..." value="<%= filters.search || '' %>">
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Filter
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="/admin/main-gate-access" class="btn btn-outline-secondary w-100">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <% if (rows && rows.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-striped table-bordered mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Apartment</th>
                                <th>Relation to Apartment</th>
                                <th>Expiry Date</th>
                                <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
                                <th class="no-print" width="140">Actions</th>
                                <% } %>
                            </tr>
                        </thead>
                        <tbody>
                            <%
                              var todayStr = new Date().toISOString().slice(0, 10);
                              rows.forEach(function(row) {
                                var expired = row.expiryDate && row.expiryDate < todayStr;
                                var apartmentLabel = 'Block ' + row.block + ' – ' + row.unitNumberOfficial;
                                if (row.unitNumberUnofficial && row.unitNumberUnofficial !== row.unitNumberOfficial) {
                                  apartmentLabel += ' (' + row.unitNumberUnofficial + ')';
                                }
                            %>
                            <tr class="<%= expired ? 'table-warning' : '' %>">
                                <td><strong><%= row.userName %></strong></td>
                                <td><%= row.userEmail || '—' %></td>
                                <td><%= row.userPhone || '—' %></td>
                                <td>
                                    Block <%= row.block %> – <%= row.unitNumberOfficial %>
                                    <% if (row.unitNumberUnofficial && row.unitNumberUnofficial !== row.unitNumberOfficial) { %>
                                        <small class="text-muted">(<%= row.unitNumberUnofficial %>)</small>
                                    <% } %>
                                </td>
                                <td><span class="badge bg-info"><%= row.relation %></span></td>
                                <td>
                                    <% if (row.expiryDate) { %>
                                        <span class="<%= expired ? 'text-danger fw-bold' : '' %>"><%= row.expiryDate %><%= expired ? ' (expired)' : '' %></span>
                                    <% } else { %>
                                        —
                                    <% } %>
                                </td>
                                <% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
                                <td class="no-print text-nowrap">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary edit-gate-access-btn"
                                            data-apartment-id="<%= row.apartmentId %>"
                                            data-user-id="<%= row.userId %>"
                                            data-user-name="<%= row.userName %>"
                                            data-apartment-label="<%= apartmentLabel %>"
                                            data-relation="<%= row.relation %>"
                                            data-expiry-date="<%= row.expiryDate || '' %>">
                                        <i class="fa fa-edit"></i> Edit
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger revoke-gate-access-btn"
                                            data-apartment-id="<%= row.apartmentId %>"
                                            data-user-id="<%= row.userId %>"
                                            data-user-name="<%= row.userName %>"
                                            data-apartment-label="<%= apartmentLabel %>">
                                        <i class="fa fa-ban"></i> Revoke
                                    </button>
                                </td>
                                <% } %>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center p-5 text-muted">
                    <i class="fas fa-door-closed fa-3x mb-3"></i>
                    <p class="mb-0">No main gate access entries found.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
(function() {
    var apartments = <%- JSON.stringify((apartments || []).map(function(a) {
        return { block: a.block, unitNumberOfficial: a.unitNumberOfficial, unitNumberUnofficial: a.unitNumberUnofficial };
    })) %>;
    var blockSelect = document.getElementById('filterBlock');
    var numberSelect = document.getElementById('filterUnitNumber');
    var currentUnitNumber = <%- JSON.stringify(filters.unitNumber || '') %>;

    if (!blockSelect || !numberSelect) return;

    function updateNumbers() {
        var selectedBlock = blockSelect.value;
        numberSelect.innerHTML = '<option value="">All numbers</option>';

        var filtered = selectedBlock
            ? apartments.filter(function(a) { return a.block === selectedBlock; })
            : apartments;

        var byOfficial = {};
        filtered.forEach(function(a) {
            if (!a.unitNumberOfficial) return;
            if (!byOfficial[a.unitNumberOfficial]) {
                byOfficial[a.unitNumberOfficial] = a.unitNumberUnofficial || '';
            }
        });

        Object.keys(byOfficial).sort(function(a, b) {
            var nA = parseInt(a, 10);
            var nB = parseInt(b, 10);
            if (!isNaN(nA) && !isNaN(nB)) return nA - nB;
            return a.localeCompare(b);
        }).forEach(function(num) {
            var option = document.createElement('option');
            option.value = num;
            var unofficial = byOfficial[num];
            option.textContent = unofficial && unofficial !== num ? num + ' (' + unofficial + ')' : num;
            if (num === currentUnitNumber) option.selected = true;
            numberSelect.appendChild(option);
        });
    }

    blockSelect.addEventListener('change', function() {
        currentUnitNumber = '';
        updateNumbers();
    });
    updateNumbers();
})();
</script>

<% if (typeof canEditAdmin !== 'undefined' && canEditAdmin) { %>
<script type="application/json" id="main-gate-access-choices"><%- JSON.stringify(gateAccessChoices || { apartments: [], users: [] }).replace(/</g, '\\u003c') %></script>
<div class="modal fade" id="addGateAccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="POST" action="/admin/main-gate-access">
                <input type="hidden" name="returnBlock" value="<%= filters.block || '' %>">
                <input type="hidden" name="returnUnitNumber" value="<%= filters.unitNumber || '' %>">
                <input type="hidden" name="returnRelation" value="<%= filters.relation || '' %>">
                <input type="hidden" name="returnSearch" value="<%= filters.search || '' %>">
                <div class="modal-header">
                    <h5 class="modal-title">Add Main Gate Access</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="addGateAccessError" role="alert"></div>
                    <p class="text-muted small">This saves gate access and adds the phone to the SafeMate app.</p>
                    <div class="mb-3">
                        <label for="addApartmentSearch" class="form-label">Apartment</label>
                        <div class="position-relative">
                            <input type="text" class="form-control" id="addApartmentSearch" placeholder="A 12" autocomplete="off" required>
                            <input type="hidden" name="apartmentId" id="addApartmentId" value="">
                            <div class="list-group gate-access-suggest d-none" id="addApartmentResults"></div>
                        </div>
                        <small class="form-text text-muted">Type the block and number, for example A 12. The owner name is shown after it.</small>
                    </div>
                    <div class="mb-3">
                        <label for="addPersonSearch" class="form-label">Existing user</label>
                        <div class="position-relative">
                            <input type="text" class="form-control" id="addPersonSearch" placeholder="Search by name or phone" autocomplete="off">
                            <input type="hidden" name="userId" id="addUserId" value="">
                            <div class="list-group gate-access-suggest d-none" id="addPersonResults"></div>
                        </div>
                        <small class="form-text text-muted">Optional. Pick someone already in the CMS, or leave this blank and enter a new person below.</small>
                    </div>
                    <div class="mb-3">
                        <label for="addName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="addName" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="addPhone" class="form-label">Phone</label>
                        <input type="text" class="form-control" id="addPhone" name="phone" required>
                        <small class="form-text text-muted">This phone is the SafeMate app account.</small>
                    </div>
                    <div class="mb-3">
                        <label for="addEmail" class="form-label">Email</label>
                        <input type="text" class="form-control" id="addEmail" name="email">
                    </div>
                    <div class="mb-3">
                        <label for="addRelation" class="form-label">Relation to Apartment</label>
                        <select class="form-control" id="addRelation" name="relation" required>
                            <% (gateAccessRelations || ['Owner','Tenant','Family','Staff','Guest','Other']).forEach(function(rel) { %>
                              <option value="<%= rel %>" <%= rel === 'Family' ? 'selected' : '' %>><%= rel %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="addExpiryDate" class="form-label">Expiry Date</label>
                        <input type="date" class="form-control" id="addExpiryDate" name="expiryDate" />
                        <small class="form-text text-muted">Optional. Leave blank for no expiry.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Access</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editGateAccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editGateAccessForm" method="POST" action="">
                <input type="hidden" name="returnBlock" value="<%= filters.block || '' %>">
                <input type="hidden" name="returnUnitNumber" value="<%= filters.unitNumber || '' %>">
                <input type="hidden" name="returnRelation" value="<%= filters.relation || '' %>">
                <input type="hidden" name="returnSearch" value="<%= filters.search || '' %>">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Main Gate Access</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3">
                        <strong id="editGateAccessUserName"></strong>
                        <span class="text-muted"> — </span>
                        <span id="editGateAccessApartmentLabel" class="text-muted"></span>
                    </p>
                    <div class="mb-3">
                        <label for="editRelation" class="form-label">Relation to Apartment</label>
                        <select class="form-control" id="editRelation" name="relation" required>
                            <% (gateAccessRelations || ['Owner','Tenant','Family','Staff','Guest','Other']).forEach(function(rel) { %>
                              <option value="<%= rel %>"><%= rel %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editExpiryDate" class="form-label">Expiry Date</label>
                        <input type="date" class="form-control" id="editExpiryDate" name="expiryDate" />
                        <small class="form-text text-muted">Optional. Leave blank for no expiry.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="revokeGateAccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="revokeGateAccessForm" method="POST" action="">
                <input type="hidden" name="returnBlock" value="<%= filters.block || '' %>">
                <input type="hidden" name="returnUnitNumber" value="<%= filters.unitNumber || '' %>">
                <input type="hidden" name="returnRelation" value="<%= filters.relation || '' %>">
                <input type="hidden" name="returnSearch" value="<%= filters.search || '' %>">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="fas fa-ban"></i> Revoke Gate Access</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>
                        Revoke main gate access for <strong id="revokeGateAccessUserName"></strong>
                        on <span id="revokeGateAccessApartmentLabel"></span>?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Revoke Access</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.edit-gate-access-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var form = document.getElementById('editGateAccessForm');
            var nameEl = document.getElementById('editGateAccessUserName');
            var aptEl = document.getElementById('editGateAccessApartmentLabel');
            var relationEl = document.getElementById('editRelation');
            var expiryEl = document.getElementById('editExpiryDate');
            if (!form || !nameEl || !aptEl || !relationEl || !expiryEl) return;

            form.action = '/admin/main-gate-access/' + btn.dataset.apartmentId + '/' + btn.dataset.userId;
            nameEl.textContent = btn.dataset.userName || '';
            aptEl.textContent = btn.dataset.apartmentLabel || '';
            relationEl.value = btn.dataset.relation || 'Other';
            expiryEl.value = btn.dataset.expiryDate || '';

            var modal = new bootstrap.Modal(document.getElementById('editGateAccessModal'));
            modal.show();
        });
    });

    document.querySelectorAll('.revoke-gate-access-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var form = document.getElementById('revokeGateAccessForm');
            var nameEl = document.getElementById('revokeGateAccessUserName');
            var aptEl = document.getElementById('revokeGateAccessApartmentLabel');
            if (!form || !nameEl || !aptEl) return;

            form.action = '/admin/main-gate-access/' + btn.dataset.apartmentId + '/' + btn.dataset.userId + '/revoke';
            nameEl.textContent = btn.dataset.userName || '';
            aptEl.textContent = btn.dataset.apartmentLabel || '';

            var modal = new bootstrap.Modal(document.getElementById('revokeGateAccessModal'));
            modal.show();
        });
    });
});
</script>
<% } %>
