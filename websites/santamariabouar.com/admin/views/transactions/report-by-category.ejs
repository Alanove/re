
<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading no-print">
				<h4 class="panel-title">
					<i class="fa fa-tags me-2"></i>Transactions Report by Category
					<% if (typeof selectedYear !== 'undefined') { %>
						<small class="text-muted ms-2">(<%= selectedYear === 'all' ? 'All Years' : selectedYear %>)</small>
					<% } %>
				</h4>
				<div class="panel-heading-btn">
					<button type="button" class="btn btn-xs btn-primary" onclick="window.print()">
						<i class="fa fa-print"></i> Print
					</button>

				</div>
			</div>
			<div class="panel-body">
				<!-- Year filter -->
				<div class="card mb-4 no-print">
					<div class="card-body py-3">
						<form method="GET" action="<%= typeof reportUrl !== 'undefined' ? reportUrl : '/admin/reports/transactions-by-category' %>" class="row align-items-end g-3">
							<div class="col-auto">
								<label class="form-label mb-1"><i class="fa fa-calendar me-1"></i> Year</label>
								<select name="year" class="form-control" onchange="this.form.submit()">
									<option value="all" <%= selectedYear === 'all' ? 'selected' : '' %>>All Years</option>
									<% (availableYears || []).forEach(function(y) { %>
										<option value="<%= y %>" <%= selectedYear === String(y) ? 'selected' : '' %>><%= y %></option>
									<% }); %>
								</select>
							</div>
							<% if (type) { %><input type="hidden" name="type" value="<%= type %>"><% } %>
							<% if (categoryId) { %><input type="hidden" name="categoryId" value="<%= categoryId %>"><% } %>
							<% if (accountId) { %><input type="hidden" name="accountId" value="<%= accountId %>"><% } %>
							<% if (keyword) { %><input type="hidden" name="keyword" value="<%= keyword %>"><% } %>
							<% if (fromDate) { %><input type="hidden" name="fromDate" value="<%= fromDate %>"><% } %>
							<% if (toDate) { %><input type="hidden" name="toDate" value="<%= toDate %>"><% } %>
						</form>
					</div>
				</div>

				<!-- Filter info -->
				<% if ((selectedYear && selectedYear !== String(new Date().getFullYear())) || selectedYear === 'all' || (fromDate && fromDate !== '') || (toDate && toDate !== '') || (type && type !== '') || (keyword && keyword !== '')) { %>
				<div class="alert alert-info mb-4 no-print">
					<h5 class="mb-2"><i class="fa fa-filter me-2"></i>Applied Filters</h5>
					<div class="row">
						<% if (selectedYear) { %>
							<div class="col-md-3">
								<strong>Year:</strong>
								<%= selectedYear === 'all' ? 'All Years' : selectedYear %>
							</div>
						<% } %>
						<% if (fromDate || toDate) { %>
							<div class="col-md-3">
								<strong>Date Range:</strong> 
								<%= fromDate ? fromDate : 'Any' %> 
								<% if (fromDate && toDate) { %> to <% } %>
								<%= toDate ? toDate : 'Any' %>
							</div>
						<% } %>
						<% if (type) { %>
							<div class="col-md-2">
								<strong>Type:</strong> <%= type.charAt(0).toUpperCase() + type.slice(1) %>
							</div>
						<% } %>
						<% if (keyword) { %>
							<div class="col-md-3">
								<strong>Search:</strong> <%= keyword %>
							</div>
						<% } %>
						<div class="col-md-12 mt-2">
							<a href="<%= typeof reportUrl !== 'undefined' ? reportUrl : '/admin/reports/transactions-by-category' %>" class="btn btn-xs btn-default">
								<i class="fa fa-times me-1"></i> Clear Filters
							</a>
						</div>
					</div>
				</div>
				<% } %>

				<!-- Summary -->
				<div class="row mb-4">
					<div class="col-md-12">
						<div class="card bg-light">
							<div class="card-body">
								<h5 class="card-title">Report Summary</h5>
								<div class="row">
									<% 
									let totalIncome = 0;
									let totalExpense = 0;
									Object.keys(categoryTotals).forEach(cat => {
										totalIncome += categoryTotals[cat].income;
										totalExpense += categoryTotals[cat].expense;
									});
									const totalBalance = totalIncome - totalExpense;
									%>
									<div class="col-md-3">
										<strong>Total Income:</strong> 
										<span class="text-success">$<%= totalIncome.toFixed(2) %></span>
									</div>
									<div class="col-md-3">
										<strong>Total Expenses:</strong> 
										<span class="text-danger">$<%= totalExpense.toFixed(2) %></span>
									</div>
									<div class="col-md-3">
										<strong>Net Balance:</strong> 
										<span class="<%= totalBalance >= 0 ? 'text-success' : 'text-danger' %>">
											$<%= totalBalance.toFixed(2) %>
										</span>
									</div>
									<div class="col-md-3">
										<strong>Categories:</strong> <%= sortedCategories.length %>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Transactions grouped by category -->
				<% sortedCategories.forEach(categoryName => { 
					const transactions = groupedByCategory[categoryName];
					const totals = categoryTotals[categoryName];
				%>
					<div class="card mb-4">
						<div class="card-header" style="background-color: <%= totals.color %>; color: white;">
							<h4 class="mb-0" style="font-size: 1.5rem; font-weight: bold;">
								<i class="fa fa-tag me-2"></i><%= categoryName %>
								<span class="float-end" style="font-size: 1rem;">
									Income: $<%= totals.income.toFixed(2) %> | 
									Expenses: $<%= totals.expense.toFixed(2) %> | 
									Balance: $<%= totals.balance.toFixed(2) %>
								</span>
							</h4>
						</div>
						<div class="card-body p-0">
							<div class="table-responsive">
								<table class="table table-striped table-bordered mb-0">
									<thead>
										<tr>
											<th>Date</th>
											<th>Type</th>
											<th>Amount</th>
											<th>Description</th>
										</tr>
									</thead>
									<tbody>
										<% transactions.forEach(transaction => { %>
											<tr>
												<td><%= new Date(transaction.date).toLocaleDateString() %></td>
												<td>
													<% if (transaction.type === 'income') { %>
														<span class="badge bg-success">Income</span>
													<% } else { %>
														<span class="badge bg-danger">Expense</span>
													<% } %>
												</td>
												<td>
													<span class="fw-bold <%= transaction.type === 'income' ? 'text-success' : 'text-danger' %>">
														<%= transaction.type === 'income' ? '+' : '-' %>$<%= transaction.amount.toFixed(2) %>
													</span>
												</td>
												<td><%= transaction.description %></td>
											</tr>
										<% }); %>
									</tbody>
									<tfoot>
										<tr class="table-info">
											<td colspan="2"><strong>Category Total</strong></td>
											<td>
												<strong class="<%= totals.balance >= 0 ? 'text-success' : 'text-danger' %>">
													$<%= totals.balance.toFixed(2) %>
												</strong>
											</td>
											<td>
												<small>
													Income: $<%= totals.income.toFixed(2) %> | 
													Expenses: $<%= totals.expense.toFixed(2) %>
												</small>
											</td>
										</tr>
									</tfoot>
								</table>
							</div>
						</div>
					</div>
				<% }); %>

				<% if (sortedCategories.length === 0) { %>
					<div class="alert alert-warning text-center">
						<i class="fa fa-exclamation-triangle fa-3x mb-3"></i>
						<h5>No Transactions Found</h5>
						<p>No transactions match the applied filters.</p>
					</div>
				<% } %>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<style>
@media print {
	@page {
		size: A4;
		margin: 0.5in;
	}
	
	/* Force color printing */
	* {
		-webkit-print-color-adjust: exact !important;
		print-color-adjust: exact !important;
		color-adjust: exact !important;
	}
	
	/* Hide ONLY admin navigation elements */
	#app > .app-header,
	#app > .app-sidebar,
	.breadcrumb,
	.page-header,
	.no-print,
	.panel-heading,
	.alert {
		display: none !important;
	}
	
	/* Make app container full width */
	#app {
		margin: 0 !important;
		padding: 0 !important;
		width: 100% !important;
	}
	
	/* Make content area full width */
	#content.app-content {
		margin: 0 !important;
		padding: 0 !important;
		width: 100% !important;
		margin-left: 0 !important;
	}
	
	/* Full width containers */
	.container-fluid {
		margin: 0 !important;
		padding: 0 !important;
		width: 100% !important;
	}
	
	.row {
		margin: 0 !important;
		width: 100% !important;
	}
	
	.col-xl-12 {
		padding: 0 !important;
		width: 100% !important;
	}
	
	/* Panel styling */
	.panel {
		border: none !important;
		box-shadow: none !important;
		margin: 0 !important;
		padding: 0 !important;
	}
	
	.panel-body {
		padding: 0 !important;
		margin: 0 !important;
	}
	
	/* Card styling for print with colors */
	.card {
		page-break-inside: avoid;
		border: 1px solid #ddd !important;
		margin-bottom: 15px !important;
		box-shadow: none !important;
	}
	
	.card-header {
		/* Keep original background color */
		color: white !important;
		border-bottom: 2px solid #ddd !important;
		padding: 10px !important;
		font-weight: bold !important;
	}
	
	/* Table styling */
	.table {
		font-size: 11px !important;
		border-collapse: collapse !important;
		width: 100% !important;
	}
	
	.table th, .table td {
		padding: 6px !important;
		border: 1px solid #ddd !important;
	}
	
	/* Keep badge colors in print */
	.badge {
		padding: 4px 8px !important;
		font-weight: bold !important;
	}
	
	.badge.bg-success {
		background-color: #28a745 !important;
		color: white !important;
	}
	
	.badge.bg-danger {
		background-color: #dc3545 !important;
		color: white !important;
	}
	
	/* Summary cards with colors */
	.widget-stats {
		border: 1px solid #ddd !important;
		margin-bottom: 10px !important;
		padding: 15px !important;
	}
	
	.widget-stats.bg-success {
		background-color: #28a745 !important;
		color: white !important;
	}
	
	.widget-stats.bg-danger {
		background-color: #dc3545 !important;
		color: white !important;
	}
	
	.widget-stats.bg-info {
		background-color: #17a2b8 !important;
		color: white !important;
	}
	
	.widget-stats .stats-icon {
		display: none !important;
	}
	
	/* Keep text colors */
	.text-success {
		color: #28a745 !important;
	}
	
	.text-danger {
		color: #dc3545 !important;
	}
	
	.text-info {
		color: #17a2b8 !important;
	}
}
</style>

