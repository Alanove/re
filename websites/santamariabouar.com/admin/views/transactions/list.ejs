
<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title">Transactions Management</h4>
				<div class="panel-heading-btn">
					<a href="/admin/transactions/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> Add New Transaction
					</a>
				</div>
			</div>
			<div class="panel-body">
				<!-- BEGIN summary cards -->
				<div class="row mb-4">
					<div class="col-lg-3 col-md-6">
						<div class="widget widget-stats bg-success">
							<div class="stats-icon"><i class="fa fa-arrow-up"></i></div>
							<div class="stats-info">
								<h5>Total Income</h5>
								<h3 id="summaryIncome">$<%= (summary.totalIncome != null ? summary.totalIncome.toFixed(2) : '0.00') %></h3>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-6">
						<div class="widget widget-stats bg-danger">
							<div class="stats-icon"><i class="fa fa-arrow-down"></i></div>
							<div class="stats-info">
								<h5>Total Expenses</h5>
								<h3 id="summaryExpenses">$<%= (summary.totalExpenses != null ? summary.totalExpenses.toFixed(2) : '0.00') %></h3>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-6">
							<div class="widget widget-stats" id="summaryBalanceWidget" style="background-color: <%= (summary.balance != null && summary.balance >= 0) ? '#00acac' : '#ff5b57' %>;">
							<div class="stats-icon"><i class="fa fa-balance-scale"></i></div>
							<div class="stats-info">
								<h5>Net Balance</h5>
								<h3 id="summaryBalance">$<%= (summary.balance != null ? summary.balance.toFixed(2) : '0.00') %></h3>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-6">
						<div class="widget widget-stats bg-info">
							<div class="stats-icon"><i class="fa fa-list"></i></div>
							<div class="stats-info">
								<h5>Total Transactions</h5>
								<h3 id="summaryCount"><%= summary.transactionCount %></h3>
							</div>
						</div>
					</div>
				</div>
				<!-- END summary cards -->
				
				<!-- BEGIN filtered summary alert -->
				<div class="alert alert-info" id="filteredSummaryAlert" style="display: none;">
					<div class="d-flex align-items-center">
						<div class="flex-grow-1">
							<h5 class="mb-2"><i class="fa fa-filter me-2"></i>Filtered Results Summary</h5>
							<div class="row">
								<div class="col-md-3">
									<strong>Income:</strong> <span class="text-success" id="filteredIncome">$0.00</span>
								</div>
								<div class="col-md-3">
									<strong>Expenses:</strong> <span class="text-danger" id="filteredExpenses">$0.00</span>
								</div>
								<div class="col-md-3">
									<strong>Net Balance:</strong> <span id="filteredBalance">$0.00</span>
								</div>
								<div class="col-md-3">
									<strong>Transactions:</strong> <span id="filteredCount">0</span>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- END filtered summary alert -->

				<!-- BEGIN filters -->
				<div class="row mb-3">
					<div class="col-md-12">
						<div class="card border-primary">
							<div class="card-body py-3">
								<!-- Date and amount filters row -->
								<div class="row align-items-end mb-3">
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">
											<i class="fa fa-calendar me-1"></i> From Date
										</label>
										<input type="date" class="form-control" id="fromDateFilter" value="<%= typeof fromDate !== 'undefined' ? fromDate : '' %>" />
									</div>
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">
											<i class="fa fa-calendar me-1"></i> To Date
										</label>
										<input type="date" class="form-control" id="toDateFilter" value="<%= typeof toDate !== 'undefined' ? toDate : '' %>" />
									</div>
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">
											<i class="fa fa-dollar-sign me-1"></i> Amount From
										</label>
										<input type="number" class="form-control" id="amountFromFilter" min="0" step="0.01" placeholder="Min amount" />
									</div>
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">
											<i class="fa fa-dollar-sign me-1"></i> Amount To
										</label>
										<input type="number" class="form-control" id="amountToFilter" min="0" step="0.01" placeholder="Max amount" />
									</div>
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">&nbsp;</label>
										<button type="button" class="btn btn-primary w-100" id="applyDateFilter" title="Apply Date Filter">
											<i class="fa fa-filter me-1"></i> Apply Date Filter
										</button>
									</div>

								</div>
								
								<!-- Other filters row -->
								<div class="row align-items-end">
									<div class="col-md-3">
										<label class="form-label small text-muted mb-1">
											<i class="fa fa-search me-1"></i> Search
										</label>
										<div class="input-group">
											<button type="button" class="btn btn-outline-secondary" id="applyKeywordFilter" title="Search transactions">
												<i class="fa fa-search"></i>
											</button>
											<input type="text" class="form-control" id="keywordFilter" placeholder="Description, owner, apartment..." value="<%= typeof keyword !== 'undefined' ? keyword : '' %>" />
										</div>
									</div>
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">Type</label>
										<select class="form-select" id="typeFilter">
											<option value="">All Types (Exclude Transfer &amp; Wallet)</option>
											<option value="all_with_transfer">All Types (Including Transfer &amp; Wallet)</option>
											<option value="income">Income</option>
											<option value="expense">Expense</option>
											<option value="transfer">Transfer</option>
											<option value="wallet_adjustment">Wallet Adjustment</option>
									</select>
									</div>
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">Category</label>
										<select class="form-select" id="categoryFilter">
											<option value="">All Categories</option>
											<% if (typeof categories !== 'undefined' && categories) { %>
												<% categories.forEach(category => { %>
													<option value="<%= category.id %>"><%= category.name %></option>
												<% }); %>
											<% } %>
										</select>
									</div>
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">Account</label>
										<select class="form-select" id="accountFilter">
											<option value="">All Accounts</option>
											<% if (typeof accounts !== 'undefined' && accounts) { %>
												<% accounts.forEach(account => { %>
													<option value="<%= account.id %>"><%= account.name %></option>
												<% }); %>
											<% } %>
										</select>
									</div>
									<div class="col-md-2">
										<label class="form-label small text-muted mb-1">Per Page</label>
										<select class="form-select" id="perPageSelect">
											<option value="25">25 per page</option>
											<option value="50">50 per page</option>
											<option value="100" selected>100 per page</option>
											<option value="250">250 per page</option>
											<option value="500">500 per page</option>
											<option value="all">Show All</option>
										</select>
									</div>
									<div class="col-md-1">
										<label class="form-label small text-muted mb-1">&nbsp;</label>
										<button type="button" class="btn btn-secondary w-100" id="clearFilters" title="Clear Filters">
											<i class="fa fa-times"></i>
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- END filters -->

				<!-- BEGIN quick actions -->
				<div class="row mb-3">
					<div class="col-12">
						<div class="d-flex gap-2">
							<a href="/admin/transactions/create" class="btn btn-primary">
								<i class="fa fa-plus"></i> New Transaction
							</a>
							<a href="/admin/accounts" class="btn btn-info">
								<i class="fa fa-account"></i> Manage Accounts
							</a>
							<a href="/admin/transaction-categories" class="btn btn-secondary">
								<i class="fa fa-tags"></i> Manage Categories
							</a>
							<button type="button" id="generateCombinedBtn" class="btn btn-warning" style="display: none;">
								<i class="fa fa-receipt"></i> Generate Combined Receipt (<span id="selectedTxCount">0</span>)
							</button>
						</div>
					</div>
				</div>
				<!-- END quick actions -->

				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th width="1%">
									<input type="checkbox" id="selectAllTx" title="Select all visible income transactions">
								</th>
								<th>Type</th>
								<th class="sortable" data-sort="amount">
									Amount <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="description">
									Description <i class="fa fa-sort"></i>
								</th>
								<th>Category</th>
								<th>Account</th>
								<th>Apartment</th>
								<th>Owner</th>
								<th class="sortable" data-sort="date">
									Date <i class="fa fa-sort"></i>
								</th>
								<th>Created By</th>
								<th>Receipt</th>
								<th>Image</th>
								<th width="1%">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof transactions !== 'undefined' && transactions && transactions.length > 0) { %>
								<% transactions.forEach(transaction => { %>
									<tr data-transaction-id="<%= transaction.id %>" data-type="<%= transaction.type %>" data-account="<%= transaction.accountId %>" data-category="<%= transaction.categoryName.toLowerCase() %>" data-category-id="<%= transaction.categoryId %>" data-date="<%= transaction.date %>" data-amount="<%= transaction.amount != null ? transaction.amount : 0 %>" data-apartment="<%= transaction.apartmentNumber ? transaction.apartmentNumber.toLowerCase() : '' %>" data-owner="<%= transaction.apartmentOwnerName ? transaction.apartmentOwnerName.toLowerCase() : '' %>" data-owner-id="<%= transaction.apartmentOwnerId || '' %>">
										<td>
											<% if (transaction.type === 'income') { %>
												<input type="checkbox" class="tx-checkbox" value="<%= transaction.id %>">
											<% } %>
										</td>
										<td>
											<% if (transaction.type === 'income') { %>
												<span class="badge bg-success">
													<i class="fa fa-arrow-up me-1"></i> Income
												</span>
											<% } else { %>
												<span class="badge bg-danger">
													<i class="fa fa-arrow-down me-1"></i> Expense
												</span>
											<% } %>
										</td>
										<td>
											<span class="fw-bold <%= transaction.type === 'income' ? 'text-success' : 'text-danger' %>">
												<%= transaction.type === 'income' ? '+' : '-' %>$<%= (transaction.amount != null ? transaction.amount.toFixed(2) : '0.00') %>
											</span>
										</td>
										<td>
											<div class="d-flex align-items-center">
												<div class="flex-grow-1">
													<div class="fw-bold"><%= transaction.description %></div>
													<% if (transaction.notes) { %>
														<div class="fs-12px text-gray-500-darker"><%= transaction.notes %></div>
													<% } %>
												</div>
											</div>
										</td>
										<td>
											<span class="badge" style="background-color: <%= transaction.categoryColor %>;">
												<%= transaction.categoryName %>
											</span>
										</td>
										<td>
											<i class="fa fa-account me-1"></i>
											<%= transaction.accountName %>
										</td>
										<td>
											<% if (transaction.apartmentNumber) { %>
												<i class="fa fa-building me-1"></i>
												<%= transaction.apartmentNumber %>
											<% } else { %>
												<span class="text-muted">-</span>
											<% } %>
										</td>
										<td>
											<% if (transaction.apartmentOwnerName) { %>
												<i class="fa fa-user me-1"></i>
												<%= transaction.apartmentOwnerName %>
											<% } else { %>
												<span class="text-muted">-</span>
											<% } %>
										</td>
										<td>
											<%= new Date(transaction.date).toLocaleDateString() %>
										</td>
										<td>
											<i class="fa fa-user me-1"></i>
											<%= transaction.createdByName %>
										</td>
										<td>
											<% if (transaction.receiptGenerated) { %>
												<a href="/admin/transactions/<%= transaction.id %>/receipt" 
												   class="btn btn-xs btn-info" target="_blank" title="View Receipt">
													<i class="fa fa-receipt"></i>
												</a>
											<% } else { %>
												<span class="text-muted">-</span>
											<% } %>
										</td>
										<td>
											<% if (transaction.receiptImage) { %>
												<% if (transaction.receiptImage.endsWith('.pdf')) { %>
													<a href="<%= transaction.receiptImage %>" class="btn btn-xs btn-warning" target="_blank" title="View Receipt PDF">
														<i class="fa fa-file-pdf"></i> PDF
													</a>
												<% } else { %>
													<a href="<%= transaction.receiptImage %>" target="_blank" title="View Receipt Image">
														<img src="<%= transaction.receiptImage %>" alt="Receipt" style="max-width: 40px; max-height: 40px; cursor: pointer; border: 1px solid #ddd; border-radius: 3px;">
													</a>
												<% } %>
											<% } else { %>
												<span class="text-muted">-</span>
											<% } %>
										</td>
										<td>
											<div class="btn-group">
												<a href="/admin/transactions/<%= transaction.id %>/edit" class="btn btn-sm btn-primary">
													<i class="fa fa-edit"></i>
												</a>
												<button type="button" class="btn btn-sm btn-danger" onclick="deleteTransaction(<%= transaction.id %>, '<%= transaction.description %>')">
													<i class="fa fa-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="12" class="text-center text-muted py-4">
										<i class="fa fa-exchange-alt fa-3x mb-3"></i>
										<h5>No Transactions Found</h5>
										<p>Start tracking your finances by creating your first transaction.</p>
										<a href="/admin/transactions/create" class="btn btn-success">
											<i class="fa fa-plus"></i> Create First Transaction
										</a>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
				
				<!-- BEGIN pagination info and controls -->
				<div class="row mt-3">
					<div class="col-md-6">
						<div class="dataTables_info">
							Showing <span id="showingFrom">0</span> to <span id="showingTo">0</span> of <span id="totalVisible">0</span> transactions
							<span id="filteredInfo" style="display: none;">(filtered from <span id="totalAll">0</span> total)</span>
						</div>
					</div>
					<div class="col-md-6">
						<nav aria-label="Transaction pagination">
							<ul class="pagination justify-content-end mb-0" id="paginationControls">
								<!-- Pagination buttons will be inserted here -->
							</ul>
						</nav>
					</div>
				</div>
				<!-- END pagination info and controls -->
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<!-- BEGIN delete confirmation modal -->
<div class="modal fade delete-modal" id="deleteModal" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">
					<i class="fa fa-exclamation-triangle me-2"></i>
					Confirm Transaction Deletion
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<div class="warning-icon">
					<i class="fa fa-exclamation-triangle"></i>
				</div>
				<h5>Are you sure you want to delete this transaction?</h5>
				<p>This action cannot be undone. The transaction will be permanently removed and account balances will be affected.</p>
				
				<div class="transaction-info">
					<div class="transaction-description" id="deleteTransactionDesc"></div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
					<i class="fa fa-times me-1"></i> Cancel
				</button>
				<button type="button" class="btn btn-delete" id="deleteConfirmBtn">
					<i class="fa fa-trash me-1"></i> Delete Transaction
				</button>
			</div>
		</div>
	</div>
</div>
<!-- END delete confirmation modal -->

<!-- BEGIN page-js -->
<script>
	// Pagination and filtering state
	let currentPage = 1;
	let itemsPerPage = 100;
	let totalRows = 0;
	let visibleRows = [];

	// Sorting functionality
	document.addEventListener('DOMContentLoaded', function() {
		const sortableHeaders = document.querySelectorAll('.sortable');
		let currentSort = { column: null, direction: 'asc' };
		
		sortableHeaders.forEach(header => {
			header.addEventListener('click', function() {
				const column = this.dataset.sort;
				const table = this.closest('table');
				const tbody = table.querySelector('tbody');
				const rows = Array.from(tbody.querySelectorAll('tr'));
				
				// Remove active class from all headers
				sortableHeaders.forEach(h => h.classList.remove('active'));
				// Add active class to clicked header
				this.classList.add('active');
				
				// Toggle sort direction
				if (currentSort.column === column) {
					currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
				} else {
					currentSort.column = column;
					currentSort.direction = 'asc';
				}
				
				// Sort rows
				rows.sort((a, b) => {
					let aValue = a.querySelector(`td:nth-child(${getColumnIndex(column)})`).textContent.trim();
					let bValue = b.querySelector(`td:nth-child(${getColumnIndex(column)})`).textContent.trim();
					
					// Handle numeric values
					if (column === 'amount') {
						aValue = parseFloat(aValue.replace(/[^0-9.-]/g, '')) || 0;
						bValue = parseFloat(bValue.replace(/[^0-9.-]/g, '')) || 0;
					} else if (column === 'date') {
						aValue = new Date(aValue);
						bValue = new Date(bValue);
					}
					
					if (currentSort.direction === 'asc') {
						return aValue > bValue ? 1 : -1;
					} else {
						return aValue < bValue ? 1 : -1;
					}
				});
				
				// Re-append sorted rows
				rows.forEach(row => tbody.appendChild(row));
			});
		});
		
		function getColumnIndex(column) {
			const columns = {
				'amount': 3,
				'description': 4,
				'date': 9
			};
			return columns[column] || 1;
		}
		
		// Filter and pagination functionality
		const keywordFilter = document.getElementById('keywordFilter');
		const fromDateFilter = document.getElementById('fromDateFilter');
		const toDateFilter = document.getElementById('toDateFilter');
		const amountFromFilter = document.getElementById('amountFromFilter');
		const amountToFilter = document.getElementById('amountToFilter');
		const typeFilter = document.getElementById('typeFilter');
		const categoryFilter = document.getElementById('categoryFilter');
		const accountFilter = document.getElementById('accountFilter');
		const perPageSelect = document.getElementById('perPageSelect');
		const clearFilters = document.getElementById('clearFilters');
		const applyDateFilter = document.getElementById('applyDateFilter');
		const applyKeywordFilter = document.getElementById('applyKeywordFilter');
		
		function applyFilters() {
			const keyword = keywordFilter.value.trim().toLowerCase();
			const fromDate = fromDateFilter.value;
			const toDate = toDateFilter.value;
			const amountFrom = amountFromFilter.value !== '' ? parseFloat(amountFromFilter.value) : null;
			const amountTo = amountToFilter.value !== '' ? parseFloat(amountToFilter.value) : null;
			const type = typeFilter.value;
			const category = categoryFilter.value;
			const account = accountFilter.value;
			
			const rows = document.querySelectorAll('tbody tr');
			visibleRows = [];
			totalRows = 0;
			
			rows.forEach(row => {
				if (row.cells.length === 1) return; // Skip "no data" row
				
				totalRows++;
				const description = row.cells[3] ? row.cells[3].textContent.toLowerCase() : '';
				const apartment = row.dataset.apartment || '';
				const owner = row.dataset.owner || '';
				const rowType = row.dataset.type;
				const rowAccount = row.dataset.account;
				const rowCategory = row.dataset.category;
				const rowCategoryId = row.dataset.categoryId;
				
				// Get transaction date from data attribute (more reliable than parsing cell text)
				const transactionDateStr = row.dataset.date;
				const transactionDate = transactionDateStr ? new Date(transactionDateStr) : null;
				
				// Search in description, apartment, and owner
				const matchesKeyword = !keyword || 
					description.includes(keyword) || 
					apartment.includes(keyword) || 
					owner.includes(keyword);
				
				// Date filtering
				let matchesDate = true;
				if (fromDate && transactionDate) {
					const from = new Date(fromDate);
					from.setHours(0, 0, 0, 0);
					if (transactionDate < from) {
						matchesDate = false;
					}
				}
				if (toDate && transactionDate) {
					const to = new Date(toDate);
					to.setHours(23, 59, 59, 999);
					if (transactionDate > to) {
						matchesDate = false;
					}
				}
				
				// Handle type filtering with special transfer / wallet adjustment logic
				const isBookkeepingOnly = rowCategory === 'transfer' || rowCategory === 'wallet adjustment';
				let matchesType;
				if (!type) {
					// "All Types" - show everything EXCEPT transfers and wallet adjustments
					matchesType = !isBookkeepingOnly;
				} else if (type === 'all_with_transfer') {
					// "All Types (Including Transfer & Wallet)" - show everything
					matchesType = true;
				} else if (type === 'transfer') {
					// "Transfer" selected - show only transfers
					matchesType = rowCategory === 'transfer';
				} else if (type === 'wallet_adjustment') {
					// "Wallet Adjustment" selected - show only wallet adjustments
					matchesType = rowCategory === 'wallet adjustment';
				} else {
					// "Income" or "Expense" selected - match type but exclude transfers and wallet adjustments
					matchesType = rowType === type && !isBookkeepingOnly;
				}
				
				const matchesCategory = !category || rowCategoryId === category;
				const matchesAccount = !account || rowAccount === account;

				const rowAmount = parseFloat(row.dataset.amount) || 0;
				let matchesAmount = true;
				if (amountFrom !== null && !isNaN(amountFrom) && rowAmount < amountFrom) {
					matchesAmount = false;
				}
				if (amountTo !== null && !isNaN(amountTo) && rowAmount > amountTo) {
					matchesAmount = false;
				}
				
				if (matchesKeyword && matchesDate && matchesType && matchesCategory && matchesAccount && matchesAmount) {
					visibleRows.push(row);
				}
			});
			
			// Reset to page 1 when filters change
			currentPage = 1;
			updatePagination();
		}
		
		function updatePagination() {
			const totalVisible = visibleRows.length;
			const perPage = perPageSelect.value === 'all' ? totalVisible : parseInt(perPageSelect.value);
			itemsPerPage = perPage;
			
			const totalPages = Math.ceil(totalVisible / itemsPerPage);
			
			// Ensure current page is within bounds
			if (currentPage > totalPages) currentPage = totalPages || 1;
			
			const startIndex = (currentPage - 1) * itemsPerPage;
			const endIndex = perPageSelect.value === 'all' ? totalVisible : Math.min(startIndex + itemsPerPage, totalVisible);
			
			// Hide all rows first
			const allRows = document.querySelectorAll('tbody tr');
			allRows.forEach(row => {
				if (row.cells.length > 1) row.style.display = 'none';
			});
			
			// Show only rows for current page
			for (let i = startIndex; i < endIndex; i++) {
				if (visibleRows[i]) {
					visibleRows[i].style.display = '';
				}
			}
			
			// Update pagination info
			document.getElementById('showingFrom').textContent = totalVisible > 0 ? startIndex + 1 : 0;
			document.getElementById('showingTo').textContent = endIndex;
			document.getElementById('totalVisible').textContent = totalVisible;
			document.getElementById('totalAll').textContent = totalRows;
			
			// Show/hide filtered info
			const filteredInfo = document.getElementById('filteredInfo');
			if (totalVisible < totalRows) {
				filteredInfo.style.display = 'inline';
			} else {
				filteredInfo.style.display = 'none';
			}
			
			// Update filtered summary
			updateFilteredSummary();
			
			// Update pagination controls
			renderPaginationControls(totalPages);
		}
		
		function updateFilteredSummary() {
			// Calculate totals for visible rows only
			let filteredIncome = 0;
			let filteredExpenses = 0;
			
			visibleRows.forEach(row => {
				const type = row.dataset.type;
				const category = row.dataset.category;
				
				// Skip transfers in calculations (consistent with server-side logic)
				if (category === 'transfer') return;
				
				// Get amount from the row (third column, after checkbox and type)
				// The format is like "+$123.45" or "-$123.45"
				const amountText = row.cells[2].textContent.trim();
				// Remove everything except digits and decimal point
				const amount = parseFloat(amountText.replace(/[^0-9.]/g, '')) || 0;
				
				if (type === 'income') {
					filteredIncome += amount;
				} else if (type === 'expense') {
					filteredExpenses += amount;
				}
			});
			
			const filteredBalance = filteredIncome - filteredExpenses;
			const filteredCount = visibleRows.length;
			
			// Check if any filters are active
			const hasActiveFilters = 
				keywordFilter.value !== '' || 
				fromDateFilter.value !== '' ||
				toDateFilter.value !== '' ||
				amountFromFilter.value !== '' ||
				amountToFilter.value !== '' ||
				typeFilter.value !== '' || 
				categoryFilter.value !== '' || 
				accountFilter.value !== '';
			
			// Update filtered summary alert
			const filteredSummaryAlert = document.getElementById('filteredSummaryAlert');
			
			if (hasActiveFilters) {
				// Show filtered summary
				filteredSummaryAlert.style.display = 'block';
				document.getElementById('filteredIncome').textContent = '$' + filteredIncome.toFixed(2);
				document.getElementById('filteredExpenses').textContent = '$' + filteredExpenses.toFixed(2);
				
				const balanceSpan = document.getElementById('filteredBalance');
				balanceSpan.textContent = '$' + filteredBalance.toFixed(2);
				balanceSpan.className = filteredBalance >= 0 ? 'text-success' : 'text-danger';
				
				document.getElementById('filteredCount').textContent = filteredCount;
			} else {
				// Hide filtered summary and update main summary cards
				filteredSummaryAlert.style.display = 'none';
				
				// Update main summary cards with current totals
				document.getElementById('summaryIncome').textContent = '$' + filteredIncome.toFixed(2);
				document.getElementById('summaryExpenses').textContent = '$' + filteredExpenses.toFixed(2);
				document.getElementById('summaryBalance').textContent = '$' + filteredBalance.toFixed(2);
				document.getElementById('summaryCount').textContent = filteredCount;
				
				// Update balance widget color
				const balanceWidget = document.getElementById('summaryBalanceWidget');
				balanceWidget.style.backgroundColor = filteredBalance >= 0 ? '#00acac' : '#ff5b57';
			}
		}
		
		function renderPaginationControls(totalPages) {
			const paginationControls = document.getElementById('paginationControls');
			paginationControls.innerHTML = '';
			
			if (totalPages <= 1 || perPageSelect.value === 'all') {
				return; // No pagination needed
			}
			
			// Previous button
			const prevLi = document.createElement('li');
			prevLi.className = 'page-item' + (currentPage === 1 ? ' disabled' : '');
			prevLi.innerHTML = '<a class="page-link" href="#" data-page="prev"><i class="fa fa-chevron-left"></i></a>';
			paginationControls.appendChild(prevLi);
			
			// Page numbers
			const maxPagesToShow = 7;
			let startPage = Math.max(1, currentPage - Math.floor(maxPagesToShow / 2));
			let endPage = Math.min(totalPages, startPage + maxPagesToShow - 1);
			
			if (endPage - startPage < maxPagesToShow - 1) {
				startPage = Math.max(1, endPage - maxPagesToShow + 1);
			}
			
			// First page
			if (startPage > 1) {
				const firstLi = document.createElement('li');
				firstLi.className = 'page-item';
				firstLi.innerHTML = '<a class="page-link" href="#" data-page="1">1</a>';
				paginationControls.appendChild(firstLi);
				
				if (startPage > 2) {
					const dotsLi = document.createElement('li');
					dotsLi.className = 'page-item disabled';
					dotsLi.innerHTML = '<a class="page-link" href="#">...</a>';
					paginationControls.appendChild(dotsLi);
				}
			}
			
			// Page numbers
			for (let i = startPage; i <= endPage; i++) {
				const pageLi = document.createElement('li');
				pageLi.className = 'page-item' + (i === currentPage ? ' active' : '');
				pageLi.innerHTML = '<a class="page-link" href="#" data-page="' + i + '">' + i + '</a>';
				paginationControls.appendChild(pageLi);
			}
			
			// Last page
			if (endPage < totalPages) {
				if (endPage < totalPages - 1) {
					const dotsLi = document.createElement('li');
					dotsLi.className = 'page-item disabled';
					dotsLi.innerHTML = '<a class="page-link" href="#">...</a>';
					paginationControls.appendChild(dotsLi);
				}
				
				const lastLi = document.createElement('li');
				lastLi.className = 'page-item';
				lastLi.innerHTML = '<a class="page-link" href="#" data-page="' + totalPages + '">' + totalPages + '</a>';
				paginationControls.appendChild(lastLi);
			}
			
			// Next button
			const nextLi = document.createElement('li');
			nextLi.className = 'page-item' + (currentPage === totalPages ? ' disabled' : '');
			nextLi.innerHTML = '<a class="page-link" href="#" data-page="next"><i class="fa fa-chevron-right"></i></a>';
			paginationControls.appendChild(nextLi);
			
			// Add click handlers
			paginationControls.querySelectorAll('.page-link').forEach(link => {
				link.addEventListener('click', function(e) {
					e.preventDefault();
					const page = this.dataset.page;
					
					if (page === 'prev' && currentPage > 1) {
						currentPage--;
					} else if (page === 'next' && currentPage < totalPages) {
						currentPage++;
					} else if (page !== 'prev' && page !== 'next') {
						currentPage = parseInt(page);
					}
					
					updatePagination();
				});
			});
		}
		
		// Event listeners
		[typeFilter, categoryFilter, accountFilter].forEach(filter => {
			filter.addEventListener('input', applyFilters);
		});
		
		// Date and amount filters - apply on change for client-side filtering
		[fromDateFilter, toDateFilter, amountFromFilter, amountToFilter].forEach(filter => {
			filter.addEventListener('input', applyFilters);
			filter.addEventListener('change', applyFilters);
		});
		
		function applyServerFilters() {
			const fromDate = fromDateFilter.value;
			const toDate = toDateFilter.value;
			const keyword = keywordFilter.value.trim();
			
			const url = new URL(window.location.href);
			
			if (fromDate) {
				url.searchParams.set('fromDate', fromDate);
			} else {
				url.searchParams.delete('fromDate');
			}
			
			if (toDate) {
				url.searchParams.set('toDate', toDate);
			} else {
				url.searchParams.delete('toDate');
			}

			if (keyword) {
				url.searchParams.set('keyword', keyword);
			} else {
				url.searchParams.delete('keyword');
			}
			
			window.location.href = url.toString();
		}

		// Keyword and date filters reload the page so matching happens in the database.
		applyDateFilter.addEventListener('click', applyServerFilters);
		applyKeywordFilter.addEventListener('click', applyServerFilters);
		keywordFilter.addEventListener('keydown', function(event) {
			if (event.key === 'Enter') {
				event.preventDefault();
				applyServerFilters();
			}
		});
		
		perPageSelect.addEventListener('change', function() {
			currentPage = 1;
			updatePagination();
		});
		
		clearFilters.addEventListener('click', function() {
			keywordFilter.value = '';
			fromDateFilter.value = '';
			toDateFilter.value = '';
			amountFromFilter.value = '';
			amountToFilter.value = '';
			typeFilter.value = '';
			categoryFilter.value = '';
			accountFilter.value = '';
			
			// Clear URL parameters and reload
			const url = new URL(window.location.href);
			url.searchParams.delete('fromDate');
			url.searchParams.delete('toDate');
			url.searchParams.delete('keyword');
			window.location.href = url.toString();
		});
		
		// Apply filters on page load to hide transfers by default
		applyFilters();
		
		// Report buttons
		const reportByCategory = document.getElementById('reportByCategory');
		const reportChronological = document.getElementById('reportChronological');
		
		reportByCategory.addEventListener('click', function() {
			generateReport('by-category');
		});
		
		reportChronological.addEventListener('click', function() {
			generateReport('chronological');
		});
	});

	function generateReport(reportType) {
		// Get all current filter values
		const fromDate = document.getElementById('fromDateFilter').value;
		const toDate = document.getElementById('toDateFilter').value;
		const amountFrom = document.getElementById('amountFromFilter').value;
		const amountTo = document.getElementById('amountToFilter').value;
		const type = document.getElementById('typeFilter').value;
		const category = document.getElementById('categoryFilter').value;
		const account = document.getElementById('accountFilter').value;
		const keyword = document.getElementById('keywordFilter').value;
		
		// Build URL with query parameters
		const url = new URL(`/admin/transactions/report/${reportType}`, window.location.origin);
		
		if (fromDate) url.searchParams.set('fromDate', fromDate);
		if (toDate) url.searchParams.set('toDate', toDate);
		if (amountFrom) url.searchParams.set('amountFrom', amountFrom);
		if (amountTo) url.searchParams.set('amountTo', amountTo);
		if (type) url.searchParams.set('type', type);
		if (category) url.searchParams.set('categoryId', category);
		if (account) url.searchParams.set('accountId', account);
		if (keyword) url.searchParams.set('keyword', keyword);
		
		// Open report in new window
		window.open(url.toString(), '_blank');
	}

	document.addEventListener('DOMContentLoaded', function() {
		const selectAllTx = document.getElementById('selectAllTx');
		const generateCombinedBtn = document.getElementById('generateCombinedBtn');
		const selectedTxCount = document.getElementById('selectedTxCount');
		
		function updateCombinedReceiptButton() {
			const visibleCheckboxes = Array.from(document.querySelectorAll('tbody tr:not([style*="display: none"]) .tx-checkbox'));
			const selectedCheckboxes = visibleCheckboxes.filter(cb => cb.checked);
			
			if (selectedCheckboxes.length > 1) {
				generateCombinedBtn.style.display = 'inline-block';
				selectedTxCount.textContent = selectedCheckboxes.length;
			} else {
				generateCombinedBtn.style.display = 'none';
			}
			
			if (selectAllTx && visibleCheckboxes.length > 0) {
				selectAllTx.checked = selectedCheckboxes.length === visibleCheckboxes.length;
			}
		}
		
		if (selectAllTx) {
			selectAllTx.addEventListener('change', function() {
				const visibleCheckboxes = document.querySelectorAll('tbody tr:not([style*="display: none"]) .tx-checkbox');
				visibleCheckboxes.forEach(cb => {
					cb.checked = this.checked;
				});
				updateCombinedReceiptButton();
			});
		}
		
		document.querySelector('table').addEventListener('change', function(e) {
			if (e.target && e.target.classList.contains('tx-checkbox')) {
				updateCombinedReceiptButton();
			}
		});
		
		if (generateCombinedBtn) {
			generateCombinedBtn.addEventListener('click', function() {
				const selectedCheckboxes = Array.from(document.querySelectorAll('tbody tr:not([style*="display: none"]) .tx-checkbox')).filter(cb => cb.checked);
				
				if (selectedCheckboxes.length < 2) {
					alert('Please select at least 2 transactions to generate a combined receipt.');
					return;
				}
				
				let selectedOwnerId = null;
				let isValid = true;
				const transactionIds = [];
				
				for (let i = 0; i < selectedCheckboxes.length; i++) {
					const cb = selectedCheckboxes[i];
					const row = cb.closest('tr');
					const ownerId = row.dataset.ownerId;
					const owner = row.dataset.owner;
					
					if (!ownerId || !owner || owner.trim() === '') {
						alert('All selected transactions must be assigned to an apartment with an owner to generate a combined receipt.');
						isValid = false;
						break;
					}
					
					if (i === 0) {
						selectedOwnerId = ownerId;
					} else if (ownerId !== selectedOwnerId) {
						alert('All selected transactions must belong to the same owner.');
						isValid = false;
						break;
					}
					
					transactionIds.push(cb.value);
				}
				
				if (isValid) {
					const originalText = generateCombinedBtn.innerHTML;
					generateCombinedBtn.disabled = true;
					generateCombinedBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Generating...';
					
					fetch('/admin/transactions/generate-combined-receipt', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify({ transactionIds })
					})
					.then(response => response.json())
					.then(result => {
						if (result.success) {
							window.open(result.receiptUrl, '_blank');
							setTimeout(() => location.reload(), 1000);
						} else {
							alert(result.message || 'Error generating receipt.');
							generateCombinedBtn.disabled = false;
							generateCombinedBtn.innerHTML = originalText;
						}
					})
					.catch(error => {
						console.error('Error:', error);
						alert('Error generating receipt.');
						generateCombinedBtn.disabled = false;
						generateCombinedBtn.innerHTML = originalText;
					});
				}
			});
		}
		
		// Hook into filtering
		const filters = document.querySelectorAll('#keywordFilter, #typeFilter, #categoryFilter, #accountFilter, #fromDateFilter, #toDateFilter, #amountFromFilter, #amountToFilter');
		filters.forEach(f => {
			f.addEventListener('input', () => setTimeout(updateCombinedReceiptButton, 100));
			f.addEventListener('change', () => setTimeout(updateCombinedReceiptButton, 100));
		});
		
		const perPageSelect = document.getElementById('perPageSelect');
		if (perPageSelect) {
			perPageSelect.addEventListener('change', () => setTimeout(updateCombinedReceiptButton, 100));
		}
		
		const paginationControls = document.getElementById('paginationControls');
		if (paginationControls) {
			paginationControls.addEventListener('click', () => setTimeout(updateCombinedReceiptButton, 100));
		}
	});

	function deleteTransaction(id, description) {
		// Set modal content
		document.getElementById('deleteTransactionDesc').textContent = description;
		
		// Show modal
		const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
		modal.show();
		
		// Handle delete confirmation
		document.getElementById('deleteConfirmBtn').onclick = async function() {
			try {
				const response = await fetch(`/admin/transactions/${id}`, {
					method: 'DELETE',
					headers: {
						'Content-Type': 'application/json'
					}
				});

				const result = await response.json();

				if (result.success) {
					location.reload();
				} else {
					alert('Error: ' + result.message);
				}
			} catch (error) {
				console.error('Error deleting transaction:', error);
				alert('Error deleting transaction. Please try again.');
			}
		};
	}
</script>
