
<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading no-print">
				<h4 class="panel-title">
					<i class="fa fa-calendar me-2"></i>Chronological Transactions Report
					<% if (typeof selectedYear !== 'undefined') { %>
						<small class="text-muted ms-2">(<%= selectedYear === 'all' ? 'All Years' : selectedYear %>)</small>
					<% } %>
				</h4>
				<div class="panel-heading-btn">
					<button type="button" class="btn btn-xs btn-primary" onclick="window.print()">
						<i class="fa fa-print"></i> Print
					</button>

				</div>
			</div>
			<div class="panel-body">
				<!-- Year filter -->
				<div class="card mb-4 no-print">
					<div class="card-body py-3">
						<form method="GET" action="<%= typeof reportUrl !== 'undefined' ? reportUrl : '/admin/reports/transactions-chronological' %>" class="row align-items-end g-3">
							<div class="col-auto">
								<label class="form-label mb-1"><i class="fa fa-calendar me-1"></i> Year</label>
								<select name="year" class="form-control" onchange="this.form.submit()">
									<option value="all" <%= selectedYear === 'all' ? 'selected' : '' %>>All Years</option>
									<% (availableYears || []).forEach(function(y) { %>
										<option value="<%= y %>" <%= selectedYear === String(y) ? 'selected' : '' %>><%= y %></option>
									<% }); %>
								</select>
							</div>
							<% if (type) { %><input type="hidden" name="type" value="<%= type %>"><% } %>
							<% if (categoryId) { %><input type="hidden" name="categoryId" value="<%= categoryId %>"><% } %>
							<% if (accountId) { %><input type="hidden" name="accountId" value="<%= accountId %>"><% } %>
							<% if (keyword) { %><input type="hidden" name="keyword" value="<%= keyword %>"><% } %>
							<% if (fromDate) { %><input type="hidden" name="fromDate" value="<%= fromDate %>"><% } %>
							<% if (toDate) { %><input type="hidden" name="toDate" value="<%= toDate %>"><% } %>
						</form>
					</div>
				</div>

				<!-- Filter info -->
				<% if ((selectedYear && selectedYear !== String(new Date().getFullYear())) || selectedYear === 'all' || (fromDate && fromDate !== '') || (toDate && toDate !== '') || (type && type !== '') || (keyword && keyword !== '')) { %>
				<div class="alert alert-info mb-4 no-print">
					<h5 class="mb-2"><i class="fa fa-filter me-2"></i>Applied Filters</h5>
					<div class="row">
						<% if (selectedYear) { %>
							<div class="col-md-3">
								<strong>Year:</strong>
								<%= selectedYear === 'all' ? 'All Years' : selectedYear %>
							</div>
						<% } %>
						<% if (fromDate || toDate) { %>
							<div class="col-md-3">
								<strong>Date Range:</strong> 
								<%= fromDate ? fromDate : 'Any' %> 
								<% if (fromDate && toDate) { %> to <% } %>
								<%= toDate ? toDate : 'Any' %>
							</div>
						<% } %>
						<% if (type) { %>
							<div class="col-md-2">
								<strong>Type:</strong> <%= type.charAt(0).toUpperCase() + type.slice(1) %>
							</div>
						<% } %>
						<% if (keyword) { %>
							<div class="col-md-3">
								<strong>Search:</strong> <%= keyword %>
							</div>
						<% } %>
						<div class="col-md-12 mt-2">
							<a href="<%= typeof reportUrl !== 'undefined' ? reportUrl : '/admin/reports/transactions-chronological' %>" class="btn btn-xs btn-default">
								<i class="fa fa-times me-1"></i> Clear Filters
							</a>
						</div>
					</div>
				</div>
				<% } %>

				<!-- Summary -->
				<div class="row mb-4 g-0">
					<div class="col-3" style="padding: 0 2px;">
						<div class="widget widget-stats bg-success">
							<div class="stats-icon"><i class="fa fa-arrow-up"></i></div>
							<div class="stats-info">
								<h5>Total Income</h5>
								<h3>$<%= totalIncome.toFixed(2) %></h3>
							</div>
						</div>
					</div>
					<div class="col-3" style="padding: 0 2px;">
						<div class="widget widget-stats bg-danger">
							<div class="stats-icon"><i class="fa fa-arrow-down"></i></div>
							<div class="stats-info">
								<h5>Total Expenses</h5>
								<h3>$<%= totalExpenses.toFixed(2) %></h3>
							</div>
						</div>
					</div>
					<div class="col-3" style="padding: 0 2px;">
						<div class="widget widget-stats" style="background-color: <%= balance >= 0 ? '#00acac' : '#ff5b57' %>;">
							<div class="stats-icon"><i class="fa fa-balance-scale"></i></div>
							<div class="stats-info">
								<h5>Net Balance</h5>
								<h3>$<%= balance.toFixed(2) %></h3>
							</div>
						</div>
					</div>
					<div class="col-3" style="padding: 0 2px;">
						<div class="widget widget-stats bg-info">
							<div class="stats-icon"><i class="fa fa-list"></i></div>
							<div class="stats-info">
								<h5>Total Transactions</h5>
								<h3><%= transactionCount %></h3>
							</div>
						</div>
					</div>
				</div>

				<!-- Transactions table -->
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th>Date</th>
								<th>Type</th>
								<th>Amount</th>
								<th>Description</th>
								<th>Category</th>
							</tr>
						</thead>
						<tbody>
							<% if (transactions && transactions.length > 0) { %>
								<% transactions.forEach(transaction => { %>
									<tr>
										<td><%= new Date(transaction.date).toLocaleDateString() %></td>
										<td>
											<% if (transaction.type === 'income') { %>
												<span class="badge bg-success">
													<i class="fa fa-arrow-up me-1"></i> Income
												</span>
											<% } else { %>
												<span class="badge bg-danger">
													<i class="fa fa-arrow-down me-1"></i> Expense
												</span>
											<% } %>
										</td>
										<td>
											<span class="fw-bold <%= transaction.type === 'income' ? 'text-success' : 'text-danger' %>">
												<%= transaction.type === 'income' ? '+' : '-' %>$<%= transaction.amount.toFixed(2) %>
											</span>
										</td>
										<td><%= transaction.description %></td>
										<td>
											<span style="color: <%= transaction.categoryColor %>; font-size: 1.1rem; font-weight: bold;">
												<%= transaction.categoryName %>
											</span>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="5" class="text-center text-muted py-4">
										<i class="fa fa-exchange-alt fa-3x mb-3"></i>
										<h5>No Transactions Found</h5>
										<p>No transactions match the applied filters.</p>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<style>
@media print {
	@page {
		size: A4;
		margin: 0.5in;
	}
	
	/* Force color printing */
	* {
		-webkit-print-color-adjust: exact !important;
		print-color-adjust: exact !important;
		color-adjust: exact !important;
	}
	
	/* Hide ONLY admin navigation elements */
	#app > .app-header,
	#app > .app-sidebar,
	.breadcrumb,
	.page-header,
	.no-print,
	.panel-heading,
	.alert {
		display: none !important;
	}
	
	/* Make app container full width */
	#app {
		margin: 0 !important;
		padding: 0 !important;
		width: 100% !important;
	}
	
	/* Make content area full width */
	#content.app-content {
		margin: 0 !important;
		padding: 0 !important;
		width: 100% !important;
		margin-left: 0 !important;
	}
	
	/* Full width containers */
	.container-fluid {
		margin: 0 !important;
		padding: 0 !important;
		width: 100% !important;
	}
	
	.row {
		margin: 0 !important;
		width: 100% !important;
	}
	
	.col-xl-12 {
		padding: 0 !important;
		width: 100% !important;
	}
	
	/* Panel styling */
	.panel {
		border: none !important;
		box-shadow: none !important;
		margin: 0 !important;
		padding: 0 !important;
	}
	
	.panel-body {
		padding: 0 !important;
		margin: 0 !important;
	}
	
	/* Summary cards with colors */
	.widget-stats {
		border: 1px solid #ddd !important;
		margin-bottom: 10px !important;
		padding: 15px !important;
		page-break-inside: avoid;
	}
	
	.widget-stats.bg-success {
		background-color: #28a745 !important;
		color: white !important;
	}
	
	.widget-stats.bg-danger {
		background-color: #dc3545 !important;
		color: white !important;
	}
	
	.widget-stats.bg-info {
		background-color: #17a2b8 !important;
		color: white !important;
	}
	
	.widget-stats[style*="background-color"] {
		/* Keep inline background colors */
		color: white !important;
	}
	
	.widget-stats .stats-icon {
		display: none !important;
	}
	
	/* Table styling - smaller for print */
	.table {
		font-size: 9px !important;
		border-collapse: collapse !important;
		width: 100% !important;
	}
	
	.table th {
		padding: 4px 6px !important;
		border: 1px solid #ddd !important;
		font-size: 9px !important;
		font-weight: bold !important;
		background-color: #f8f9fa !important;
	}
	
	.table td {
		padding: 4px 6px !important;
		border: 1px solid #ddd !important;
		font-size: 9px !important;
	}
	
	/* Keep badge colors in print - much smaller size */
	.badge {
		padding: 2px 5px !important;
		font-weight: bold !important;
		font-size: 8px !important;
		line-height: 1.2 !important;
	}
	
	.badge.bg-success {
		background-color: #28a745 !important;
		color: white !important;
	}
	
	.badge.bg-danger {
		background-color: #dc3545 !important;
		color: white !important;
	}
	
	/* Category text - smaller in print */
	td span[style*="color"] {
		font-size: 9px !important;
		font-weight: bold !important;
	}
	
	.badge[style*="background-color"] {
		/* Keep inline background colors for category badges */
		color: white !important;
	}
	
	/* Summary cards - much smaller in print */
	.widget-stats {
		padding: 8px !important;
		margin-bottom: 6px !important;
		border: 1px solid #ddd !important;
	}
	
	.widget-stats h3 {
		font-size: 14px !important;
		margin: 0 !important;
		line-height: 1.2 !important;
	}
	
	.widget-stats h5 {
		font-size: 9px !important;
		margin: 0 0 3px 0 !important;
		line-height: 1.2 !important;
	}
	
	/* Make summary row smaller */
	.row.mb-4 {
		margin-bottom: 8px !important;
	}
	
	.col-lg-3, .col-md-6 {
		padding: 0 4px !important;
	}
	
	/* Keep text colors */
	.text-success {
		color: #28a745 !important;
	}
	
	.text-danger {
		color: #dc3545 !important;
	}
	
	.text-info {
		color: #17a2b8 !important;
	}
}
</style>

