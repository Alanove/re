
<style>
.special-category-section {
    display: none;
    background: #f8f9fa;
    padding: 15px;
    border-radius: 8px;
    margin-top: 15px;
    border: 1px solid #dee2e6;
}

.apartment-selection {
    max-height: 200px;
    overflow-y: auto;
    border: 1px solid #ced4da;
    padding: 10px;
    border-radius: 4px;
}

.apartment-item {
    padding: 8px;
    border-bottom: 1px solid #eee;
}

.apartment-item:last-child {
    border-bottom: none;
}

.category-indicator {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-block;
    margin-right: 8px;
}
</style>

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Create Transaction</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/admin/transactions">Transactions</a></li>
                        <li class="breadcrumb-item active">Create</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Transaction Details</h3>
                        </div>
                        <form id="transactionForm" action="/admin/transactions/create" method="POST" enctype="multipart/form-data">
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="categoryId">Category *</label>
                                    <select class="form-control" id="categoryId" name="categoryId" required>
                                        <option value="">Select a category</option>
                                        <% categories.forEach(category => { %>
                                            <option value="<%= category.id %>" 
                                                    data-type="<%= category.type %>" 
                                                    data-color="<%= category.color %>"
                                                    data-name="<%= category.name.toLowerCase() %>">
                                                <span class="category-indicator" style="background-color: <%= category.color %>;"></span>
                                                <%= category.name %> 
                                                <% if (category.type === 'income') { %>
                                                    (+)
                                                <% } else if (category.type === 'expense') { %>
                                                    (-)
                                                <% } else { %>
                                                    (+/-)
                                                <% } %>
                                            </option>
                                        <% }); %>
                                    </select>
                                    <small class="form-text text-muted">Choose the category that best describes this transaction</small>
                                </div>

                                <div class="form-group">
                                    <label for="amount">Total Amount *</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">$</span>
                                        </div>
                                        <input type="number" step="0.01" min="0" class="form-control" id="amount" 
                                               name="amount" required placeholder="0.00">
                                    </div>
                                    <small class="form-text text-muted" id="amountHelpText"></small>
                                </div>

                                <!-- Transaction Type for 'both' categories -->
                                <div class="form-group" id="transactionTypeGroup" style="display: none;">
                                    <label for="transactionType">Transaction Type *</label>
                                    <select class="form-control" id="transactionType" name="transactionType">
                                        <option value="income">Income (+)</option>
                                        <option value="expense">Expense (-)</option>
                                    </select>
                                    <small class="form-text text-muted">Choose whether this adds or removes money from the account</small>
                                </div>

                                <div class="form-group">
                                    <label for="description">Description <span id="descriptionRequired">*</span></label>
                                    <textarea class="form-control" id="description" name="description" rows="3" 
                                              required placeholder="Describe this transaction..."></textarea>
                                </div>

                                <div class="form-group">
                                    <label for="date">Date *</label>
                                    <input type="date" class="form-control" id="date" name="date" required>
                                </div>

                                <div class="form-group">
                                    <label for="receiptImage">Receipt Image (Optional)</label>
                                    <input type="file" class="form-control" id="receiptImage" name="receiptImage" accept="image/*,application/pdf">
                                    <small class="form-text text-muted">Upload a receipt image or PDF (max 20MB). Supported formats: JPEG, PNG, GIF, WebP, PDF</small>
                                    <div id="receiptImagePreview" class="mt-2" style="display: none;">
                                        <img id="previewImage" src="" alt="Receipt Preview" style="max-width: 200px; max-height: 200px; border: 1px solid #ddd; padding: 5px;">
                                    </div>
                                </div>

                                <div class="form-group" id="accountGroup">
                                    <label for="accountId">Account *</label>
                                    <select class="form-control" id="accountId" name="accountId" required>
                                        <option value="">Select a account</option>
                                        <% accounts.filter(w => w.isActive).forEach(account => { %>
                                            <option value="<%= account.id %>">
                                                <%= account.name %> ($<%= (account.balance != null ? account.balance.toFixed(2) : '0.00') %>)
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <!-- Transfer Section -->
                                <div id="transferSection" class="special-category-section">
                                    <h5><i class="fa fa-exchange-alt text-info"></i> Transfer Details</h5>
                                    <div class="form-group">
                                        <label for="toAccountId">To Account *</label>
                                        <select class="form-control" id="toAccountId" name="toAccountId">
                                            <option value="">Select destination account</option>
                                            <% accounts.filter(w => w.isActive).forEach(account => { %>
                                                <option value="<%= account.id %>">
                                                    <%= account.name %> ($<%= (account.balance != null ? account.balance.toFixed(2) : '0.00') %>)
                                                </option>
                                            <% }); %>
                                        </select>
                                        <small class="form-text text-muted">Money will be moved from the source account to this account</small>
                                    </div>
                                </div>

                                <!-- Common Expenses Section -->
                                <div id="commonExpensesSection" class="special-category-section">
                                    <h5><i class="fa fa-building text-success"></i> Common Expenses</h5>
                                    <p class="text-muted">Select one apartment and the year for this expense:</p>
                                    
                                    <div class="form-group">
                                        <label for="apartmentId">Apartment *</label>
                                        <select class="form-control" id="apartmentId" name="apartmentId">
                                            <option value="">Select an apartment</option>
                                            <% 
                                            const apartmentsByBlock = {};
                                            apartments.forEach(apt => {
                                                if (!apartmentsByBlock[apt.block]) {
                                                    apartmentsByBlock[apt.block] = [];
                                                }
                                                apartmentsByBlock[apt.block].push(apt);
                                            });
                                            %>
                                            
                                            <% Object.keys(apartmentsByBlock).sort().forEach(block => { %>
                                                <optgroup label="Block <%= block %>">
                                                    <% apartmentsByBlock[block].forEach(apartment => { 
                                                        const owner = users.find(u => u.id === apartment.ownerId);
                                                        const ownerName = owner ? owner.name : 'Unknown Owner';
                                                    %>
                                                        <option value="<%= apartment.id %>" 
                                                                data-area="<%= apartment.areaInM2 %>"
                                                                data-block="<%= apartment.block %>"
                                                                data-official="<%= apartment.unitNumberOfficial %>"
                                                                data-unofficial="<%= apartment.unitNumberUnofficial %>"
                                                                data-registration="<%= apartment.registrationDate %>">
                                                            <%= ownerName %> - Block <%= apartment.block %> <%= apartment.unitNumberOfficial %> 
                                                            (<%= apartment.unitNumberUnofficial %>) - <%= apartment.areaInM2 %>m²
                                                        </option>
                                                    <% }); %>
                                                </optgroup>
                                            <% }); %>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label>Select Years and Payment Amounts *</label>
                                        <div id="yearsCheckboxContainer" class="border rounded p-3" style="background: #f8f9fa;">
                                            <div id="yearsList">
                                                <!-- Checkboxes will be populated dynamically -->
                                            </div>
                                        </div>
                                        <small class="form-text text-muted mt-2">
                                            <i class="fa fa-info-circle"></i> Enter the amount to pay for each year. 
                                            <button type="button" class="btn btn-xs btn-link p-0" onclick="autoDistributePayment()">
                                                <i class="fa fa-magic"></i> Auto-distribute from total amount
                                            </button>
                                        </small>
                                    </div>

                                    <div id="paymentDetails" style="display: none;">
                                        <div class="alert alert-info">
                                            <h6><i class="fa fa-calculator"></i> Payment Breakdown</h6>
                                            <div id="paymentInfo"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" name="submitAction" id="submitAction" value="create">
                            <div class="card-footer d-flex align-items-center">
                                <button type="submit" class="btn btn-primary mr-2" data-action="create" style="margin-right:8px;">
                                    <i class="fa fa-save"></i> Create
                                </button>
                                <button type="submit" class="btn btn-outline-primary mr-2" data-action="create_edit" style="margin-right:8px;">
                                    <i class="fa fa-edit"></i> Create & Edit
                                </button>
                                <a href="/admin/transactions" class="btn btn-secondary">
                                    <i class="fa fa-arrow-left"></i> Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="col-md-4">
                    <!-- Outstanding Invoices Section -->
                    <% if (outstandingInvoices && outstandingInvoices.length > 0) { %>
                    <div class="card card-warning">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h3 class="card-title"><i class="fa fa-file-invoice"></i> Outstanding Invoices</h3>
                            <button type="button" class="btn btn-sm btn-success" id="paySelectedInvoicesBtn" style="display: none;">
                                <i class="fa fa-money-bill"></i> Pay Selected
                            </button>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">Select invoices to pay together, or click "Pay" for a single invoice</p>
                            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th style="width: 30px;">
                                                <input type="checkbox" id="selectAllInvoices" title="Select All">
                                            </th>
                                            <th>Date</th>
                                            <th>Category</th>
                                            <th>Amount</th>
                                            <th>Paid</th>
                                            <th>Balance</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% outstandingInvoices.forEach(invoice => { %>
                                        <tr>
                                            <td>
                                                <input type="checkbox" 
                                                       class="invoice-checkbox" 
                                                       data-invoice-id="<%= invoice.id %>"
                                                       data-invoice-amount="<%= invoice.amount %>"
                                                       data-invoice-paid="<%= invoice.amountPaid %>"
                                                       data-invoice-balance="<%= invoice.balance %>"
                                                       data-invoice-description="<%= (invoice.description || '').replace(/'/g, "\\'") %>"
                                                       data-category-id="<%= invoice.categoryId %>"
                                                       onchange="updateSelectedInvoices()">
                                            </td>
                                            <td><small><%= new Date(invoice.invoiceDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></small></td>
                                            <td>
                                                <span class="badge" style="background-color: <%= invoice.categoryColor %>; color: white;">
                                                    <%= invoice.categoryName %>
                                                </span>
                                            </td>
                                            <td><strong>$<%= invoice.amount.toFixed(2) %></strong></td>
                                            <td>$<%= invoice.amountPaid.toFixed(2) %></td>
                                            <td>
                                                <span class="badge badge-<%= invoice.balance > 0 ? 'danger' : 'success' %>">
                                                    $<%= invoice.balance.toFixed(2) %>
                                                </span>
                                            </td>
                                            <td>
                                                <button type="button" 
                                                        class="btn btn-xs btn-primary pay-invoice-btn" 
                                                        data-invoice-id="<%= invoice.id %>"
                                                        data-invoice-amount="<%= invoice.amount %>"
                                                        data-invoice-paid="<%= invoice.amountPaid %>"
                                                        data-invoice-balance="<%= invoice.balance %>"
                                                        data-invoice-description="<%= (invoice.description || '').replace(/'/g, "\\'") %>"
                                                        data-category-id="<%= invoice.categoryId %>"
                                                        onclick="payInvoiceFromButton(this); return false;"
                                                        title="Pay this invoice">
                                                    <i class="fa fa-money-bill"></i> Pay
                                                </button>
                                            </td>
                                        </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            <div id="selectedInvoicesSummary" class="mt-2" style="display: none;">
                                <div class="alert alert-info">
                                    <strong>Selected:</strong> <span id="selectedCount">0</span> invoice(s) | 
                                    <strong>Total Balance:</strong> $<span id="selectedTotal">0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% } %>
                    
                    <div class="card card-info">
                        <div class="card-header">
                            <h3 class="card-title">Transaction Types</h3>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <h6><i class="fa fa-arrow-up text-success"></i> Income Transactions</h6>
                                <p class="small text-muted">Add money to the selected account. Examples: salary, sales, payments received.</p>
                            </div>
                            <div class="mb-3">
                                <h6><i class="fa fa-arrow-down text-danger"></i> Expense Transactions</h6>
                                <p class="small text-muted">Remove money from the selected account. Examples: bills, purchases, payments made.</p>
                            </div>
                            <div class="mb-3">
                                <h6><i class="fa fa-exchange-alt text-info"></i> Transfers</h6>
                                <p class="small text-muted">Move money between accounts. Creates two transactions automatically.</p>
                            </div>
                            <div>
                                <h6><i class="fa fa-building text-warning"></i> Common Expenses</h6>
                                <p class="small text-muted">Expenses shared among apartments. Select multiple apartments and receipts will be generated.</p>
                            </div>
                        </div>
                    </div>

                    <div class="card card-success" id="transactionPreview" style="display: none;">
                        <div class="card-header">
                            <h3 class="card-title">Transaction Preview</h3>
                        </div>
                        <div class="card-body" id="previewContent">
                            <!-- Dynamic content will be inserted here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fa fa-exclamation-circle"></i> Error
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="errorModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
// Define payInvoiceFromButton function globally FIRST, before any other code
window.payInvoiceFromButton = function(btn) {
    console.log('payInvoiceFromButton called', btn);
    
    // If called from event, extract button
    if (btn && btn.target) {
        btn = btn.target.closest('.pay-invoice-btn') || btn.target;
    }
    
    if (!btn || !btn.classList || !btn.classList.contains('pay-invoice-btn')) {
        console.error('Invalid button element', btn);
        return;
    }
    
    console.log('Processing invoice payment for button:', btn);
    
    const invoiceId = btn.getAttribute('data-invoice-id');
    const invoiceAmount = parseFloat(btn.getAttribute('data-invoice-amount'));
    const invoicePaid = parseFloat(btn.getAttribute('data-invoice-paid'));
    const invoiceBalance = parseFloat(btn.getAttribute('data-invoice-balance'));
    let invoiceDescription = btn.getAttribute('data-invoice-description');
    const categoryId = btn.getAttribute('data-category-id');
    
    // Decode HTML entities if any
    if (invoiceDescription) {
        const txt = document.createElement('textarea');
        txt.innerHTML = invoiceDescription;
        invoiceDescription = txt.value;
    }
    
    console.log('Invoice payment data:', { 
        invoiceId, 
        invoiceBalance, 
        categoryId, 
        invoiceDescription: invoiceDescription || '(empty)' 
    });
    
    // Get apartmentId from URL parameter, form field, or template variable
    const urlParams = new URLSearchParams(window.location.search);
    let apartmentId = urlParams.get('apartmentId') || 
                     document.getElementById('apartmentId')?.value || 
                     '<%= apartmentId || "" %>';
    
    console.log('Apartment ID:', apartmentId);
    
    if (!apartmentId || apartmentId === '' || apartmentId === 'null') {
        alert('Please select an apartment first');
        return;
    }
    
    // Validate required elements exist
    const categorySelect = document.getElementById('categoryId');
    const amountInput = document.getElementById('amount');
    const descriptionInput = document.getElementById('description');
    const transactionTypeSelect = document.getElementById('transactionType');
    const apartmentSelect = document.getElementById('apartmentId');
    
    if (!categorySelect || !amountInput || !transactionTypeSelect) {
        console.error('Required form elements not found');
        alert('Error: Form elements not found. Please refresh the page.');
        return;
    }
    
    console.log('Pre-filling form...');
    console.log('Invoice description from button:', invoiceDescription);
    
    // Store invoice ID FIRST to prevent updateDescriptionForCommonExpense from overwriting
    let invoiceIdInput = document.getElementById('invoiceId');
    if (!invoiceIdInput) {
        invoiceIdInput = document.createElement('input');
        invoiceIdInput.type = 'hidden';
        invoiceIdInput.id = 'invoiceId';
        invoiceIdInput.name = 'invoiceId';
        document.getElementById('transactionForm').appendChild(invoiceIdInput);
    }
    invoiceIdInput.value = invoiceId;
    
    // Store invoice amount separately so it doesn't get lost when credit is added
    let invoiceAmountInput = document.getElementById('invoiceAmount');
    if (!invoiceAmountInput) {
        invoiceAmountInput = document.createElement('input');
        invoiceAmountInput.type = 'hidden';
        invoiceAmountInput.id = 'invoiceAmount';
        invoiceAmountInput.name = 'invoiceAmount';
        document.getElementById('transactionForm').appendChild(invoiceAmountInput);
    }
    invoiceAmountInput.value = invoiceBalance.toFixed(2);
    
    // Get description field reference
    const descriptionField = document.getElementById('description');
    
    // Pre-fill the form for paying this invoice
    document.getElementById('categoryId').value = categoryId;
    document.getElementById('amount').value = invoiceBalance.toFixed(2);
    document.getElementById('transactionType').value = 'income';
    
    // Set apartment
    if (!document.getElementById('apartmentId').value) {
        document.getElementById('apartmentId').value = apartmentId;
    }
    
    // Set description RIGHT NOW - before any events fire
    if (invoiceDescription && invoiceDescription.trim() !== '') {
        descriptionField.value = invoiceDescription;
        console.log('✓ Description set to:', invoiceDescription);
    } else {
        console.warn('⚠ No invoice description found in button data!');
    }
    
    // Now trigger category change - but description is already set and invoiceId prevents overwrite
    document.getElementById('categoryId').dispatchEvent(new Event('change'));
    
    // Keep forcing the description - use a persistent interval
    let descriptionSetCount = 0;
    const descriptionInterval = setInterval(() => {
        if (invoiceDescription && invoiceDescription.trim() !== '') {
            descriptionField.value = invoiceDescription;
            descriptionSetCount++;
            if (descriptionSetCount <= 3) {
                console.log(`Description forced (attempt ${descriptionSetCount}):`, invoiceDescription);
            }
        }
        // Stop after 2 seconds
        if (descriptionSetCount >= 20) {
            clearInterval(descriptionInterval);
        }
    }, 100);
    
    // Invoice ID already set above, no need to set it again
    
    // Scroll to form and highlight
    document.getElementById('transactionForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
    document.getElementById('amount').focus();
    document.getElementById('amount').select();
    
    // Show info message
    const infoDiv = document.createElement('div');
    infoDiv.className = 'alert alert-info alert-dismissible fade show';
    infoDiv.innerHTML = `
        <strong><i class="fa fa-info-circle"></i> Invoice Payment Mode</strong><br>
        Form pre-filled to pay invoice #${invoiceId}. Amount set to balance: $${invoiceBalance.toFixed(2)}<br>
        <small>Select an account and date, then click "Create" to complete the payment.</small>
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    `;
    const formCard = document.querySelector('.card-body');
    if (formCard) {
        formCard.insertBefore(infoDiv, formCard.firstChild);
    }
    
    // Auto-dismiss after 5 seconds
    setTimeout(() => {
        if (infoDiv.parentNode) {
            infoDiv.remove();
        }
    }, 5000);
};

// Multiple invoice selection functions
function updateSelectedInvoices() {
    const checkboxes = document.querySelectorAll('.invoice-checkbox:checked');
    const paySelectedBtn = document.getElementById('paySelectedInvoicesBtn');
    const summaryDiv = document.getElementById('selectedInvoicesSummary');
    const selectedCount = document.getElementById('selectedCount');
    const selectedTotal = document.getElementById('selectedTotal');
    
    if (checkboxes.length > 0) {
        paySelectedBtn.style.display = 'block';
        summaryDiv.style.display = 'block';
        
        let total = 0;
        checkboxes.forEach(checkbox => {
            const balance = parseFloat(checkbox.getAttribute('data-invoice-balance')) || 0;
            total += balance;
        });
        
        selectedCount.textContent = checkboxes.length;
        selectedTotal.textContent = total.toFixed(2);
    } else {
        paySelectedBtn.style.display = 'none';
        summaryDiv.style.display = 'none';
    }
}

// Select all invoices
document.getElementById('selectAllInvoices')?.addEventListener('change', function() {
    const checkboxes = document.querySelectorAll('.invoice-checkbox');
    checkboxes.forEach(cb => cb.checked = this.checked);
    updateSelectedInvoices();
});

// Pay selected invoices
document.getElementById('paySelectedInvoicesBtn')?.addEventListener('click', function() {
    const checkboxes = document.querySelectorAll('.invoice-checkbox:checked');
    if (checkboxes.length === 0) {
        alert('Please select at least one invoice');
        return;
    }
    
    const invoiceIds = [];
    const invoiceAmounts = {};
    let totalBalance = 0;
    let categoryId = null;
    
    checkboxes.forEach(checkbox => {
        const id = checkbox.getAttribute('data-invoice-id');
        const balance = parseFloat(checkbox.getAttribute('data-invoice-balance')) || 0;
        const catId = checkbox.getAttribute('data-category-id');
        
        invoiceIds.push(id);
        invoiceAmounts[id] = balance;
        totalBalance += balance;
        
        if (!categoryId) {
            categoryId = catId;
        }
    });
    
    // Pre-fill form for multiple invoice payment
    if (categoryId) {
        document.getElementById('categoryId').value = categoryId;
    }
    document.getElementById('amount').value = totalBalance.toFixed(2);
    document.getElementById('transactionType').value = 'income';
    
    // Store selected invoice IDs
    let invoiceIdsInput = document.getElementById('invoiceIds');
    if (!invoiceIdsInput) {
        invoiceIdsInput = document.createElement('input');
        invoiceIdsInput.type = 'hidden';
        invoiceIdsInput.id = 'invoiceIds';
        invoiceIdsInput.name = 'invoiceIds';
        document.getElementById('transactionForm').appendChild(invoiceIdsInput);
    }
    invoiceIdsInput.value = JSON.stringify(invoiceIds);
    
    // Store invoice amounts
    let invoiceAmountsInput = document.getElementById('invoiceAmounts');
    if (!invoiceAmountsInput) {
        invoiceAmountsInput = document.createElement('input');
        invoiceAmountsInput.type = 'hidden';
        invoiceAmountsInput.id = 'invoiceAmounts';
        invoiceAmountsInput.name = 'invoiceAmounts';
        document.getElementById('transactionForm').appendChild(invoiceAmountsInput);
    }
    invoiceAmountsInput.value = JSON.stringify(invoiceAmounts);
    
    // Show info message
    const infoDiv = document.createElement('div');
    infoDiv.className = 'alert alert-info alert-dismissible fade show';
    infoDiv.innerHTML = `
        <strong><i class="fa fa-info-circle"></i> Multiple Invoice Payment Mode</strong><br>
        Form pre-filled to pay ${invoiceIds.length} invoice(s). Total amount: $${totalBalance.toFixed(2)}<br>
        <small>Select an account and date, then click "Create" to complete the payment.</small>
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    `;
    const formCard = document.querySelector('.card-body');
    if (formCard) {
        formCard.insertBefore(infoDiv, formCard.firstChild);
    }
    
    // Auto-dismiss after 5 seconds
    setTimeout(() => {
        if (infoDiv.parentNode) {
            infoDiv.remove();
        }
    }, 5000);
    
    // Scroll to form
    document.getElementById('transactionForm').scrollIntoView({ behavior: 'smooth', block: 'start' });
    document.getElementById('amount').focus();
    document.getElementById('amount').select();
});

// Set today's date as default
document.getElementById('date').value = new Date().toISOString().split('T')[0];

