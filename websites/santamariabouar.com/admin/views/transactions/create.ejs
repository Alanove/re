console.log('Pay invoice handlers attached. Buttons found:', document.querySelectorAll('.pay-invoice-btn').length);

// Form submission
document.getElementById('transactionForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const categorySelect = document.getElementById('categoryId');
    const selectedCategory = categorySelect.options[categorySelect.selectedIndex];
    const categoryName = selectedCategory.getAttribute('data-name');
    
    // Validation for transfers
    if (categoryName === 'transfer') {
        const fromAccount = document.getElementById('accountId').value;
        const toAccount = document.getElementById('toAccountId').value;
        
        if (!toAccount) {
            showError('Please select a destination account for the transfer.');
            return;
        }
        
        if (fromAccount === toAccount) {
            showError('Cannot transfer to the same account. Please select different accounts.');
            return;
        }
    }
    
    // Get submit button early for error handling
    const submitBtn = this.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    
    // Validation for common expenses
    if (categoryName === 'common expenses') {
        const apartmentId = document.getElementById('apartmentId').value;
        const selectedCheckboxes = Array.from(document.querySelectorAll('.year-checkbox:checked'));
        
        if (!apartmentId) {
            showError('Please select an apartment for common expenses.');
            return;
        }
        
        if (selectedCheckboxes.length === 0) {
            showError('Please select at least one year or credit for future use.');
            return;
        }
        
        // Check if at least one checkbox has an amount entered
        let hasAmount = false;
        selectedCheckboxes.forEach(checkbox => {
            const year = checkbox.value;
            const isCredit = (year === '0');
            const amountInput = document.getElementById(isCredit ? 'amount_credit' : `amount_${year}`);
            const amount = parseFloat(amountInput.value) || 0;
            if (amount > 0) {
                hasAmount = true;
            }
        });
        
        if (!hasAmount) {
            showError('Please enter an amount for at least one selected option.');
            return;
        }
    }
    
    // Ensure submitAction reflects which button was clicked
    const actionInput = document.getElementById('submitAction');
    const activeBtn = document.activeElement;
    if (activeBtn && activeBtn.getAttribute && activeBtn.getAttribute('data-action')) {
        actionInput.value = activeBtn.getAttribute('data-action');
    }

    // Use FormData to handle file upload
    const formData = new FormData(this);
    
    // Handle multiple invoice payments
    const invoiceIdsInput = document.getElementById('invoiceIds');
    if (invoiceIdsInput && invoiceIdsInput.value) {
        try {
            const invoiceIds = JSON.parse(invoiceIdsInput.value);
            const invoiceAmountsInput = document.getElementById('invoiceAmounts');
            let invoiceAmounts = null;
            
            if (invoiceAmountsInput && invoiceAmountsInput.value) {
                invoiceAmounts = JSON.parse(invoiceAmountsInput.value);
            }
            
            // Add invoiceIds array to formData
            invoiceIds.forEach(id => {
                formData.append('invoiceIds[]', id.toString());
            });
            
            if (invoiceAmounts) {
                formData.set('invoiceAmounts', JSON.stringify(invoiceAmounts));
            }
            
            console.log('Multiple invoice payment:', { invoiceIds, invoiceAmounts });
        } catch (e) {
            console.error('Error parsing invoice IDs:', e);
        }
    }
    
    // For common expenses, collect year amounts manually
    if (categoryName === 'common expenses') {
        const selectedCheckboxes = Array.from(document.querySelectorAll('.year-checkbox:checked'));
        const yearAmounts = {};
        let totalFromYears = 0;
        let hasManualAmounts = false;
        const paymentYears = [];
        
        // Check if there's an invoice payment (invoiceId present)
        const invoiceIdInput = document.getElementById('invoiceId');
        const invoiceAmountInput = document.getElementById('invoiceAmount');
        const hasInvoice = invoiceIdInput && invoiceIdInput.value;
        let invoiceAmount = 0;
        
        if (hasInvoice) {
            // Get the invoice amount from the stored hidden field (more reliable)
            if (invoiceAmountInput && invoiceAmountInput.value) {
                invoiceAmount = parseFloat(invoiceAmountInput.value) || 0;
            } else {
                // Fallback to main amount field if hidden field doesn't exist
                invoiceAmount = parseFloat(document.getElementById('amount').value) || 0;
            }
            console.log('Invoice payment detected. Amount:', invoiceAmount);
        }
        
        // Check if user entered amounts per year (including credit)
        selectedCheckboxes.forEach(checkbox => {
            const year = checkbox.value;
            const isCredit = (year === '0');
            const amountInput = document.getElementById(isCredit ? 'amount_credit' : `amount_${year}`);
            const amount = parseFloat(amountInput.value) || 0;
            
            // Always include in paymentYears array
            paymentYears.push(parseInt(year));
            
            if (amount > 0) {
                yearAmounts[year] = amount;
                totalFromYears += amount;
                hasManualAmounts = true;
            }
        });
        
        // Ensure paymentYears is set in formData
        paymentYears.forEach(year => {
            formData.append('paymentYears[]', year.toString());
        });
        
        // Decide which amount to use
        if (hasManualAmounts) {
            // User entered amounts per year - combine with invoice amount if present
            const totalAmount = totalFromYears + invoiceAmount;
            formData.set('amount', totalAmount.toString());
            formData.set('yearAmounts', JSON.stringify(yearAmounts));
            console.log('Using manual year amounts. Credit/Year total:', totalFromYears);
            console.log('Invoice amount:', invoiceAmount);
            console.log('Combined total:', totalAmount);
            console.log('Year amounts:', yearAmounts);
            console.log('Payment years:', paymentYears);
        } else {
            // No manual amounts - use main amount field with auto-distribution
            const mainAmount = parseFloat(document.getElementById('amount').value) || 0;
            if (mainAmount <= 0) {
                showError('Please enter a total amount OR enter amounts for each year.');
                return;
            }
            console.log('Using main amount field for auto-distribution:', mainAmount);
            console.log('Payment years:', paymentYears);
            // Don't send yearAmounts - backend will auto-distribute
        }
    }
    
    // Show loading state
    submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Creating...';
    submitBtn.disabled = true;
    
    try {
        // Send as multipart/form-data to handle file upload
        const response = await fetch('/admin/transactions/create', {
            method: 'POST',
            headers: {
                'Accept': 'application/json'
                // Don't set Content-Type - browser will set it with boundary for multipart/form-data
            },
            body: formData
        });
        
        if (response.ok) {
            const result = await response.json();
            const action = actionInput.value || 'create';
            if (action === 'create_edit' && result && result.success) {
                let createdId = null;
                if (result.result && typeof result.result === 'object') {
                    if (result.result.id) {
                        createdId = result.result.id;
                    } else if (result.result.fromTransaction && result.result.fromTransaction.id) {
                        createdId = result.result.fromTransaction.id;
                    }
                }
                if (createdId) {
                    window.location.href = `/admin/transactions/${createdId}/edit`;
                    return;
                }
            }
            window.location.href = '/admin/transactions';
        } else {
            const result = await response.json();
            showError(result.message || 'Failed to create transaction');
        }
    } catch (error) {
        console.error('Error creating transaction:', error);
        showError('Error creating transaction: ' + error.message);
    } finally {
        // Restore button state
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
    }
});

// Helper function to show errors
function showError(message) {
    document.getElementById('errorModalBody').textContent = message;
    $('#errorModal').modal('show');
}
</script>
