function autoDistributePayment() {
    const totalAmount = parseFloat(document.getElementById('amount').value) || 0;
    
    if (totalAmount <= 0) {
        alert('Please enter a total payment amount first.');
        return;
    }
    
    const allCheckboxes = Array.from(document.querySelectorAll('.year-checkbox'));
    const sortedCheckboxes = allCheckboxes.sort((a, b) => parseInt(a.value) - parseInt(b.value));
    
    let remainingAmount = totalAmount;
    
    // Uncheck all and clear amounts first
    allCheckboxes.forEach(cb => {
        cb.checked = false;
        const isCredit = (cb.value === '0');
        const amountInput = document.getElementById(isCredit ? 'amount_credit' : `amount_${cb.value}`);
        const statusElement = document.getElementById(isCredit ? 'status_credit' : `status_${cb.value}`);
        
        if (amountInput) {
            amountInput.value = '';
            amountInput.disabled = true;
        }
        if (statusElement) {
            statusElement.innerHTML = '<span class="badge badge-secondary">Not selected</span>';
        }
    });
    
    // Distribute from oldest to newest (skip credit field - year 0)
    for (const checkbox of sortedCheckboxes) {
        if (remainingAmount <= 0) break;
        
        // Skip credit field during auto-distribution
        if (checkbox.value === '0') continue;
        
        const outstanding = parseFloat(checkbox.dataset.outstanding);
        const paymentForYear = Math.min(remainingAmount, outstanding);
        
        checkbox.checked = true;
        const amountInput = document.getElementById(`amount_${checkbox.value}`);
        amountInput.disabled = false;
        amountInput.value = paymentForYear.toFixed(2);
        
        // Trigger input event to update status
        amountInput.dispatchEvent(new Event('input'));
        
        remainingAmount -= paymentForYear;
    }
    
    // If there's still remaining amount after distributing to all years, add it to credit
    if (remainingAmount > 0) {
        const creditCheckbox = document.getElementById('year_credit');
        const creditInput = document.getElementById('amount_credit');
        const creditStatus = document.getElementById('status_credit');
        
        if (creditCheckbox && creditInput) {
            creditCheckbox.checked = true;
            creditInput.disabled = false;
            creditInput.value = remainingAmount.toFixed(2);
            
            if (creditStatus) {
                creditStatus.innerHTML = `<span class="badge badge-info">Credit: $${remainingAmount.toFixed(2)}</span>`;
            }
        }
    }
    
    updatePaymentDetails();
    updateTransactionPreview();
}

function updatePaymentDetails() {
    const apartmentId = document.getElementById('apartmentId').value;
    const selectedCheckboxes = Array.from(document.querySelectorAll('.year-checkbox:checked'));
    const paymentDetails = document.getElementById('paymentDetails');
    const paymentInfo = document.getElementById('paymentInfo');
    
    if (!apartmentId) {
        paymentDetails.style.display = 'none';
        return;
    }
    
    if (selectedCheckboxes.length === 0) {
        paymentDetails.style.display = 'none';
        return;
    }
    
    // Sort selected years by year value (oldest first)
    const sortedCheckboxes = selectedCheckboxes.sort((a, b) => 
        parseInt(a.value) - parseInt(b.value)
    );
    
    // Check if there's an invoice payment
    const invoiceIdInput = document.getElementById('invoiceId');
    const invoiceAmountInput = document.getElementById('invoiceAmount');
    const hasInvoice = invoiceIdInput && invoiceIdInput.value;
    let invoiceAmount = 0;
    
    if (hasInvoice) {
        // Get the invoice amount from the stored hidden field (more reliable than main amount field)
        if (invoiceAmountInput && invoiceAmountInput.value) {
            invoiceAmount = parseFloat(invoiceAmountInput.value) || 0;
        } else {
            // Fallback to main amount field if hidden field doesn't exist yet
            invoiceAmount = parseFloat(document.getElementById('amount').value) || 0;
        }
    }
    
    // Calculate totals from manual inputs
    let totalPayment = 0;
    let totalOutstanding = 0;
    let creditAmount = 0;
    const yearPayments = [];
    
    sortedCheckboxes.forEach((checkbox) => {
        const year = checkbox.value;
        
        // Handle credit separately
        if (year === '0') {
            const creditInput = document.getElementById('amount_credit');
            creditAmount = parseFloat(creditInput.value) || 0;
            totalPayment += creditAmount;
            return;
        }
        
        const yearOutstanding = parseFloat(checkbox.dataset.outstanding);
        const amountInput = document.getElementById(`amount_${year}`);
        const yearPayment = parseFloat(amountInput.value) || 0;
        
        totalOutstanding += yearOutstanding;
        totalPayment += yearPayment;
        
        yearPayments.push({
            year: year,
            payment: yearPayment,
            outstanding: yearOutstanding
        });
    });
    
    // Calculate total including invoice amount
    const totalWithInvoice = totalPayment + invoiceAmount;
    
    let info = `<p><strong>Selected Years:</strong> ${sortedCheckboxes.map(cb => cb.value).join(', ')}</p>`;
    info += `<p><strong>Total Outstanding:</strong> $${totalOutstanding.toFixed(2)}</p>`;
    
    // Show invoice payment if present
    if (hasInvoice && invoiceAmount > 0) {
        info += `<p><strong>Invoice Payment:</strong> <span class="text-info"><strong>$${invoiceAmount.toFixed(2)}</strong></span></p>`;
    }
    
    // Only show/update total if amounts were manually entered
    if (totalPayment > 0 || invoiceAmount > 0) {
        if (hasInvoice && invoiceAmount > 0) {
            info += `<p><strong>Total Payment (Invoice + Credit/Years):</strong> <span class="text-primary"><strong>$${totalWithInvoice.toFixed(2)}</strong></span></p>`;
            // Update the main amount field to include both invoice and credit/years
            // But preserve the invoice amount in the hidden field
            document.getElementById('amount').value = totalWithInvoice.toFixed(2);
            // Ensure invoice amount is still stored in hidden field
            if (invoiceAmountInput) {
                invoiceAmountInput.value = invoiceAmount.toFixed(2);
            }
        } else {
            info += `<p><strong>Total Payment (from year amounts):</strong> <span class="text-primary"><strong>$${totalPayment.toFixed(2)}</strong></span></p>`;
            // Update the main amount field to reflect the calculated total
            // Only update if there's no invoice (to avoid overwriting invoice amount)
            if (!hasInvoice) {
                document.getElementById('amount').value = totalPayment.toFixed(2);
            }
        }
    } else {
        // Show what the main amount field has
        const mainAmount = parseFloat(document.getElementById('amount').value) || 0;
        if (mainAmount > 0) {
            info += `<p><strong>Total Amount to Distribute:</strong> <span class="text-primary"><strong>$${mainAmount.toFixed(2)}</strong></span></p>`;
            info += `<p class="text-muted small"><i class="fa fa-lightbulb"></i> Click "Auto-distribute" to allocate this amount across years</p>`;
        }
    }
    
    // Show breakdown by year
    info += `<div class="mt-3"><h6>Payment Distribution:</h6><ul class="list-unstyled">`;
    
    yearPayments.forEach((yp) => {
        info += `<li class="mb-2">
            <div class="d-flex justify-content-between align-items-center">
                <span><strong>Year ${yp.year}:</strong> $${yp.payment.toFixed(2)}</span>`;
        
        if (yp.payment >= yp.outstanding) {
            info += `<span class="badge badge-success"><i class="fa fa-check"></i> Fully Paid</span>`;
        } else if (yp.payment > 0) {
            info += `<span class="badge badge-warning">Partial ($${(yp.outstanding - yp.payment).toFixed(2)} remaining)</span>`;
        } else {
            info += `<span class="badge badge-danger">No payment entered</span>`;
        }
        info += `</div></li>`;
    });
    
    // Show credit if specified
    if (creditAmount > 0) {
        info += `<li class="mb-2" style="background: #f0f9ff; padding: 8px; border-radius: 4px;">
            <div class="d-flex justify-content-between align-items-center">
                <span><strong><i class="fa fa-piggy-bank"></i> Credit for Future:</strong> $${creditAmount.toFixed(2)}</span>
                <span class="badge badge-success"><i class="fa fa-check"></i> Will be saved</span>
            </div>
        </li>`;
    }
    
    info += `</ul></div>`;
    
    // Show summary
    if (totalPayment > totalOutstanding) {
        const excess = totalPayment - totalOutstanding;
        info += `<div class="alert alert-warning mt-2">
                    <strong><i class="fa fa-exclamation-triangle"></i> Excess Payment:</strong> $${excess.toFixed(2)} will be stored as credit for future years.
                </div>`;
    } else if (totalPayment < totalOutstanding) {
        const totalRemaining = totalOutstanding - totalPayment;
        info += `<div class="alert alert-info mt-2">
                    <strong><i class="fa fa-info-circle"></i> Remaining Balance:</strong> $${totalRemaining.toFixed(2)} still outstanding across selected years.
                </div>`;
    } else if (totalPayment === totalOutstanding && totalPayment > 0) {
        info += `<div class="alert alert-success mt-2">
                    <strong><i class="fa fa-check-circle"></i> Perfect Match!</strong> This will fully settle all selected years.
                </div>`;
    }
    
    paymentInfo.innerHTML = info;
    paymentDetails.style.display = 'block';
}

function autoFillYears(paymentAmount) {
    const allCheckboxes = Array.from(document.querySelectorAll('.year-checkbox'));
    
    if (allCheckboxes.length === 0) return;
    
    let remainingAmount = paymentAmount;
    const selectedYears = [];
    
    // Sort checkboxes by year (oldest first)
    const sortedCheckboxes = allCheckboxes.sort((a, b) => parseInt(a.value) - parseInt(b.value));
    
    for (const checkbox of sortedCheckboxes) {
        const outstandingAmount = parseFloat(checkbox.dataset.outstanding);
        
        // Skip if invalid data
        if (isNaN(outstandingAmount) || !checkbox.value) {
            continue;
        }
        
        if (remainingAmount >= outstandingAmount) {
            selectedYears.push({
                year: checkbox.value,
                amount: outstandingAmount
            });
            checkbox.checked = true;
            remainingAmount -= outstandingAmount;
        } else if (remainingAmount > 0) {
            selectedYears.push({
                year: checkbox.value,
                amount: remainingAmount
            });
            checkbox.checked = true;
            remainingAmount = 0;
            break;
        }
    }
    
    if (selectedYears.length > 0) {
        // Show auto-fill info
        const autoFillInfo = document.getElementById('autoFillInfo');
        if (!autoFillInfo) {
            const infoDiv = document.createElement('div');
            infoDiv.id = 'autoFillInfo';
            infoDiv.className = 'alert alert-info mt-2';
            infoDiv.innerHTML = `
                <h6>Auto-filled Years:</h6>
                <ul class="mb-0">
                    ${selectedYears.map(y => `<li>${y.year}: $${y.amount.toFixed(2)}</li>`).join('')}
                </ul>
            `;
            document.getElementById('paymentDetails').appendChild(infoDiv);
        }
    }
}

function updateTransactionPreview() {
    const categorySelect = document.getElementById('categoryId');
    const selectedCategory = categorySelect.options[categorySelect.selectedIndex];
    const amount = document.getElementById('amount').value;
    const description = document.getElementById('description').value;
    
    if (!selectedCategory.value || !amount) {
        document.getElementById('transactionPreview').style.display = 'none';
        return;
    }
    
    const categoryName = selectedCategory.getAttribute('data-name');
    const categoryType = selectedCategory.getAttribute('data-type');
    const previewContent = document.getElementById('previewContent');
    
    let preview = `<h6>${selectedCategory.text}</h6>`;
    preview += `<p><strong>Amount:</strong> $${parseFloat(amount).toFixed(2)}</p>`;
    
    if (categoryName === 'transfer') {
        const toAccount = document.getElementById('toAccountId');
        const fromAccount = document.getElementById('accountId');
        if (toAccount.value && fromAccount.value) {
            preview += `<p><strong>From:</strong> ${fromAccount.options[fromAccount.selectedIndex].text}</p>`;
            preview += `<p><strong>To:</strong> ${toAccount.options[toAccount.selectedIndex].text}</p>`;
            preview += `<div class="alert alert-info">This will create 2 transactions</div>`;
        }
    } else if (categoryName === 'common expenses') {
        const apartmentId = document.getElementById('apartmentId').value;
        const selectedCheckboxes = Array.from(document.querySelectorAll('.year-checkbox:checked'));
        if (apartmentId && selectedCheckboxes.length > 0) {
            const apartmentSelect = document.getElementById('apartmentId');
            const selectedApartment = apartmentSelect.options[apartmentSelect.selectedIndex];
            preview += `<p><strong>Apartment:</strong> ${selectedApartment.text}</p>`;
            preview += `<p><strong>Years:</strong> ${selectedCheckboxes.map(cb => cb.value).join(', ')}</p>`;
            preview += `<p><strong>Amount:</strong> $${parseFloat(amount).toFixed(2)}</p>`;
            preview += `<div class="alert alert-success"><i class="fa fa-check-circle"></i> Payment will be applied to apartment</div>`;
        }
    }
    
    if (description) {
        preview += `<p><strong>Description:</strong> ${description}</p>`;
    }
    
    previewContent.innerHTML = preview;
    document.getElementById('transactionPreview').style.display = 'block';
}

