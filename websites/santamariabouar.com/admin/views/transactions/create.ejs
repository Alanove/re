// Category change handler
document.getElementById('categoryId').addEventListener('change', function() {
    const selectedOption = this.options[this.selectedIndex];
    const categoryType = selectedOption.getAttribute('data-type');
    const categoryName = selectedOption.getAttribute('data-name');
    
    // Reset all special sections
    document.getElementById('transferSection').style.display = 'none';
    document.getElementById('commonExpensesSection').style.display = 'none';
    // Hide transaction type selector and clear any previous selection to avoid stale values
    document.getElementById('transactionTypeGroup').style.display = 'none';
    const txTypeEl = document.getElementById('transactionType');
    if (txTypeEl) txTypeEl.value = '';
    
    // Show transaction type for 'both' categories (except special ones)
    if (categoryType === 'both' && categoryName !== 'transfer') {
        document.getElementById('transactionTypeGroup').style.display = 'block';
    }
    
    // Show special sections
    if (categoryName === 'transfer') {
        document.getElementById('transferSection').style.display = 'block';
        document.querySelector('label[for="accountId"]').textContent = 'From Account *';
    } else {
        document.querySelector('label[for="accountId"]').textContent = 'Account *';
    }
    
    if (categoryName === 'common expenses') {
        document.getElementById('commonExpensesSection').style.display = 'block';
        // Make description optional for common expenses
        document.getElementById('description').required = false;
        document.getElementById('descriptionRequired').style.display = 'none';
        // Make apartmentId required for common expenses
        document.getElementById('apartmentId').required = true;
        // Auto-generate description if apartment is already selected
        updateDescriptionForCommonExpense();
        // Update amount field help text
        document.getElementById('amountHelpText').innerHTML = '<i class="fa fa-info-circle"></i> Enter total here and use auto-distribute, OR enter amounts per year below';
        document.getElementById('amountHelpText').className = 'form-text text-info';
    } else {
        // Make description required for other transaction types
        document.getElementById('description').required = true;
        document.getElementById('descriptionRequired').style.display = 'inline';
        // Make apartmentId not required for other transaction types
        document.getElementById('apartmentId').required = false;
        // Clear amount help text
        document.getElementById('amountHelpText').textContent = '';
    }
    
    updateTransactionPreview();
});

// Amount and other field change handlers
['amount', 'description', 'accountId', 'toAccountId', 'transactionType'].forEach(fieldId => {
    const field = document.getElementById(fieldId);
    if (field) {
        field.addEventListener('input', function() {
            updateTransactionPreview();
            updatePaymentDetails();
        });
        field.addEventListener('change', function() {
            updateTransactionPreview();
            updatePaymentDetails();
        });
    }
});

// Apartment selection handler
document.addEventListener('DOMContentLoaded', function() {
    const apartmentSelect = document.getElementById('apartmentId');
    
    if (apartmentSelect) {
        apartmentSelect.addEventListener('change', function() {
            loadAvailableYears();
            updateTransactionPreview();
            updateDescriptionForCommonExpense();
        });
    }
    
    // Check for values in URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    const apartmentId = urlParams.get('apartmentId');
    const presetCategoryId = urlParams.get('categoryId');
    const presetTransactionType = urlParams.get('transactionType');
    const presetAccountId = urlParams.get('accountId');
    
    if (apartmentId && apartmentSelect) {
        // Pre-select the apartment
        apartmentSelect.value = apartmentId;
        
        // Find and select the "Common Expenses" category
        const categorySelect = document.getElementById('categoryId');
        if (categorySelect) {
            const commonExpenseOption = Array.from(categorySelect.options).find(
                option => option.getAttribute('data-name') === 'common expenses'
            );
            
            if (commonExpenseOption) {
                categorySelect.value = commonExpenseOption.value;
                // Trigger the category change event to show the common expenses section
                categorySelect.dispatchEvent(new Event('change'));
            }
        }
        
        // Load available years for the selected apartment
        setTimeout(() => {
            loadAvailableYears();
            updateDescriptionForCommonExpense();
        }, 100);
    }
    
    // Prefill category, transaction type, and account if provided
    const categorySelect = document.getElementById('categoryId');
    const accountSelect = document.getElementById('accountId');
    
    if (presetCategoryId && categorySelect) {
        categorySelect.value = presetCategoryId;
        // Trigger change to apply dependent UI logic
        categorySelect.dispatchEvent(new Event('change'));
    }
    
    if (presetTransactionType) {
        const txTypeEl = document.getElementById('transactionType');
        if (txTypeEl) {
            txTypeEl.value = presetTransactionType;
        }
    }
    
    if (presetAccountId && accountSelect) {
        accountSelect.value = presetAccountId;
        accountSelect.dispatchEvent(new Event('change'));
    }
});

function updateDescriptionForCommonExpense() {
    // ALWAYS check for invoice ID first - if paying an invoice, NEVER update description
    const invoiceIdInput = document.getElementById('invoiceId');
    if (invoiceIdInput && invoiceIdInput.value) {
        console.log('Invoice payment in progress - SKIPPING auto-description update');
        return;
    }
    
    const categorySelect = document.getElementById('categoryId');
    const selectedCategory = categorySelect.options[categorySelect.selectedIndex];
    const categoryName = selectedCategory.getAttribute('data-name');
    
    // Only auto-generate for common expenses
    if (categoryName !== 'common expenses') {
        return;
    }
    
    const apartmentSelect = document.getElementById('apartmentId');
    if (!apartmentSelect.value) {
        return;
    }
    
    const selectedOption = apartmentSelect.options[apartmentSelect.selectedIndex];
    const block = selectedOption.getAttribute('data-block');
    const official = selectedOption.getAttribute('data-official');
    const unofficial = selectedOption.getAttribute('data-unofficial');
    
    if (block && official && unofficial) {
        const description = `Common Expenses Payment for Apartment Block ${block} ${official} (${unofficial})`;
        document.getElementById('description').value = description;
    }
}

async function loadAvailableYears() {
    const apartmentId = document.getElementById('apartmentId').value;
    const yearsList = document.getElementById('yearsList');
    
    if (!apartmentId) {
        yearsList.innerHTML = '';
        document.getElementById('paymentDetails').style.display = 'none';
        return;
    }
    
    try {
        const response = await fetch(`/admin/apartments/${apartmentId}/unsettled-years`);
        const data = await response.json();
        
        yearsList.innerHTML = '';
        
        // Show credit information if available
        if (data.creditAvailable && data.creditAvailable > 0) {
            const creditDiv = document.createElement('div');
            creditDiv.className = 'alert alert-success mb-3';
            creditDiv.id = 'creditInfo';
            creditDiv.innerHTML = `
                <h6><i class="fa fa-wallet"></i> Wallet Available</h6>
                <p class="mb-0">This apartment has <strong>$${data.creditAvailable.toFixed(2)}</strong> in its wallet that will be automatically applied to payments.</p>
            `;
            yearsList.appendChild(creditDiv);
        }
        
        // Helper function to create credit option
        function createCreditOption() {
            const creditDiv = document.createElement('div');
            creditDiv.className = 'mb-3 p-3 border rounded';
            creditDiv.style.backgroundColor = '#f0f9ff';
            creditDiv.style.borderColor = '#3b82f6';
            creditDiv.innerHTML = `
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <div class="form-check">
                            <input class="form-check-input year-checkbox" 
                                   type="checkbox" 
                                   name="paymentYears" 
                                   value="0" 
                                   id="year_credit"
                                   data-outstanding="999999">
                            <label class="form-check-label" for="year_credit">
                                <strong><i class="fa fa-wallet"></i> Wallet (prepaid balance)</strong>
                                <br>
                                <small class="text-muted">Add to apartment wallet for future expenses</small>
                            </label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <div class="input-group-prepend">
                                <span class="input-group-text">$</span>
                            </div>
                            <input type="number" 
                                   step="0.01" 
                                   min="0" 
                                   class="form-control year-amount-input" 
                                   id="amount_credit"
                                   data-year="credit"
                                   placeholder="0.00"
                                   disabled>
                        </div>
                    </div>
                    <div class="col-md-4 text-right">
                        <small class="text-muted" id="status_credit">
                            <span class="badge badge-secondary">Not selected</span>
                        </small>
                    </div>
                </div>
            `;
            return creditDiv;
        }
        
        // Helper function to add event listeners
        function addEventListeners() {
            // Add change listeners to all checkboxes (including credit)
            document.querySelectorAll('.year-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const year = this.value;
                    const amountInput = document.getElementById(`amount_${year === '0' ? 'credit' : year}`);
                    const statusBadge = document.getElementById(`status_${year === '0' ? 'credit' : year}`);
                    
                    if (this.checked) {
                        amountInput.disabled = false;
                        amountInput.focus();
                        statusBadge.innerHTML = '<span class="badge badge-info">Enter amount</span>';
                    } else {
                        amountInput.disabled = true;
                        amountInput.value = '';
                        statusBadge.innerHTML = '<span class="badge badge-secondary">Not selected</span>';
                    }
                    
                    updatePaymentDetails();
                    updateTransactionPreview();
                });
            });
            
            // Add input listeners to all amount inputs
            document.querySelectorAll('.year-amount-input').forEach(input => {
                input.addEventListener('input', function() {
                    const year = this.dataset.year;
                    const checkbox = document.getElementById(`year_${year === 'credit' ? 'credit' : year}`);
                    const outstanding = parseFloat(checkbox.dataset.outstanding);
                    let amount = parseFloat(this.value) || 0;
                    const statusBadge = document.getElementById(`status_${year === 'credit' ? 'credit' : year}`);
                    
                    // Special handling for credit - no max validation
                    if (year === 'credit') {
                        if (amount > 0) {
                            statusBadge.innerHTML = `<span class="badge badge-success"><i class="fa fa-piggy-bank"></i> Credit: $${amount.toFixed(2)}</span>`;
                        } else {
                            statusBadge.innerHTML = '<span class="badge badge-info">Enter amount</span>';
                        }
                    } else {
                        // Regular year validation: don't allow exceeding outstanding amount
                        if (amount > outstanding) {
                            amount = outstanding;
                            this.value = outstanding.toFixed(2);
                            statusBadge.innerHTML = '<span class="badge badge-warning"><i class="fa fa-exclamation-triangle"></i> Max amount applied</span>';
                            setTimeout(() => {
                                statusBadge.innerHTML = '<span class="badge badge-success"><i class="fa fa-check"></i> Fully paid</span>';
                            }, 2000);
                        } else if (amount > 0) {
                            if (amount >= outstanding) {
                                statusBadge.innerHTML = '<span class="badge badge-success"><i class="fa fa-check"></i> Fully paid</span>';
                            } else {
                                const remaining = outstanding - amount;
                                statusBadge.innerHTML = `<span class="badge badge-warning">$${remaining.toFixed(2)} remaining</span>`;
                            }
                        } else {
                            statusBadge.innerHTML = '<span class="badge badge-info">Enter amount</span>';
                        }
                    }
                    
                    updatePaymentDetails();
                    updateTransactionPreview();
                });
            });
        }
        
        if (data.success && data.years && data.years.length > 0) {
            // Filter out any invalid years and sort
            const validYears = data.years.filter(y => y.year > 0 && !isNaN(y.outstandingAmount));
            
            if (validYears.length > 0) {
                validYears.forEach((year, index) => {
                    const yearDiv = document.createElement('div');
                    yearDiv.className = 'mb-3 p-3 border rounded';
                    yearDiv.style.backgroundColor = '#ffffff';
                    yearDiv.innerHTML = `
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <div class="form-check">
                                    <input class="form-check-input year-checkbox" 
                                           type="checkbox" 
                                           name="paymentYears" 
                                           value="${year.year}" 
                                           id="year_${year.year}"
                                           data-outstanding="${year.outstandingAmount}">
                                    <label class="form-check-label" for="year_${year.year}">
                                        <strong>Year ${year.year}</strong>
                                        <br>
                                        <small class="text-muted"> $${year.outstandingAmount.toFixed(2)}</small>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="input-group input-group-sm">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text">$</span>
                                    </div>
                                    <input type="number" 
                                           step="0.01" 
                                           min="0" 
                                           max="${year.outstandingAmount}"
                                           class="form-control year-amount-input" 
                                           id="amount_${year.year}"
                                           data-year="${year.year}"
                                           placeholder="0.00"
                                           disabled>
                                </div>
                            </div>
                            <div class="col-md-4 text-right">
                                <small class="text-muted" id="status_${year.year}">
                                    <span class="badge badge-secondary">Not selected</span>
                                </small>
                            </div>
                        </div>
                    `;
                    yearsList.appendChild(yearDiv);
                });
            }
            
            // Always add "Credit for Future Use" option at the end
            yearsList.appendChild(createCreditOption());
            addEventListeners();
        } else {
            // No unsettled years - show message but still allow credit
            const noYearsMsg = document.createElement('div');
            noYearsMsg.className = 'alert alert-info mb-3';
            noYearsMsg.innerHTML = '<i class="fa fa-info-circle"></i> No unsettled payments found. You can still add money as credit for future use.';
            yearsList.appendChild(noYearsMsg);
            
            // Always show credit option even when no unsettled years
            yearsList.appendChild(createCreditOption());
            addEventListeners();
        }
        
        // Show credit info if available
        await loadCreditInfo(apartmentId);
    } catch (error) {
        console.error('Error loading available years:', error);
        yearsList.innerHTML = '<p class="text-danger mb-0"><i class="fa fa-exclamation-triangle"></i> Error loading years</p>';
    }
}

