<div class="row" id="safemate-users-page">
  <div class="col-xl-12">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">SafeMate Users</h4>
      </div>
      <div class="panel-body">
        <form method="GET" action="/admin/main-gate/safemate" class="row g-3 align-items-end mb-3">
          <div class="col-md-2">
            <label class="form-label" for="safemateFilterStatus">Status</label>
            <select class="form-select" id="safemateFilterStatus" name="status">
              <option value="" <%= !filters.status ? 'selected' : '' %>>All</option>
              <option value="app-only" <%= filters.status === 'app-only' ? 'selected' : '' %>>App only</option>
              <option value="matched" <%= filters.status === 'matched' ? 'selected' : '' %>>Matched</option>
              <option value="system" <%= filters.status === 'system' ? 'selected' : '' %>>System</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label" for="safemateSearch">Search</label>
            <input class="form-control" id="safemateSearch" name="q" value="<%= filters.q || '' %>" placeholder="Phone, owner, or CMS user name" />
          </div>
          <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a href="/admin/main-gate/safemate" class="btn btn-outline-secondary">Clear</a>
            <% if (cloudOk) { %>
              <a class="btn btn-outline-success" href="/admin/main-gate/safemate/export<%= exportQuery ? ('?' + exportQuery) : '' %>">Export numbers</a>
            <% } %>
          </div>
        </form>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (!cloudOk) { %>
          <div class="alert alert-warning"><%= cloudMessage || 'SafeMate is unreachable.' %> Existing gate access in the database is unchanged.</div>
        <% } %>

        <p class="text-muted">
          SafeMate is the source list. A CMS user matches when the last 6 digits of the phone are the same, after spaces and other characters are removed.
        </p>

        <p class="text-muted" id="safemate-count" data-shown="<%= rows.length %>" data-total="<%= totalCount %>">Showing <%= rows.length %> of <%= totalCount %>.</p>

        <div class="table-responsive">
          <table class="table table-striped table-bordered align-middle">
            <thead>
              <tr>
                <th class="sortable">SafeMate account <i class="fa fa-sort"></i></th>
                <th class="sortable">Phone <i class="fa fa-sort"></i></th>
                <th class="sortable">Email <i class="fa fa-sort"></i></th>
                <th class="sortable">Valid until <i class="fa fa-sort"></i></th>
                <th class="sortable">CMS users <i class="fa fa-sort"></i></th>
                <th class="sortable">Apartment <i class="fa fa-sort"></i></th>
                <th class="sortable">Status <i class="fa fa-sort"></i></th>
                <th width="1%">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (rows && rows.length) { %>
                <% rows.forEach(function(row, index) { %>
                  <tr class="<%= row.protected ? 'safemate-system-row' : '' %>">
                    <td><%= row.account %></td>
                    <td><%= row.phone || '—' %></td>
                    <td><%= row.email || '—' %></td>
                    <td><%= row.validDate || '—' %></td>
                    <td>
                      <% if (row.matches.length) { %>
                        <% row.matches.forEach(function(match) { %>
                          <div>
                            <%= match.name %>
                            <% if (match.phone) { %><small class="text-muted"> <%= match.phone %></small><% } %>
                            <% if (match.keepReason) { %>
                              <br><small class="text-muted">Kept on revoke: <%= match.keepReason %></small>
                            <% } %>
                          </div>
                        <% }); %>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                    <td>
                      <% if (row.matches.length) { %>
                        <% row.matches.forEach(function(match) { %>
                          <div class="mb-2">
                            <% if (row.matches.length > 1) { %>
                              <div><strong><%= match.name %></strong></div>
                            <% } %>
                            <% if (match.apartments.length) { %>
                              <% match.apartments.forEach(function(apartment) { %>
                                <div class="mb-2">
                                  <span class="badge bg-success">Related</span>
                                  <a href="/admin/apartments/<%= apartment.id %>/edit"><%= apartment.label %></a>
                                  <br><small>Main owner: <%= apartment.mainOwner || '—' %></small>
                                  <br><small class="text-muted"><%= apartment.relation %></small>
                                </div>
                              <% }); %>
                            <% } else { %>
                              <span class="badge bg-secondary">Not related to an apartment</span>
                            <% } %>
                          </div>
                        <% }); %>
                      <% } else { %>
                        <span class="text-muted">Not related to an apartment</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (row.status === 'system') { %>
                        <span class="badge bg-secondary">System</span>
                      <% } else if (row.status === 'matched') { %>
                        <span class="badge bg-success">Matched</span>
                      <% } else { %>
                        <span class="badge bg-warning text-dark">App only</span>
                      <% } %>
                    </td>
                    <td class="text-nowrap">
                      <% if (row.status === 'app-only') { %>
                        <button type="button" class="btn btn-sm btn-primary js-safemate-add"
                          data-account="<%= row.account %>"
                          data-phone="<%= row.phone %>"
                          data-email="<%= row.email %>"
                          data-name="<%= row.phone || row.account %>">Add access</button>
                      <% } %>
                      <% if (row.status !== 'system') { %>
                        <button type="button" class="btn btn-sm btn-danger js-safemate-revoke"
                          data-account="<%= row.account %>"
                          data-phone="<%= row.phone %>"
                          data-detail-id="safemate-revoke-detail-<%= index %>">Revoke access</button>
                        <div id="safemate-revoke-detail-<%= index %>" class="d-none">
                          <p>Remove SafeMate account <strong><%= row.account %></strong>.</p>
                          <% if (row.matches.length) { %>
                            <ul class="mb-0">
                              <% row.matches.forEach(function(match) { %>
                                <li>
                                  <%= match.name %>
                                  <% if (match.keepReason) { %>
                                    — kept (<%= match.keepReason %>). Gate access rows will be removed.
                                  <% } else { %>
                                    — CMS user will be deleted.
                                  <% } %>
                                </li>
                              <% }); %>
                            </ul>
                          <% } else { %>
                            <p class="mb-0">No CMS user matches this phone.</p>
                          <% } %>
                        </div>
                      <% } %>
                      <% if (row.status === 'system') { %>
                        —
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center">
                    <% if (!cloudOk) { %>
                      SafeMate users could not be loaded.
                    <% } else if (totalCount > 0) { %>
                      No SafeMate users match these filters.
                    <% } else { %>
                      No SafeMate users.
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="safemateAddModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/main-gate/safemate/add" id="safemateAddForm">
        <div class="modal-header">
          <h4 class="modal-title">Add access</h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="account" id="safemateAddAccount" value="" />
          <div class="mb-3">
            <label class="form-label" for="safemateAddName">Name</label>
            <input class="form-control" id="safemateAddName" name="name" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="safemateAddPhone">Phone</label>
            <input class="form-control" id="safemateAddPhone" name="phone" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="safemateAddEmail">Email</label>
            <input class="form-control" id="safemateAddEmail" name="email" type="text" />
          </div>
          <div class="mb-3">
            <label class="form-label" for="safemateAddApartment">Apartment</label>
            <select class="form-select" id="safemateAddApartment" name="apartmentId" required>
              <option value="">Select an apartment</option>
              <% apartmentOptions.forEach(function(apartment) { %>
                <option value="<%= apartment.id %>"><%= apartment.label %></option>
              <% }); %>
            </select>
          </div>
          <div class="mb-0">
            <label class="form-label" for="safemateAddRelation">Relation</label>
            <select class="form-select" id="safemateAddRelation" name="relation" required>
              <% relations.forEach(function(relation) { %>
                <option value="<%= relation %>" <%= relation === 'Guest' ? 'selected' : '' %>><%= relation %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="safemateAddSubmit">Create user</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="safemateRevokeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/main-gate/safemate/revoke" id="safemateRevokeForm">
        <div class="modal-header">
          <h4 class="modal-title">Revoke access</h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger d-none" id="safemateRevokeError"></div>
          <div id="safemateRevokeBody"></div>
        </div>
        <input type="hidden" name="account" id="safemateRevokeAccount" value="" />
        <input type="hidden" name="phone" id="safemateRevokePhone" value="" />
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger" id="safemateRevokeSubmit">Revoke access</button>
        </div>
      </form>
    </div>
  </div>
</div>
