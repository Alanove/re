<div class="row">
  <div class="col-xl-12">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">Gate Access Requests</h4>
      </div>
      <div class="panel-body">
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="mb-3">
          <a href="/admin/gate-access-requests?status=pending" class="btn btn-sm <%= status === 'pending' ? 'btn-primary' : 'btn-outline-primary' %>">Pending</a>
          <a href="/admin/gate-access-requests?status=approved" class="btn btn-sm <%= status === 'approved' ? 'btn-primary' : 'btn-outline-primary' %>">Approved</a>
          <a href="/admin/gate-access-requests?status=rejected" class="btn btn-sm <%= status === 'rejected' ? 'btn-primary' : 'btn-outline-primary' %>">Rejected</a>
          <a href="/admin/gate-access-requests?status=all" class="btn btn-sm <%= status === 'all' ? 'btn-primary' : 'btn-outline-primary' %>">All</a>
        </div>

        <div class="table-responsive">
          <table class="table table-striped table-bordered align-middle">
            <thead>
              <tr>
                <th>Date</th>
                <th>Apartment</th>
                <th>Requested by</th>
                <th>Action</th>
                <th>Person</th>
                <th>Relation</th>
                <th>Expiry</th>
                <th>Status</th>
                <th width="1%">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (requests && requests.length) { %>
                <% requests.forEach(function(r) { %>
                  <tr>
                    <td><%= r.createdAt ? new Date(r.createdAt).toLocaleString() : '—' %></td>
                    <td><%= r.apartmentLabel %></td>
                    <td><%= r.ownerName %></td>
                    <td><%= r.action %></td>
                    <td>
                      <%= r.targetName || ('User #' + r.targetUserId) %>
                      <% if (r.targetPhone) { %><br><small><%= r.targetPhone %></small><% } %>
                      <% if (r.targetEmail) { %><br><small><%= r.targetEmail %></small><% } %>
                    </td>
                    <td><%= r.relation || '—' %></td>
                    <td><%= r.expiryDate || '—' %></td>
                    <td><%= r.status %></td>
                    <td class="text-nowrap">
                      <% if (r.status === 'pending') { %>
                        <form method="POST" action="/admin/gate-access-requests/<%= r.id %>/approve" class="d-inline">
                          <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form method="POST" action="/admin/gate-access-requests/<%= r.id %>/reject" class="d-inline">
                          <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                        </form>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="9" class="text-center">No gate access requests.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
