<div class="row">
  <div class="col-xl-12">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">Review Access Request</h4>
        <div class="panel-heading-btn">
          <a href="/admin/access-requests" class="btn btn-xs btn-secondary">Back</a>
        </div>
      </div>
      <div class="panel-body">
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <%
          var formFullName = (typeof formValues !== 'undefined' && formValues.fullName) ? formValues.fullName : request.fullName;
          var formEmail = (typeof formValues !== 'undefined' && formValues.email) ? formValues.email : request.email;
          var formPhone = (typeof formValues !== 'undefined' && formValues.phone) ? formValues.phone : request.phone;
        %>

        <div class="mb-4">
          <h5>Requester</h5>
          <p class="mb-1"><strong>Submitted:</strong> <%= new Date(request.createdAt).toLocaleString() %></p>
          <p class="mb-1 text-muted small">
            Original request:
            <%= request.fullName %> · <%= request.email %> · <%= request.phone %>
          </p>
          <div class="mt-3">
            <strong>Requested apartments &amp; type:</strong>
            <% if (request.apartments && request.apartments.length) { %>
              <ul class="mb-0 mt-2">
                <% request.apartments.forEach(function(a) { %>
                  <% var roleLabel = a.role === 'tenant' ? 'Tenant' : 'Owner'; %>
                  <li>
                    <%= a.label %>
                    <span class="badge <%= a.role === 'tenant' ? 'bg-info' : 'bg-primary' %> ms-1"><%= roleLabel %></span>
                  </li>
                <% }); %>
              </ul>
            <% } else { %>
              <p class="mb-0 text-muted">No apartments on this request.</p>
            <% } %>
          </div>
          <div class="alert alert-info mt-3 mb-0">
            <strong>Linking rules:</strong>
            Tenants are added without changing the primary owner.
            Additional owners are added by default when an apartment already has an owner —
            choose <em>Transfer primary ownership</em> only when you intend to replace the owner
            (affects transactions / invoices display).
          </div>
        </div>

        <form method="POST" action="/admin/access-requests/<%= request.id %>/approve" id="approveAccessForm">
          <div class="mb-3">
            <label class="form-label">Member contact details</label>
            <div class="row g-2">
              <div class="col-md-4">
                <label class="form-label small mb-1" for="fullName">Name</label>
                <input type="text" class="form-control" id="fullName" name="fullName"
                       value="<%= formFullName %>" required />
              </div>
              <div class="col-md-4">
                <label class="form-label small mb-1" for="email">Email</label>
                <input type="email" class="form-control" id="email" name="email"
                       value="<%= formEmail %>" required />
              </div>
              <div class="col-md-4">
                <label class="form-label small mb-1" for="phone">Phone</label>
                <input type="text" class="form-control" id="phone" name="phone"
                       value="<%= formPhone %>" required />
              </div>
            </div>
            <div class="form-text">
              Edit if needed before approving. Email and phone must be unique across users.
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Member account</label>
            <%
              var defaultCreate = typeof hasTenantRequest !== 'undefined' && hasTenantRequest
                && !(typeof hasOwnerRequest !== 'undefined' && hasOwnerRequest);
            %>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="linkMode" id="linkModeCreate" value="create"
                     <%= defaultCreate ? 'checked' : '' %> />
              <label class="form-check-label" for="linkModeCreate">
                Create new member from this request
              </label>
            </div>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="linkMode" id="linkModeExisting" value="existing"
                     <%= defaultCreate ? '' : 'checked' %> />
              <label class="form-check-label" for="linkModeExisting">
                Link to existing Member user
              </label>
            </div>
            <select name="userId" id="existingMemberSelect" class="form-select mt-2" <%= defaultCreate ? 'disabled' : 'required' %>>
              <option value="">— Select member —</option>
              <% members.forEach(function(m) { %>
                <%
                  var suggested = suggestedMemberIds && suggestedMemberIds.indexOf(m.id) !== -1;
                  var suggestedOwner = suggestedOwnerIds && suggestedOwnerIds.indexOf(m.id) !== -1;
                %>
                <option value="<%= m.id %>" <%= suggested ? 'selected' : '' %>>
                  <%= m.name %><%= m.email ? ' (' + m.email + ')' : '' %><%= m.phone ? ' · ' + m.phone : '' %><%= suggestedOwner ? ' ★ suggested owner' : (suggested ? ' ★ suggested' : '') %>
                </option>
              <% }); %>
            </select>
            <div class="form-text">
              For tenants, prefer creating a new member. A temporary password will be emailed to the address above.
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Apartments to link</label>
            <div class="border rounded p-3" style="max-height: 420px; overflow: auto;">
              <%
                var requestedById = {};
                (request.apartments || []).forEach(function(a) { requestedById[a.id] = a; });
              %>
              <% allApartments.forEach(function(apt) { %>
                <%
                  var requested = requestedById[apt.id];
                  var label = 'Block ' + (apt.block || '') + ' ' + (apt.unitNumberOfficial || '') + ' (' + (apt.unitNumberUnofficial || '') + ')';
                  var checked = Boolean(requested);
                  var defaultRole = requested && requested.role === 'tenant' ? 'tenant' : 'owner';
                  var hasPrimary = Boolean(apt.ownerId);
                %>
                <div class="border-bottom py-2 apt-link-row" data-apt-id="<%= apt.id %>">
                  <div class="form-check">
                    <input class="form-check-input apt-checkbox" type="checkbox" name="apartmentIds" value="<%= apt.id %>" id="apt<%= apt.id %>" <%= checked ? 'checked' : '' %> />
                    <label class="form-check-label" for="apt<%= apt.id %>">
                      <%= label %>
                      <%= apt.ownerName ? ' — current owner: ' + apt.ownerName : ' — no primary owner' %>
                    </label>
                  </div>
                  <div class="row g-2 mt-1 ms-4 apt-options">
                    <div class="col-md-4">
                      <label class="form-label small mb-0" for="role<%= apt.id %>">Role</label>
                      <select class="form-select form-select-sm apt-role" name="apartmentRoles[<%= apt.id %>]" id="role<%= apt.id %>" <%= checked ? '' : 'disabled' %>>
                        <option value="owner" <%= defaultRole === 'owner' ? 'selected' : '' %>>Owner</option>
                        <option value="tenant" <%= defaultRole === 'tenant' ? 'selected' : '' %>>Tenant</option>
                      </select>
                    </div>
                    <div class="col-md-8 apt-action-wrap" style="<%= defaultRole === 'owner' && hasPrimary ? '' : 'display:none;' %>">
                      <label class="form-label small mb-0" for="action<%= apt.id %>">If owner &amp; apartment already has owner</label>
                      <select class="form-select form-select-sm apt-action" name="apartmentActions[<%= apt.id %>]" id="action<%= apt.id %>" <%= checked && defaultRole === 'owner' && hasPrimary ? '' : 'disabled' %>>
                        <option value="add_owner" selected>Add as additional owner (keep current primary)</option>
                        <option value="transfer_primary">Transfer primary ownership</option>
                      </select>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

          <button type="submit" class="btn btn-success">Approve &amp; Email Password</button>
          <a href="/admin/access-requests" class="btn btn-secondary">Cancel</a>
        </form>

        <hr class="my-4" />
        <form method="POST" action="/admin/access-requests/<%= request.id %>/reject"
              onsubmit="return confirm('Reject and delete this request?');">
          <button type="submit" class="btn btn-outline-danger">Reject Request</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var createRadio = document.getElementById('linkModeCreate');
  var existingRadio = document.getElementById('linkModeExisting');
  var select = document.getElementById('existingMemberSelect');
  if (createRadio && existingRadio && select) {
    function syncLinkMode() {
      var useExisting = existingRadio.checked;
      select.disabled = !useExisting;
      select.required = useExisting;
    }
    createRadio.addEventListener('change', syncLinkMode);
    existingRadio.addEventListener('change', syncLinkMode);
    syncLinkMode();
  }

  function syncAptRow(row) {
    var checkbox = row.querySelector('.apt-checkbox');
    var roleSelect = row.querySelector('.apt-role');
    var actionWrap = row.querySelector('.apt-action-wrap');
    var actionSelect = row.querySelector('.apt-action');
    if (!checkbox || !roleSelect) return;

    var enabled = checkbox.checked;
    roleSelect.disabled = !enabled;

    var hasAction = Boolean(actionWrap && actionSelect);
    var showAction = enabled && roleSelect.value === 'owner' && hasAction;
    if (actionWrap) actionWrap.style.display = showAction ? '' : 'none';
    if (actionSelect) actionSelect.disabled = !showAction;
  }

  document.querySelectorAll('.apt-link-row').forEach(function (row) {
    var checkbox = row.querySelector('.apt-checkbox');
    var roleSelect = row.querySelector('.apt-role');
    if (checkbox) checkbox.addEventListener('change', function () { syncAptRow(row); });
    if (roleSelect) roleSelect.addEventListener('change', function () { syncAptRow(row); });
    syncAptRow(row);
  });
})();
</script>
