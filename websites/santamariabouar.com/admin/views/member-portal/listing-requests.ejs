<div class="row">
  <div class="col-xl-12">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">Listing Requests</h4>
      </div>
      <div class="panel-body">
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <div class="mb-3">
          <a href="/admin/listing-requests?status=pending" class="btn btn-sm <%= status === 'pending' ? 'btn-primary' : 'btn-outline-primary' %>">Pending</a>
          <a href="/admin/listing-requests?status=approved" class="btn btn-sm <%= status === 'approved' ? 'btn-primary' : 'btn-outline-primary' %>">Approved</a>
          <a href="/admin/listing-requests?status=rejected" class="btn btn-sm <%= status === 'rejected' ? 'btn-primary' : 'btn-outline-primary' %>">Rejected</a>
          <a href="/admin/listing-requests?status=all" class="btn btn-sm <%= status === 'all' ? 'btn-primary' : 'btn-outline-primary' %>">All</a>
        </div>

        <div class="table-responsive">
          <table class="table table-striped table-bordered align-middle">
            <thead>
              <tr>
                <th>Date</th>
                <th>Apartment</th>
                <th>Requested by</th>
                <th>Request</th>
                <th>Details</th>
                <th>Photos</th>
                <th>Status</th>
                <th width="1%">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (requests && requests.length) { %>
                <% requests.forEach(function(r) { %>
                  <%
                    function priceText(req) {
                      if (req.contactForPrice) return 'Contact for price';
                      if (req.priceUsd == null || req.priceUsd <= 0) return '—';
                      return '$' + Number(req.priceUsd).toLocaleString('en-US') + (req.priceNegotiable ? ' (negotiable)' : '');
                    }
                  %>
                  <tr>
                    <td><%= r.createdAt ? new Date(r.createdAt).toLocaleString() : '—' %></td>
                    <td>
                      <%= r.apartmentLabel %>
                      <% if (r.ownerName) { %><br><small>Owner: <%= r.ownerName %></small><% } %>
                    </td>
                    <td>
                      <%= r.requesterName || '—' %>
                      <% if (r.requesterEmail) { %><br><small><%= r.requesterEmail %></small><% } %>
                      <% if (r.requesterPhone) { %><br><small><%= r.requesterPhone %></small><% } %>
                    </td>
                    <td><%= r.requestType === 'for_sale' ? 'For Sale' : 'For Rent' %></td>
                    <td style="max-width: 320px;">
                      <div><strong>Price:</strong> <%= priceText(r) %></div>
                      <div><strong>Beds/Baths:</strong> <%= r.bedrooms %> / <%= r.bathrooms %></div>
                      <div><strong>Parking:</strong> <%= r.parkingSpaces %></div>
                      <div><strong>Furnished:</strong> <%= r.isFurnished ? 'Yes' : 'No' %></div>
                      <div>
                        <strong>Features:</strong>
                        <%= [r.hasGarden ? 'Garden' : null, r.hasTerrace ? 'Terrace' : null, r.hasBalcony ? 'Balcony' : null, r.hasStorageRoom ? 'Storage' : null].filter(Boolean).join(', ') || '—' %>
                      </div>
                      <% if (r.requestType === 'for_rent' && r.availabilityDate) { %>
                        <div><strong>Available:</strong> <%= r.availabilityDate %></div>
                      <% } %>
                      <% if (r.requestType === 'for_rent' && r.petFriendly != null) { %>
                        <div><strong>Pet friendly:</strong> <%= r.petFriendly ? 'Yes' : 'No' %></div>
                      <% } %>
                      <% if (r.description) { %>
                        <div class="mt-2" style="white-space: pre-wrap;"><strong>Description:</strong><br><%= r.description %></div>
                      <% } %>
                    </td>
                    <td>
                      <%= r.approvedPhotoCount || 0 %> approved
                      <% if ((r.approvedPhotoCount || 0) < 1) { %>
                        <br><span class="text-danger">No approved photos</span>
                      <% } %>
                      <br><a href="/admin/apartments/<%= r.apartmentId %>/edit" target="_blank" rel="noopener">View apartment</a>
                    </td>
                    <td><%= r.status %></td>
                    <td class="text-nowrap">
                      <% if (r.status === 'pending') { %>
                        <% if ((r.approvedPhotoCount || 0) < 1) { %>
                          <span class="text-muted">Approve blocked</span>
                        <% } else { %>
                          <form method="POST" action="/admin/listing-requests/<%= r.id %>/approve" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                          </form>
                        <% } %>
                        <form method="POST" action="/admin/listing-requests/<%= r.id %>/reject" class="d-inline">
                          <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                        </form>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="8" class="text-center">No listing requests.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
