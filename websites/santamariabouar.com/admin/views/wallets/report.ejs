<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof siteTitle !== 'undefined' && siteTitle ? siteTitle : 'Santa Maria Bouar' %> | Wallet Statement</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .report-header { text-align: center; margin-bottom: 30px; }
        .summary-cards { display: flex; gap: 10px; margin-bottom: 25px; }
        .summary-card { flex: 1; text-align: center; border: 1px solid #ddd; padding: 15px; background: white; border-radius: 5px; }
        .summary-card h5 { font-size: 18px; margin: 0 0 5px 0; font-weight: bold; }
        .summary-card p { font-size: 12px; margin: 0; color: #666; }
        .apartment-header { background-color: #f8f9fa; padding: 15px; border: 1px solid #dee2e6; border-radius: 5px; margin-bottom: 20px; }

        @media print {
            @page { size: A4; margin: 0.2in; }
            * { -webkit-print-color-adjust: exact !important; color-adjust: exact !important; }
            .no-print, .account-col { display: none !important; }
            html, body { font-family: Arial, sans-serif; font-size: 10px; color: #000 !important; background: white !important; }
            .container-fluid { margin: 0 !important; padding: 0 !important; max-width: 100% !important; }
        }
    </style>
</head>
<body>
<div class="container-fluid py-3">

    <div class="report-header">
        <h1><i class="fas fa-wallet text-success"></i> <%= pageTitle %></h1>
        <h4 class="text-muted"><%= pageSubtitle %></h4>
        <p class="text-muted small">Generated on: <%= reportDate %></p>
    </div>

    <div class="no-print mb-3 d-flex gap-2">
        <button onclick="window.print()" class="btn btn-success">
            <i class="fas fa-print"></i> Print Statement
        </button>
        <a href="/admin/wallets/<%= apartment.id %>" class="btn btn-outline-success">
            <i class="fas fa-wallet"></i> Manage Wallet
        </a>
        <a href="/admin/wallets" class="btn btn-outline-secondary">
            <i class="fas fa-list"></i> All Wallets
        </a>
    </div>

    <div class="apartment-header">
        <div class="row">
            <div class="col-md-4">
                <strong>Block:</strong> <%= apartment.block %>
            </div>
            <div class="col-md-4">
                <strong>Unit:</strong> <%= apartment.unitNumberOfficial %><% if (apartment.unitNumberUnofficial) { %> (<%= apartment.unitNumberUnofficial %>)<% } %>
            </div>
            <div class="col-md-4">
                <strong>Owner:</strong> <%= apartment.ownerName || '—' %>
            </div>
        </div>
    </div>

    <div class="summary-cards">
        <div class="summary-card">
            <h5 class="text-success">$<%= totalAdded.toFixed(2) %></h5>
            <p>Total Added</p>
        </div>
        <div class="summary-card">
            <h5 class="text-danger">$<%= totalSubtracted.toFixed(2) %></h5>
            <p>Total Subtracted</p>
        </div>
        <div class="summary-card">
            <h5>$<%= walletBalance.toFixed(2) %></h5>
            <p>Current Balance</p>
        </div>
        <div class="summary-card">
            <h5><%= entries.length %></h5>
            <p>Movements</p>
        </div>
    </div>

    <table class="table table-bordered table-sm align-middle">
        <thead class="table-light">
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Description</th>
                <th class="account-col">Account</th>
                <th>Transaction</th>
                <th class="text-end">Amount</th>
                <th class="text-end">Balance</th>
            </tr>
        </thead>
        <tbody>
            <% entries.forEach(function(entry) { %>
            <tr>
                <td><%= entry.date ? new Date(entry.date).toLocaleDateString() : new Date(entry.createdAt).toLocaleDateString() %></td>
                <td>
                    <% if (entry.amount < 0 && /^wallet payment\b/i.test(entry.description || '')) { %>
                        <span class="text-warning">Invoice payment</span>
                    <% } else if (entry.amount < 0) { %>
                        <span class="text-danger">Deduction</span>
                    <% } else { %>
                        <span class="text-success">Top-up</span>
                    <% } %>
                </td>
                <td><%= entry.description || '—' %></td>
                <td class="account-col"><%= entry.accountName || '—' %></td>
                <td><%= entry.transactionId ? '#' + entry.transactionId : '—' %></td>
                <td class="text-end <%= entry.amount < 0 ? 'text-danger' : 'text-success' %>">
                    <%= entry.amount < 0 ? '-' : '+' %>$<%= Math.abs(entry.amount).toFixed(2) %>
                </td>
                <td class="text-end">$<%= entry.runningBalance.toFixed(2) %></td>
            </tr>
            <% }); %>
            <% if (entries.length === 0) { %>
            <tr>
                <td colspan="7" class="text-center text-muted py-4">No wallet movements recorded for this apartment.</td>
            </tr>
            <% } %>
        </tbody>
        <% if (entries.length > 0) { %>
        <tfoot>
            <tr class="table-light">
                <th colspan="3" class="text-end">Closing balance</th>
                <th class="account-col"></th>
                <th></th>
                <th></th>
                <th class="text-end">$<%= walletBalance.toFixed(2) %></th>
            </tr>
        </tfoot>
        <% } %>
    </table>

    <p class="text-muted small mt-4">
        Wallet movements are recorded as Wallet Adjustment transactions and are excluded from the main transactions report.
    </p>
</div>
</body>
</html>
