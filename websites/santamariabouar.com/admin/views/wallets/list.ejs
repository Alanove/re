<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title"><i class="fa fa-wallet text-success"></i> <%= pageTitle %></h4>
				<div class="panel-heading-btn">
					<a href="/admin/reports/credits-report" class="btn btn-xs btn-info" target="_blank">
						<i class="fa fa-chart-bar"></i> Wallet Report
					</a>
				</div>
			</div>
			<div class="panel-body">
				<p class="text-muted mb-3"><%= pageSubtitle %></p>

				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong>Success!</strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>

				<div class="row mb-4">
					<div class="col-md-4">
						<div class="card border-success">
							<div class="card-body text-center">
								<h6 class="text-muted mb-1">Total Wallet Balance</h6>
								<h3 class="text-success mb-0">$<%= summary.totalBalance.toFixed(2) %></h3>
							</div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="card">
							<div class="card-body text-center">
								<h6 class="text-muted mb-1">Apartments with Balance</h6>
								<h3 class="mb-0"><%= summary.apartmentsWithBalance %></h3>
							</div>
						</div>
					</div>
					<div class="col-md-4">
						<div class="card">
							<div class="card-body text-center">
								<h6 class="text-muted mb-1">Wallet Entries</h6>
								<h3 class="mb-0"><%= summary.entryCount %></h3>
							</div>
						</div>
					</div>
				</div>

				<form method="GET" class="row g-2 mb-3">
					<div class="col-md-3">
						<select name="block" class="form-select">
							<option value="">All Blocks</option>
							<% ['A','B','C','D','E','F','G','H','I','J'].forEach(function(b) { %>
								<option value="<%= b %>" <%= filters.block === b ? 'selected' : '' %>>Block <%= b %></option>
							<% }); %>
						</select>
					</div>
					<div class="col-md-4">
						<input type="text" name="search" class="form-control" placeholder="Search owner or unit..." value="<%= filters.search %>">
					</div>
					<div class="col-md-3">
						<div class="form-check mt-2">
							<input class="form-check-input" type="checkbox" name="withBalance" value="1" id="withBalance" <%= filters.withBalance ? 'checked' : '' %>>
							<label class="form-check-label" for="withBalance">Only apartments with balance</label>
						</div>
					</div>
					<div class="col-md-2">
						<button type="submit" class="btn btn-primary w-100"><i class="fa fa-filter"></i> Filter</button>
					</div>
				</form>

				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle" id="walletsTable">
						<thead>
							<tr>
								<th>Block</th>
								<th>Unit (Official)</th>
								<th>Owner</th>
								<th class="text-end">Wallet Balance</th>
								<th width="1%">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% apartments.forEach(function(apt) { %>
							<tr data-block="<%= apt.block %>">
								<td><span class="badge bg-primary">Block <%= apt.block %></span></td>
								<td><%= apt.unitNumberOfficial %><% if (apt.unitNumberUnofficial) { %> <small class="text-muted">(<%= apt.unitNumberUnofficial %>)</small><% } %></td>
								<td><%= apt.ownerName || '—' %></td>
								<td class="text-end">
									<% if (apt.walletBalance > 0.001) { %>
										<span class="badge bg-success fs-6">$<%= apt.walletBalance.toFixed(2) %></span>
									<% } else { %>
										<span class="text-muted">$0.00</span>
									<% } %>
								</td>
								<td>
									<div class="btn-group" style="white-space: nowrap;">
										<a href="/admin/wallets/<%= apt.id %>" class="btn btn-sm btn-success" title="Manage Wallet">
											<i class="fa fa-wallet"></i> Manage
										</a>
										<a href="/admin/wallets/<%= apt.id %>?action=add" class="btn btn-sm btn-outline-success" title="Add Balance">
											<i class="fa fa-plus"></i>
										</a>
										<a href="/admin/wallets/<%= apt.id %>?action=subtract" class="btn btn-sm btn-outline-danger" title="Subtract Balance">
											<i class="fa fa-minus"></i>
										</a>
										<a href="/admin/wallets/<%= apt.id %>/report" class="btn btn-sm btn-outline-info" title="Wallet Statement" target="_blank">
											<i class="fa fa-file-invoice"></i>
										</a>
										<a href="/admin/transactions/create?apartmentId=<%= apt.id %>" class="btn btn-sm btn-primary" title="Record Payment">
											<i class="fa fa-money-bill-wave"></i>
										</a>
									</div>
								</td>
							</tr>
							<% }); %>
							<% if (apartments.length === 0) { %>
							<tr>
								<td colspan="5" class="text-center text-muted py-4">No apartments match your filters.</td>
							</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- END content area -->
