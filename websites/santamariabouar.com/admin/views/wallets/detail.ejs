<!-- BEGIN content area -->
<div id="wallet-detail-page" data-apartment-id="<%= apartment.id %>" data-open-action="<%= typeof openAction !== 'undefined' ? openAction : '' %>">
<div class="row">
	<div class="col-xl-12">
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title"><i class="fa fa-wallet text-success"></i> <%= pageTitle %></h4>
				<div class="panel-heading-btn d-flex gap-2">
					<a href="/admin/wallets" class="btn btn-xs btn-secondary">
						<i class="fa fa-arrow-left"></i> All Wallets
					</a>
					<a href="/admin/wallets/<%= apartment.id %>/report" class="btn btn-xs btn-info" target="_blank">
						<i class="fa fa-file-invoice"></i> Wallet Statement
					</a>
					<button type="button" class="btn btn-xs btn-success" id="openAddWalletBtn">
						<i class="fa fa-plus"></i> Add Balance
					</button>
					<button type="button" class="btn btn-xs btn-danger" id="openSubtractWalletBtn">
						<i class="fa fa-minus"></i> Subtract Balance
					</button>
				</div>
			</div>
			<div class="panel-body">
				<p class="text-muted mb-3"><%= pageSubtitle %></p>

				<div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
					<div>
						<strong>Current wallet balance:</strong>
						<span class="fs-4 text-success ms-2">$<%= walletBalance.toFixed(2) %></span>
					</div>
					<div class="small text-muted">
						Added <strong class="text-success">$<%= (typeof totalAdded !== 'undefined' ? totalAdded : 0).toFixed(2) %></strong>
						&nbsp;&middot;&nbsp;
						Subtracted <strong class="text-danger">$<%= (typeof totalSubtracted !== 'undefined' ? totalSubtracted : 0).toFixed(2) %></strong>
					</div>
					<small class="text-muted">Recorded as Wallet Adjustment transactions, excluded from the main transactions report</small>
				</div>

				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th>Date</th>
								<th>Type</th>
								<th>Description</th>
								<th>Account</th>
								<th>Linked Payment</th>
								<th class="text-end">Amount</th>
								<th class="text-end">Balance</th>
								<th width="1%">Actions</th>
							</tr>
						</thead>
						<tbody>
							<% entries.forEach(function(entry) { %>
							<tr>
								<td><small><%= entry.date ? new Date(entry.date).toLocaleDateString() : new Date(entry.createdAt).toLocaleDateString() %></small></td>
								<td>
									<% if (entry.amount < 0 && /^wallet payment\b/i.test(entry.description || '')) { %>
										<span class="badge bg-warning text-dark">Invoice payment</span>
									<% } else if (entry.amount < 0) { %>
										<span class="badge bg-danger">Deduction</span>
									<% } else if (entry.source === 'payment') { %>
										<span class="badge bg-primary">Top-up</span>
									<% } else { %>
										<span class="badge bg-secondary">Manual Adjustment</span>
									<% } %>
								</td>
								<td><small><%= entry.description || '—' %></small></td>
								<td><small><%= entry.accountName || '—' %></small></td>
								<td>
									<% if (entry.transactionId) { %>
										<a href="/admin/transactions/<%= entry.transactionId %>/edit">Transaction #<%= entry.transactionId %></a>
									<% } else { %>
										<span class="text-muted">—</span>
									<% } %>
								</td>
								<td class="text-end">
									<strong class="<%= entry.amount < 0 ? 'text-danger' : 'text-success' %>">
										<%= entry.amount < 0 ? '-' : '+' %>$<%= Math.abs(entry.amount).toFixed(2) %>
									</strong>
								</td>
								<td class="text-end"><small>$<%= entry.runningBalance.toFixed(2) %></small></td>
								<td>
									<div class="btn-group btn-group-sm">
										<button type="button" class="btn btn-primary wallet-edit-btn" title="Edit"
											data-entry-id="<%= entry.id %>"
											data-entry-amount="<%= entry.amount %>"
											data-entry-description="<%= encodeURIComponent(entry.description || '') %>"
											data-has-transaction="<%= entry.transactionId ? '1' : '0' %>">
											<i class="fa fa-edit"></i>
										</button>
										<button type="button" class="btn btn-danger wallet-delete-btn" title="Delete"
											data-entry-id="<%= entry.id %>"
											data-entry-amount="<%= entry.amount %>">
											<i class="fa fa-trash"></i>
										</button>
									</div>
								</td>
							</tr>
							<% }); %>
							<% if (entries.length === 0) { %>
							<tr>
								<td colspan="8" class="text-center text-muted py-4">
									No wallet entries yet. Use <strong>Add Balance</strong> to record a payment into this apartment&rsquo;s wallet.
								</td>
							</tr>
							<% } %>
						</tbody>
						<% if (entries.length > 0) { %>
						<tfoot>
							<tr class="table-success">
								<th colspan="5" class="text-end">Total</th>
								<th class="text-end">$<%= walletBalance.toFixed(2) %></th>
								<th colspan="2"></th>
							</tr>
						</tfoot>
						<% } %>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
</div>
<!-- END content area -->

<!-- Add Wallet Entry Modal -->
<div class="modal fade" id="addWalletModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title"><i class="fa fa-plus-circle"></i> Add Wallet Balance</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<p class="text-muted small">Records an income transaction and adds the amount to this apartment&rsquo;s wallet.</p>
				<div class="mb-3">
					<label class="form-label">Amount ($) *</label>
					<input type="number" class="form-control" id="addWalletAmount" step="0.01" min="0.01" placeholder="0.00">
				</div>
				<div class="mb-3">
					<label class="form-label">Account *</label>
					<select class="form-select" id="addWalletAccount" required>
						<option value="">Select account</option>
						<% accounts.forEach(function(acc) { %>
							<option value="<%= acc.id %>"><%= acc.name %> ($<%= (acc.balance != null ? acc.balance.toFixed(2) : '0.00') %>)</option>
						<% }); %>
					</select>
				</div>
				<div class="mb-3">
					<label class="form-label">Date *</label>
					<input type="date" class="form-control" id="addWalletDate" value="<%= defaultDate %>">
				</div>
				<div class="mb-3">
					<label class="form-label">Description</label>
					<input type="text" class="form-control" id="addWalletDescription" value="<%= defaultDescription %>">
				</div>
				<div id="addWalletFeedback" class="d-none"></div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-success" id="addWalletSubmitBtn">
					<i class="fa fa-save"></i> Record &amp; Add Balance
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Subtract Wallet Entry Modal -->
<div class="modal fade" id="subtractWalletModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-danger text-white">
				<h5 class="modal-title"><i class="fa fa-minus-circle"></i> Subtract Wallet Balance</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<p class="text-muted small">Records an expense transaction from the selected account and reduces this apartment&rsquo;s wallet.</p>
				<div class="alert alert-light border small mb-3">
					Available balance: <strong>$<%= walletBalance.toFixed(2) %></strong>
				</div>
				<div class="mb-3">
					<label class="form-label">Amount ($) *</label>
					<input type="number" class="form-control" id="subtractWalletAmount" step="0.01" min="0.01" max="<%= walletBalance.toFixed(2) %>" placeholder="0.00">
				</div>
				<div class="mb-3">
					<label class="form-label">Account *</label>
					<select class="form-select" id="subtractWalletAccount" required>
						<option value="">Select account</option>
						<% accounts.forEach(function(acc) { %>
							<option value="<%= acc.id %>"><%= acc.name %> ($<%= (acc.balance != null ? acc.balance.toFixed(2) : '0.00') %>)</option>
						<% }); %>
					</select>
				</div>
				<div class="mb-3">
					<label class="form-label">Date *</label>
					<input type="date" class="form-control" id="subtractWalletDate" value="<%= defaultDate %>">
				</div>
				<div class="mb-3">
					<label class="form-label">Description *</label>
					<textarea class="form-control" id="subtractWalletDescription" rows="2" placeholder="Reason for this deduction"></textarea>
				</div>
				<div id="subtractWalletFeedback" class="d-none"></div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger" id="subtractWalletSubmitBtn">
					<i class="fa fa-save"></i> Record &amp; Subtract Balance
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Edit Wallet Entry Modal -->
<div class="modal fade" id="editWalletModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title"><i class="fa fa-edit"></i> Edit Wallet Entry</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<p class="text-muted small">Updates the wallet amount and the linked transaction when one exists.</p>
				<div class="mb-3">
					<label class="form-label">Amount ($) *</label>
					<input type="number" class="form-control" id="editWalletAmount" step="0.01" min="0.01">
					<div class="form-text" id="editWalletTypeLabel"></div>
				</div>
				<div class="mb-3" id="editWalletDescriptionGroup">
					<label class="form-label">Description <span id="editWalletDescriptionRequiredMark">*</span></label>
					<textarea class="form-control" id="editWalletDescription" rows="2" placeholder="Description for this wallet entry"></textarea>
					<div class="form-text" id="editWalletDescriptionHint"></div>
				</div>
				<div id="editWalletFeedback" class="d-none"></div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-primary" id="editWalletSubmitBtn">
					<i class="fa fa-save"></i> Save Changes
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteWalletModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-danger text-white">
				<h5 class="modal-title"><i class="fa fa-exclamation-triangle"></i> Remove Wallet Entry</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<p>Remove this wallet entry of <strong id="deleteWalletAmountLabel"></strong>?</p>
				<p class="text-muted small mb-0">The linked transaction will also be deleted when one exists.</p>
				<div id="deleteWalletFeedback" class="d-none mt-2"></div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-danger" id="deleteWalletSubmitBtn">
					<i class="fa fa-trash"></i> Remove Entry
				</button>
			</div>
		</div>
	</div>
</div>
