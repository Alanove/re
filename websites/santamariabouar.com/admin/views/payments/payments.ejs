<!-- BEGIN content area -->
<style media="print">
  body > * {
    display: none !important;
  }
  body > .modal-backdrop {
    display: none !important;
  }
  #simulationModal.show,
  #interestSimulationModal.show {
    display: block !important;
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    padding: 0;
    overflow: visible !important;
    background: white !important;
  }
  #simulationModal .modal-dialog,
  #interestSimulationModal .modal-dialog {
    max-width: 100%;
    margin: 0;
    padding: 0;
    transform: none !important;
  }
  #simulationModal .modal-content,
  #interestSimulationModal .modal-content {
    border: none;
    box-shadow: none;
  }
  #simulationModal .modal-header,
  #simulationModal .modal-footer,
  #interestSimulationModal .modal-header,
  #interestSimulationModal .modal-footer {
    display: none !important;
  }
  #simulationModal .modal-body,
  #interestSimulationModal .modal-body {
    padding: 0;
  }
  /* Show only the content we want */
  #simulationContent,
  #interestSimulationContent {
    display: block !important;
  } 
  
  /* Ensure tables are visible and readable */
  .table {
    width: 100% !important;
    border-collapse: collapse !important;
  }
  .card {
    border: none !important;
    break-inside: avoid;
  }
  .card-header {
    background-color: #f8f9fa !important;
    border-bottom: 2px solid #dee2e6 !important;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
</style>
<div class="row">
  <!-- BEGIN col-9 -->
  <div class="col-9">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">Price per Meter Management</h4>
        <div class="panel-heading-btn">
          <button type="button" class="btn btn-xs btn-success" data-bs-toggle="modal" data-bs-target="#addPriceModal">
            <i class="fa fa-plus"></i> Add Price
          </button>
        </div>
      </div>
      <div class="panel-body">
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <div class="table-responsive">
          <table class="table table-striped table-bordered align-middle">
            <thead>
              <tr>
                <th width="200px">Year</th>
                <th>Price per M²</th>
                <th width="100px">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (pricePerMeter && pricePerMeter.length > 0) { %>
                <% pricePerMeter.forEach(function(entry) { %>
                <tr data-year="<%= entry.year %>">
                  <td>
                    <span class="badge bg-primary fs-6"><%= entry.year %></span>
                  </td>
                  <td>
                    <span class="fw-bold text-success">$<%= entry.price.toFixed(2) %></span>
                  </td>
                  <td>
                    <div class="btn-group">
                      <button type="button" class="btn btn-sm btn-primary" onclick="editPrice(<%= entry.year %>, <%= entry.price %>)" title="Edit">
                        <i class="fa fa-edit"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-success" onclick="generatePayments(<%= entry.year %>)" title="Generate Payments">
                        <i class="fa fa-calculator"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-info" onclick="simulatePayments(<%= entry.year %>)" title="Simulate Payments">
                        <i class="fa fa-list-alt"></i>
                      </button>
                      <button type="button" class="btn btn-sm btn-danger" onclick="deletePrice(<%= entry.year %>)" title="Delete">
                        <i class="fa fa-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
                <% }); %>
              <% } else { %>
              <tr>
                <td colspan="3" class="text-center text-muted">
                  <i class="fa fa-money-bill fa-3x mb-3"></i><br>
                  No price data found. <button type="button" class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#addPriceModal">Add the first price entry</button>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <!-- END col-9 -->

  <!-- BEGIN col-3 -->
  <div class="col-3">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">Payment Statistics</h4>
      </div>
      <div class="panel-body">
        <div class="mb-15px">
          <label class="form-label">Overview</label>
          <div class="border rounded p-3 bg-light">
            <div class="mb-2">
              <strong>Total Years:</strong> <%= paymentStats.totalYears %>
            </div>
            <div class="mb-2">
              <strong>Average Price:</strong> 
              <span class="text-success">$<%= paymentStats.averagePrice.toFixed(2) %></span>
            </div>
            <% if (paymentStats.latestYear) { %>
            <div class="mb-2">
              <strong>Latest Year:</strong> <%= paymentStats.latestYear %>
            </div>
            <div class="mb-2">
              <strong>Current Price:</strong> 
              <span class="text-primary fw-bold">$<%= paymentStats.latestPrice.toFixed(2) %></span>
            </div>
            <% } %>
          </div>
        </div>

        <div class="mb-15px">
          <label class="form-label">Quick Actions</label>
          <div class="d-grid gap-2">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addPriceModal">
              <i class="fa fa-plus"></i> Add New Price
            </button>
            <% if (paymentStats.latestYear) { %>
            <button type="button" class="btn btn-primary" onclick="editPrice(<%= paymentStats.latestYear %>, <%= paymentStats.latestPrice %>)">
              <i class="fa fa-edit"></i> Edit Current Price
            </button>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- END col-3 -->
</div>

<div class="row mt-3">
  <div class="col-9">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">Yearly Interest Rate</h4>
      </div>
      <div class="panel-body">
        <form action="/admin/payments/set-interest-rate" method="POST" class="row g-3 align-items-end mb-4">
          <div class="col-md-4">
            <label for="interestRate" class="form-label">Yearly interest rate</label>
            <div class="input-group">
              <input type="number" class="form-control" id="interestRate" name="rate" step="0.01" min="0" max="100" required value="<%= Number(yearlyInterestRate).toFixed(2) %>">
              <span class="input-group-text">%</span>
            </div>
          </div>
          <div class="col-md-3">
            <button type="submit" class="btn btn-primary">
              <i class="fa fa-save"></i> Save Rate
            </button>
          </div>
        </form>

        <hr>

        <div class="row g-3 align-items-end">
          <div class="col-md-4">
            <label for="interestYear" class="form-label">Create interest invoices for year</label>
            <select class="form-select" id="interestYear">
              <% (interestYears || []).forEach(function(year) { %>
                <option value="<%= year %>" <%= year === currentYear ? 'selected' : '' %>><%= year %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-8">
            <button type="button" class="btn btn-info" onclick="simulateInterestInvoices()">
              <i class="fa fa-list-alt"></i> Simulate
            </button>
            <button type="button" class="btn btn-success" onclick="generateInterestInvoices()">
              <i class="fa fa-calculator"></i> Generate
            </button>
          </div>
        </div>
        <p class="text-muted small mt-3 mb-0">
          Interest is <%= Number(yearlyInterestRate).toFixed(2) %>% of each apartment’s unpaid invoices from earlier years (including unpaid interest). Apartments that already have an Interest invoice for the selected year are skipped.
        </p>
      </div>
    </div>
  </div>
  <div class="col-3">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">Interest</h4>
      </div>
      <div class="panel-body">
        <div class="border rounded p-3 bg-light">
          <div class="mb-2">
            <strong>Current rate:</strong>
            <span class="text-primary fw-bold"><%= Number(yearlyInterestRate).toFixed(2) %>%</span>
          </div>
          <p class="small text-muted mb-0">
            Simulate first, then generate. Current-year invoices are not charged until the following year.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- END content area -->

<!-- Generate Payments Confirmation Modal -->
<div class="modal fade" id="generatePaymentsModal" tabindex="-1" aria-labelledby="generatePaymentsModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="generatePaymentsModalLabel">Generate Apartment Payments</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info">
          <i class="fa fa-info-circle"></i>
          <strong>Note:</strong> This will generate payment records for apartments that don't already have payments for the selected year. Not sold apartments are excluded.
        </div>
        <p>Are you sure you want to generate apartment payments for year <span id="generateYearDisplay"></span>?</p>
        <div id="generatePaymentsInfo" class="mt-3">
          <!-- Dynamic content will be inserted here -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" id="confirmGeneratePayments">
          <i class="fa fa-calculator"></i> Generate Payments
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Simulation Modal -->
<div class="modal fade" id="simulationModal" tabindex="-1" aria-labelledby="simulationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="simulationModalLabel">Payment Simulation Report <span id="simulationYearDisplay"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="simulationLoading" class="text-center py-5" style="display: none;">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2">Calculating simulation...</p>
        </div>
        
        <div id="simulationContent" style="display: none;">
          <div class="alert alert-info">
            <i class="fa fa-info-circle"></i> This is a simulation based on the current price of <strong>$<span id="simulationPriceDisplay"></span>/m²</strong>.
          </div>
          
          <div id="simulationTables">
            <!-- Dynamic content -->
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" onclick="window.print()">Print Report</button>
      </div>
    </div>
  </div>
</div>

<!-- Generate Interest Confirmation Modal -->
<div class="modal fade" id="generateInterestModal" tabindex="-1" aria-labelledby="generateInterestModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="generateInterestModalLabel">Generate Interest Invoices</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-info">
          <i class="fa fa-info-circle"></i>
          <strong>Note:</strong> This will create Interest invoices for apartments that do not already have one for the selected year. Amounts are based on unpaid invoices from earlier years.
        </div>
        <p>Generate interest invoices for year <span id="generateInterestYearDisplay"></span>?</p>
        <div id="generateInterestInfo" class="mt-3">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" id="confirmGenerateInterest">
          <i class="fa fa-calculator"></i> Generate Interest Invoices
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Interest Simulation Modal -->
<div class="modal fade" id="interestSimulationModal" tabindex="-1" aria-labelledby="interestSimulationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="interestSimulationModalLabel">Interest Simulation Report <span id="interestSimulationYearDisplay"></span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="interestSimulationLoading" class="text-center py-5" style="display: none;">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2">Calculating interest simulation...</p>
        </div>
        
        <div id="interestSimulationContent" style="display: none;">
          <div class="alert alert-info">
            <i class="fa fa-info-circle"></i> This is a simulation at <strong><span id="interestSimulationRateDisplay"></span>%</strong> of unpaid invoices from earlier years.
          </div>
          
          <div id="interestSimulationTables">
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" onclick="window.print()">Print Report</button>
      </div>
    </div>
  </div>
</div>

<!-- Add/Edit Price Modal -->
<div class="modal fade" id="addPriceModal" tabindex="-1" aria-labelledby="addPriceModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="priceForm" action="/admin/payments/set-price" method="POST">
        <div class="modal-header">
          <h5 class="modal-title" id="addPriceModalLabel">Add Price per Meter</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="year" class="form-label">Year <span class="text-danger">*</span></label>
            <input type="number" class="form-control" id="year" name="year" min="1900" max="2100" required>
            <div class="form-text">Enter the year for this price setting</div>
          </div>
          <div class="mb-3">
            <label for="price" class="form-label">Price per M² <span class="text-danger">*</span></label>
            <div class="input-group">
              <span class="input-group-text">$</span>
              <input type="number" class="form-control" id="price" name="price" step="0.01" min="0" required>
            </div>
            <div class="form-text">Enter the price per square meter</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">
            <i class="fa fa-save"></i> Save Price
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
// Edit price function
function editPrice(year, price) {
  document.getElementById('year').value = year;
  document.getElementById('price').value = price;
  document.getElementById('addPriceModalLabel').textContent = 'Edit Price per Meter';
  
  const modal = new bootstrap.Modal(document.getElementById('addPriceModal'));
  modal.show();
}

// Delete price function
function deletePrice(year) {
  if (confirm(`Are you sure you want to delete the price for year ${year}?`)) {
    fetch(`/admin/payments/price/${year}`, {
      method: 'DELETE',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        location.reload();
      } else {
        alert('Error: ' + data.error);
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Failed to delete price');
    });
  }
}

// Generate payments function
function generatePayments(year) {
  // Set the year in the modal
  document.getElementById('generateYearDisplay').textContent = year;
  
  // Show loading state
  document.getElementById('generatePaymentsInfo').innerHTML = '<div class="text-center"><i class="fa fa-spinner fa-spin"></i> Loading apartment information...</div>';
  
  // Reset buttons
  document.getElementById('confirmGeneratePayments').style.display = 'block';
  document.getElementById('confirmGeneratePayments').disabled = true; // Disable until simulation loaded
  
  // Show the modal
  const modal = new bootstrap.Modal(document.getElementById('generatePaymentsModal'));
  modal.show();
  
  // Fetch missing payments simulation
  fetch('/admin/payments/simulate', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ year: year, onlyMissing: true })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      const container = document.getElementById('generatePaymentsInfo');
      
      if (data.simulation.length === 0) {
        container.innerHTML = `
          <div class="alert alert-success">
            <i class="fa fa-check-circle"></i> All apartments already have invoices for year ${year}.
          </div>
        `;
        document.getElementById('confirmGeneratePayments').style.display = 'none';
        return;
      }
      
      let totalToGenerate = 0;
      let aptCount = 0;
      let tablesHtml = '<div style="max-height: 300px; overflow-y: auto;">';
      
      data.simulation.forEach(group => {
        tablesHtml += `
          <div class="mb-2">
            <div class="bg-light p-1 px-2 fw-bold small border rounded-top">Block ${group.block}</div>
            <table class="table table-sm table-bordered mb-0" style="font-size: 0.85rem;">
              <tbody>
        `;
        
        group.apartments.forEach(apt => {
          totalToGenerate += apt.amount;
          aptCount++;
          const displayUnit = `${apt.block}${apt.unitNumberUnofficial || ''}(${apt.unitNumber})`;
          tablesHtml += `
            <tr>
              <td>${displayUnit}</td>
              <td>${apt.ownerName}</td>
              <td class="text-end">$${apt.amount.toFixed(2)}</td>
            </tr>
          `;
        });
        
        tablesHtml += '</tbody></table></div>';
      });
      
      tablesHtml += '</div>';
      
      container.innerHTML = `
        <div class="alert alert-warning mb-3">
          <i class="fa fa-info-circle"></i> Found <strong>${aptCount}</strong> apartments requiring new invoices for <strong>$${totalToGenerate.toFixed(2)}</strong> total.
        </div>
        ${tablesHtml}
      `;
      
      document.getElementById('confirmGeneratePayments').disabled = false;
    } else {
      document.getElementById('generatePaymentsInfo').innerHTML = `<div class="alert alert-danger">Error: ${data.error}</div>`;
    }
  })
  .catch(error => {
    console.error('Error fetching simulation:', error);
    document.getElementById('generatePaymentsInfo').innerHTML = '<div class="alert alert-danger">Failed to load preview.</div>';
  });
  
  // Set up the confirm button
  document.getElementById('confirmGeneratePayments').onclick = function() {
    // Disable button and show loading
    this.disabled = true;
    this.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Generating...';
    
    fetch('/admin/payments/generate-payments', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ year: year })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Show success message
        document.getElementById('generatePaymentsInfo').innerHTML = `
          <div class="alert alert-success">
            <i class="fa fa-check-circle"></i>
            <strong>Success!</strong> ${data.message}
            ${data.newPaymentsCount > 0 ? `<br><small>Generated ${data.newPaymentsCount} new payment records.</small>` : ''}
          </div>
        `;
        
        // Hide the confirm button and show close button
        document.getElementById('confirmGeneratePayments').style.display = 'none';
        document.querySelector('#generatePaymentsModal .btn-secondary').innerHTML = '<i class="fa fa-check"></i> Close';
        
        // Reload page after a short delay
        setTimeout(() => {
          location.reload();
        }, 2000);
      } else {
        // Show error message
        document.getElementById('generatePaymentsInfo').innerHTML = `
          <div class="alert alert-danger">
            <i class="fa fa-exclamation-circle"></i>
            <strong>Error:</strong> ${data.error}
          </div>
        `;
        
        // Reset button
        document.getElementById('confirmGeneratePayments').disabled = false;
        document.getElementById('confirmGeneratePayments').innerHTML = '<i class="fa fa-calculator"></i> Generate Payments';
      }
    })
    .catch(error => {
      console.error('Error:', error);
      document.getElementById('generatePaymentsInfo').innerHTML = `
        <div class="alert alert-danger">
          <i class="fa fa-exclamation-circle"></i>
          <strong>Error:</strong> Failed to generate payments
        </div>
      `;
      
      // Reset button
      document.getElementById('confirmGeneratePayments').disabled = false;
      document.getElementById('confirmGeneratePayments').innerHTML = '<i class="fa fa-calculator"></i> Generate Payments';
    });
  };
}

// Simulate payments function
function simulatePayments(year) {
  document.getElementById('simulationYearDisplay').textContent = year;
  document.getElementById('simulationLoading').style.display = 'block';
  document.getElementById('simulationContent').style.display = 'none';
  
  const modal = new bootstrap.Modal(document.getElementById('simulationModal'));
  modal.show();
  
  fetch('/admin/payments/simulate', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ year: year })
  })
  .then(response => response.json())
  .then(data => {
    document.getElementById('simulationLoading').style.display = 'none';
    
    if (data.success) {
      document.getElementById('simulationContent').style.display = 'block';
      document.getElementById('simulationPriceDisplay').textContent = data.pricePerMeter.toFixed(2);
      
      const container = document.getElementById('simulationTables');
      container.innerHTML = '';
      
      if (data.simulation.length === 0) {
        container.innerHTML = '<p class="text-center text-muted">No apartments found.</p>';
        return;
      }
      
      let grandTotal = 0;
      
      data.simulation.forEach(group => {
        grandTotal += group.totalAmount;
        
        const card = document.createElement('div');
        card.className = 'card mb-4';
        
        let rows = '';
        group.apartments.forEach(apt => {
          // Format: Block + Unofficial + (Official) e.g., A203(1)
          const displayUnit = `${apt.block}${apt.unitNumberUnofficial || ''}(${apt.unitNumber})`;
          
          rows += `
            <tr>
              <td>${displayUnit}</td>
              <td>
                ${apt.ownerName}
                ${apt.exists ? '<span class="badge bg-secondary ms-2">Already Generated</span>' : ''}
              </td>
              <td>${apt.area} m²</td>
              <td class="text-end">$${apt.amount.toFixed(2)}</td>
            </tr>
          `;
        });
        
        card.innerHTML = `
          <div class="card-header bg-light fw-bold d-flex justify-content-between align-items-center">
            <span>Block ${group.block}</span>
            <span>Total: $${group.totalAmount.toFixed(2)}</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-sm table-striped mb-0">
                <thead>
                  <tr>
                    <th style="width: 100px;">Unit</th>
                    <th>Owner</th>
                    <th style="width: 150px;">Size</th>
                    <th style="width: 150px;" class="text-end">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  ${rows}
                </tbody>
              </table>
            </div>
          </div>
        `;
        
        container.appendChild(card);
      });
      
      // Add Grand Total
      const totalDiv = document.createElement('div');
      totalDiv.className = 'alert alert-success fw-bold text-end fs-5';
      totalDiv.innerHTML = `Grand Total: $${grandTotal.toFixed(2)}`;
      container.appendChild(totalDiv);
      
    } else {
      alert('Error: ' + data.error);
      modal.hide();
    }
  })
  .catch(error => {
    console.error('Error:', error);
    document.getElementById('simulationLoading').style.display = 'none';
    alert('Failed to simulate payments');
    modal.hide();
  });
}

// Reset modal when closed
document.getElementById('addPriceModal').addEventListener('hidden.bs.modal', function () {
  document.getElementById('priceForm').reset();
  document.getElementById('addPriceModalLabel').textContent = 'Add Price per Meter';
});

// Reset generate payments modal when closed
document.getElementById('generatePaymentsModal').addEventListener('hidden.bs.modal', function () {
  // Reset the modal content
  document.getElementById('generatePaymentsInfo').innerHTML = '';
  document.getElementById('confirmGeneratePayments').style.display = 'block';
  document.getElementById('confirmGeneratePayments').disabled = false;
  document.getElementById('confirmGeneratePayments').innerHTML = '<i class="fa fa-calculator"></i> Generate Payments';
  document.querySelector('#generatePaymentsModal .btn-secondary').innerHTML = 'Cancel';
});

function getSelectedInterestYear() {
  const select = document.getElementById('interestYear');
  return select ? parseInt(select.value, 10) : new Date().getFullYear();
}

function generateInterestInvoices() {
  const year = getSelectedInterestYear();
  document.getElementById('generateInterestYearDisplay').textContent = year;
  document.getElementById('generateInterestInfo').innerHTML = '<div class="text-center"><i class="fa fa-spinner fa-spin"></i> Loading apartment information...</div>';
  document.getElementById('confirmGenerateInterest').style.display = 'block';
  document.getElementById('confirmGenerateInterest').disabled = true;

  const modal = new bootstrap.Modal(document.getElementById('generateInterestModal'));
  modal.show();

  fetch('/admin/payments/simulate-interest', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ year: year, onlyMissing: true })
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      const container = document.getElementById('generateInterestInfo');

      if (!data.simulation || data.simulation.length === 0) {
        container.innerHTML = `
          <div class="alert alert-success">
            <i class="fa fa-check-circle"></i> All apartments already have interest invoices for year ${year}, or none have prior-year unpaid balances.
          </div>
        `;
        document.getElementById('confirmGenerateInterest').style.display = 'none';
        return;
      }

      let totalToGenerate = 0;
      let totalOutstanding = 0;
      let aptCount = 0;
      let tablesHtml = '<div style="max-height: 300px; overflow-y: auto;">';

      data.simulation.forEach(group => {
        tablesHtml += `
          <div class="mb-2">
            <div class="bg-light p-1 px-2 fw-bold small border rounded-top">Block ${group.block}</div>
            <table class="table table-sm table-bordered mb-0" style="font-size: 0.85rem;">
              <thead>
                <tr>
                  <th>Unit</th>
                  <th>Owner</th>
                  <th class="text-end">Unpaid base</th>
                  <th class="text-end">Interest</th>
                </tr>
              </thead>
              <tbody>
        `;

        group.apartments.forEach(apt => {
          totalToGenerate += apt.amount;
          totalOutstanding += apt.outstandingBase;
          aptCount++;
          const displayUnit = `${apt.block}${apt.unitNumberUnofficial || ''}(${apt.unitNumber})`;
          tablesHtml += `
            <tr>
              <td>${displayUnit}</td>
              <td>${apt.ownerName}</td>
              <td class="text-end">$${apt.outstandingBase.toFixed(2)}</td>
              <td class="text-end">$${apt.amount.toFixed(2)}</td>
            </tr>
          `;
        });

        tablesHtml += '</tbody></table></div>';
      });

      tablesHtml += '</div>';

      container.innerHTML = `
        <div class="alert alert-warning mb-3">
          <i class="fa fa-info-circle"></i> Found <strong>${aptCount}</strong> apartments requiring interest invoices of <strong>$${totalToGenerate.toFixed(2)}</strong> on <strong>$${totalOutstanding.toFixed(2)}</strong> unpaid (${data.rate}%).
        </div>
        ${tablesHtml}
      `;

      document.getElementById('confirmGenerateInterest').disabled = false;
    } else {
      document.getElementById('generateInterestInfo').innerHTML = `<div class="alert alert-danger">Error: ${data.error}</div>`;
    }
  })
  .catch(error => {
    console.error('Error fetching interest simulation:', error);
    document.getElementById('generateInterestInfo').innerHTML = '<div class="alert alert-danger">Failed to load preview.</div>';
  });

  document.getElementById('confirmGenerateInterest').onclick = function() {
    this.disabled = true;
    this.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Generating...';

    fetch('/admin/payments/generate-interest', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ year: year })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        document.getElementById('generateInterestInfo').innerHTML = `
          <div class="alert alert-success">
            <i class="fa fa-check-circle"></i>
            <strong>Success!</strong> ${data.message}
            ${data.newPaymentsCount > 0 ? `<br><small>Generated ${data.newPaymentsCount} new interest invoices.</small>` : ''}
          </div>
        `;

        document.getElementById('confirmGenerateInterest').style.display = 'none';
        document.querySelector('#generateInterestModal .btn-secondary').innerHTML = '<i class="fa fa-check"></i> Close';

        setTimeout(() => {
          location.reload();
        }, 2000);
      } else {
        document.getElementById('generateInterestInfo').innerHTML = `
          <div class="alert alert-danger">
            <i class="fa fa-exclamation-circle"></i>
            <strong>Error:</strong> ${data.error}
          </div>
        `;

        document.getElementById('confirmGenerateInterest').disabled = false;
        document.getElementById('confirmGenerateInterest').innerHTML = '<i class="fa fa-calculator"></i> Generate Interest Invoices';
      }
    })
    .catch(error => {
      console.error('Error:', error);
      document.getElementById('generateInterestInfo').innerHTML = `
        <div class="alert alert-danger">
          <i class="fa fa-exclamation-circle"></i>
          <strong>Error:</strong> Failed to generate interest invoices
        </div>
      `;

      document.getElementById('confirmGenerateInterest').disabled = false;
      document.getElementById('confirmGenerateInterest').innerHTML = '<i class="fa fa-calculator"></i> Generate Interest Invoices';
    });
  };
}

function simulateInterestInvoices() {
  const year = getSelectedInterestYear();
  document.getElementById('interestSimulationYearDisplay').textContent = year;
  document.getElementById('interestSimulationLoading').style.display = 'block';
  document.getElementById('interestSimulationContent').style.display = 'none';

  const modal = new bootstrap.Modal(document.getElementById('interestSimulationModal'));
  modal.show();

  fetch('/admin/payments/simulate-interest', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ year: year })
  })
  .then(response => response.json())
  .then(data => {
    document.getElementById('interestSimulationLoading').style.display = 'none';

    if (data.success) {
      document.getElementById('interestSimulationContent').style.display = 'block';
      document.getElementById('interestSimulationRateDisplay').textContent = Number(data.rate).toFixed(2);

      const container = document.getElementById('interestSimulationTables');
      container.innerHTML = '';

      if (!data.simulation || data.simulation.length === 0) {
        container.innerHTML = '<p class="text-center text-muted">No apartments with prior-year unpaid balances found.</p>';
        return;
      }

      let grandTotal = 0;
      let grandOutstanding = 0;

      data.simulation.forEach(group => {
        grandTotal += group.totalAmount;
        grandOutstanding += group.totalOutstanding;

        const card = document.createElement('div');
        card.className = 'card mb-4';

        let rows = '';
        group.apartments.forEach(apt => {
          const displayUnit = `${apt.block}${apt.unitNumberUnofficial || ''}(${apt.unitNumber})`;
          rows += `
            <tr>
              <td>${displayUnit}</td>
              <td>
                ${apt.ownerName}
                ${apt.exists ? '<span class="badge bg-secondary ms-2">Already Generated</span>' : ''}
              </td>
              <td class="text-end">$${apt.outstandingBase.toFixed(2)}</td>
              <td class="text-end">$${apt.amount.toFixed(2)}</td>
            </tr>
          `;
        });

        card.innerHTML = `
          <div class="card-header bg-light fw-bold d-flex justify-content-between align-items-center">
            <span>Block ${group.block}</span>
            <span>Interest: $${group.totalAmount.toFixed(2)}</span>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-sm table-striped mb-0">
                <thead>
                  <tr>
                    <th style="width: 100px;">Unit</th>
                    <th>Owner</th>
                    <th style="width: 150px;" class="text-end">Unpaid base</th>
                    <th style="width: 150px;" class="text-end">Interest</th>
                  </tr>
                </thead>
                <tbody>
                  ${rows}
                </tbody>
              </table>
            </div>
          </div>
        `;

        container.appendChild(card);
      });

      const totalDiv = document.createElement('div');
      totalDiv.className = 'alert alert-success fw-bold text-end fs-5';
      totalDiv.innerHTML = `Unpaid base: $${grandOutstanding.toFixed(2)} &nbsp;|&nbsp; Grand Total Interest: $${grandTotal.toFixed(2)}`;
      container.appendChild(totalDiv);
    } else {
      alert('Error: ' + data.error);
      modal.hide();
    }
  })
  .catch(error => {
    console.error('Error:', error);
    document.getElementById('interestSimulationLoading').style.display = 'none';
    alert('Failed to simulate interest invoices');
    modal.hide();
  });
}

document.getElementById('generateInterestModal').addEventListener('hidden.bs.modal', function () {
  document.getElementById('generateInterestInfo').innerHTML = '';
  document.getElementById('confirmGenerateInterest').style.display = 'block';
  document.getElementById('confirmGenerateInterest').disabled = false;
  document.getElementById('confirmGenerateInterest').innerHTML = '<i class="fa fa-calculator"></i> Generate Interest Invoices';
  document.querySelector('#generateInterestModal .btn-secondary').innerHTML = 'Cancel';
});

// Set current year as default when adding new price
document.addEventListener('DOMContentLoaded', function() {
  const currentYear = new Date().getFullYear();
  document.getElementById('year').value = currentYear;
  
  // Move simulation modal to body to ensure print styles work correctly
  const modal = document.getElementById('simulationModal');
  if (modal) {
    document.body.appendChild(modal);
  }
  const interestModal = document.getElementById('interestSimulationModal');
  if (interestModal) {
    document.body.appendChild(interestModal);
  }
});
</script>
