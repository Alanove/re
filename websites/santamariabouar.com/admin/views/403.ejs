<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Access Denied' %></title>
    <link href="/admin/css/vendor.min.css" rel="stylesheet" />
    <link href="/admin/css/default/app.min.css" rel="stylesheet" />
    <style>
        .error-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .error-content {
            background: white;
            border-radius: 10px;
            padding: 3rem;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0,0,0,.1);
            max-width: 500px;
            margin: 2rem;
        }
        .error-code {
            font-size: 6rem;
            font-weight: bold;
            color: #dc3545;
            margin: 0;
            line-height: 1;
        }
        .error-title {
            font-size: 1.5rem;
            margin: 1rem 0;
            color: #333;
        }
        .error-message {
            color: #666;
            margin: 1.5rem 0;
            line-height: 1.6;
        }
        .error-actions {
            margin-top: 2rem;
        }
        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            margin: 0.25rem;
            text-decoration: none;
            border-radius: 5px;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .btn-primary {
            background: #007bff;
            color: white;
        }
        .btn-primary:hover {
            background: #0056b3;
            color: white;
        }
        .btn-secondary {
            background: #6c757d;
            color: white;
        }
        .btn-secondary:hover {
            background: #545b62;
            color: white;
        }
        .error-icon {
            font-size: 4rem;
            color: #dc3545;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="error-page">
        <div class="error-content">
            <div class="error-icon">
                <i class="fa fa-lock"></i>
            </div>
            <h1 class="error-code">403</h1>
            <h2 class="error-title">
                <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Access Denied' %>
            </h2>
            <p class="error-message">
                <%= typeof message !== 'undefined' ? message : 'You do not have permission to access this page.' %>
            </p>
            <div class="error-actions">
                <a href="/admin/dashboard" class="btn btn-primary">
                    <i class="fa fa-home me-1"></i>
                    Go to Dashboard
                </a>
                <a href="javascript:history.back()" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-1"></i>
                    Go Back
                </a>
            </div>
        </div>
    </div>

    <script src="/admin/js/vendor.min.js"></script>
    <script src="/admin/js/app.min.js"></script>
</body>
</html>
