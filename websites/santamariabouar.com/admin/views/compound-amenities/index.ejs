<div class="row">
  <div class="col-xl-12">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">Compound Amenities</h4>
      </div>
      <div class="panel-body">
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <p class="text-muted mb-4">These amenities are shown on all For Rent and For Sale listing pages.</p>

        <div class="card mb-4">
          <div class="card-header"><strong>Add amenity</strong></div>
          <div class="card-body">
            <form method="POST" action="/admin/compound-amenities" class="row g-3">
              <div class="col-md-3">
                <label class="form-label" for="newName">Name</label>
                <input type="text" class="form-control" id="newName" name="name" required />
              </div>
              <div class="col-md-2">
                <label class="form-label" for="newIcon">Icon class</label>
                <input type="text" class="form-control" id="newIcon" name="icon" value="bi-star" placeholder="bi-water" />
              </div>
              <div class="col-md-2">
                <label class="form-label" for="newSortOrder">Sort order</label>
                <input type="number" class="form-control" id="newSortOrder" name="sortOrder" value="0" />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="newDescription">Description</label>
                <input type="text" class="form-control" id="newDescription" name="description" />
              </div>
              <div class="col-md-1 d-flex align-items-end">
                <div class="form-check mb-2">
                  <input class="form-check-input" type="checkbox" id="newIsActive" name="isActive" value="1" checked />
                  <label class="form-check-label" for="newIsActive">Active</label>
                </div>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary">Add amenity</button>
              </div>
            </form>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-striped table-bordered align-middle">
            <thead>
              <tr>
                <th>Order</th>
                <th>Icon</th>
                <th>Name</th>
                <th>Description</th>
                <th>Active</th>
                <th width="1%">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (amenities && amenities.length) { %>
                <% amenities.forEach(function(item) { %>
                  <tr>
                    <td colspan="6" class="p-0">
                      <form method="POST" action="/admin/compound-amenities/<%= item.id %>" class="table-row-form">
                        <table class="table table-borderless mb-0">
                          <tr>
                            <td style="width:8%"><input type="number" class="form-control form-control-sm" name="sortOrder" value="<%= item.sortOrder %>" /></td>
                            <td style="width:12%"><input type="text" class="form-control form-control-sm" name="icon" value="<%= item.icon %>" /></td>
                            <td style="width:18%"><input type="text" class="form-control form-control-sm" name="name" value="<%= item.name %>" required /></td>
                            <td><input type="text" class="form-control form-control-sm" name="description" value="<%= item.description || '' %>" /></td>
                            <td style="width:10%">
                              <input type="checkbox" name="isActive" value="1" <%= item.isActive ? 'checked' : '' %> />
                            </td>
                            <td style="width:14%" class="text-nowrap">
                              <button type="submit" class="btn btn-sm btn-success">Save</button>
                              <button
                                type="button"
                                class="btn btn-sm btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteAmenityModal"
                                data-amenity-id="<%= item.id %>"
                                data-amenity-name="<%= item.name %>"
                              >
                                Delete
                              </button>
                            </td>
                          </tr>
                        </table>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr><td colspan="6" class="text-center">No amenities yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteAmenityModal" tabindex="-1" aria-labelledby="deleteAmenityModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteAmenityModalLabel">Delete amenity</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Delete <strong id="deleteAmenityName"></strong>?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <form method="POST" id="deleteAmenityForm" class="d-inline">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('deleteAmenityModal');
    if (!modal) return;
    modal.addEventListener('show.bs.modal', function (event) {
      const button = event.relatedTarget;
      const id = button.getAttribute('data-amenity-id');
      const name = button.getAttribute('data-amenity-name');
      document.getElementById('deleteAmenityName').textContent = name || 'this amenity';
      document.getElementById('deleteAmenityForm').action = '/admin/compound-amenities/' + id + '/delete';
    });
  })();
</script>
