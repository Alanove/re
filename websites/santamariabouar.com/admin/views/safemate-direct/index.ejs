<div class="row" id="safemate-direct-page">
  <div class="col-xl-12">
    <div class="panel panel-inverse">
      <div class="panel-heading">
        <h4 class="panel-title">SafeMate Direct</h4>
      </div>
      <div class="panel-body">
        <p class="text-muted">
          This page talks only to SafeMate. It does not change CMS users, apartments, or gate access.
          The app password is always <strong>12345678</strong>.
          Leave email blank to use the name, or the phone, at gate.santamariabouar.com.
        </p>

        <form method="GET" action="/admin/safemate-direct" class="row g-3 align-items-end mb-3">
          <div class="col-md-6">
            <label class="form-label" for="safemateDirectSearch">Search</label>
            <input class="form-control" id="safemateDirectSearch" name="q" value="<%= q || '' %>" placeholder="Account, phone, or email" />
          </div>
          <div class="col-md-6 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a href="/admin/safemate-direct" class="btn btn-outline-secondary">Clear</a>
            <button type="button" class="btn btn-success ms-auto" id="safemateDirectAddOpen" <%= cloudOk ? '' : 'disabled' %>>Add account</button>
          </div>
        </form>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <% if (!cloudOk) { %>
          <div class="alert alert-warning"><%= cloudMessage || 'SafeMate is unreachable.' %></div>
        <% } %>

        <p class="text-muted">Showing <%= users.length %> of <%= totalCount %>.</p>

        <div class="table-responsive">
          <table class="table table-striped table-bordered align-middle">
            <thead>
              <tr>
                <th class="sortable">Account <i class="fa fa-sort"></i></th>
                <th class="sortable">Phone <i class="fa fa-sort"></i></th>
                <th class="sortable">Email <i class="fa fa-sort"></i></th>
                <th class="sortable">Valid until <i class="fa fa-sort"></i></th>
                <th width="1%">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (users && users.length) { %>
                <% users.forEach(function(row) { %>
                  <tr class="<%= row.protected ? 'safemate-system-row' : '' %>">
                    <td><%= row.account %></td>
                    <td><%= row.phone || '—' %></td>
                    <td><%= row.email || '—' %></td>
                    <td><%= row.validDate || '—' %></td>
                    <td class="text-nowrap">
                      <% if (row.protected) { %>
                        <span class="text-muted">Protected</span>
                      <% } else { %>
                        <button type="button" class="btn btn-sm btn-primary js-safemate-direct-edit"
                          data-account="<%= row.account %>"
                          data-email="<%= row.email %>"
                          data-valid="<%= row.validDate %>">Edit</button>
                        <button type="button" class="btn btn-sm btn-danger js-safemate-direct-delete"
                          data-account="<%= row.account %>">Delete</button>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center">
                    <% if (!cloudOk) { %>
                      SafeMate accounts could not be loaded.
                    <% } else if (totalCount > 0) { %>
                      No SafeMate accounts match this search.
                    <% } else { %>
                      No SafeMate accounts.
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="safemateDirectAddModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/safemate-direct/add" id="safemateDirectAddForm">
        <div class="modal-header">
          <h4 class="modal-title">Add SafeMate account</h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted">The app password will be 12345678. This does not create a CMS user.</p>
          <input type="hidden" name="q" value="<%= q || '' %>" />
          <div class="mb-3">
            <label class="form-label" for="safemateDirectAddAccount">Account / phone</label>
            <input class="form-control" id="safemateDirectAddAccount" name="account" required />
          </div>
          <div class="mb-3">
            <label class="form-label" for="safemateDirectAddName">Name</label>
            <input class="form-control" id="safemateDirectAddName" name="name" />
            <div class="form-text">Used for the email only when email is blank.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="safemateDirectAddEmail">Email</label>
            <input class="form-control" id="safemateDirectAddEmail" name="email" type="text" />
            <div class="form-text">Leave blank to use name@gate.santamariabouar.com, or the phone if there is no name.</div>
          </div>
          <div class="mb-0">
            <label class="form-label" for="safemateDirectAddValid">Valid until</label>
            <input class="form-control" id="safemateDirectAddValid" name="validDate" placeholder="YYYY-MM-DD" />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="safemateDirectAddSubmit">Create account</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="safemateDirectEditModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/safemate-direct/edit" id="safemateDirectEditForm">
        <div class="modal-header">
          <h4 class="modal-title">Edit SafeMate account</h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted">Saving sets the app password back to 12345678. CMS records are not changed.</p>
          <input type="hidden" name="q" value="<%= q || '' %>" />
          <div class="mb-3">
            <label class="form-label" for="safemateDirectEditAccount">Account</label>
            <input class="form-control" id="safemateDirectEditAccount" name="account" readonly />
          </div>
          <div class="mb-3">
            <label class="form-label" for="safemateDirectEditName">Name</label>
            <input class="form-control" id="safemateDirectEditName" name="name" />
            <div class="form-text">Used for the email only when email is blank.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="safemateDirectEditEmail">Email</label>
            <input class="form-control" id="safemateDirectEditEmail" name="email" type="text" />
          </div>
          <div class="mb-0">
            <label class="form-label" for="safemateDirectEditValid">Valid until</label>
            <input class="form-control" id="safemateDirectEditValid" name="validDate" placeholder="YYYY-MM-DD" />
            <div class="form-text">Leave blank to keep the current date.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="safemateDirectEditSubmit">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="safemateDirectDeleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/safemate-direct/delete" id="safemateDirectDeleteForm">
        <div class="modal-header">
          <h4 class="modal-title">Delete SafeMate account</h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p>This removes the account from SafeMate only. It cannot be undone.</p>
          <p class="mb-0">Account: <strong id="safemateDirectDeleteLabel"></strong></p>
          <input type="hidden" name="q" value="<%= q || '' %>" />
          <input type="hidden" name="account" id="safemateDirectDeleteAccount" value="" />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger" id="safemateDirectDeleteSubmit">Delete</button>
        </div>
      </form>
    </div>
  </div>
</div>
