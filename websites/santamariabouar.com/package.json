{
  "name": "lw-njs-cms",
  "version": "1.0.0",
  "description": "TypeScript Node.js CMS Project",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/app.js",
    "start:production": "node --env-file=.env.production dist/src/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:debug": "ts-node-dev --respawn --transpile-only --inspect=9229 src/app.ts",
    "dev:debug-brk": "ts-node-dev --respawn --transpile-only --inspect-brk=9299 ./src/app.ts",
    "start:debug": "node --inspect dist/src/app.js",
    "scss": "npx sass public/css/styles.scss:public/css/styles.css --style=compressed --watch",
    "scss:once": "npx sass public/css/styles.scss:public/css/styles.css --style=compressed",
    "scss-dev": "npx sass public/css/styles.scss:public/css/styles.css --style=expanded --watch",
    "scss-admin": "npx sass admin/public/css/admin.scss:admin/public/css/admin.css --style=compressed --watch",
    "scss-admin-dev": "npx sass admin/public/css/admin.scss:admin/public/css/admin.css --style=expanded --watch",
    "scss-all": "npm run scss:once && npx sass admin/public/css/admin.scss:admin/public/css/admin.css --style=compressed",
    "scss-all-dev": "npm run scss-dev && npm run scss-admin-dev",
    "js:build": "node build-script.js",
    "js:watch": "node build-script.js --watch",
    "clean": "rimraf dist",
    "test:api": "node --no-experimental-strip-types --test -r ts-node/register/transpile-only \"tests/api/**/*.test.ts\"",
    "prebuild": "npm run clean",
    "generate-test-images": "node scripts/generate-test-images.js",
    "import-apartments": "ts-node admin/scripts/import-apartments-csv.ts",
    "migrate": "ts-node data-migration/run-migrations.ts run --env=development",
    "migrate:dev": "ts-node data-migration/run-migrations.ts run --env=development",
    "migrate:production": "ts-node data-migration/run-migrations.ts run --env=production",
    "migrate:status": "ts-node data-migration/run-migrations.ts status --env=development",
    "migrate:status:production": "ts-node data-migration/run-migrations.ts status --env=production",
    "migrate:mark": "ts-node data-migration/run-migrations.ts mark --env=development",
    "migrate:mark-before": "ts-node data-migration/run-migrations.ts mark-before --env=development",
    "migrate:payments-refactor": "ts-node data-migration/2025-01-17-refactor-payments-system.ts",
    "fix:invoice-amounts": "ts-node data-migration/2025-01-17-fix-invoice-amounts.ts",
    "fix:duplicate-transactions": "ts-node data-migration/2025-01-17-remove-duplicate-invoice-transactions.ts",
    "fix:duplicates-simple": "ts-node data-migration/2025-01-17-simple-remove-duplicates.ts",
    "fix:link-transactions": "ts-node data-migration/2025-01-17-link-transactions-to-invoices.ts",
    "fix:smart-link": "ts-node data-migration/2025-01-17-smart-link-transactions.ts",
    "fix:credits": "ts-node data-migration/2025-01-17-fix-credits-as-invoices.ts",
    "fix:duplicate-credits": "ts-node data-migration/2025-01-17-remove-duplicate-credits.ts",
    "import-old-electricity-bills": "ts-node data-migration/2026-03-05-import-old-electricity-bills.ts",
    "investigate:credits": "ts-node admin/scripts/investigate-credits-invoices.ts"
  },
  "dependencies": {
    "@img/sharp-wasm32": "^0.35.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.18.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "mysql2": "^3.15.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/sanitize-html": "^2.16.1",
    "csv-parse": "^6.1.0",
    "rimraf": "^5.0.0",
    "sass": "^1.93.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "cms",
    "typescript",
    "nodejs",
    "express"
  ],
  "author": "CMS Project",
  "license": "MIT"
}
