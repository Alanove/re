<button type="button" class="account-btn account-btn--primary account-pwa-install-btn" data-pwa-install="<%= typeof pwaInstallKind !== 'undefined' ? pwaInstallKind : 'account' %>" hidden>
  <%= typeof pwaInstallLabel !== 'undefined' ? pwaInstallLabel : 'Install app' %>
</button>

<div class="account-pwa-manual" data-pwa-manual>
  <div class="account-pwa-help" data-pwa-help="prompt" hidden>
    <p>Tap <strong>Install app</strong> above when it appears.</p>
  </div>

  <div class="account-pwa-help" data-pwa-help="samsung" hidden>
    <p class="account-pwa-help__title">On Samsung Internet</p>
    <ol>
      <li>Look at the <strong>bottom</strong> of the screen for the menu button (three lines ≡ or the tabs/menu icon).</li>
      <li>Tap <strong>Add page to</strong>.</li>
      <li>Tap <strong>Home screen</strong>, then confirm.</li>
    </ol>
    <p class="account-pwa-help__note">If you are in Chrome instead, switch to the Chrome steps below, or open this page in Samsung Internet.</p>
  </div>

  <div class="account-pwa-help" data-pwa-help="chrome-android" hidden>
    <p class="account-pwa-help__title">On Chrome (Android)</p>
    <ol>
      <li>Look in the <strong>address bar at the top</strong> for an Install icon (phone / download). Tap it if you see it.</li>
      <li>If not, tap the menu at the <strong>top right</strong> (three dots).</li>
      <li>Tap <strong>Install app</strong> or <strong>Add to Home screen</strong>, then confirm.</li>
    </ol>
  </div>

  <div class="account-pwa-help" data-pwa-help="android" hidden>
    <p class="account-pwa-help__title">On Android</p>
    <ol>
      <li><strong>Samsung Internet:</strong> bottom menu → <strong>Add page to</strong> → <strong>Home screen</strong>.</li>
      <li><strong>Chrome:</strong> top address bar Install icon, or top-right menu → <strong>Install app</strong> / <strong>Add to Home screen</strong>.</li>
    </ol>
  </div>

  <div class="account-pwa-help" data-pwa-help="ios" hidden>
    <p class="account-pwa-help__title">On iPhone / iPad</p>
    <ol>
      <li>Open this page in <strong>Safari</strong> (not Chrome or Instagram/Facebook’s in-app browser).</li>
      <li>Tap the <strong>Share</strong> button at the bottom (square with an arrow up).</li>
      <li>Scroll and tap <strong>Add to Home Screen</strong>, then <strong>Add</strong>.</li>
    </ol>
    <p class="account-pwa-help__note">If you do not see Share, tap <strong>aA</strong> in the address bar, or open the link in Safari from the share sheet of another app.</p>
  </div>

  <div class="account-pwa-help" data-pwa-help="other" hidden>
    <p class="account-pwa-help__title">Add to your home screen</p>
    <ol>
      <li>Open your browser’s menu.</li>
      <li>Choose <strong>Add to Home screen</strong>, <strong>Install app</strong>, or <strong>Add page to → Home screen</strong>.</li>
    </ol>
  </div>
</div>
