<div class="account-page">
  <div class="account-container">
    <div class="account-card">
      <h1>Forgot Password</h1>
      <p class="account-subtitle">
        Enter the email for your My Account. If we find a matching account, we will send a reset link.
      </p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="account-alert account-alert--error"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="account-alert account-alert--success"><%= success %></div>
        <p><a href="/account/login" class="account-back">Back to login</a></p>
      <% } else { %>
        <form method="POST" action="/account/forgot-password" class="account-form" id="forgotPasswordForm">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
          <div class="account-field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email"
                   value="<%= typeof email !== 'undefined' && email ? email : '' %>"
                   placeholder="Email address" />
          </div>
          <button type="submit" class="account-btn account-btn--primary" id="forgotPasswordSubmit">
            <span class="account-btn__label">Send Reset Link</span>
            <span class="account-btn__spinner" hidden aria-hidden="true"></span>
          </button>
        </form>

        <div class="account-footer-links">
          <p><a href="/account/login" class="account-back">Back to login</a></p>
        </div>
      <% } %>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('forgotPasswordForm');
    var submitBtn = document.getElementById('forgotPasswordSubmit');
    if (!form || !submitBtn) return;

    var labelEl = submitBtn.querySelector('.account-btn__label');
    var spinnerEl = submitBtn.querySelector('.account-btn__spinner');

    function setForgotSubmitting(isSubmitting) {
      submitBtn.disabled = isSubmitting;
      submitBtn.classList.toggle('is-loading', isSubmitting);
      if (labelEl) labelEl.hidden = isSubmitting;
      if (spinnerEl) {
        spinnerEl.hidden = !isSubmitting;
        spinnerEl.setAttribute('aria-hidden', isSubmitting ? 'false' : 'true');
      }
      submitBtn.setAttribute('aria-busy', isSubmitting ? 'true' : 'false');
    }

    // Show loader immediately on submit (including when reCAPTCHA is not configured).
    form.addEventListener('submit', function () {
      setForgotSubmitting(true);
    });

    if (typeof bindInvisibleRecaptcha === 'function') {
      bindInvisibleRecaptcha('#forgotPasswordForm', {
        beforeSubmit: function () {
          setForgotSubmitting(true);
          return true;
        },
        onError: function () {
          setForgotSubmitting(false);
          var existing = form.querySelector('.account-alert--error.js-recaptcha-error');
          if (existing) existing.remove();
          var div = document.createElement('div');
          div.className = 'account-alert account-alert--error js-recaptcha-error';
          div.textContent = 'Security check failed. Please try again.';
          form.parentNode.insertBefore(div, form);
        }
      });
    }
  });
</script>
