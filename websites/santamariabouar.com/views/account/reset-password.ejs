<div class="account-page">
  <div class="account-container">
    <div class="account-card">
      <h1>Reset Password</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="account-alert account-alert--error"><%= error %></div>
      <% } %>

      <% if (typeof tokenValid !== 'undefined' && tokenValid) { %>
        <p class="account-subtitle">Choose a new password for your My Account.</p>
        <form method="POST" action="/account/reset-password" class="account-form">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
          <input type="hidden" name="token" value="<%= typeof token !== 'undefined' ? token : '' %>" />
          <div class="account-field">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword" required minlength="8"
                   autocomplete="new-password" />
            <small>At least 8 characters.</small>
          </div>
          <div class="account-field">
            <label for="confirmPassword">Confirm New Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8"
                   autocomplete="new-password" />
          </div>
          <button type="submit" class="account-btn account-btn--primary">Update Password</button>
        </form>
      <% } else { %>
        <p class="account-subtitle">
          Request a new reset link from the forgot password page.
        </p>
        <div class="account-footer-links">
          <a href="/account/forgot-password" class="account-btn account-btn--secondary">Forgot Password</a>
        </div>
      <% } %>

      <div class="account-footer-links">
        <p><a href="/account/login" class="account-back">Back to login</a></p>
      </div>
    </div>
  </div>
</div>
