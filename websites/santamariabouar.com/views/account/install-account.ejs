<div class="account-page account-page--gate account-page--gate-install">
  <div class="account-gate-install">
    <img class="account-gate-install__icon" src="/pwa/icons/account-192.png" alt="" width="96" height="96" />
    <h1>Santa Maria Account</h1>
    <p class="account-meta">
      Install this app on your home screen. It opens your member portal after you sign in once.
    </p>
    <button type="button" class="account-btn account-btn--primary" data-pwa-install="account" hidden>
      Install Account
    </button>
    <div class="account-pwa-manual" data-pwa-manual>
      <p><strong>Android / Chrome:</strong> open the browser menu (⋮), then tap <strong>Install app</strong> or <strong>Add to Home screen</strong>.</p>
      <p><strong>iPhone / iPad:</strong> tap Share, then <strong>Add to Home Screen</strong>.</p>
    </div>
    <p class="account-meta">
      Already installed? <a href="/account">Open My Account</a>
      · <a href="/account/apps">Back to Apps</a>
    </p>
  </div>
</div>
