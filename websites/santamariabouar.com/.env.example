# Copy to .env.development / .env.production and fill in values.
# .env, .env.development, and .env.production are tracked in git.

# Server
NODE_ENV=development
PORT=3002
APP_BASE_URL=http://localhost:3002
# Required in production — use a long random string (never commit real secrets)
SESSION_SECRET=change-me-to-a-long-random-string
# Mobile app API (/api/v1) token signing key. Required in production (32+ chars);
# without it the API answers 503 and the website keeps working.
JWT_SECRET=change-me-to-a-different-long-random-string

# Google reCAPTCHA v2 Invisible (required in production for login/contact forms)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Dev-only admin one-click login (never enable in production)
ALLOW_DEV_LOGIN=false
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=sa
DB_PASSWORD=P@55w0rd
DB_NAME=smb

# SMTP (optional — emails are logged to console if unset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@santamariabouar.com
ADMIN_NOTIFY_EMAIL=admin@santamariabouar.com
# Prefer IPv4 for SMTP (avoids ENETUNREACH on some networks). Defaults to true outside production.
SMTP_FORCE_IPV4=true

# Google OAuth (optional — Google login disabled if unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/account/auth/google/callback
