# Production Environment Variables
NODE_ENV=production
PORT=3021

# Database configuration (if applicable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=emdc_cms
# DB_USER=emdc_user
# DB_PASSWORD=your_password

# Session configuration
SESSION_SECRET=aa97653b60cf0ad89d0d0a1a2b39ad503a2d4d25042076f58ffd86507805de41

# File upload settings (slider uses SLIDER_*; default raw upload 50MB then resize in app)
# SLIDER_UPLOAD_MAX_BYTES=52428800
# SLIDER_IMAGE_MAX_WIDTH=2500
# SLIDER_WEBP_QUALITY=82
# (SLIDER_JPEG_QUALITY is still honored if SLIDER_WEBP_QUALITY is unset)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/var/www/uploads

# Log level
LOG_LEVEL=info

# Self-hosted captcha (packages/captcha). Random secret, at least 32 characters; no external account needed.
CAPTCHA_SECRET=97759427bfb2efc56f421ece38381330ff35e14e7d4a474cbda8bc2cc7475c31
# Optional. Proof-of-work size; higher is harder for bots and slower for people (default 100000).
CAPTCHA_DIFFICULTY=100000
