# Production Environment Variables
NODE_ENV=production
PORT=3021

# Database configuration (if applicable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=emdc_cms
# DB_USER=emdc_user
# DB_PASSWORD=your_password

# Session configuration
SESSION_SECRET=your-very-secure-session-secret-here

# File upload settings (slider uses SLIDER_*; default raw upload 50MB then resize in app)
# SLIDER_UPLOAD_MAX_BYTES=52428800
# SLIDER_IMAGE_MAX_WIDTH=2500
# SLIDER_WEBP_QUALITY=82
# (SLIDER_JPEG_QUALITY is still honored if SLIDER_WEBP_QUALITY is unset)
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/var/www/uploads

# Log level
LOG_LEVEL=info
