<section id="home" class="hero-section<%= typeof slides !== 'undefined' && slides && slides.length ? ' hero-section--slider' : '' %>"<% if (typeof slides !== 'undefined' && slides && slides.length > 1) { %> tabindex="0"<% } %>>
    <% if (typeof slides !== 'undefined' && slides && slides.length) { %>
    <div class="hero-slider" id="homeHeroSlider" role="region" aria-roledescription="carousel" aria-label="Home highlights">
        <div class="hero-slider__track">
            <% slides.forEach(function(slide, index) { %>
            <div class="hero-slide<%= index === 0 ? ' is-active' : '' %>" data-slide-index="<%= index %>" aria-hidden="<%= index === 0 ? 'false' : 'true' %>">
                <img class="hero-slide__image" src="/images/slide/<%= slide.image %>" alt="<%= slide.alt %>"<% if (index === 0) { %> fetchpriority="high"<% } else { %> loading="lazy"<% } %> />
                <% if (slide.title || slide.buttonText) { %>
                <div class="hero-slide__caption">
                    <% if (slide.title) { %><h2 class="hero-slide__title"><%= slide.title %></h2><% } %>
                    <% if (slide.buttonText && slide.link) { %>
                    <a class="hero-slide__cta" href="<%= slide.link %>"><%= slide.buttonText %></a>
                    <% } else if (slide.buttonText) { %>
                    <span class="hero-slide__cta hero-slide__cta--static"><%= slide.buttonText %></span>
                    <% } %>
                </div>
                <% } %>
            </div>
            <% }); %>
        </div>
    </div>
    <% if (slides.length > 1) { %>
    <div class="hero-slider__dots" role="tablist" aria-label="Slide indicators">
        <% slides.forEach(function(slide, index) { %>
        <button type="button" class="hero-slider__dot<%= index === 0 ? ' is-active' : '' %>" role="tab" aria-selected="<%= index === 0 ? 'true' : 'false' %>" aria-label="Slide <%= index + 1 %> of <%= slides.length %>"></button>
        <% }); %>
    </div>
    <button type="button" class="hero-slider__nav hero-slider__prev" aria-label="Previous slide">
        <i class="bi bi-chevron-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="hero-slider__nav hero-slider__next" aria-label="Next slide">
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
    </button>
    <% } %>
    <% } else { %>
    <video id="homeHeroVideo" autoplay muted loop playsinline>
        <source src="/videos/<%= heroData.currentVideo %>" type="video/mp4">
        <!-- Fallback image if video not supported -->
        <img src="/images/slide/home4-poster.jpg" alt="Home background" />
    </video>
    <% } %>
    <!-- Decorative tilted vertical lines (visual only) -->
    <div class="hero-decor-lines" aria-hidden="true">
        <span class="decor-line"></span>
        <span class="decor-line"></span>
        <span class="decor-line"></span>
    </div>

    <!-- Rotating quotes: from slider slides when a slider exists; otherwise from hero-section (video). -->
    <% var hasSliderQuotes = typeof slides !== 'undefined' && slides && slides.length && slides.some(function(sl) { return sl.quoteText; }); %>
    <% if (hasSliderQuotes) { %>
        <div class="hero-quotes" aria-hidden="true">
            <div class="quote-container">
                <% slides.forEach(function(slide, index) { %>
                    <div class="quote-item<%= index === 0 ? ' active' : '' %>" data-slide-index="<%= index %>">
                        <% if (slide.quoteText) { %>
                        <blockquote class="quote-text">"<%= slide.quoteText %>"</blockquote>
                        <cite class="quote-author">— <%= slide.quoteAuthor || '' %></cite>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } else if (activeQuotes && activeQuotes.length > 0) { %>
        <div class="hero-quotes" aria-hidden="true">
            <div class="quote-container">
                <% activeQuotes.forEach(function(quote, index) { %>
                    <div class="quote-item<%= index === 0 ? ' active' : '' %>" data-quote-id="<%= quote.id %>">
                        <blockquote class="quote-text">"<%= quote.text %>"</blockquote>
                        <cite class="quote-author">— <%= quote.author %></cite>
                    </div>
                <% }); %>
            </div>
        </div>
    <% } %>

            <div class="scroll-arrow-container ">
                <button class="scroll-arrow" aria-label="Scroll to next section">
                    <img src="/images/icons/arrow-down.svg" alt="Scroll down" width="32" height="32" />
                </button>
            </div>

</section>
<section id="about" class="inverted">
    <div class="container">
        <h2>
            <%= typeof aboutTitle !=='undefined' ? aboutTitle : 'About EMDC Group' %>
        </h2>
        <div class="section-layout">
            <div class="section-content">
                <%- typeof aboutContent !=='undefined' && aboutContent ? aboutContent : (typeof pageContent
                    !=='undefined' && pageContent ? pageContent : '' ) %>
            </div>
            <% if (typeof aboutImage !=='undefined' && aboutImage && aboutImage !=='' ) { %>
                <div class="section-image">
                    <img src="<%= aboutImage %>" alt="About EMDC Group" class="slide-in-image" />
                </div>
                <% } %>
        </div>
    </div>
</section>
