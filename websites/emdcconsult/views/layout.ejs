<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO Meta Tags -->
  <title><%= formatDocumentTitle(typeof pageTitle !== 'undefined' ? pageTitle : '', typeof siteData !== 'undefined' ? siteData.name : '', typeof isDocumentTitleHome !== 'undefined' ? isDocumentTitleHome : false) %></title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : '' %>">
  <meta name="keywords" content="<%= typeof pageKeywords !== 'undefined' ? pageKeywords : '' %>">
  <meta name="author" content="<%= typeof siteData !== 'undefined' && siteData.name ? siteData.name : '' %>">
  <meta name="robots" content="<%= typeof pageRobots !== 'undefined' ? pageRobots : 'index, follow' %>">
  
  <!-- Open Graph Meta Tags -->
  <meta property="og:title" content="<%= formatDocumentTitle(typeof pageTitle !== 'undefined' ? pageTitle : '', typeof siteData !== 'undefined' ? siteData.name : '', typeof isDocumentTitleHome !== 'undefined' ? isDocumentTitleHome : false) %>">
  <meta property="og:description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : '' %>">
  <meta property="og:type" content="<%= typeof pageType !== 'undefined' ? pageType : 'website' %>">
  <meta property="og:url" content="<%= typeof pageUrl !== 'undefined' ? pageUrl : '' %>">
  <meta property="og:image" content="<%= typeof pageImage !== 'undefined' ? pageImage : '' %>">
  <meta property="og:site_name" content="<%= typeof siteData !== 'undefined' && siteData.name ? siteData.name : '' %>">
  <meta property="og:locale" content="en_US">
  
  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= formatDocumentTitle(typeof pageTitle !== 'undefined' ? pageTitle : '', typeof siteData !== 'undefined' ? siteData.name : '', typeof isDocumentTitleHome !== 'undefined' ? isDocumentTitleHome : false) %>">
  <meta name="twitter:description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : '' %>">
  <meta name="twitter:image" content="<%= typeof pageImage !== 'undefined' ? pageImage : '' %>">
  
  <!-- Additional SEO Meta Tags -->
  <meta name="language" content="English">
  <meta name="revisit-after" content="7 days">
  <meta name="distribution" content="global">
  <meta name="rating" content="general">
  <meta name="theme-color" content="#383838">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="<%= typeof pageUrl !== 'undefined' ? pageUrl : '' %>">
  
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="<%= typeof siteData !== 'undefined' && siteData.favicon ? siteData.favicon : '/images/favicon.ico' %>">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  
  <!-- Preconnect to external domains -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://cdnjs.cloudflare.com">
  
  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/styles.css">
  <% if (typeof includeSlideshowAssets !== 'undefined' && includeSlideshowAssets) { %>
    <link rel="stylesheet" href="/css/slideshow.css">
  <% } %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  
  <!-- Structured Data -->
  <script type="application/ld+json">
  <%- typeof structuredData !== 'undefined' ? structuredData : (function() {
    const siteName = typeof siteData !== 'undefined' && siteData.name ? siteData.name : '';
    const siteUrl = typeof siteData !== 'undefined' && siteData.domain ? siteData.domain : '';
    const siteLogo = typeof siteData !== 'undefined' && siteData.logo ? siteData.domain + siteData.logo : '';
    const siteDescription = typeof siteData !== 'undefined' && siteData.description ? siteData.description : '';
    const linkedinUrl = typeof siteData !== 'undefined' && siteData.social && siteData.social.linkedin ? siteData.social.linkedin : '';
    const facebookUrl = typeof siteData !== 'undefined' && siteData.social && siteData.social.facebook ? siteData.social.facebook : '';
    
    return JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": siteName,
      "url": siteUrl,
      "logo": siteLogo,
      "description": siteDescription,
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "Lebanon"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service"
      },
      "sameAs": [
        linkedinUrl,
        facebookUrl
      ]
    });
  })() %>
  </script>
</head>
<body<%- typeof bodyClass !== 'undefined' ? ' class="' + bodyClass + '"' : '' %>>
  <!-- Page Loader -->
  <div class="loader" id="pageLoader">
    <div class="loader-content">
      <div class="loader-title">
        <%= typeof siteData !== 'undefined' && (siteData.siteTitle || siteData.name) ? (siteData.siteTitle || siteData.name) : 'EMDC' %>
      </div>
    </div>
  </div>

  <!-- Section Navigation Indicators (dynamically populated by JavaScript) -->
  <div class="section-indicators" id="sectionIndicators"></div>
  
  <div class="main">
    <%- include('partials/header') %>
    <%- body %>
    <%- include('partials/footer') %>
  </div>

  <%- include('partials/menu') %>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <% if (typeof bodyClass !== 'undefined' && (bodyClass.includes('contact') || bodyClass === 'contact')) { %>
    <script src="/js/worldmap.js"></script>
  <% } %>
  <script src="/js/script.js"></script>
</body>
</html> 