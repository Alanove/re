<%
	const images = product.images;
	const telHref = function (value) { return 'tel:' + String(value || '').replace(/[^+\d]/g, ''); };
	const phone = primaryOffice && primaryOffice.phones[0];
	const keySpecs = product.specs.slice(0, 4);
	const showModel = product.model && product.model.toLowerCase() !== product.name.toLowerCase();
%>
<div class="product-top">
	<div class="container">
		<div class="product-top__crumbs"><%- include('../partials/breadcrumbs') %></div>
		<div class="product-hero">
			<div class="product-gallery" data-product-gallery>
				<div class="product-gallery__stage">
					<% if (images.length) { %>
						<% images.forEach(function (image, index) { %>
							<a class="product-gallery__slide" href="<%= image.src %>" data-gallery-slide data-gallery-item data-caption="<%= image.alt || product.name %>" aria-label="Enlarge image: <%= image.alt || product.name %>"<%- index === 0 ? '' : ' hidden' %>>
								<img src="<%= image.src %>" alt="<%= image.alt || product.name %>"<% if (image.width && image.height) { %> width="<%= image.width %>" height="<%= image.height %>"<% } %><%- index === 0 ? ' fetchpriority="high"' : ' loading="lazy"' %> />
								<span class="product-gallery__zoom material-symbols-outlined" aria-hidden="true">zoom_in</span>
							</a>
						<% }) %>
					<% } else { %>
						<div class="product-gallery__empty"><span class="material-symbols-outlined" aria-hidden="true">lock</span></div>
					<% } %>
				</div>
				<% if (images.length > 1) { %>
					<div class="product-gallery__thumbs" role="group" aria-label="Product images">
						<% images.forEach(function (image, index) { %>
							<button class="product-gallery__thumb" type="button" data-gallery-thumb aria-pressed="<%= index === 0 %>" aria-label="Show image <%= index + 1 %>">
								<img src="<%= thumbUrl(image.src) %>" alt="" loading="lazy" />
							</button>
						<% }) %>
					</div>
				<% } %>
			</div>

			<div class="product-summary">
				<div class="product-summary__labels">
					<a class="product-summary__category" href="<%= product.category.url %>"><span class="material-symbols-outlined" aria-hidden="true"><%= product.category.icon || 'lock' %></span><%= product.category.name %></a>
					<% if (product.brand) { %>
						<a class="product-summary__brand" href="<%= product.brand.url %>">
							<% if (product.brand.logo) { %><img src="<%= thumbUrl(product.brand.logo) %>" alt="" /><% } %>
							<%= product.brand.name %>
						</a>
					<% } %>
				</div>
				<h1 class="product-summary__title"><%= product.name %></h1>
				<% if (showModel) { %><p class="product-summary__model">Model <strong><%= product.model %></strong></p><% } %>
				<% if (product.tagline) { %><p class="product-summary__tagline"><%= product.tagline %></p><% } %>
				<% if (keySpecs.length) { %>
					<dl class="key-specs">
						<% keySpecs.forEach(function (spec) { %>
							<div class="key-specs__item">
								<dt><%= spec.label %></dt>
								<dd><%= spec.value %></dd>
							</div>
						<% }) %>
					</dl>
				<% } %>
				<div class="product-summary__actions">
					<a class="btn btn--primary btn--lg" href="#enquiry"><span class="material-symbols-outlined" aria-hidden="true">request_quote</span> Request a quote</a>
					<% if (phone) { %><a class="btn btn--outline btn--lg" href="<%= telHref(phone) %>"><span class="material-symbols-outlined" aria-hidden="true">call</span> <%= phone %></a><% } %>
				</div>
				<ul class="product-summary__assurances">
					<li><span class="material-symbols-outlined" aria-hidden="true">verified</span> Genuine products from authorized brands</li>
					<li><span class="material-symbols-outlined" aria-hidden="true">local_shipping</span> Delivery and installation across Lebanon</li>
					<li><span class="material-symbols-outlined" aria-hidden="true">build</span> After-sales service and maintenance</li>
				</ul>
			</div>
		</div>
	</div>
</div>

<% if (product.specs.length || product.description) { %>
	<section class="section section--tight product-details">
		<div class="container product-details__grid<%= product.specs.length && product.description ? '' : ' product-details__grid--single' %>">
			<% if (product.specs.length) { %>
				<div class="product-details__specs">
					<h2 class="product-details__title">Specifications</h2>
					<table class="spec-table">
						<tbody>
							<% product.specs.forEach(function (spec) { %>
								<tr><th scope="row"><%= spec.label %></th><td><%= spec.value %></td></tr>
							<% }) %>
						</tbody>
					</table>
				</div>
			<% } %>
			<% if (product.description) { %>
				<div class="product-details__description">
					<h2 class="product-details__title">Features</h2>
					<div class="prose prose--compact"><%- product.description %></div>
				</div>
			<% } %>
		</div>
	</section>
<% } %>

<section class="section section--low section--tight" id="enquiry">
	<div class="container enquiry-layout">
		<div class="enquiry-layout__intro">
			<span class="divider" aria-hidden="true"></span>
			<h2 class="section-title">Ask about this product</h2>
			<p class="muted">Send us your details and a Throne Trading specialist will get back to you with pricing and availability for the <strong><%= product.name %></strong>.</p>
			<% if (primaryOffice) { %>
				<ul class="contact-lines">
					<% primaryOffice.phones.forEach(function (line) { %>
						<li><span class="material-symbols-outlined" aria-hidden="true">call</span><a href="<%= telHref(line) %>"><%= line %></a></li>
					<% }) %>
					<% primaryOffice.emails.forEach(function (email) { %>
						<li><span class="material-symbols-outlined" aria-hidden="true">mail</span><a href="mailto:<%= email %>"><%= email %></a></li>
					<% }) %>
					<% if (primaryOffice.address) { %><li><span class="material-symbols-outlined" aria-hidden="true">location_on</span><%= primaryOffice.address %></li><% } %>
				</ul>
			<% } %>
		</div>
		<div class="form-panel form-panel--elevated">
			<%- include('../partials/enquiry-form') %>
		</div>
	</div>
</section>

<% if (related.length) { %>
	<section class="section section--tight">
		<div class="container">
			<div class="section-head section-head--row">
				<div>
					<span class="divider" aria-hidden="true"></span>
					<h2 class="section-title">Related products</h2>
				</div>
				<a class="text-link" href="<%= product.category.url %>">All <%= product.category.name %> <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span></a>
			</div>
			<ul class="product-grid product-grid--wide">
				<% related.forEach(function (card) { %>
					<li><%- include('../partials/product-card', { card: card, showCategory: false }) %></li>
				<% }) %>
			</ul>
		</div>
	</section>
<% } %>
<% if (images.length) { %><%- include('../partials/lightbox') %><% } %>
