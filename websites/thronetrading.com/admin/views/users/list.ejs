<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">CMS users</h4>
		<div class="panel-heading-btn"><a href="/admin/users/create" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add user</a></div>
	</div>
	<div class="panel-body p-0">
		<table class="table table-hover align-middle mb-0">
			<thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last sign-in</th><th style="width:1%"></th></tr></thead>
			<tbody>
				<% users.forEach(function (user) { %>
					<tr>
						<td><a href="/admin/users/<%= user.id %>/edit" class="fw-bold"><%= user.name %></a><% if (currentUser.id === user.id) { %> <span class="badge bg-info ms-1">You</span><% } %></td>
						<td><%= user.email %></td>
						<td><span class="badge <%= user.role === 'admin' ? 'bg-primary' : 'bg-light text-dark' %>"><%= user.role %></span></td>
						<td><% if (user.active) { %><span class="badge bg-success">Active</span><% } else { %><span class="badge bg-secondary">Disabled</span><% } %></td>
						<td class="small"><%= user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleString('en-GB') : 'Never' %></td>
						<td class="text-nowrap">
							<a href="/admin/users/<%= user.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
							<% if (currentUser.id !== user.id) { %>
								<button type="button" class="btn btn-sm btn-danger" title="Delete" data-delete-url="/admin/users/<%= user.id %>" data-delete-title="Delete user" data-delete-message="Delete <%= user.name %>? They will no longer be able to sign in."><i class="fa fa-trash"></i></button>
							<% } %>
						</td>
					</tr>
				<% }) %>
			</tbody>
		</table>
	</div>
</div>
