<% if (typeof pageImage !== 'undefined' && pageImage) { %>
    <!-- Hero Section -->
    <div class="container-fluid mb-5 p-0 page-hero-container">
        <div class="page-hero" style="background-image: url('<%= pageImage %>');">
            <div class="page-hero-overlay"></div>
            <div class="page-hero-content text-center">
                <h1 class="display-3 text-white mb-3 animate__animated animate__fadeInDown text-uppercase font-weight-light">
                    <%- typeof formatTrademarks !== 'undefined' ? formatTrademarks(typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Page') : (typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Page') %>
                </h1>
                <div class="d-inline-flex text-white">
                    <p class="m-0"><a class="text-white" href="/">Home</a></p>
                    <p class="m-0 px-2">/</p>
                    <p class="m-0"><%- typeof formatTrademarks !== 'undefined' ? formatTrademarks(typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Page') : (typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Page') %></p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Content Start -->
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-12 mb-5">
                <div class="bg-light">
                    <% if (typeof pageContent !== 'undefined' && pageContent) { %>
                        <%- pageContent %>
                    <% } else { %>
                        <p>This page is under construction.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <!-- Content End -->
<% } else { %>
    <!-- Default Layout (No Image) -->
    <!-- Breadcrumb Start -->
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-12">
                <nav class="breadcrumb bg-light mb-30">
                    <a class="breadcrumb-item text-dark" href="/">Home</a>
                    <span class="breadcrumb-item active"><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Page' %></span>
                </nav>
            </div>
        </div>
    </div>
    <!-- Breadcrumb End -->

    <!-- Content Start -->
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-12 mb-5">
                <% if (typeof pageTitle !== 'undefined' && pageTitle) { %>
                    <h2 class="section-title position-relative text-uppercase mb-4 font-weight-light"><span class="bg-secondary pr-3"><%= pageTitle %></span></h2>
                <% } %>
                <div class="bg-light">
                    <% if (typeof pageContent !== 'undefined' && pageContent) { %>
                        <%- pageContent %>
                    <% } else { %>
                        <p>This page is under construction.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <!-- Content End -->
<% } %>

<% if (typeof pagePhotos !== 'undefined' && pagePhotos && pagePhotos.length > 0) { %>
    <!-- Gallery Section -->
    <div class="container-fluid">
        <div class="px-xl-5">
            <div class="row page-gallery-grid">
                <%
                const limitedPhotos = (typeof pagePhotos !== 'undefined' && pagePhotos) ? pagePhotos.slice(0, 4) : [];
                limitedPhotos.forEach(function(photo) { %>
                    <div class="col-6 col-md-4 col-lg-3 mb-4">
                    <div class="gallery-photo-item mb-3">
                        <a href="<%= photo.filePath %>" data-fancybox="page-gallery" data-caption="<%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Gallery Photo' %>" style="display: block; position: relative;">
                            <img src="<%= typeof photo.thumbSrc !== 'undefined' && photo.thumbSrc ? photo.thumbSrc : photo.filePath %>" alt="<%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Gallery Photo' %>" class="img-fluid gallery-photo-img" loading="lazy" style="width: 100%; height: 300px; object-fit: cover;">
                            <div class="gallery-photo-overlay">
                                <i class="bi bi-eye"></i>
                            </div>
                        </a>
                    </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
    <!-- Gallery Section End -->
<% } %>

<% 
  // Check if this is a contact page and show Google Maps
  const isContactPage = typeof selected !== 'undefined' && (
    selected.toLowerCase().includes('kontakty') || 
    selected.toLowerCase().includes('contact') ||
    selected.toLowerCase().includes('адрес') ||
    selected.toLowerCase().includes('телефон')
  );
  
  const hasGoogleMaps = typeof siteSettings !== 'undefined' && 
                        siteSettings.googleMaps && 
                        (siteSettings.googleMaps.embedUrl || siteSettings.googleMaps.directionsUrl);
%>

<% if (isContactPage && hasGoogleMaps) { %>
    <div class="container-fluid pt-5">
        <div class="row px-xl-5">
            <div class="col-12">
                <% if (siteSettings.googleMaps.directionsUrl) { %>
                    <div class="text-center mb-4">
                        <a href="<%= siteSettings.googleMaps.directionsUrl %>" 
                           target="_blank" 
                           rel="noopener noreferrer" 
                           class="btn btn-primary">
                            <i class="fa fa-map-marker-alt mr-2"></i>
                            Get Directions
                        </a>
                    </div>
                <% } %>
                
                <% if (siteSettings.googleMaps.embedUrl) { %>
                    <div class="google-maps-container">
                        <div class="google-maps-wrapper">
                            <iframe 
                                src="<%= siteSettings.googleMaps.embedUrl %>" 
                                style="border:0;" 
                                allowfullscreen="" 
                                loading="lazy" 
                                referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
<% } %>
