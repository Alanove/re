<% if (block && block.config) { %>
    <% if (block.config.displayMode === 'fullscreen') { %>
        <%- include('./category-fullscreen', { block }) %>
    <% } else if (block.config.displayMode === 'video') { %>
        <%- include('./category-video', { block }) %>
    <% } else { %>
        <%- include('./shop-the-look', { block, blockIndex }) %>
    <% } %>
<% } %>
