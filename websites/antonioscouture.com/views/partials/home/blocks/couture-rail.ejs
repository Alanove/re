<% if (block && block.products && block.products.length > 0) { %>
<%
    var productLimit = block.config.limit || 12;
    var railProducts = block.products.slice(0, productLimit);
    var fallbackImg = (typeof siteImage !== 'undefined' ? siteImage : '/images/no-image.jpg');
    var sectionTitle = block.config && block.config.title ? String(block.config.title).trim() : '';
    var discoverLink = block.config && block.config.discoverLink ? String(block.config.discoverLink).trim() : '';
    var showArrows = railProducts.length > 1;
%>
<section class="home-couture-rail<%= sectionTitle ? ' home-couture-rail--has-title' : '' %>" aria-label="<%= sectionTitle || 'Couture' %>">
    <% if (sectionTitle) { %>
        <div class="home-couture-rail-intro">
            <div class="home-couture-rail-intro-body">
                <h2 class="home-section-title"><%= sectionTitle %></h2>
                <% if (discoverLink) { %>
                    <div class="luxury-hero-tagline-shop">
                        <a href="<%= discoverLink %>" class="home-section-link">Discover</a>
                    </div>
                <% } %>
            </div>
        </div>
    <% } %>
    <div class="home-couture-rail-viewport" data-couture-rail data-couture-continuous="1" data-couture-visible="4">
        <div class="home-couture-rail-track">
            <% railProducts.forEach(function(product) { %>
                <%
                    var img = fallbackImg;
                    if (product.images && product.images.length > 0) {
                        img = product.images[0].image_url || product.images[0].thumb_url || fallbackImg;
                    }
                %>
                <a class="home-couture-rail-slide" href="/shop/product/<%= product.slug %>" data-couture-slide>
                    <img src="<%= img %>" alt="<%= product.name %>" loading="lazy" draggable="false" />
                </a>
            <% }); %>
        </div>
        <% if (showArrows) { %>
            <button type="button" class="home-couture-rail-arrow home-couture-rail-prev" aria-label="Previous" data-couture-prev>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></svg>
            </button>
            <button type="button" class="home-couture-rail-arrow home-couture-rail-next" aria-label="Next" data-couture-next>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </button>
        <% } %>
    </div>
</section>
<% } %>
