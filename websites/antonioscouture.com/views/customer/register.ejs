<!-- Register Page -->

    <!-- Breadcrumb Start -->
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-12">
                <nav class="breadcrumb bg-light mb-30">
                    <a class="breadcrumb-item text-dark" href="/">Home</a>
                    <span class="breadcrumb-item active">
                        <%= typeof t !=='undefined' ? t('ecommerce.customer.register') : 'Login / Register' %>
                    </span>
                </nav>
            </div>
        </div>
    </div>
    <!-- Breadcrumb End -->

    <!-- Login/Register Start -->
    <div class="container-fluid pb-5">
        <div class="row px-xl-5 justify-content-center">
            <div class="col-lg-6">
                <div class="bg-light">
                    <!-- Tabs (Login = link to login page, Register = current) -->
                    <ul class="nav nav-tabs mb-4" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link" href="/customer/login">
                                <%= typeof t !=='undefined' ? t('ecommerce.customer.login') : 'Login' %>
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link active">
                                <%= typeof t !=='undefined' ? t('ecommerce.customer.register') : 'Register' %>
                            </span>
                        </li>
                    </ul>

                    <form id="registerForm">
                                <div id="registerError" class="alert alert-danger d-none" role="alert"></div>
                                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                <% if (typeof orderNumber !== 'undefined' && orderNumber) { %><input type="hidden" name="orderNumber" value="<%= orderNumber %>"><% } %>
                                <div class="form-group">
                                    <label>Email</label>
                                    <input class="form-control" type="email" name="email" required>
                                </div>
                                <div class="form-group">
                                    <label>Password</label>
                                    <input class="form-control" type="password" name="password" required>
                                </div>
                                <div class="form-group">
                                    <label>Confirm Password</label>
                                    <input class="form-control" type="password" name="confirmPassword" required>
                                </div>
                                <div class="form-group">
                                    <label>Name</label>
                                    <input class="form-control" type="text" name="name" required>
                                </div>
                                <div class="form-group">
                                    <label>Phone</label>
                                    <input class="form-control" type="text" name="phone" required>
                                </div>
                                <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
                                <div class="form-group turnstile-wrapper" style="min-height: 65px;">
                                    <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-callback="onRegisterTurnstileSuccess" data-error-callback="onRegisterTurnstileError" data-expired-callback="onRegisterTurnstileExpired"></div>
                                    <div id="register-turnstile-error" class="alert alert-danger small mt-2 py-2" style="display: none;">
                                        <%= typeof t !== 'undefined' ? t('ecommerce.pleaseCompleteVerification') : 'Please complete the security verification.' %>
                                    </div>
                                </div>
                                <% } %>
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary w-100">
                                        <%= typeof t !=='undefined' ? t('ecommerce.customer.register') : 'Register' %>
                                    </button>
                                </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Login/Register End -->

    <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% } %>
    <script>
        window.registerTurnstileToken = '';
        window.onRegisterTurnstileSuccess = function(token) {
            window.registerTurnstileToken = token;
            var r = document.getElementById('register-turnstile-error');
            if (r) r.style.display = 'none';
        };
        window.onRegisterTurnstileError = function() {
            window.registerTurnstileToken = '';
            var r = document.getElementById('register-turnstile-error');
            if (r) r.style.display = 'block';
        };
        window.onRegisterTurnstileExpired = function() {
            window.registerTurnstileToken = '';
            var r = document.getElementById('register-turnstile-error');
            if (r) r.style.display = 'block';
        };
        document.getElementById('registerForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const formData = new FormData(e.target);

            <% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey) { %>
            if (!window.registerTurnstileToken) {
                var errEl = document.getElementById('register-turnstile-error');
                if (errEl) { errEl.style.display = 'block'; errEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
                return;
            }
            <% } %>
            fetch('/api/customer/register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': formData.get('_csrf')
                },
                body: JSON.stringify({
                    _csrf: formData.get('_csrf'),
                    email: formData.get('email'),
                    password: formData.get('password'),
                    confirmPassword: formData.get('confirmPassword'),
                    name: formData.get('name'),
                    phone: formData.get('phone'),
                    cf_turnstile_response: window.registerTurnstileToken || '',
                    orderNumber: formData.get('orderNumber') || undefined
                })
            })
                .then(response => response.json())
                .then(data => {
                    var errEl = document.getElementById('registerError');
                    if (data.success) {
                        if (errEl) { errEl.classList.add('d-none'); errEl.textContent = ''; }
                        window.location.href = '/customer/account';
                    } else {
                        if (errEl) {
                            var msg = data.error || 'Registration failed';
                            var isAlreadyRegistered = msg.toLowerCase().indexOf('already registered') !== -1;
                            if (isAlreadyRegistered) {
                                errEl.innerHTML = msg + ' <a href="/customer/forgot-password" class="alert-link">Forgot password?</a>';
                            } else {
                                errEl.textContent = msg;
                            }
                            errEl.classList.remove('d-none');
                            errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    var errEl = document.getElementById('registerError');
                    if (errEl) {
                        errEl.textContent = 'Registration failed. Please try again.';
                        errEl.classList.remove('d-none');
                        errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }
                });
        });
    </script>

