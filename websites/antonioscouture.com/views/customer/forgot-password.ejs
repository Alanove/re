<!-- Forgot Password Page -->

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="/">Home</a>
                <a class="breadcrumb-item text-dark" href="/customer/login"><%= typeof t !== 'undefined' ? t('ecommerce.customer.login') : 'Login' %></a>
                <span class="breadcrumb-item active"><%= typeof t !== 'undefined' ? t('ecommerce.customer.forgotPassword') : 'Forgot Password' %></span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->

<!-- Forgot Password Start -->
<div class="container-fluid pb-5">
    <div class="row px-xl-5 justify-content-center">
        <div class="col-lg-6">
            <div class="bg-light">
                <h3 class="mb-4 text-center"><%= typeof t !== 'undefined' ? t('ecommerce.customer.forgotPassword') : 'Forgot Password' %></h3>
                <p class="text-center mb-4"><%= typeof t !== 'undefined' ? t('ecommerce.customer.forgotPasswordDesc') : 'Enter your email address to receive password reset instructions.' %></p>
                
                <div id="messageAlert" class="alert d-none" role="alert"></div>
                
                <form id="forgotPasswordForm">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <div class="form-group">
                        <label><%= typeof t !== 'undefined' ? t('ecommerce.customer.email') : 'Email' %></label>
                        <input class="form-control" type="email" name="email" required>
                    </div>
                    <div class="form-group mb-0">
                        <button type="submit" class="btn btn-primary w-100">
                            <%= typeof t !== 'undefined' ? t('ecommerce.customer.sendResetLink') : 'Send Reset Link' %>
                        </button>
                    </div>
                    <div class="text-center mt-3">
                        <a href="/customer/login" class="text-primary"><%= typeof t !== 'undefined' ? t('ecommerce.customer.backToLogin') : 'Back to Login' %></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Forgot Password End -->

<script>
document.getElementById('forgotPasswordForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    const messageAlert = document.getElementById('messageAlert');
    
    // Reset alert
    messageAlert.classList.add('d-none');
    messageAlert.classList.remove('alert-success', 'alert-danger');
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Sending...';
    
    fetch('/api/customer/forgot-password', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'CSRF-Token': formData.get('_csrf')
        },
        body: JSON.stringify({
            email: formData.get('email'),
            _csrf: formData.get('_csrf')
        })
    })
    .then(response => response.json())
    .then(data => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        
        if (data.success) {
            messageAlert.textContent = data.message || 'If an account exists with this email, you will receive password reset instructions.';
            messageAlert.classList.add('alert-success');
            messageAlert.classList.remove('d-none');
            // Optional: Hide form fields if you want to prevent re-submission
            // e.target.style.display = 'none';
        } else {
            messageAlert.textContent = 'Error: ' + (data.error || 'Failed to process request');
            messageAlert.classList.add('alert-danger');
            messageAlert.classList.remove('d-none');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        messageAlert.textContent = 'An error occurred. Please try again.';
        messageAlert.classList.add('alert-danger');
        messageAlert.classList.remove('d-none');
    });
});
</script>
