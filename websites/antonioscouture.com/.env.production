# Production Environment Configuration

# Node Environment
NODE_ENV=production

# Debug: set to true to show verbose logs in terminal (cart, checkout, session, CSRF, logger). Set false to quiet.
DEBUG=false

# Server Configuration
# IMPORTANT: Set this in your production environment
PORT=3013

# HTTPS (production): set USE_HTTPS=true and paths to PEM key/cert to run over HTTPS.
# USE_HTTPS=false
# HTTPS_KEY_PATH=cert/key.pem
# HTTPS_CERT_PATH=cert/cert.pem

# Session Configuration
# IMPORTANT: Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters long
SESSION_SECRET=MYSECRETSESSION_PASSS_123123%23433adasisgoodforyou

# Cookie Configuration
# Set this if you need to share cookies across subdomains
COOKIE_DOMAIN=antonioscouture.liteweb.info

# Cloudflare Turnstile Configuration
# IMPORTANT: Replace with your production keys
TURNSTILE_SITE_KEY=0x4AAAAAAFjKhpwqRQq_8AO5
TURNSTILE_SECRET_KEY=0x4AAAAAAFjKhp1-6Poo8VL5IjXuXWeLVi0

# Database Configuration
# IMPORTANT: Set these in your production environment
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=antonios
DB_PASSWORD=rRyPKBTE5rkLPHKE
DB_NAME=antonioscouture
DB_WAIT_FOR_CONNECTIONS=true
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0


# Content Security Policy Configuration
# Default script sources (comma-separated) - used as base configuration
CSP_SCRIPT_SRC_DEFAULT='self','unsafe-inline',https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com,https://code.jquery.com,https://stackpath.bootstrapcdn.com,https://challenges.cloudflare.com,https://static.cloudflareinsights.com,https://www.googletagmanager.com

# Default style sources (comma-separated) - used as base configuration
CSP_STYLE_SRC_DEFAULT='self','unsafe-inline',https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com,https://fonts.googleapis.com

# Default frame sources (comma-separated) - used as base configuration
CSP_FRAME_SRC_DEFAULT='self',https://*.google.com,https://*.googleapis.com,https://*.gstatic.com,https://www.youtube.com,https://*.youtube.com,https://challenges.cloudflare.com

# Default object sources (comma-separated) - used as base configuration
CSP_OBJECT_SRC_DEFAULT='none'

# Default base URI (comma-separated) - used as base configuration
CSP_BASE_URI_DEFAULT='self'

# Default image sources (comma-separated) - used as base configuration
CSP_IMG_SRC_DEFAULT='self',data:,https:

# Default font sources (comma-separated) - used as base configuration
CSP_FONT_SRC_DEFAULT='self',data:,https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com,https://fonts.gstatic.com

# Default connect sources (comma-separated) - used as base configuration
CSP_CONNECT_SRC_DEFAULT='self',https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com,https://challenges.cloudflare.com,https://static.cloudflareinsights.com,https://www.google-analytics.com,https://*.google-analytics.com,https://*.analytics.google.com,https://www.googletagmanager.com,https://*.googletagmanager.com

# Override variables (optional) - these override the defaults if set
# CSP_SCRIPT_SRC=
# CSP_STYLE_SRC=
# CSP_FRAME_SRC=
# CSP_OBJECT_SRC=
# CSP_BASE_URI=
# CSP_IMG_SRC=
# CSP_FONT_SRC=
# CSP_CONNECT_SRC=

# Helmet HSTS Configuration
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Aramex Configuration (JSON API - all required; no hardcoded fallbacks)
ARAMEX_USERNAME=
# Password must be quoted so # is not treated as start of comment
ARAMEX_PASSWORD=
ARAMEX_VERSION=v1.0
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=BEY
ARAMEX_ACCOUNT_COUNTRY_CODE=LB
ARAMEX_TEST_MODE=false
IS_ARAMEX_ENABLED=false
# Show actual credentials in Admin Test shipping error debug (remove after fixing ERR75)
ARAMEX_DEBUG_CREDENTIALS=true
# Set ARAMEX_LOGGING=true to log Aramex API request/response in terminal (leave unset/false to quiet)
# ARAMEX_LOGGING=false


# Netcommerce (Credit Libanais / Mastercard Hosted Checkout)
NETCOMMERCE_MERCHANT_ID=
NETCOMMERCE_API_PASSWORD=
# Credit Libanais test host (may not resolve from your network – get URL from bank if needed)
NETCOMMERCE_GATEWAY_URL=https://creditlibanais-netcommerce.gateway.mastercard.com/
# To try redirect to Mastercard test bank page (if above fails), use:
# NETCOMMERCE_GATEWAY_URL=https://test-gateway.mastercard.com/api/rest/version/70
NETCOMMERCE_TEST_MODE=true
# Display name on the gateway payment page; partner ID sent to gateway (e.g. STORENAME_1.0)
NETCOMMERCE_MERCHANT_NAME=
NETCOMMERCE_PARTNER_SOLUTION_ID=

# HTTPS / App URL (set if using HTTPS in production)
# USE_HTTPS=true
# HTTPS_KEY_PATH=cert/key.pem
# HTTPS_CERT_PATH=cert/cert.pem
APP_URL=https://antonioscouture.liteweb.info


