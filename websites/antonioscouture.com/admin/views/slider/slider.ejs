<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('slider.pageTitle') : 'Home Page Slider' %></h4>
				<div class="panel-heading-btn">
					<a href="/admin/slider/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> <%= typeof t !== 'undefined' ? t('slider.addNewSlide') : 'Add New Slide' %>
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong><%= typeof t !== 'undefined' ? t('messages.success') : 'Success!' %></strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong><%= typeof t !== 'undefined' ? t('messages.error') : 'Error!' %></strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<!-- BEGIN filters -->
				<div class="row mb-3">
					<div class="col-md-6">
						<div class="input-group">
							<span class="input-group-text">
								<i class="fa fa-search"></i>
							</span>
							<input type="text" class="form-control" id="keywordFilter" placeholder="<%= typeof t !== 'undefined' ? t('slider.searchByAltText') : 'Search by alt text...' %>" />
						</div>
					</div>
					<div class="col-md-3">
						<select class="form-select" id="statusFilter">
							<option value=""><%= typeof t !== 'undefined' ? t('filters.allStatus') : 'All Status' %></option>
							<option value="active"><%= typeof t !== 'undefined' ? t('common.active') : 'Active' %></option>
							<option value="inactive"><%= typeof t !== 'undefined' ? t('common.inactive') : 'Inactive' %></option>
						</select>
					</div>
					<div class="col-md-3">
						<button type="button" class="btn btn-secondary" id="clearFilters">
							<i class="fa fa-times me-1"></i> <%= typeof t !== 'undefined' ? t('common.clearFilters') : 'Clear Filters' %>
						</button>
					</div>
				</div>
				<!-- END filters -->
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th width="120"><%= typeof t !== 'undefined' ? t('slider.media') : 'Media' %></th>
								<th><%= typeof t !== 'undefined' ? t('slider.type') : 'Type' %></th>
								<th class="sortable" data-sort="alt">
									<%= typeof t !== 'undefined' ? t('slider.altTextLabel') : 'Alt Text' %> <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="title">
									<%= typeof t !== 'undefined' ? t('common.title') : 'Title' %> <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="order">
									<%= typeof t !== 'undefined' ? t('slider.order') : 'Order' %> <i class="fa fa-sort"></i>
								</th>
								<th class="text-nowrap" style="width: 88px">
									<%= typeof t !== 'undefined' ? t('slider.displayTime') : 'Time (s)' %>
								</th>
								<th class="sortable" data-sort="status">
									<%= typeof t !== 'undefined' ? t('common.status') : 'Status' %> <i class="fa fa-sort"></i>
								</th>
								<th><%= typeof t !== 'undefined' ? t('slider.linkButton') : 'Link & Button' %></th>
								<th width="200"><%= typeof t !== 'undefined' ? t('common.actions') : 'Actions' %></th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof slides !== 'undefined' && slides && slides.length > 0) { %>
								<% slides.forEach(slide => { %>
									<% 
										var listPosterFile = null;
										if (slide.mediaType === 'video' && slide.videoUrl) {
											if (slide.posterImage) listPosterFile = slide.posterImage;
											else if (slide.image && slide.image !== slide.videoUrl) listPosterFile = slide.image;
										}
									%>
									<tr data-slide-id="<%= slide.id %>" data-status="<%= slide.active ? 'active' : 'inactive' %>">
										<td>
											<% if (slide.mediaType === 'video') { %>
												<div class="position-relative">
													<video class="rounded" width="80" height="60" style="object-fit:cover;">
														<source src="/images/slide/<%= slide.videoUrl || slide.image %>" type="video/mp4">
													</video>
													<div class="position-absolute top-50 start-50 translate-middle">
														<i class="fa fa-play-circle text-white" style="font-size: 24px; text-shadow: 0 0 5px rgba(0,0,0,0.7);"></i>
													</div>
												</div>
											<% } else { %>
												<img src="/images/slide/<%= slide.image %>" alt="<%= slide.alt %>" class="rounded" width="80" height="60" style="object-fit:cover;" />
											<% } %>
										</td>
										<td>
											<% if (slide.mediaType === 'video') { %>
												<span class="badge bg-info"><i class="fa fa-video me-1"></i><%= typeof t !== 'undefined' ? t('slider.video') || 'Video' : 'Video' %></span>
												<% if (listPosterFile) { %>
													<span class="badge bg-success ms-1"><i class="fa fa-image me-1"></i><%= typeof t !== 'undefined' ? t('slider.posterBadge') : 'Poster' %></span>
												<% } %>
												<% if (slide.videoUrlMobile) { %>
													<span class="badge bg-primary ms-1"><i class="fa fa-mobile me-1"></i><%= typeof t !== 'undefined' ? t('slider.mobileVideoBadge') : 'Mobile' %></span>
												<% } %>
											<% } else { %>
												<span class="badge bg-secondary"><i class="fa fa-image me-1"></i><%= typeof t !== 'undefined' ? t('slider.image') || 'Image' : 'Image' %></span>
											<% } %>
										</td>
										<td>
											<div class="d-flex align-items-center">
												<div class="flex-grow-1">
													<div class="fw-bold"><%= slide.alt %></div>
													<div class="fs-12px text-gray-500-darker"><%= slide.image %></div>
												</div>
											</div>
										</td>
										<td>
											<% if (slide.title) { %>
												<div class="fw-bold"><%= slide.title %></div>
											<% } else { %>
												<span class="text-muted"><%= typeof t !== 'undefined' ? t('slider.noTitle') : 'No Title' %></span>
											<% } %>
										</td>
										<td>
											<span class="badge bg-primary"><%= slide.order %></span>
										</td>
										<td>
											<span class="text-muted small"><% var _ds = (slide.durationSeconds != null && slide.durationSeconds > 0) ? Math.min(600, slide.durationSeconds) : 5; %><%= _ds %>s</span>
										</td>
										<td>
											<% if (slide.active) { %>
												<span class="badge bg-success"><%= typeof t !== 'undefined' ? t('common.active') : 'Active' %></span>
											<% } else { %>
												<span class="badge bg-secondary"><%= typeof t !== 'undefined' ? t('common.inactive') : 'Inactive' %></span>
											<% } %>
										</td>
										<td>
											<% if (slide.link) { %>
												<div class="mb-1">
													<a href="<%= slide.link %>" target="_blank" class="text-primary" title="<%= typeof t !== 'undefined' ? t('slider.viewLink') : 'View Link' %>">
														<i class="fa fa-external-link-alt"></i> <%= slide.link %>
													</a>
												</div>
												<% if (slide.buttonText) { %>
													<div class="fs-12px text-gray-500-darker">
														<%= typeof t !== 'undefined' ? t('slider.buttonText') || 'Button' : 'Button' %>: "<%= slide.buttonText %>"
													</div>
												<% } %>
											<% } else { %>
												<span class="text-muted"><%= typeof t !== 'undefined' ? t('slider.noLink') : 'No Link' %></span>
											<% } %>
										</td>
										<td>
											<div class="btn-group" role="group">
												<a href="/admin/slider/<%= slide.id %>/edit" class="btn btn-xs btn-primary" title="<%= typeof t !== 'undefined' ? t('common.edit') : 'Edit' %>">
													<i class="fa fa-edit"></i>
												</a>
												<a href="/admin/slider/create?copyFrom=<%= slide.id %>" class="btn btn-xs btn-secondary" title="<%= typeof t !== 'undefined' ? t('slider.copySlideTitle') : 'Create new slide with same text; add new media' %>">
													<i class="fa fa-copy"></i>
												</a>
												<a href="/admin/slider/<%= slide.id %>/move-up" class="btn btn-xs btn-info" title="<%= typeof t !== 'undefined' ? t('slider.moveUp') : 'Move Up' %>">
													<i class="fa fa-arrow-up"></i>
												</a>
												<a href="/admin/slider/<%= slide.id %>/move-down" class="btn btn-xs btn-info" title="<%= typeof t !== 'undefined' ? t('slider.moveDown') : 'Move Down' %>">
													<i class="fa fa-arrow-down"></i>
												</a>
												<a href="/admin/slider/<%= slide.id %>/toggle-active" class="btn btn-xs btn-warning" title="<%= typeof t !== 'undefined' ? t('slider.toggleStatus') : 'Toggle Status' %>">
													<i class="fa fa-toggle-on"></i>
												</a>
												<button type="button" class="btn btn-xs btn-danger delete-slide" data-slide-id="<%= slide.id %>" title="<%= typeof t !== 'undefined' ? t('common.delete') : 'Delete' %>">
													<i class="fa fa-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="9" class="text-center py-4">
										<div class="text-muted">
											<i class="fa fa-images fa-3x mb-3"></i>
											<h5><%= typeof t !== 'undefined' ? t('slider.noSlidesFound') : 'No slides found' %></h5>
											<p><%= typeof t !== 'undefined' ? t('slider.getStarted') : 'Get started by adding your first slide to the home page slider.' %></p>
											<a href="/admin/slider/create" class="btn btn-primary">
												<i class="fa fa-plus me-1"></i> <%= typeof t !== 'undefined' ? t('slider.addFirstSlide') : 'Add First Slide' %>
											</a>
										</div>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteSlideModal" tabindex="-1" aria-labelledby="deleteSlideModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="deleteSlideModalLabel"><%= typeof t !== 'undefined' ? t('slider.confirmDelete') : 'Confirm Delete' %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= typeof t !== 'undefined' ? t('common.close') : 'Close' %>"></button>
			</div>
			<div class="modal-body">
				<p><%= typeof t !== 'undefined' ? t('slider.deleteSlideConfirm') : 'Are you sure you want to delete this slide? This action cannot be undone.' %></p>
				<p class="text-danger"><strong><%= typeof t !== 'undefined' ? t('common.note') || 'Note' : 'Note' %>:</strong> <%= typeof t !== 'undefined' ? t('slider.deleteImageNote') : 'The image file will also be permanently deleted.' %></p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= typeof t !== 'undefined' ? t('common.cancel') : 'Cancel' %></button>
				<button type="button" class="btn btn-danger" id="confirmDeleteSlide"><%= typeof t !== 'undefined' ? t('common.delete') : 'Delete' %> <%= typeof t !== 'undefined' ? t('slider.slide') || 'Slide' : 'Slide' %></button>
			</div>
		</div>
	</div>
</div> 