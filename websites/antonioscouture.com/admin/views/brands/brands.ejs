<%- include('../partials/header') %>

	<!-- BEGIN content area -->
	<div class="row">
		<div class="col-xl-12">
			<!-- BEGIN panel -->
			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('brands.title') : 'Brands' %>
					</h4>
					<div class="panel-heading-btn">
						<a href="/admin/brands/create" class="btn btn-sm btn-success">
							<i class="fa fa-plus"></i>
							<%= typeof t !=='undefined' ? t('brands.addNew') : 'Add New Brand' %>
						</a>
					</div>
				</div>
				<div class="panel-body">
					<% if (typeof success !=='undefined' && success) { %>
						<div class="alert alert-success alert-dismissible fade show" role="alert">
							<strong>
								<%= typeof t !=='undefined' ? t('messages.success') : 'Success!' %>
							</strong>
							<%= success %>
								<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
						</div>
						<% } %>

							<div class="table-responsive">
								<table class="table table-striped table-bordered align-middle">
									<thead>
										<tr>
											<th width="80">Logo</th>
											<th>Brand Name</th>
											<th>Slug</th>
											<th>Website</th>
											<th width="100">Display Order</th>
											<th width="80">Featured</th>
											<th width="80">
												<%= typeof t !=='undefined' ? t('common.status') : 'Status' %>
											</th>
											<th width="100">
												<%= typeof t !=='undefined' ? t('common.actions') : 'Actions' %>
											</th>
										</tr>
									</thead>
									<tbody>
										<% if (typeof brands !=='undefined' && brands && brands.length> 0) { %>
											<% brands.forEach(function(brand) { %>
												<tr data-brand-id="<%= brand.id %>">
													<td>
														<% if (brand.logo_url && brand.logo_url.trim() !=='' ) { %>
															<% let logoUrl=brand.logo_url.trim();
																logoUrl=logoUrl.replace(/\\/g, '/' );
																logoUrl=logoUrl.replace(/^\/+/, '/' ); if
																(!logoUrl.startsWith('/')) { logoUrl='/' + logoUrl; }
																logoUrl=logoUrl.replace(/\/+/g, '/' ); %>
																<img src="<%= logoUrl %>" alt="<%= brand.name %>"
																	class="img-thumbnail brand-logo"
																	style="width: 60px; height: 60px; object-fit: contain; background: white; display: block;"
																	onerror="this.onerror=null; this.src=''; this.style.display='none'; this.nextElementSibling.style.display='flex';">
																<div class="bg-light align-items-center justify-content-center brand-fallback"
																	style="width: 60px; height: 60px; display: none;">
																	<i class="fa fa-building text-muted"></i>
																</div>
																<% } else { %>
																	<div class="bg-light d-flex align-items-center justify-content-center"
																		style="width: 60px; height: 60px;">
																		<i class="fa fa-building text-muted"></i>
																	</div>
																	<% } %>
													</td>
													<td>
														<strong>
															<%= brand.name %>
														</strong>
														<% if (brand.description) { %>
															<div class="text-muted small mt-1">
																<%= brand.description.substring(0, 100) %>
																	<%= brand.description.length> 100 ? '...' : '' %>
															</div>
															<% } %>
													</td>
													<td>
														<code class="text-muted"><%= brand.slug %></code>
													</td>
													<td>
														<% if (brand.website_url) { %>
															<a href="<%= brand.website_url %>" target="_blank"
																class="text-primary">
																<i class="fa fa-external-link-alt"></i> Visit
															</a>
															<% } else { %>
																<span class="text-muted">-</span>
																<% } %>
													</td>
													<td class="text-center">
														<%= brand.display_order %>
													</td>
													<td class="text-center">
														<% if (brand.is_featured) { %>
															<span class="badge bg-warning text-dark"><i
																	class="fa fa-star"></i></span>
															<% } else { %>
																<span class="text-muted">-</span>
																<% } %>
													</td>
													<td>
														<% if (brand.is_active) { %>
															<span class="badge bg-success">
																<%= typeof t !=='undefined' ? t('common.active')
																	: 'Active' %>
															</span>
															<% } else { %>
																<span class="badge bg-danger">
																	<%= typeof t !=='undefined' ? t('common.inactive')
																		: 'Inactive' %>
																</span>
																<% } %>
													</td>
													<td>
														<div class="btn-group">
															<a href="/admin/brands/<%= brand.id %>/edit"
																class="btn btn-xs btn-primary"
																title="<%= typeof t !== 'undefined' ? t('common.edit') : 'Edit' %>">
																<i class="fa fa-edit"></i>
															</a>
															<button type="button"
																class="btn btn-xs btn-danger delete-brand-btn"
																data-brand-id="<%= brand.id %>"
																data-brand-name="<%= brand.name %>"
																title="<%= typeof t !== 'undefined' ? t('common.delete') : 'Delete' %>">
																<i class="fa fa-trash"></i>
															</button>
														</div>
													</td>
												</tr>
												<% }); %>
													<% } else { %>
														<tr>
															<td colspan="8" class="text-center text-muted">
																<%= typeof t !=='undefined' ? t('brands.noBrandsFound')
																	: 'No brands found. Click "Add New Brand" to create one.'
																	%>
															</td>
														</tr>
														<% } %>
									</tbody>
								</table>
							</div>
				</div>
			</div>
			<!-- END panel -->
		</div>
	</div>
	<!-- END content area -->

	<script>
		// Delete brand
		document.querySelectorAll('.delete-brand-btn').forEach(btn => {
			btn.addEventListener('click', function () {
				const brandId = this.getAttribute('data-brand-id');
				const brandName = this.getAttribute('data-brand-name');

				if (confirm(`Are you sure you want to delete the brand "${brandName}"? This action cannot be undone.`)) {
					const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

					fetch(`/admin/brands/${brandId}/delete`, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'X-CSRF-Token': csrfToken
						}
					})
						.then(response => response.json())
						.then(data => {
							if (data.success) {
								window.location.reload();
							} else {
								alert('Error: ' + (data.error || 'Failed to delete brand'));
							}
						})
						.catch(error => {
							console.error('Error:', error);
							alert('Error deleting brand');
						});
				}
			});
		});
	</script>

	<%- include('../partials/footer') %>