<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'en' %>" dir="<%= typeof htmlDir !== 'undefined' ? htmlDir : 'ltr' %>">
<head>
	<meta charset="utf-8" />
	<title><%= typeof siteTitle !== 'undefined' ? siteTitle : 'CMS' %> | Admin Login</title>
	<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport" />
	<meta content="Admin login for <%= typeof siteTitle !== 'undefined' ? siteTitle : 'CMS' %>" name="description" />
	<meta content="<%= typeof siteTitle !== 'undefined' ? siteTitle : 'CMS' %>" name="author" />
	
	<!-- ================== BEGIN core-css ================== -->
	<link href="/admin/css/vendor.min.css" rel="stylesheet" />
	<link href="/admin/css/app.min.css" rel="stylesheet" />
	<!-- ================== END core-css ================== -->
	
	<!-- Cloudflare Turnstile (only in production) -->
	<% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey && (!isDevelopment)) { %>
	<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
	<% } %>
</head>
<body class='pace-top'>
	<!-- BEGIN #loader -->
	<div id="loader" class="app-loader">
		<span class="spinner"></span>
	</div>
	<!-- END #loader -->


	<!-- BEGIN #app -->
	<div id="app" class="app">
		<!-- BEGIN login -->
		<div class="login login-v1">
			<!-- BEGIN login-container -->
			<div class="login-container">
				<!-- BEGIN login-header -->
				<div class="login-header">
					<div class="brand">
						<div class="d-flex align-items-center">
							<b class="me-1"><%= typeof siteTitle !== 'undefined' && siteTitle ? siteTitle : 'Admin Panel' %></b>
						</div>
						<small><%= typeof t !== 'undefined' ? t('common.adminPanel') : 'Admin Panel' %></small>
					</div>
					<div class="icon">
						<i class="fa fa-lock"></i>
					</div>
				</div>
				<!-- END login-header -->
				
				<!-- BEGIN login-body -->
				<div class="login-body">
					<!-- BEGIN login-content -->
					<div class="login-content fs-13px">
						<% if (locals.error) { %>
							<div class="alert alert-danger alert-dismissible fade show" role="alert">
								<i class="fas fa-exclamation-triangle me-2"></i>
								<%= error %>
								<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
							</div>
						<% } %>
						
						<% if (locals.success) { %>
							<div class="alert alert-success alert-dismissible fade show" role="alert">
								<i class="fas fa-check-circle me-2"></i>
								<%= success %>
								<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
							</div>
						<% } %>
						
						<form action="/admin/login" method="POST" data-bs-theme="dark">
							<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
							<div class="form-floating mb-20px">
								<input type="email" class="form-control fs-13px h-45px" id="email" name="email" placeholder="<%= typeof t !== 'undefined' ? t('auth.emailAddress') : 'Email Address' %>" required />
								<label for="email" class="d-flex align-items-center"><%= typeof t !== 'undefined' ? t('auth.emailAddress') : 'Email Address' %></label>
							</div>
							<div class="form-floating mb-20px">
								<input type="password" class="form-control fs-13px h-45px" id="password" name="password" placeholder="<%= typeof t !== 'undefined' ? t('auth.password') : 'Password' %>" required />
								<label for="password" class="d-flex align-items-center"><%= typeof t !== 'undefined' ? t('auth.password') : 'Password' %></label>
							</div>
							<% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey && (!isDevelopment)) { %>
							<div class="mb-20px d-flex justify-content-center">
								<div class="cf-turnstile" 
								     data-sitekey="<%= turnstileSiteKey %>" 
								     data-theme="dark" 
								     data-callback="onTurnstileSuccess"
								     data-error-callback="onTurnstileError"
								     data-expired-callback="onTurnstileExpired"
								     id="turnstile-widget"></div>
							</div>
							<div id="turnstile-error-alert" class="alert alert-danger alert-dismissible fade" role="alert" style="display: none;">
								<i class="fas fa-exclamation-triangle me-2"></i>
								<span id="turnstile-error-message"><%= typeof t !== 'undefined' ? t('auth.turnstileRequired') : 'Please complete the security verification' %></span>
								<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
							</div>
							<input type="hidden" name="cf-turnstile-response" id="cf-turnstile-response" />
							<% } %>
							<div class="login-buttons">
								<button type="submit" class="btn btn-theme h-45px d-block w-100 btn-lg" id="login-submit-btn"><%= typeof t !== 'undefined' ? t('auth.login') : 'Sign me in' %></button>
								<% if (typeof showDevQuickLogin !== 'undefined' && showDevQuickLogin) { %>
								<button type="button" class="btn btn-outline-warning h-45px d-block w-100 btn-lg mt-10px" id="dev-login-btn">
									<i class="fas fa-code me-2"></i>Dev Login
								</button>
								<% } %>
							</div>
						</form>
					</div>
					<!-- END login-content -->
				</div>
				<!-- END login-body -->
			</div>
			<!-- END login-container -->
		</div>
		<!-- END login -->
		
		<!-- BEGIN scroll-top-btn -->
		<a href="javascript:;" class="btn btn-icon btn-circle btn-theme btn-scroll-to-top" data-toggle="scroll-to-top"><i class="fa fa-angle-up"></i></a>
		<!-- END scroll-top-btn -->
	</div>
	<!-- END #app -->
	
	<!-- ================== BEGIN core-js ================== -->
	<script src="/admin/js/vendor.min.js"></script>
	<script src="/admin/js/app.min.js"></script>
	<!-- ================== END core-js ================== -->
	
	<!-- ================== BEGIN theme-js ================== -->
	<script src="/admin/js/theme.js"></script>
	<!-- ================== END theme-js ================== -->
	
	<!-- ================== BEGIN login-form-js ================== -->
	<% if (typeof turnstileSiteKey !== 'undefined' && turnstileSiteKey && (!isDevelopment)) { %>
	<script>
		(function() {
			const loginForm = document.querySelector('form[action="/admin/login"]');
			const submitBtn = document.getElementById('login-submit-btn');
			const turnstileResponseInput = document.getElementById('cf-turnstile-response');
			let turnstileToken = '';
			
			if (loginForm) {
				const turnstileErrorAlert = document.getElementById('turnstile-error-alert');
				
				// Function to show Turnstile error
				function showTurnstileError() {
					if (turnstileErrorAlert) {
						turnstileErrorAlert.style.display = 'block';
						turnstileErrorAlert.classList.add('show');
					}
				}
				
				// Function to hide Turnstile error
				function hideTurnstileError() {
					if (turnstileErrorAlert) {
						turnstileErrorAlert.style.display = 'none';
						turnstileErrorAlert.classList.remove('show');
					}
				}
				
				// Prevent form submission if Turnstile token is missing
				loginForm.addEventListener('submit', function(e) {
					if (!turnstileToken || !turnstileResponseInput || turnstileResponseInput.value === '') {
						e.preventDefault();
						showTurnstileError();
						// Scroll to error
						if (turnstileErrorAlert) {
							turnstileErrorAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
						}
						return false;
					} else {
						hideTurnstileError();
					}
				});
				
				// Hide error when Turnstile is successfully verified
				window.onTurnstileSuccess = function(token) {
					turnstileToken = token;
					if (turnstileResponseInput) {
						turnstileResponseInput.value = token;
					}
					if (submitBtn) {
						submitBtn.disabled = false;
					}
					hideTurnstileError();
				};
				
				// Show error when Turnstile fails
				window.onTurnstileError = function() {
					turnstileToken = '';
					if (turnstileResponseInput) {
						turnstileResponseInput.value = '';
					}
					if (submitBtn) {
						submitBtn.disabled = true;
					}
					showTurnstileError();
				};
				
				// Show error when Turnstile expires
				window.onTurnstileExpired = function() {
					turnstileToken = '';
					if (turnstileResponseInput) {
						turnstileResponseInput.value = '';
					}
					if (submitBtn) {
						submitBtn.disabled = true;
					}
					showTurnstileError();
				};
				
				// Initially disable submit button until Turnstile is verified
				if (submitBtn) {
					submitBtn.disabled = true;
				}
			}
		})();
	</script>
	<% } %>
	<!-- ================== END login-form-js ================== -->
	
	<!-- ================== BEGIN dev-login-js ================== -->
	<% if (typeof showDevQuickLogin !== 'undefined' && showDevQuickLogin) { %>
	<script>
		(function() {
			const devLoginBtn = document.getElementById('dev-login-btn');
			const loginForm = document.querySelector('form[action="/admin/login"]');
			const emailInput = document.getElementById('email');
			const passwordInput = document.getElementById('password');
			
			if (devLoginBtn && loginForm && emailInput && passwordInput) {
				devLoginBtn.addEventListener('click', function() {
					// Auto-fill credentials (aligned with DEV_ADMIN_* and startup bootstrap)
					emailInput.value = <%- JSON.stringify(typeof devLoginEmail !== 'undefined' ? devLoginEmail : '') %>;
					passwordInput.value = <%- JSON.stringify(typeof devLoginPassword !== 'undefined' ? devLoginPassword : '') %>;
					
					// Trigger input events to ensure form validation passes
					emailInput.dispatchEvent(new Event('input', { bubbles: true }));
					passwordInput.dispatchEvent(new Event('input', { bubbles: true }));
					
					// Submit the form
					loginForm.submit();
				});
			}
		})();
	</script>
	<% } %>
	<!-- ================== END dev-login-js ================== -->
</body>
</html> 