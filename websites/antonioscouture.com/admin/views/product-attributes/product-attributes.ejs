<%- include('../partials/header') %>

<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('ecommerce.productAttributes.title') : 'Product Attributes' %></h4>
				<div class="panel-heading-btn">
					<a href="/admin/product-attributes/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> <%= typeof t !== 'undefined' ? t('ecommerce.productAttributes.addNew') : 'Add New Product Attribute' %>
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong><%= typeof t !== 'undefined' ? t('messages.success') : 'Success!' %></strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th><%= typeof t !== 'undefined' ? t('ecommerce.productAttributes.name') : 'Name' %></th>
								<th><%= typeof t !== 'undefined' ? t('ecommerce.productAttributes.values') : 'Values' %></th>
								<th><%= typeof t !== 'undefined' ? t('ecommerce.productAttributes.hasImage') : 'Has Image' %></th>
								<th><%= typeof t !== 'undefined' ? t('common.status') : 'Status' %></th>
								<th width="150"><%= typeof t !== 'undefined' ? t('common.actions') : 'Actions' %></th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof productAttributes !== 'undefined' && productAttributes && productAttributes.length > 0) { %>
								<% productAttributes.forEach(function(productAttribute) { %>
									<tr>
										<td>
											<strong><%= productAttribute.name %></strong>
											<% if (productAttribute.description) { %>
												<br><small class="text-muted"><%= productAttribute.description %></small>
											<% } %>
										</td>
										<td>
											<% if (productAttribute.values && productAttribute.values.length > 0) { %>
												<% productAttribute.values.forEach(function(value, index) { %>
													<span class="badge bg-secondary me-1"><%= value.value %></span>
												<% }); %>
											<% } else { %>
												<span class="text-muted">No values</span>
											<% } %>
										</td>
										<td>
											<% if (productAttribute.has_image) { %>
												<span class="badge bg-info"><i class="fa fa-image"></i> Yes</span>
											<% } else { %>
												<span class="badge bg-secondary">No</span>
											<% } %>
										</td>
										<td>
											<% if (productAttribute.is_active) { %>
												<span class="badge bg-success">Active</span>
											<% } else { %>
												<span class="badge bg-danger">Inactive</span>
											<% } %>
										</td>
										<td>
											<a href="/admin/product-attributes/<%= productAttribute.id %>/edit" class="btn btn-xs btn-primary" title="<%= typeof t !== 'undefined' ? t('common.edit') : 'Edit' %>">
												<i class="fa fa-edit"></i>
											</a>
											<button type="button" class="btn btn-xs btn-danger delete-product-attribute-btn" 
											        data-product-attribute-id="<%= productAttribute.id %>" 
											        title="<%= typeof t !== 'undefined' ? t('common.delete') : 'Delete' %>">
												<i class="fa fa-trash"></i>
											</button>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="5" class="text-center py-4">
										<i class="fa fa-tags fa-3x text-muted mb-3"></i>
										<p class="text-muted"><%= typeof t !== 'undefined' ? t('common.noData') : 'No product attributes found' %></p>
										<a href="/admin/product-attributes/create" class="btn btn-primary">
											<i class="fa fa-plus"></i> <%= typeof t !== 'undefined' ? t('ecommerce.productAttributes.addNew') : 'Add New Product Attribute' %>
										</a>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<script>
document.querySelectorAll('.delete-product-attribute-btn').forEach(btn => {
	btn.addEventListener('click', function() {
		const productAttributeId = this.getAttribute('data-product-attribute-id');
		if (!confirm('<%= typeof t !== 'undefined' ? t('messages.confirmDelete') : 'Are you sure you want to delete this product attribute?' %>')) {
			return;
		}
		
		fetch(`/admin/product-attributes/${productAttributeId}`, {
			method: 'DELETE',
			headers: {
				'Content-Type': 'application/json',
			}
		})
		.then(response => response.json())
		.then(data => {
			if (data.success) {
				location.reload();
			} else {
				alert('Error: ' + (data.error || 'Failed to delete product attribute'));
			}
		})
		.catch(error => {
			console.error('Error:', error);
			alert('Error deleting product attribute');
		});
	});
});
</script>

<%- include('../partials/footer') %>
