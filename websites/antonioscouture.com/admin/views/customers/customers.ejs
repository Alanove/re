<%- include('../partials/header') %>

<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('ecommerce.customers.title') : 'Customers' %></h4>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong><%= typeof t !== 'undefined' ? t('messages.success') : 'Success!' %></strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<!-- BEGIN filters -->
				<form method="GET" action="/admin/customers" id="filters-form">
					<div class="row mb-3">
						<div class="col-md-4">
							<div class="input-group">
								<span class="input-group-text">
									<i class="fa fa-search"></i>
								</span>
								<input type="text" class="form-control" name="search" id="searchFilter" 
								       placeholder="<%= typeof t !== 'undefined' ? t('common.search') : 'Search customers...' %>" 
								       value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>" />
							</div>
						</div>
						<div class="col-md-2">
							<select class="form-select" name="status" id="statusFilter">
								<option value="">All Status</option>
								<option value="Active" <%= typeof filters !== 'undefined' && filters.status === 'Active' ? 'selected' : '' %>>
									Active
								</option>
								<option value="Inactive" <%= typeof filters !== 'undefined' && filters.status === 'Inactive' ? 'selected' : '' %>>
									Inactive
								</option>
							</select>
						</div>
						<div class="col-md-3">
							<button type="submit" class="btn btn-primary me-1">
								<i class="fa fa-filter"></i> <%= typeof t !== 'undefined' ? t('common.filter') : 'Filter' %>
							</button>
							<a href="/admin/customers" class="btn btn-secondary">
								<i class="fa fa-times"></i> <%= typeof t !== 'undefined' ? t('common.clearFilters') : 'Clear' %>
							</a>
						</div>
					</div>
				</form>
				<!-- END filters -->
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th>Email</th>
								<th>Username</th>
								<th>Total Orders</th>
								<th>Total Spent</th>
								<th>Last Order</th>
								<th>Registered</th>
								<th><%= typeof t !== 'undefined' ? t('common.status') : 'Status' %></th>
								<th width="100"><%= typeof t !== 'undefined' ? t('common.actions') : 'Actions' %></th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof customers !== 'undefined' && customers && customers.length > 0) { %>
								<% customers.forEach(function(customer) { %>
									<tr data-customer-id="<%= customer.id %>">
										<td>
											<%= customer.email %>
										</td>
										<td>
											<%= customer.username %>
										</td>
										<td>
											<%= customer.total_orders || 0 %>
										</td>
										<td>
											$<%= parseFloat(customer.total_spent || 0).toFixed(2) %>
										</td>
										<td>
											<% if (customer.last_order_date) { %>
												<%= new Date(customer.last_order_date).toLocaleDateString() %>
											<% } else { %>
												<span class="text-muted">Never</span>
											<% } %>
										</td>
										<td>
											<%= new Date(customer.created_at).toLocaleDateString() %>
										</td>
										<td>
											<% if (customer.status === 'Active') { %>
												<span class="badge bg-success">Active</span>
											<% } else { %>
												<span class="badge bg-danger">Inactive</span>
											<% } %>
										</td>
										<td>
											<a href="/admin/customers/<%= customer.id %>" class="btn btn-xs btn-primary" title="<%= typeof t !== 'undefined' ? t('common.view') : 'View' %>">
												<i class="fa fa-eye"></i>
											</a>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="8" class="text-center py-4">
										<i class="fa fa-users fa-3x text-muted mb-3"></i>
										<p class="text-muted"><%= typeof t !== 'undefined' ? t('common.noData') : 'No customers found' %></p>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
				
				<!-- BEGIN pagination -->
				<% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
					<div class="d-flex justify-content-between align-items-center mt-3">
						<div>
							<%= typeof t !== 'undefined' ? (t('common.showing') || t('ecommerce.showing')) : 'Showing' %> 
							<%= ((pagination.page - 1) * pagination.limit) + 1 %> - 
							<%= Math.min(pagination.page * pagination.limit, pagination.total) %> 
							<%= typeof t !== 'undefined' ? t('common.of') : 'of' %> 
							<%= pagination.total %> 
							<%= typeof t !== 'undefined' ? t('common.items') : 'items' %>
						</div>
						<nav>
							<ul class="pagination mb-0">
								<% 
									const currentPage = pagination.page;
									const totalPages = pagination.totalPages;
									const queryParams = new URLSearchParams();
									if (typeof filters !== 'undefined') {
										if (filters.search) queryParams.set('search', filters.search);
										if (filters.status) queryParams.set('status', filters.status);
									}
									
									// Previous button
									if (currentPage > 1) {
										queryParams.set('page', (currentPage - 1).toString());
								%>
									<li class="page-item">
										<a class="page-link" href="?<%= queryParams.toString() %>">
											<i class="fa fa-chevron-left"></i>
										</a>
									</li>
								<% } else { %>
									<li class="page-item disabled">
										<span class="page-link"><i class="fa fa-chevron-left"></i></span>
									</li>
								<% } %>

								<% 
									// Page numbers
									let startPage = Math.max(1, currentPage - 2);
									let endPage = Math.min(totalPages, currentPage + 2);
									
									for (let i = startPage; i <= endPage; i++) {
										queryParams.set('page', i.toString());
								%>
									<li class="page-item <%= i === currentPage ? 'active' : '' %>">
										<a class="page-link" href="?<%= queryParams.toString() %>"><%= i %></a>
									</li>
								<% } %>

								<% 
									// Next button
									if (currentPage < totalPages) {
										queryParams.set('page', (currentPage + 1).toString());
								%>
									<li class="page-item">
										<a class="page-link" href="?<%= queryParams.toString() %>">
											<i class="fa fa-chevron-right"></i>
										</a>
									</li>
								<% } else { %>
									<li class="page-item disabled">
										<span class="page-link"><i class="fa fa-chevron-right"></i></span>
									</li>
								<% } %>
							</ul>
						</nav>
					</div>
				<% } %>
				<!-- END pagination -->
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<%- include('../partials/footer') %>

