<!-- BEGIN breadcrumb -->
<ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="/admin/dashboard"><%= typeof t !== 'undefined' ? t('common.home') : 'Home' %></a></li>
	<li class="breadcrumb-item"><a href="/admin/pages"><%= typeof t !== 'undefined' ? t('menu.pages') : 'Pages' %></a></li>
	<li class="breadcrumb-item active">
		<%= typeof t !== 'undefined' ? (isCreateMode ? t('pages.createPage') : t('pages.editPage')) : (isCreateMode ? 'Create Page' : 'Edit Page') %>
	</li>
</ol>
<!-- END breadcrumb -->

<form method="POST" action="<%= isCreateMode ? '/admin/pages/create' : '/admin/pages/' + page.key + '/edit' %>"
	enctype="multipart/form-data" id="editPageForm" data-create-mode="<%= isCreateMode %>"
	data-page-key="<%= page.key %>">
	<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
	<!-- BEGIN row -->
	<div class="row">
		<!-- BEGIN col-9 -->
		<div class="col-xl-9">
			<!-- BEGIN panel -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-1">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('pages.pageInformation') : 'Page Information' %></h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<% if (typeof error !=='undefined' && error) { %>
						<div class="alert alert-danger">
							<i class="fa fa-exclamation-triangle"></i>
							<%= error %>
						</div>
						<% } %>
							<% if (typeof success !=='undefined' && success) { %>
								<div class="alert alert-success">
									<i class="fa fa-check-circle"></i>
									<%= success %>
								</div>
								<% } %>
									<!-- Basic Information -->
									<div class="row mb-15px">
										<label class="form-label col-form-label col-md-3"><%= t('pages.pageTitle') %> <span
												class="text-danger">*</span></label>
										<div class="col-md-9">
											<input type="text" class="form-control" id="title" name="title"
												value="<%= page.title %>" required />
											<small class="fs-12px text-gray-500-darker"><%= t('pages.displayTitle') %></small>
										</div>
									</div>

									<div class="row mb-15px">
										<label class="form-label col-form-label col-md-3"><%= typeof t !== 'undefined' ? t('pages.pageKey') : 'Page Key' %> <span
												class="text-danger">*</span></label>
										<div class="col-md-9">
											<input type="text" class="form-control" id="key" name="key"
												value="<%= page.key %>" required />
											<small class="fs-12px text-gray-500-darker">
												<%= typeof t !== 'undefined' 
													? (isCreateMode ? t('pages.autoGeneratedKey') : t('pages.uniqueIdentifier'))
													: (isCreateMode ? 'Auto-generated from title (e.g., "about", "contact")' : 'Unique identifier for the page') %>
											</small>
										</div>
									</div>

									<div class="row mb-15px">
										<label class="form-label col-form-label col-md-3"><%= typeof t !== 'undefined' ? t('pages.pageUrl') : 'Page URL' %> <span
												class="text-danger">*</span></label>
										<div class="col-md-9">
											<input type="text" class="form-control" id="url" name="url"
												value="<%= page.url %>" required />
											<small class="fs-12px text-gray-500-darker">
												<%= typeof t !== 'undefined'
													? (isCreateMode ? t('pages.autoGeneratedUrl') : t('pages.urlPath'))
													: (isCreateMode ? 'Auto-generated from title (e.g., "/about", "/contact")' : 'URL path for the page') %>
											</small>
										</div>
									</div>

									<div class="row mb-15px">
										<div class="col-12">
											<label class="form-label"><%= typeof t !== 'undefined' ? t('pages.pageDescription') : 'Page Description' %></label>
											<textarea class="form-control" id="description" name="description" rows="3" maxlength="1000"
												placeholder="<%= typeof t !== 'undefined' ? t('pages.enterDescription') : 'Enter a brief description of the page (max 1000 characters)...' %>"><%= page.description || '' %></textarea>
											<div class="d-flex justify-content-between align-items-center">
												<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.descriptionHelp') : 'Brief description of the page (max 1000 characters)' %></small>
												<small class="fs-12px text-gray-500-darker" id="descriptionCount">0/1000</small>
											</div>
										</div>
									</div>

									<div class="row mb-15px">
										<div class="col-12">
											<label class="form-label"><%= typeof t !== 'undefined' ? t('pages.pageContent') : 'Page Content' %></label>
											<textarea class="form-control rich-text" id="content" name="content" rows="8"
												placeholder="<%= typeof t !== 'undefined' ? t('pages.enterContent') : 'Enter the page content in HTML format...' %>"><%= page.content || '' %></textarea>
										</div>
									</div>

									<!-- Hidden inputs for existing image URLs -->
									<input type="hidden" id="pageImage" name="pageImage"
										value="<%= page.pageImage || '' %>">
									<input type="hidden" id="seoImage" name="seoImage"
										value="<%= page.seoImage || '' %>">
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-3">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('pages.seoSettings') : 'SEO Settings' %></h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<!-- SEO Information -->
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3"><%= typeof t !== 'undefined' ? t('pages.seoPageTitle') : 'SEO Page Title' %></label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="seoPageTitle" name="pageTitle"
								value="<%= (page.seo && page.seo.pageTitle) ? page.seo.pageTitle : '' %>" maxlength="60" />
							<div class="d-flex justify-content-between">
								<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.seoTitleDescription') : 'Title that appears in search results and browser tabs' %></small>
								<small class="fs-12px text-gray-500-darker" id="seoTitleCount">0/60</small>
							</div>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3"><%= typeof t !== 'undefined' ? t('pages.seoPageDescription') : 'SEO Page Description' %></label>
						<div class="col-md-9">
							<textarea class="form-control" id="seoPageDescription" name="pageDescription" rows="3"
								maxlength="500"><%= (page.seo && page.seo.pageDescription) ? page.seo.pageDescription : '' %></textarea>
							<div class="d-flex justify-content-between align-items-center">
								<div>
									<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.seoDescDescription') : 'Description that appears in search results' %></small>
								</div>
								<div class="d-flex align-items-center">
									<small class="fs-12px text-gray-500-darker" id="seoDescCount">0/500</small>
								</div>
							</div>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3"><%= typeof t !== 'undefined' ? t('pages.seoKeywords') : 'SEO Keywords' %></label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="seoPageKeywords" name="pageKeywords"
								value="<%= (page.seo && page.seo.pageKeywords) ? page.seo.pageKeywords : '' %>" />
							<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.seoKeywordsDescription') : 'Comma-separated keywords for search optimization (optional)' %></small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3"><%= typeof t !== 'undefined' ? t('pages.seoPageImage') : 'SEO Page Image' %></label>
						<div class="col-md-9">
							<div class="d-flex align-items-center mb-2">
								<div class="form-check me-3">
									<input class="form-check-input" type="checkbox" id="usePageImage"
										name="usePageImage" value="1" <%=page.pageImage && page.seoImage && page.seoImage === page.pageImage ? 'checked' : '' %> />
									<label class="form-check-label" for="usePageImage">
										<%= typeof t !== 'undefined' ? t('pages.usePageImage') : 'Use page image' %>
									</label>
								</div>
							</div>

							<!-- SEO Image Display -->
							<div id="seoImageContainer" class="mb-3"
								style="display: <%= page.pageImage && page.seoImage && page.seoImage === page.pageImage ? 'none' : 'block' %>;">
								<% if (page.seoImage && page.seoImage !== page.pageImage) { %>
									<div class="text-center">
										<img id="seoCurrentImage" src="<%= page.seoImage %>"
											alt="<%= typeof t !== 'undefined' ? t('pages.currentSeoImage') : 'Current SEO image' %>" class="img-fluid rounded"
											style="max-width: 100px; max-height: 100px; cursor: pointer;"
											onclick="openImageInNewTab('<%= page.seoImage %>')" />
										<div class="mt-2">
											<button type="button" class="btn btn-sm btn-outline-primary"
												onclick="uploadSeoImage()">
												<i class="fa fa-upload me-1"></i> <%= typeof t !== 'undefined' ? t('pages.uploadNewImage') : 'Upload New Image' %>
											</button>
										</div>
									</div>
									<% } else if (page.pageImage) { %>
										<div class="text-center">
											<img id="seoCurrentImage" src="<%= page.pageImage %>"
												alt="<%= typeof t !== 'undefined' ? t('pages.currentSeoImage') : 'Current SEO image' %>" class="img-fluid rounded"
												style="max-width: 100px; max-height: 100px; cursor: pointer;"
												onclick="openImageInNewTab('<%= page.pageImage %>')" />
											<div class="mt-2">
												<button type="button" class="btn btn-sm btn-outline-primary"
													onclick="uploadSeoImage()">
													<i class="fa fa-upload me-1"></i> <%= typeof t !== 'undefined' ? t('pages.uploadNewImage') : 'Upload New Image' %>
												</button>
											</div>
										</div>
										<% } else { %>
											<div class="text-center p-3 border rounded bg-light">
												<i class="fa fa-image fa-2x text-muted mb-2"></i>
												<p class="text-muted mb-2"><%= typeof t !== 'undefined' ? t('pages.noImageUploaded') : 'No image uploaded' %></p>
												<button type="button" class="btn btn-sm btn-outline-primary"
													onclick="uploadSeoImage()">
													<i class="fa fa-upload me-1"></i> <%= typeof t !== 'undefined' ? t('pages.uploadImage') : 'Upload Image' %>
												</button>
											</div>
											<% } %>
							</div>

							<!-- Hidden file input for SEO image -->
							<input type="file" id="seoImageFile" name="seoImageFile" accept="image/*"
								style="display: none;" />

							<!-- SEO Image URL input (when usePageImage is unchecked) -->
							<div id="seoImageUrlContainer" style="display: none;">
								<input type="text" class="form-control" id="seoImageUrl" name="seoImageUrl"
									value="<%= page.seoImage || '' %>" />
								<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.imageUrlForSocial') : 'Image URL for social media sharing' %></small>
							</div>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-5">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('pages.photoGallery') : 'Photo Gallery' %></h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<% if (!isCreateMode) { %>
						<div class="mb-3">
							<label class="form-label"><%= typeof t !== 'undefined' ? t('pages.uploadPhotos') : 'Upload Photos' %></label>
							<input type="file" class="form-control" id="photoUploadInput" name="photos" accept="image/*" multiple />
							<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.selectMultiplePhotos') : 'Select multiple photos to upload to the gallery' %></small>
						</div>

						<div id="photoGalleryContainer" class="photo-gallery-container">
							<div id="photoGalleryLoading" class="text-center p-4">
								<i class="fa fa-spinner fa-spin fa-2x text-muted"></i>
								<p class="text-muted mt-2"><%= typeof t !== 'undefined' ? t('pages.loadingPhotos') : 'Loading photos...' %></p>
							</div>
							<div id="photoGalleryGrid" class="row g-2" style="display: none;"></div>
							<div id="photoGalleryEmpty" class="text-center p-4 border rounded bg-light" style="display: none;">
								<i class="fa fa-images fa-3x text-muted mb-2"></i>
								<p class="text-muted mb-0"><%= typeof t !== 'undefined' ? t('pages.noPhotosInGallery') : 'No photos in gallery. Upload photos to get started.' %></p>
							</div>
						</div>
					<% } else { %>
						<div class="alert alert-info">
							<i class="fa fa-info-circle"></i> <%= typeof t !== 'undefined' ? t('pages.savePageFirstToAddPhotos') : 'Please save the page first before adding photos to the gallery.' %>
						</div>
					<% } %>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->
		</div>
		<!-- END col-9 -->

		<!-- BEGIN col-3 -->
		<div class="col-xl-3">
			<!-- BEGIN panel - Page Image -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-2">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('pages.pageImage') : 'Page Image' %></h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<!-- Page Image Section -->
					<div class="mb-15px">
						<label class="form-label"><%= typeof t !== 'undefined' ? t('pages.pageImage') : 'Page Image' %></label>

						<!-- Image Display -->
						<div id="currentImageContainer" class="mb-3">
							<% if (page.pageImage) { %>
								<div class="text-center">
									<img id="currentImage" src="<%= page.pageImage %>" alt="<%= typeof t !== 'undefined' ? t('pages.pageImage') : 'Current page image' %>"
										class="img-fluid rounded"
										style="max-width: 100%; max-height: 200px; cursor: pointer;"
										onclick="openImageInNewTab('<%= page.pageImage %>')" />
									<% if (!isCreateMode) { %>
										<div class="mt-2">
											<button type="button" class="btn btn-sm btn-danger"
												onclick="deletePageImage()">
												<i class="fa fa-trash me-1"></i> <%= typeof t !== 'undefined' ? t('pages.deleteImage') : 'Delete Image' %>
											</button>
										</div>
										<% } %>
								</div>
								<% } else { %>
									<div class="text-center p-4 border rounded bg-light">
										<i class="fa fa-image fa-3x text-muted mb-2"></i>
										<p class="text-muted mb-0"><%= typeof t !== 'undefined' ? t('pages.noImageUploaded') : 'No image uploaded' %></p>
									</div>
									<% } %>
						</div>

						<!-- Image Upload -->
						<div class="mb-3">
							<label for="pagePicture" class="form-label"><%= typeof t !== 'undefined' ? t('pages.uploadNewImage') : 'Upload New Image' %></label>
							<input type="file" class="form-control" id="pagePicture" name="pagePicture"
								accept="image/*" />
							<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.replaceCurrentImage') : 'Upload a new image to replace the current one' %></small>
						</div>

						<!-- Image Preview -->
						<div id="imagePreview" class="mb-3" style="display: none;">
							<label class="form-label"><%= typeof t !== 'undefined' ? t('pages.preview') : 'Preview' %></label>
							<div class="text-center">
								<img id="previewImg" src="" alt="<%= typeof t !== 'undefined' ? t('pages.preview') : 'Preview' %>" class="img-fluid rounded"
									style="max-width: 100%; max-height: 150px;" />
								<div class="mt-2">
									<button type="button" class="btn btn-sm btn-secondary"
										onclick="removeImagePreview()">
										<i class="fa fa-times me-1"></i> <%= typeof t !== 'undefined' ? t('pages.removePreview') : 'Remove Preview' %>
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Publish Date & Status -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-3">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('pages.publishDateAndStatus') : 'Publish Date & Status' %></h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<!-- Publish Date Section -->
					<div class="mb-15px">
						<label class="form-label" for="publishDate"><%= typeof t !== 'undefined' ? t('pages.publishDate') : 'Publish Date' %></label>
						<input type="date" class="form-control" id="publishDate" name="publishDate"
							value="<%= isCreateMode ? '' : (page.publishDate || '') %>" />
						<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.publishDateDescription') : 'Set the date when this page should be published (optional)' %></small>
					</div>

					<!-- Status Section -->
					<div class="mb-15px">
						<label class="form-label"><%= typeof t !== 'undefined' ? t('pages.pageStatus') : 'Page Status' %></label>
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="isActive" name="isActive" value="1"
								<%= isCreateMode ? 'checked' : (page.status==='published' ? 'checked' : '') %> />
							<label class="form-check-label" for="isActive">
								<%= typeof t !== 'undefined' ? t('common.published') : 'Published' %>
							</label>
						</div>
						<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.checkToPublish') : 'Check to publish this page (unchecked = draft)' %></small>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Page Tags -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-4">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('pages.pageTags') : 'Page Tags' %></h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<!-- Page Tags Section -->
					<div class="mb-15px">
						<label class="form-label"><%= typeof t !== 'undefined' ? t('pages.pageTags') : 'Page Tags' %></label>
						
						<!-- Tags Input -->
						<div class="input-group mb-2">
							<input type="text" class="form-control" id="tagInput" placeholder="<%= typeof t !== 'undefined' ? t('pages.enterTagName') : 'Enter tag name and press Enter' %>" />
							<button type="button" class="btn btn-primary" id="addTagBtn">
								<i class="fa fa-plus"></i> <%= typeof t !== 'undefined' ? t('pages.addTag') : 'Add' %>
							</button>
						</div>

						<!-- Existing Tags Display -->
						<div id="tagsContainer" class="mb-2">
							<% if (page.tags && page.tags.length > 0) { %>
								<% page.tags.forEach(function(tag) { %>
									<span class="badge bg-primary me-1 mb-1 tag-badge" data-tag-id="<%= tag.id %>" data-tag-name="<%= tag.name %>">
										<%= tag.name %>
										<button type="button" class="btn-close btn-close-white ms-1" aria-label="Remove" onclick="removeTag('<%= tag.name %>')"></button>
									</span>
								<% }); %>
							<% } %>
						</div>

						<!-- Hidden input to store tags -->
						<input type="hidden" id="pageTags" name="pageTags" value="" />

						<small class="fs-12px text-gray-500-darker"><%= typeof t !== 'undefined' ? t('pages.tagsDescription') : 'Add tags to categorize and organize your pages' %></small>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->
		</div>
		<!-- END col-3 -->
	</div>
	<!-- END row -->

	<!-- Sticky actions footer (same pattern as product edit) -->
	<div class="sticky-actions-footer bg-white border-top py-3 px-4 d-flex justify-content-end align-items-center">
		<a href="/admin/pages" class="btn btn-secondary me-2">
			<i class="fa fa-times"></i>
			<%= typeof t !== 'undefined' ? t('common.cancel') : 'Cancel' %>
		</a>
		<button type="submit" class="btn btn-primary">
			<i class="fa fa-save"></i>
			<%= typeof t !== 'undefined' ? (isCreateMode ? t('pages.createPage') : t('pages.updatePage')) : (isCreateMode ? 'Create Page' : 'Update Page') %>
		</button>
	</div>
</form>
<!-- Spacer for sticky footer -->
<div style="height: 80px;"></div>

<script>
	// Character count for description field
	const descriptionField = document.getElementById('description');
	if (descriptionField) {
		descriptionField.addEventListener('input', function () {
			const count = this.value.length;
			const countElement = document.getElementById('descriptionCount');
			if (countElement) {
				countElement.textContent = count + '/1000';
				if (count > 1000) {
					countElement.classList.add('text-danger');
				} else {
					countElement.classList.remove('text-danger');
				}
			}
			// Limit to 1000 characters
			if (this.value.length > 1000) {
				this.value = this.value.substring(0, 1000);
			}
		});
		// Initialize count on page load
		if (descriptionField.value) {
			descriptionField.dispatchEvent(new Event('input'));
		}
	}

	// Character count for SEO fields
	document.getElementById('seoPageTitle').addEventListener('input', function () {
		const count = this.value.length;
		document.getElementById('seoTitleCount').textContent = count + '/60';
	});

	document.getElementById('seoPageDescription').addEventListener('input', function () {
		const count = this.value.length;
		const countElement = document.getElementById('seoDescCount');
		countElement.textContent = count + '/500';
		
		// Update styling based on character count
		countElement.className = 'fs-12px text-gray-500-darker';
		if (count > 450) {
			countElement.classList.add('text-warning');
		}
		if (count > 500) {
			countElement.classList.remove('text-warning');
			countElement.classList.add('text-danger');
		}
		
		// Limit to 500 characters
		if (this.value.length > 500) {
			this.value = this.value.substring(0, 500);
			countElement.textContent = '500/500';
			countElement.className = 'fs-12px text-danger';
		}
	});

	// Auto-fill key and URL from title (only in create mode)
	document.addEventListener('DOMContentLoaded', function () {
		const titleInput = document.getElementById('title');
		const keyInput = document.getElementById('key');
		const urlInput = document.getElementById('url');
		const isCreateModeFlag = document.getElementById('editPageForm').dataset.createMode === 'true';

		// Function to convert title to URL (uses titleToKey from custom.js)
		function titleToUrl(title) {
			return '/' + titleToKey(title);
		}

		// Auto-fill key and URL from title (only in create mode)
		if (titleInput && isCreateModeFlag && keyInput && urlInput) {
			titleInput.addEventListener('input', function() {
				const pageTitle = this.value;
				if (pageTitle) {
					// Use the global titleToKey function from custom.js which handles transliteration
					keyInput.value = titleToKey(pageTitle);
					urlInput.value = titleToUrl(pageTitle);
					
					// Trigger validation
					keyInput.dispatchEvent(new Event('input'));
					urlInput.dispatchEvent(new Event('input'));
				}
			});
		}
	});

	// Initialize character counts and other functionality
	document.addEventListener('DOMContentLoaded', function () {
		// Set default publish date to today in create mode
		const isCreateModeFlag = document.getElementById('editPageForm')?.dataset.createMode === 'true';
		const publishDateInput = document.getElementById('publishDate');
		if (isCreateModeFlag && publishDateInput && !publishDateInput.value) {
			// Get today's date in YYYY-MM-DD format
			const today = new Date();
			const year = today.getFullYear();
			const month = String(today.getMonth() + 1).padStart(2, '0');
			const day = String(today.getDate()).padStart(2, '0');
			publishDateInput.value = `${year}-${month}-${day}`;
		}
		
		document.getElementById('seoPageTitle').dispatchEvent(new Event('input'));
		document.getElementById('seoPageDescription').dispatchEvent(new Event('input'));



		// SEO Image functionality
		const usePageImageCheckbox = document.getElementById('usePageImage');
		if (usePageImageCheckbox) {
			usePageImageCheckbox.addEventListener('change', function () {
				const seoImageContainer = document.getElementById('seoImageContainer');
				const seoImageUrlContainer = document.getElementById('seoImageUrlContainer');

				if (this.checked) {
					// Use page image - hide both upload UI and URL input
					seoImageContainer.style.display = 'none';
					seoImageUrlContainer.style.display = 'none';
					console.log('Use page image checked - hiding SEO upload UI');
				} else {
					// Use custom image - show upload UI, hide URL input
					seoImageContainer.style.display = 'block';
					seoImageUrlContainer.style.display = 'none';
					console.log('Use page image unchecked - showing SEO upload UI');
				}
			});

			// Initialize SEO image checkbox state
			console.log('Initializing SEO image checkbox state');
			const currentPageImage = document.getElementById('pageImage')?.value || '';
			const currentSeoImage = document.getElementById('seoImage')?.value || '';
			console.log('Page image:', currentPageImage);
			console.log('SEO image:', currentSeoImage);
			console.log('Checkbox checked:', usePageImageCheckbox.checked);
			usePageImageCheckbox.dispatchEvent(new Event('change'));
		}
	});

	// Image preview functionality
	document.getElementById('pagePicture').addEventListener('change', function () {
		const preview = document.getElementById('imagePreview');
		const previewImg = document.getElementById('previewImg');
		const file = this.files[0];

		console.log('File selected:', file);

		if (file) {
			const reader = new FileReader();
			reader.onload = function (e) {
				previewImg.src = e.target.result;
				preview.style.display = 'block';
			}
			reader.readAsDataURL(file);
		} else {
			preview.style.display = 'none';
		}
	});

	// Form submission - update CSRF token and intercept for multipart forms
	document.getElementById('editPageForm').addEventListener('submit', function (e) {
		console.log('Form submitted');
		
		// CRITICAL: Update CSRF token from meta tag before submission
		// This ensures we always use the latest token (important after AJAX calls)
		const csrfTokenMeta = document.querySelector('meta[name="csrf-token"]');
		const csrfTokenInput = document.querySelector('input[name="_csrf"]');
		
		if (csrfTokenMeta && csrfTokenInput) {
			const latestToken = csrfTokenMeta.getAttribute('content');
			if (latestToken) {
				csrfTokenInput.setAttribute('value', latestToken);
				csrfTokenInput.value = latestToken; // Also set .value property
				console.log('CSRF token updated before form submission:', latestToken.substring(0, 10) + '...');
			} else {
				console.warn('CSRF token not found in meta tag!');
			}
		} else {
			console.warn('CSRF token meta tag or input not found!');
		}
		
		// Also try the helper function if available
		if (typeof refreshCsrfTokenInForms === 'function') {
			refreshCsrfTokenInForms();
		}
		
		// For multipart forms, we can't easily add headers via normal form submission
		// But the token should be in the form data, which multer will parse
		// The server-side code will extract it from headers if needed
		
		// Debug SEO fields
		const seoPageTitle = document.getElementById('seoPageTitle');
		const seoPageDescription = document.getElementById('seoPageDescription');
		const seoPageKeywords = document.getElementById('seoPageKeywords');
		
		console.log('SEO Page Title:', seoPageTitle ? seoPageTitle.value : 'not found');
		console.log('SEO Page Description:', seoPageDescription ? seoPageDescription.value : 'not found');
		console.log('SEO Page Keywords:', seoPageKeywords ? seoPageKeywords.value : 'not found');

		// Update content textarea before submission
		const contentTextarea = document.getElementById('content');
		if (contentTextarea) {
			console.log('Content textarea value:', contentTextarea.value);
		}

		// Check if file is selected
		const fileInput = document.getElementById('pagePicture');
		if (fileInput.files.length > 0) {
			console.log('File will be uploaded:', fileInput.files[0]);
		} else {
			console.log('No file selected');
		}
	});

	// Real-time validation for page key and URL uniqueness
	document.addEventListener('DOMContentLoaded', function () {
		const keyInput = document.getElementById('key');
		const urlInput = document.getElementById('url');
		const isCreateModeFlag = document.getElementById('editPageForm').dataset.createMode === 'true';
		const currentPageKey = document.getElementById('editPageForm').dataset.pageKey || '';
		const currentPageUrl = '<%= page.url || "" %>';

		// Function to validate key uniqueness
		async function validateKeyUniqueness(key) {
			if (!key || key.trim() === '') return;

			try {
				// In edit mode, exclude current page key from check
				const excludeParam = !isCreateModeFlag && currentPageKey ? `?exclude=${encodeURIComponent(currentPageKey)}` : '';
				const response = await fetch(`/admin/api/pages/check-key/${encodeURIComponent(key.trim())}${excludeParam}`);
				const data = await response.json();

				const keyField = document.getElementById('key');
				const keyHelpText = keyField.parentNode.querySelector('small');

				const thisKeyExists = '<%= typeof t !== "undefined" ? t("pages.thisKeyExists") : "This page key already exists. Please choose a different one." %>';
				const autoGeneratedKey = '<%= typeof t !== "undefined" ? t("pages.autoGeneratedKey") : "Unique identifier for the page (e.g., \"about\", \"contact\")" %>';
				
				if (data.exists) {
					keyField.classList.add('is-invalid');
					keyField.classList.remove('is-valid');
					if (keyHelpText) {
						keyHelpText.textContent = thisKeyExists;
						keyHelpText.className = 'fs-12px text-danger';
					}
				} else {
					keyField.classList.remove('is-invalid');
					keyField.classList.add('is-valid');
					if (keyHelpText) {
						keyHelpText.textContent = autoGeneratedKey;
						keyHelpText.className = 'fs-12px text-gray-500-darker';
					}
				}
			} catch (error) {
				console.error('Error validating key:', error);
			}
		}

		// Function to validate URL uniqueness
		async function validateUrlUniqueness(url) {
			if (!url || url.trim() === '') return;

			try {
				// In edit mode, exclude current page URL from check
				const excludeParam = !isCreateModeFlag && currentPageUrl ? `?exclude=${encodeURIComponent(currentPageUrl)}` : '';
				const response = await fetch(`/admin/api/pages/check-url/${encodeURIComponent(url.trim())}${excludeParam}`);
				const data = await response.json();

				const urlField = document.getElementById('url');
				const urlHelpText = urlField.parentNode.querySelector('small');

				const thisUrlExists = '<%= typeof t !== "undefined" ? t("pages.thisUrlExists") : "This URL already exists. Please choose a different one." %>';
				const autoGeneratedUrl = '<%= typeof t !== "undefined" ? t("pages.autoGeneratedUrl") : "URL path for the page (e.g., \"/about\", \"/contact\")" %>';
				
				if (data.exists) {
					urlField.classList.add('is-invalid');
					urlField.classList.remove('is-valid');
					if (urlHelpText) {
						urlHelpText.textContent = thisUrlExists;
						urlHelpText.className = 'fs-12px text-danger';
					}
				} else {
					urlField.classList.remove('is-invalid');
					urlField.classList.add('is-valid');
					if (urlHelpText) {
						urlHelpText.textContent = autoGeneratedUrl;
						urlHelpText.className = 'fs-12px text-gray-500-darker';
					}
				}
			} catch (error) {
				console.error('Error validating URL:', error);
			}
		}

		// Add event listeners for real-time validation
		if (keyInput) {
			let keyTimeout;
			keyInput.addEventListener('input', function () {
				clearTimeout(keyTimeout);
				keyTimeout = setTimeout(() => {
					validateKeyUniqueness(this.value);
				}, 500); // Debounce for 500ms
			});
		}

		if (urlInput) {
			let urlTimeout;
			urlInput.addEventListener('input', function () {
				clearTimeout(urlTimeout);
				urlTimeout = setTimeout(() => {
					validateUrlUniqueness(this.value);
				}, 500); // Debounce for 500ms
			});
		}
	});

	function removeImagePreview() {
		document.getElementById('pagePicture').value = '';
		document.getElementById('imagePreview').style.display = 'none';
		document.getElementById('previewImg').src = '';
	}

	function openImageInNewTab(imageUrl) {
		if (imageUrl) {
			window.open(imageUrl, '_blank');
		}
	}

	function uploadSeoImage() {
		console.log('uploadSeoImage called');
		const seoImageFile = document.getElementById('seoImageFile');
		if (seoImageFile) {
			console.log('SEO image file input found, clicking...');
			seoImageFile.click();
		} else {
			console.error('SEO image file input not found');
		}
	}

	// Handle SEO image file selection
	document.addEventListener('DOMContentLoaded', function () {
		const seoImageFile = document.getElementById('seoImageFile');
		if (seoImageFile) {
			seoImageFile.addEventListener('change', function () {
				console.log('SEO image file selected:', this.files[0]);
				const file = this.files[0];
				if (file) {
					const reader = new FileReader();
					reader.onload = function (e) {
						console.log('SEO image file loaded, updating UI');
						const seoImageContainer = document.getElementById('seoImageContainer');
						const uploadNewImageText = '<%= typeof t !== "undefined" ? t("pages.uploadNewImage") : "Upload New Image" %>';
						const currentSeoImageAlt = '<%= typeof t !== "undefined" ? t("pages.currentSeoImage") : "Current SEO image" %>';
						seoImageContainer.innerHTML = `
						<div class="text-center">
							<img id="seoCurrentImage" src="${e.target.result}" alt="${currentSeoImageAlt}" class="img-fluid rounded" style="max-width: 100px; max-height: 100px; cursor: pointer;" onclick="openImageInNewTab('${e.target.result}')" />
							<div class="mt-2">
								<button type="button" class="btn btn-sm btn-outline-primary" onclick="uploadSeoImage()">
									<i class="fa fa-upload me-1"></i> ${uploadNewImageText}
								</button>
							</div>
						</div>
					`;

						// Don't update the pageImage input with base64 data URL
						// The file will be uploaded separately and the path will be set by the server
						console.log('SEO image file selected, will be uploaded with form');
					};
					reader.readAsDataURL(file);
				}
			});
		}
	});



	function deletePageImage() {
		const pageKey = '<%= page.key %>';
		const currentImage = '<%= page.pageImage || '' %>';
		const isCreateModeFlag = document.getElementById('editPageForm').dataset.createMode === 'true';

		const cannotDeleteInCreateMode = '<%= typeof t !== "undefined" ? t("pages.cannotDeleteInCreateMode") : "Cannot delete image in create mode" %>';
		const noImageToDelete = '<%= typeof t !== "undefined" ? t("pages.noImageToDelete") : "No image to delete" %>';
		const deleteImageTitle = '<%= typeof t !== "undefined" ? t("pages.deleteImageConfirm") : "Delete Image" %>';
		const deleteImageMessage = '<%= typeof t !== "undefined" ? t("pages.deleteImageMessage") : "Are you sure you want to delete the page image? This action cannot be undone." %>';
		
		if (isCreateModeFlag) {
			showWarningToast(cannotDeleteInCreateMode);
			return;
		}

		console.log('deletePageImage called');
		console.log('pageKey:', pageKey);
		console.log('currentImage:', currentImage);

		if (!currentImage) {
			console.log('No image to delete, showing warning toast');
			showWarningToast(noImageToDelete);
			return;
		}

			showActionModal({
			title: deleteImageTitle,
			message: deleteImageMessage,
			endpoint: `/admin/pages/${pageKey}/delete-image`,
			onSuccess: function (data) {
				console.log('Delete image response:', data);
				const noImageUploaded = '<%= typeof t !== "undefined" ? t("pages.noImageUploaded") : "No image uploaded" %>';
				const imageDeletedSuccess = '<%= typeof t !== "undefined" ? t("pages.imageDeletedSuccess") : "Image deleted successfully" %>';
				const failedToDeleteImage = '<%= typeof t !== "undefined" ? t("pages.failedToDeleteImage") : "Failed to delete image" %>';
				
				if (data.success) {
					// Update the image container to show placeholder
					
					const container = document.getElementById('currentImageContainer');
					container.innerHTML = `
					<div class="text-center p-4 border rounded bg-light">
						<i class="fa fa-image fa-3x text-muted mb-2"></i>
						<p class="text-muted mb-0">${noImageUploaded}</p>
					</div>
				`;

					// Clear the hidden input
					const pageImageInput = document.getElementById('pageImage');
					if (pageImageInput) {
						pageImageInput.value = '';
					}

					// Show success toast
					console.log('Showing success toast');
					showSuccessToast(imageDeletedSuccess);
				} else {
					console.log('Showing error toast');
					showErrorToast(failedToDeleteImage + ': ' + (data.message || 'Unknown error'));
				}
			}
		});
	}

	// Photo Gallery functionality
	<% if (!isCreateMode) { %>
	const pageKey = '<%= page.key %>';
	let photoGalleryPhotos = [];

	// Load photos on page load
	async function loadPhotoGallery() {
		try {
			const response = await fetch(`/admin/pages/${pageKey}/photos`);
			const data = await response.json();
			
			if (data.success) {
				photoGalleryPhotos = data.photos || [];
				renderPhotoGallery();
			}
		} catch (error) {
			console.error('Error loading photo gallery:', error);
		}
	}

	// Render photo gallery
	function renderPhotoGallery() {
		const loadingEl = document.getElementById('photoGalleryLoading');
		const gridEl = document.getElementById('photoGalleryGrid');
		const emptyEl = document.getElementById('photoGalleryEmpty');

		if (photoGalleryPhotos.length === 0) {
			loadingEl.style.display = 'none';
			gridEl.style.display = 'none';
			emptyEl.style.display = 'block';
			return;
		}

		loadingEl.style.display = 'none';
		emptyEl.style.display = 'none';
		gridEl.style.display = 'flex';
		gridEl.style.flexWrap = 'wrap';
		
		gridEl.innerHTML = photoGalleryPhotos.map((photo, index) => `
			<div class="col-6 col-md-4 col-lg-3 photo-item mb-3" data-photo-id="${photo.id}" data-order="${photo.displayOrder}">
				<div class="card position-relative h-100">
					<img src="${photo.url}" class="card-img-top" style="height: 150px; object-fit: contain; cursor: move; background-color: #f5f5f5;" 
						alt="Photo ${index + 1}" draggable="true" />
					<div class="card-body p-2">
						<div class="d-flex justify-content-between align-items-center">
							<small class="text-muted"><i class="fa fa-image me-1"></i> ${index + 1}</small>
							<button type="button" class="btn btn-sm btn-danger" onclick="deletePhoto(${photo.id})" title="<%= typeof t !== "undefined" ? t("pages.deletePhoto") : "Delete Photo" %>">
								<i class="fa fa-trash"></i>
							</button>
						</div>
					</div>
					<div class="position-absolute top-0 start-0 m-2">
						<span class="badge bg-primary"><i class="fa fa-grip-vertical"></i> <small>Drag</small></span>
					</div>
				</div>
			</div>
		`).join('');

		// Initialize drag and drop
		initDragAndDrop();
	}

	// Initialize drag and drop for reordering
	function initDragAndDrop() {
		const gridEl = document.getElementById('photoGalleryGrid');
		const photoItems = gridEl.querySelectorAll('.photo-item');
		let draggedElement = null;

		photoItems.forEach(item => {
			item.draggable = true;
			item.addEventListener('dragstart', (e) => {
				draggedElement = item;
				item.style.opacity = '0.5';
				e.dataTransfer.effectAllowed = 'move';
			});

			item.addEventListener('dragend', () => {
				item.style.opacity = '1';
				draggedElement = null;
			});

			item.addEventListener('dragover', (e) => {
				e.preventDefault();
				e.dataTransfer.dropEffect = 'move';
				
				if (draggedElement && draggedElement !== item) {
					const allItems = Array.from(gridEl.querySelectorAll('.photo-item'));
					const draggedIndex = allItems.indexOf(draggedElement);
					const targetIndex = allItems.indexOf(item);
					
					if (draggedIndex < targetIndex) {
						gridEl.insertBefore(draggedElement, item.nextSibling);
					} else {
						gridEl.insertBefore(draggedElement, item);
					}
				}
			});

			item.addEventListener('drop', async (e) => {
				e.preventDefault();
				if (draggedElement && draggedElement !== item) {
					// Update order
					const allItems = Array.from(gridEl.querySelectorAll('.photo-item'));
					const newOrders = allItems.map((el, idx) => ({
						id: parseInt(el.dataset.photoId),
						order: idx + 1
					}));

					await reorderPhotos(newOrders);
				}
			});
		});
	}

	// Reorder photos
	async function reorderPhotos(photoOrders) {
		try {
			const response = await fetch(`/admin/pages/${pageKey}/photos/reorder`, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify({ photoOrders })
			});

			const data = await response.json();
			if (data.success) {
				// Reload photos to get updated order
				await loadPhotoGallery();
				showSuccessToast('<%= typeof t !== "undefined" ? t("pages.photosReordered") : "Photos reordered successfully" %>');
			} else {
				showErrorToast(data.message || '<%= typeof t !== "undefined" ? t("pages.failedToReorderPhotos") : "Failed to reorder photos" %>');
			}
		} catch (error) {
			console.error('Error reordering photos:', error);
			showErrorToast('<%= typeof t !== "undefined" ? t("pages.errorReorderingPhotos") : "Error reordering photos" %>');
		}
	}

	// Delete photo
	async function deletePhoto(photoId) {
		const deletePhotoTitle = '<%= typeof t !== "undefined" ? t("pages.deletePhoto") : "Delete Photo" %>';
		const deletePhotoMessage = '<%= typeof t !== "undefined" ? t("pages.deletePhotoConfirm") : "Are you sure you want to delete this photo? This action cannot be undone." %>';
		const photoDeletedSuccess = '<%= typeof t !== "undefined" ? t("pages.photoDeletedSuccess") : "Photo deleted successfully" %>';
		const failedToDeletePhoto = '<%= typeof t !== "undefined" ? t("pages.failedToDeletePhoto") : "Failed to delete photo" %>';

		showActionModal({
			title: deletePhotoTitle,
			message: deletePhotoMessage,
			endpoint: `/admin/pages/${pageKey}/photos/${photoId}`,
			method: 'DELETE',
			onSuccess: function(data) {
				if (data.success) {
					loadPhotoGallery();
					showSuccessToast(photoDeletedSuccess);
				} else {
					showErrorToast(failedToDeletePhoto + ': ' + (data.message || 'Unknown error'));
				}
			}
		});
	}

	// Handle photo upload
	const photoUploadInput = document.getElementById('photoUploadInput');
	if (photoUploadInput) {
		photoUploadInput.addEventListener('change', async function(e) {
			const files = e.target.files;
			if (!files || files.length === 0) return;

			const formData = new FormData();
			for (let i = 0; i < files.length; i++) {
				formData.append('photos', files[i]);
			}

			try {
				const uploadSuccess = '<%= typeof t !== "undefined" ? t("pages.photosUploadedSuccess") : "Photos uploaded successfully" %>';
				const uploadError = '<%= typeof t !== "undefined" ? t("pages.failedToUploadPhotos") : "Failed to upload photos" %>';

				const response = await fetch(`/admin/pages/${pageKey}/photos/upload`, {
					method: 'POST',
					body: formData
				});

				const data = await response.json();
				if (data.success) {
					showSuccessToast(uploadSuccess);
					photoUploadInput.value = '';
					await loadPhotoGallery();
				} else {
					showErrorToast(uploadError + ': ' + (data.message || 'Unknown error'));
				}
			} catch (error) {
				console.error('Error uploading photos:', error);
				showErrorToast('<%= typeof t !== "undefined" ? t("pages.errorUploadingPhotos") : "Error uploading photos" %>');
			}
		});
	}

	// Load gallery on page load
	document.addEventListener('DOMContentLoaded', function() {
		loadPhotoGallery();
	});
	<% } %>

	// Page Tags Management
	let pageTags = [];
	
	// Initialize tags from existing page tags
	<% if (page.tags && page.tags.length > 0) { %>
		<% page.tags.forEach(function(tag) { %>
			pageTags.push('<%= tag.name.replace(/'/g, "\\'").replace(/\n/g, "\\n").replace(/\r/g, "\\r") %>');
		<% }); %>
		updateTagsDisplay();
		updateTagsHiddenInput();
	<% } %>

	// Add tag function
	function addTag(tagName) {
		const trimmedTag = tagName.trim();
		if (trimmedTag && !pageTags.includes(trimmedTag)) {
			pageTags.push(trimmedTag);
			updateTagsDisplay();
			updateTagsHiddenInput();
			document.getElementById('tagInput').value = '';
		}
	}

	// Remove tag function
	function removeTag(tagName) {
		pageTags = pageTags.filter(tag => tag !== tagName);
		updateTagsDisplay();
		updateTagsHiddenInput();
	}

	// Update tags display
	function updateTagsDisplay() {
		const container = document.getElementById('tagsContainer');
		container.innerHTML = '';
		
		pageTags.forEach(tag => {
			const badge = document.createElement('span');
			badge.className = 'badge bg-primary me-1 mb-1 tag-badge';
			badge.dataset.tagName = tag;
			badge.innerHTML = `
				${tag}
				<button type="button" class="btn-close btn-close-white ms-1" aria-label="Remove" onclick="removeTag('${tag.replace(/'/g, "\\'")}')"></button>
			`;
			container.appendChild(badge);
		});
	}

	// Update hidden input for form submission
	function updateTagsHiddenInput() {
		document.getElementById('pageTags').value = JSON.stringify(pageTags);
	}

	// Add tag button click handler
	document.addEventListener('DOMContentLoaded', function() {
		const addTagBtn = document.getElementById('addTagBtn');
		const tagInput = document.getElementById('tagInput');

		if (addTagBtn) {
			addTagBtn.addEventListener('click', function() {
				const tagName = tagInput.value;
				if (tagName) {
					addTag(tagName);
				}
			});
		}

		if (tagInput) {
			tagInput.addEventListener('keypress', function(e) {
				if (e.key === 'Enter') {
					e.preventDefault();
					const tagName = tagInput.value;
					if (tagName) {
						addTag(tagName);
					}
				}
			});
		}
	});
</script>