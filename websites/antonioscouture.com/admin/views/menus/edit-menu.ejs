						<label for="editItemPageAutocomplete" class="form-label"><%= typeof t !== 'undefined' ? t('menus.selectPage') : 'Select Page' %> <span class="text-danger">*</span></label>
						<div class="autocomplete-wrapper position-relative">
							<input type="text" class="form-control" id="editItemPageAutocomplete" 
								   placeholder="<%= typeof t !== 'undefined' ? t('menus.searchPages') || 'Search pages...' : 'Search pages...' %>" 
								   autocomplete="off">
							<input type="hidden" id="editItemPageKey">
							<div class="autocomplete-dropdown" id="editItemPageDropdown" style="display: none;"></div>
							<div class="spinner-border spinner-border-sm position-absolute" id="editItemPageSpinner" style="display: none; right: 10px; top: 50%; transform: translateY(-50%);" role="status">
								<span class="visually-hidden">Loading...</span>
							</div>
						</div>
					</div>
					
					<!-- File Upload (shown when type is 'file') -->
					<div class="mb-3" id="editFileUploadDiv" style="display: none;">
						<label for="editItemFileUpload" class="form-label"><%= typeof t !== 'undefined' ? t('menus.uploadFile') : 'Upload File' %> <span class="text-danger">*</span></label>
						<div class="input-group">
							<input type="file" class="form-control" id="editItemFileUpload" accept="*/*">
							<button type="button" class="btn btn-outline-secondary" id="editUploadFileBtn">
								<i class="fa fa-upload"></i> <%= typeof t !== 'undefined' ? t('common.upload') : 'Upload' %>
							</button>
						</div>
						<div class="form-text"><%= typeof t !== 'undefined' ? t('menus.uploadFileDescription') : 'Upload a file to the downloads folder' %></div>
					</div>
					
					<!-- External Link (shown when type is 'external') -->
					<div class="mb-3" id="editExternalLinkDiv" style="display: none;">
						<label for="editItemLink" class="form-label"><%= typeof t !== 'undefined' ? t('menus.externalUrl') : 'External URL' %> <span class="text-danger">*</span></label>
						<input type="url" class="form-control" id="editItemLink" placeholder="https://example.com">
						<div class="form-text"><%= typeof t !== 'undefined' ? t('menus.externalUrlDescription') : 'Enter the full URL (e.g., "https://example.com")' %></div>
					</div>
					
					<div class="mb-3">
						<label for="editItemSort" class="form-label"><%= typeof t !== 'undefined' ? t('menus.sortOrder') : 'Sort Order' %></label>
						<input type="number" class="form-control" id="editItemSort" min="1">
					</div>
					
					<div class="mb-3">
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="editItemActive" checked>
							<label class="form-check-label" for="editItemActive">
								<%= typeof t !== 'undefined' ? t('common.active') : 'Active' %>
							</label>
						</div>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= typeof t !== 'undefined' ? t('common.cancel') : 'Cancel' %></button>
				<button type="button" class="btn btn-primary" id="saveEditItem"><%= typeof t !== 'undefined' ? t('menus.saveChanges') : 'Save Changes' %></button>
			</div>
		</div>
	</div>
</div>

