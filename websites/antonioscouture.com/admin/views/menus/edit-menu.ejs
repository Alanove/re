					showToast({ message: 'Access denied. You do not have permission to update menu items.', type: 'error' });
					return { success: false, errors: ['Access denied'] };
				}
				showToast({ message: 'Server error. Please try again.', type: 'error' });
				return { success: false, errors: ['Server error'] };
			}
			return response.json();
		})
		.then(data => {
			if (!data) return;
			
			if (data.success) {
				// Show success message
				showToast({ message: 'Menu item updated successfully!', type: 'success' });
				
				// Reload menu items
				fetch(`/admin/menus/${menuId}/items`)
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							menuItems = data.items;
							loadMenuItems();
							editModal.hide();
						} else {
							console.error('Error reloading menu items:', data.errors);
							// Even if reload fails, the update was successful
							editModal.hide();
							// Try to reload the page to ensure UI is in sync
							location.reload();
						}
					})
					.catch(error => {
						console.error('Error reloading menu items:', error);
						// Even if reload fails, the update was successful
						editModal.hide();
						// Try to reload the page to ensure UI is in sync
						location.reload();
					});
			} else {
				const errorMessage = (data.errors && Array.isArray(data.errors)) 
					? data.errors.join(', ') 
					: (data.error || 'Unknown error occurred');
				showToast({ message: 'Error: ' + errorMessage, type: 'error' });
			}
		})
		.catch(error => {
			console.error('Error:', error);
			showToast({ message: 'Failed to update menu item', type: 'error' });
		});
	});
	
	// Delete menu item
	document.addEventListener('click', function(e) {
		if (e.target.closest('.delete-item')) {
			const button = e.target.closest('.delete-item');
			itemToDelete = button.dataset.itemId;
			const deleteItemNameEl = document.getElementById('deleteItemName');
			if (deleteItemNameEl) {
				deleteItemNameEl.textContent = button.dataset.itemTitle || '';
			}
			deleteModal.show();
		}
	});
	
	document.getElementById('confirmDeleteItem').addEventListener('click', function() {
		if (itemToDelete) {
			fetch(`/admin/menus/${menuId}/items/${itemToDelete}`, {
				method: 'DELETE',
				headers: getCsrfHeaders({
					'Accept': 'application/json',
					'X-Requested-With': 'XMLHttpRequest'
				})
			})
			.then(async response => {
				// Check if response is JSON
				const contentType = response.headers.get('content-type');
				if (!contentType || !contentType.includes('application/json')) {
					if (response.status === 403) {
						showToast({ message: 'Access denied. You do not have permission to delete menu items.', type: 'error' });
						return { success: false, errors: ['Access denied'] };
					}
					showToast({ message: 'Server error. Please try again.', type: 'error' });
					return { success: false, errors: ['Server error'] };
				}
				return response.json();
			})
			.then(data => {
				if (!data) return;
				
				if (data.success) {
					// Show success message
					showToast({ message: 'Menu item deleted successfully!', type: 'success' });
					
					// Reload menu items
					fetch(`/admin/menus/${menuId}/items`)
						.then(response => response.json())
						.then(data => {
							if (data.success) {
								menuItems = data.items;
								loadMenuItems();
								deleteModal.hide();
							} else {
								console.error('Error reloading menu items:', data.errors);
								// Even if reload fails, the deletion was successful
								deleteModal.hide();
								// Try to reload the page to ensure UI is in sync
								location.reload();
							}
						})
						.catch(error => {
							console.error('Error reloading menu items:', error);
							// Even if reload fails, the deletion was successful
							deleteModal.hide();
							// Try to reload the page to ensure UI is in sync
							location.reload();
						});
				} else {
					const errorMessage = (data.errors && Array.isArray(data.errors)) 
						? data.errors.join(', ') 
						: (data.error || 'Unknown error occurred');
					showToast({ message: 'Error: ' + errorMessage, type: 'error' });
				}
			})
			.catch(error => {
				console.error('Error:', error);
				showToast({ message: 'Failed to delete menu item', type: 'error' });
			});
		}
	});
	
	// Handle drag and drop
	function handleItemMove(evt) {
		const itemId = evt.item.dataset.itemId;
		const newIndex = evt.newIndex;
		
		// Determine the parent based on the container
		// If the container has class 'menu-item-children', find its parent menu-item
		// Otherwise, it's a top-level item (parent is the menuId)
		let newParentId = null;
		const targetContainer = evt.to;
		
		if (targetContainer.classList.contains('menu-item-children')) {
			// Find the parent menu-item element
			const parentMenuItem = targetContainer.closest('.menu-item');
			if (parentMenuItem) {
				newParentId = parentMenuItem.dataset.itemId;
			}
		}
		// If targetContainer is the main menuItemsList, parent is the menuId (which will be null in the database)
		// Top-level items have parent_id = menuId (but we pass null since the database stores menu items with parent_id pointing to menu)
		
		fetch(`/admin/menus/${menuId}/items/${itemId}/move`, {
			method: 'POST',
			headers: getCsrfHeaders({
				'Content-Type': 'application/json',
				'Accept': 'application/json',
				'X-Requested-With': 'XMLHttpRequest'
			}),
			body: JSON.stringify({
				newSort: newIndex + 1,
				newParentId: newParentId
			})
		})
		.then(async response => {
			// Check if response is JSON
			const contentType = response.headers.get('content-type');
			if (!contentType || !contentType.includes('application/json')) {
				if (response.status === 403) {
					showToast({ message: 'Access denied. You do not have permission to move menu items.', type: 'error' });
					return { success: false, errors: ['Access denied'] };
				}
				showToast({ message: 'Server error. Please try again.', type: 'error' });
				return { success: false, errors: ['Server error'] };
			}
			return response.json();
		})
		.then(data => {
			if (!data) return;
			
			if (data.success) {
				// Reload menu items
				fetch(`/admin/menus/${menuId}/items`)
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							menuItems = data.items;
							loadMenuItems();
						} else {
							console.error('Error reloading menu items:', data.errors);
							// Even if reload fails, the move was successful
							// Try to reload the page to ensure UI is in sync
							location.reload();
						}
					})
					.catch(error => {
						console.error('Error reloading menu items:', error);
						// Even if reload fails, the move was successful
						// Try to reload the page to ensure UI is in sync
						location.reload();
					});
			} else {
				const errorMessage = (data.errors && Array.isArray(data.errors)) 
					? data.errors.join(', ') 
					: (data.error || 'Unknown error occurred');
				showToast({ message: 'Error: ' + errorMessage, type: 'error' });
			}
		})
		.catch(error => {
			console.error('Error:', error);
			showToast({ message: 'Failed to move menu item', type: 'error' });
		});
	}
	
	// Helper function to find menu item
	function findMenuItem(items, id) {
		for (const item of items) {
			if (item.id === id) return item;
			if (item.children && item.children.length > 0) {
				const found = findMenuItem(item.children, id);
				if (found) return found;
			}
		}
		return null;
	}
	
	// Expand/Collapse all
	document.getElementById('expandAll').addEventListener('click', function() {
		const childrenContainers = document.querySelectorAll('.menu-item-children');
		childrenContainers.forEach(container => {
			container.style.display = 'block';
		});
		showToast({ message: 'All menu items expanded', type: 'success' });
	});
	
	document.getElementById('collapseAll').addEventListener('click', function() {
		const childrenContainers = document.querySelectorAll('.menu-item-children');
		childrenContainers.forEach(container => {
			container.style.display = 'none';
		});
		showToast({ message: 'All menu items collapsed', type: 'success' });
	});
	
	// Initial load
	loadMenuItems();
	
	// Reset form when modal is hidden
	editModal._element.addEventListener('hidden.bs.modal', function() {
		// Reset uploaded file path and current item link
		window.editUploadedFilePath = null;
		window.currentEditItemLink = null;
		
		// Reset autocomplete fields
		document.getElementById('editItemPageAutocomplete').value = '';
		document.getElementById('editItemPageKey').value = '';
		document.getElementById('editItemPageDropdown').style.display = 'none';
		
		// Restore file input for next use
		const editFileUploadDiv = document.getElementById('editFileUploadDiv');
		if (editFileUploadDiv) {
			const fileInputContainer = editFileUploadDiv.querySelector('.input-group');
			if (fileInputContainer) {
				fileInputContainer.innerHTML = `
					<input type="file" class="form-control" id="editItemFileUpload" accept="*/*">
					<button type="button" class="btn btn-outline-secondary" id="editUploadFileBtn">
						<i class="fa fa-upload"></i> Upload
					</button>
				`;
			}
		}
	});
	
	addMenuItemModal._element.addEventListener('hidden.bs.modal', function() {
		// Reset uploaded file path
		window.uploadedFilePath = null;
		
		// Reset form
		document.getElementById('addMenuItemForm').reset();
		document.getElementById('itemSort').value = '1';
		document.getElementById('parentItem').value = '';
		document.getElementById('itemPageAutocomplete').value = '';
		document.getElementById('itemPageKey').value = '';
		document.getElementById('itemPageDropdown').style.display = 'none';
		
		// Ensure Active checkbox is checked by default
		setTimeout(() => {
			document.getElementById('itemActive').checked = true;
		}, 0);
		
		// Hide all type-specific divs
		document.getElementById('pageSelectionDiv').style.display = 'none';
		document.getElementById('fileUploadDiv').style.display = 'none';
		document.getElementById('externalLinkDiv').style.display = 'none';
	});
	
	fileUploadModal._element.addEventListener('hidden.bs.modal', function() {
		// Reset uploaded file path
		window.uploadedFilePath = null;
	});
});
</script>
