	// Handle file upload - upload immediately when file is selected
	document.getElementById('itemFileUpload').addEventListener('change', function(e) {
		const fileInput = this;
		const file = fileInput.files && fileInput.files[0];
		
		if (!file) {
			return;
		}
		
		// Show upload status
		const uploadStatus = document.getElementById('fileUploadStatus');
		const uploadStatusText = document.getElementById('fileUploadStatusText');
		const uploadSuccess = document.getElementById('fileUploadSuccess');
		const uploadSuccessText = document.getElementById('fileUploadSuccessText');
		
		if (uploadStatus) uploadStatus.style.display = 'block';
		if (uploadStatusText) uploadStatusText.textContent = 'Uploading ' + file.name + '...';
		if (uploadSuccess) uploadSuccess.style.display = 'none';
		
		const formData = new FormData();
		formData.append('file', file);
		
		fetch('/admin/upload-file', {
			method: 'POST',
			headers: getCsrfHeaders({
				'X-Requested-With': 'XMLHttpRequest'
			}),
			body: formData
		})
		.then(async response => {
			// Check if response is JSON
			const contentType = response.headers.get('content-type');
			if (!contentType || !contentType.includes('application/json')) {
				if (response.status === 403) {
					showToast({ message: 'Access denied. You do not have permission to upload files.', type: 'error' });
					return { success: false, error: 'Access denied' };
				}
				const text = await response.text();
				console.error('Non-JSON response:', text);
				showToast({ message: 'Server error. Please try again.', type: 'error' });
				return { success: false, error: 'Server error' };
			}
			return response.json();
		})
		.then(data => {
			if (!data) return;
			
			if (data.success) {
				// Set the file path
				window.uploadedFilePath = data.filePath;
				
				// Set the title to the original filename
				const itemTitleInput = document.getElementById('itemTitle');
				if (itemTitleInput && !itemTitleInput.value.trim()) {
					itemTitleInput.value = data.originalName || file.name;
				}
				
				// Hide upload status, show success
				if (uploadStatus) uploadStatus.style.display = 'none';
				if (uploadSuccess) uploadSuccess.style.display = 'block';
				if (uploadSuccessText) uploadSuccessText.textContent = 'File uploaded: ' + (data.originalName || file.name);
				
				showToast({ message: 'File uploaded successfully!', type: 'success' });
			} else {
				const errorMessage = data.error || 'Unknown error occurred';
				if (uploadStatus) uploadStatus.style.display = 'none';
				showToast({ message: 'Error: ' + errorMessage, type: 'error' });
				fileInput.value = ''; // Clear the file input
			}
		})
		.catch(error => {
			console.error('Error uploading file:', error);
			if (uploadStatus) uploadStatus.style.display = 'none';
			showToast({ message: 'Failed to upload file: ' + error.message, type: 'error' });
			fileInput.value = ''; // Clear the file input
		});
	});
	
