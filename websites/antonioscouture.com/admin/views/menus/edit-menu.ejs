<script>
document.addEventListener('DOMContentLoaded', function() {
	const menuId = '<%= menu.id %>';
	let menuItems = <%- JSON.stringify(menu.items) %>;
	const allMenus = <%- JSON.stringify(typeof allMenus !== 'undefined' ? allMenus : [menu]) %>;
	const currentMenuLabel = <%- JSON.stringify(menu.name) %>;
	let itemToDelete = null;
	
	// Autocomplete debounce timeout
	let autocompleteTimeout = null;
	const autocompleteDelay = 300; // milliseconds
	
	// Initialize modals
	const editModal = new bootstrap.Modal(document.getElementById('editMenuItemModal'));
	const deleteModal = new bootstrap.Modal(document.getElementById('deleteItemModal'));
	const fileUploadModalElement = document.getElementById('fileUploadModal');
	if (!fileUploadModalElement) {
		console.error('File upload modal element not found!');
	}
	const fileUploadModal = new bootstrap.Modal(fileUploadModalElement);
	const addMenuItemModal = new bootstrap.Modal(document.getElementById('addMenuItemModal'));
	
	// Initialize Sortable.js for drag and drop
	let sortableInstance = null;
	let childSortableInstances = [];
	
	// Autocomplete functionality
	function initAutocomplete(inputId, hiddenInputId, dropdownId, spinnerId, titleInputId) {
		const input = document.getElementById(inputId);
		const hiddenInput = document.getElementById(hiddenInputId);
		const dropdown = document.getElementById(dropdownId);
		const spinner = document.getElementById(spinnerId);
		const titleInput = titleInputId ? document.getElementById(titleInputId) : null;
		let selectedPage = null;
		
		if (!input || !hiddenInput || !dropdown) return;
		
		// Search pages function
		function searchPages(query) {
			if (!query || query.trim().length < 2) {
				dropdown.style.display = 'none';
				return;
			}
			
			spinner.style.display = 'block';
			
			fetch(`/admin/api/pages?search=${encodeURIComponent(query)}`)
				.then(response => response.json())
				.then(data => {
					spinner.style.display = 'none';
					if (data.success && data.pages && data.pages.length > 0) {
						dropdown.innerHTML = '';
						data.pages.forEach(page => {
							const item = document.createElement('div');
							item.className = 'autocomplete-item';
							item.textContent = page.title;
							item.dataset.key = page.key;
							item.dataset.title = page.title;
							item.addEventListener('click', function() {
								input.value = page.title;
								hiddenInput.value = page.key;
								selectedPage = page;
								dropdown.style.display = 'none';
								if (titleInput) {
									titleInput.value = page.title;
								}
							});
							dropdown.appendChild(item);
						});
						dropdown.style.display = 'block';
					} else {
						dropdown.innerHTML = '<div class="autocomplete-item autocomplete-no-results">No pages found</div>';
						dropdown.style.display = 'block';
					}
				})
				.catch(error => {
					console.error('Error searching pages:', error);
					spinner.style.display = 'none';
					dropdown.style.display = 'none';
				});
		}
		
		// Debounced search
		input.addEventListener('input', function() {
			clearTimeout(autocompleteTimeout);
			const query = this.value.trim();
			
			if (query.length === 0) {
				hiddenInput.value = '';
				selectedPage = null;
				dropdown.style.display = 'none';
				return;
			}
			
			autocompleteTimeout = setTimeout(() => {
				searchPages(query);
			}, autocompleteDelay);
		});
		
		// Hide dropdown when clicking outside
		document.addEventListener('click', function(e) {
			if (!input.contains(e.target) && !dropdown.contains(e.target)) {
				dropdown.style.display = 'none';
			}
		});
		
		// Handle keyboard navigation
		input.addEventListener('keydown', function(e) {
			const items = dropdown.querySelectorAll('.autocomplete-item:not(.autocomplete-no-results)');
			if (items.length === 0) return;
			
			const currentIndex = Array.from(items).findIndex(item => item.classList.contains('active'));
			
			if (e.key === 'ArrowDown') {
				e.preventDefault();
				items.forEach(item => item.classList.remove('active'));
				const nextIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
				items[nextIndex].classList.add('active');
				items[nextIndex].scrollIntoView({ block: 'nearest' });
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				items.forEach(item => item.classList.remove('active'));
				const prevIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
				items[prevIndex].classList.add('active');
				items[prevIndex].scrollIntoView({ block: 'nearest' });
			} else if (e.key === 'Enter') {
				e.preventDefault();
				const activeItem = dropdown.querySelector('.autocomplete-item.active');
				if (activeItem) {
					activeItem.click();
				}
			} else if (e.key === 'Escape') {
				dropdown.style.display = 'none';
			}
		});
		
		// Return function to get selected value
		return function() {
			return hiddenInput.value || null;
		};
	}
	
	// Initialize autocomplete for add and edit modals
	let getItemPageValue = null;
	let getEditItemPageValue = null;
	
	// Load menu items
	function loadMenuItems() {
		const container = document.getElementById('menuItemsList');
		const noItemsMessage = document.getElementById('noItemsMessage');
		
		if (menuItems.length === 0) {
			container.style.display = 'none';
			noItemsMessage.style.display = 'block';
			return;
		}
		
		container.style.display = 'block';
		noItemsMessage.style.display = 'none';
		
		// Sort items by sort order
		menuItems.sort((a, b) => a.sort - b.sort);
		
		container.innerHTML = renderMenuItems(menuItems);
		
		// Initialize sortable - destroy existing instances first
		if (sortableInstance) {
			sortableInstance.destroy();
		}
		childSortableInstances.forEach(instance => {
			if (instance) instance.destroy();
		});
		childSortableInstances = [];
		
		// Initialize sortable on main container
		sortableInstance = Sortable.create(container, {
			group: 'menu-items',
			animation: 150,
			draggable: '.menu-item',
			handle: '.menu-item-handle',
			onEnd: function(evt) {
				handleItemMove(evt);
			}
		});
		
		// Initialize sortable on all child containers
		const childContainers = container.querySelectorAll('.menu-item-children');
		childContainers.forEach(childContainer => {
			const childInstance = new Sortable(childContainer, {
				group: 'menu-items',
				animation: 150,
				draggable: '.menu-item',
				handle: '.menu-item-handle',
				onEnd: function(evt) {
					handleItemMove(evt);
				}
			});
			childSortableInstances.push(childInstance);
		});
		
		// Update parent item dropdown
		updateParentItemDropdown();
	}
	
	function renderMenuItems(items, level = 0) {
		return items.map(item => `
			<div class="menu-item" data-item-id="${item.id}" data-sort="${item.sort}">
				<div class="menu-item-content">
					<div class="menu-item-handle">
						<i class="fa fa-grip-vertical text-muted"></i>
					</div>
					<div class="menu-item-info">
						<div class="menu-item-title">${item.title}</div>
						<div class="menu-item-details">
							<span class="badge bg-${getTypeBadgeColor(item.type)}">${item.type === '' ? 'Parent' : item.type}</span>
							<span class="text-muted">${item.type === '' ? 'No link' : item.link}</span>
							${item.active ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-secondary">Inactive</span>'}
						</div>
					</div>
					<div class="menu-item-actions">
						<button type="button" class="btn btn-xs btn-primary edit-item" data-item-id="${item.id}">
							<i class="fa fa-edit"></i>
						</button>
						<button type="button" class="btn btn-xs btn-success add-child" data-item-id="${item.id}">
							<i class="fa fa-plus"></i>
						</button>
						<button type="button" class="btn btn-xs btn-danger delete-item" data-item-id="${item.id}" data-item-title="${item.title}">
							<i class="fa fa-trash"></i>
						</button>
					</div>
				</div>
				${item.children && item.children.length > 0 ? `
					<div class="menu-item-children" style="margin-left: ${(level + 1) * 20}px;">
						${renderMenuItems(item.children, level + 1)}
					</div>
				` : ''}
			</div>
		`).join('');
	}
	
	function getTypeBadgeColor(type) {
		switch(type) {
			case 'page': return 'primary';
			case 'file': return 'info';
			case 'external': return 'warning';
			case '': return 'secondary';
			default: return 'secondary';
		}
	}
	
	function appendParentOptionsFromAllMenus(dropdown, excludeIds) {
		dropdown.innerHTML = '';
		const opt0 = document.createElement('option');
		opt0.value = '';
		opt0.textContent = 'No Parent (Top Level) — ' + currentMenuLabel;
		dropdown.appendChild(opt0);
		
		for (const m of allMenus) {
			const mid = String(m.id);
			if (mid !== String(menuId)) {
				if (!excludeIds.has(mid)) {
					const o = document.createElement('option');
					o.value = mid;
					o.textContent = 'Top level — ' + m.name;
					dropdown.appendChild(o);
				}
			}
			function walk(items, depth) {
				(items || []).forEach(item => {
					if (excludeIds.has(String(item.id))) return;
					const o = document.createElement('option');
					o.value = item.id;
					o.textContent = m.name + ': ' + '\u2014'.repeat(depth) + ' ' + item.title;
					dropdown.appendChild(o);
					if (item.children && item.children.length) walk(item.children, depth + 1);
				});
			}
			walk(m.items || [], 0);
		}
	}
	
	function updateParentItemDropdown() {
		appendParentOptionsFromAllMenus(document.getElementById('parentItem'), new Set());
	}
	
	function collectSubtreeIds(item) {
		const ids = [String(item.id)];
		(item.children || []).forEach(c => {
			collectSubtreeIds(c).forEach(id => ids.push(id));
		});
		return ids;
	}
	
	function findParentIdOfItem(items, childId, parentRef = null) {
		for (const item of items) {
			if (String(item.id) === String(childId)) return parentRef;
			if (item.children && item.children.length > 0) {
				const found = findParentIdOfItem(item.children, childId, item.id);
				if (found !== undefined) return found;
			}
		}
		return undefined;
	}
	
	function updateEditParentItemDropdown(editingItemId) {
		const editingItem = findMenuItem(menuItems, editingItemId);
		const exclude = new Set(editingItem ? collectSubtreeIds(editingItem) : [String(editingItemId)]);
		appendParentOptionsFromAllMenus(document.getElementById('editParentItem'), exclude);
	}
	
