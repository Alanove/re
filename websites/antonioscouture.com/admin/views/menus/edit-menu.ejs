<!-- BEGIN content area -->
<div class="menu-editing">
	<div class="row">
		<div class="col-xl-12">
			<!-- BEGIN panel -->
			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('menus.editMenu') : 'Edit Menu' %>: <%= menu.name %></h4>
					<div class="panel-heading-btn">
						<a href="/admin/menus" class="btn btn-xs btn-secondary">
							<i class="fa fa-arrow-left"></i> <%= typeof t !== 'undefined' ? t('menus.backToMenus') : 'Back to Menus' %>
						</a>
					</div>
				</div>
				<div class="panel-body">
				<div class="row">
					<div class="col-md-4">
						<!-- Menu Details -->
						<div class="card">
							<div class="card-header">
								<h5 class="card-title mb-0">
									<i class="fa fa-bars me-2"></i><%= typeof t !== 'undefined' ? t('menus.menuInformation') : 'Menu Information' %>
								</h5>
							</div>
							<div class="card-body">
								<form method="POST" action="/admin/menus/<%= menu.id %>/edit">
									<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
									<div class="mb-3">
										<label for="name" class="form-label"><%= typeof t !== 'undefined' ? t('menus.menuName') : 'Menu Name' %> <span class="text-danger">*</span></label>
										<input type="text" class="form-control" id="name" name="name" value="<%= menu.name %>" required>
									</div>
									
								<div class="mb-3">
									<label for="description" class="form-label"><%= typeof t !== 'undefined' ? t('menus.description') : 'Description' %></label>
									<textarea class="form-control" id="description" name="description" rows="3"><%= menu.description %></textarea>
								</div>
									
									<div class="d-grid">
										<button type="submit" class="btn btn-primary">
											<i class="fa fa-save me-1"></i> <%= typeof t !== 'undefined' ? t('menus.updateMenu') : 'Update Menu' %>
										</button>
									</div>
								</form>
							</div>
						</div>
						
						<!-- Add Menu Item Button -->
						<div class="card mt-3">
							<div class="card-body">
								<div class="d-grid">
									<button type="button" class="btn btn-success" id="addMenuItemBtn">
										<i class="fa fa-plus me-1"></i> <%= typeof t !== 'undefined' ? t('menus.addMenuItem') : 'Add Menu Item' %>
									</button>
								</div>
							</div>
						</div>
					</div>
					
					<div class="col-md-8">
						<!-- Menu Items -->
						<div class="card">
							<div class="card-header">
								<h5 class="card-title mb-0">
									<i class="fa fa-list me-2"></i><%= typeof t !== 'undefined' ? t('menus.menuItems') : 'Menu Items' %>
								</h5>
								<div class="card-header-btn">
									<button type="button" class="btn btn-xs btn-outline-secondary" id="expandAll">
										<i class="fa fa-expand"></i> <%= typeof t !== 'undefined' ? t('menus.expandAll') : 'Expand All' %>
									</button>
									<button type="button" class="btn btn-xs btn-outline-secondary" id="collapseAll">
										<i class="fa fa-compress"></i> <%= typeof t !== 'undefined' ? t('menus.collapseAll') : 'Collapse All' %>
									</button>
								</div>
							</div>
							<div class="card-body">
								<div id="menuItemsContainer">
									<div class="text-center text-muted py-4" id="noItemsMessage">
										<i class="fa fa-list fa-3x mb-3"></i>
										<h6><%= typeof t !== 'undefined' ? t('menus.noMenuItems') : 'No menu items' %></h6>
										<p><%= typeof t !== 'undefined' ? t('menus.addFirstMenuItem') : 'Add your first menu item to get started.' %></p>
									</div>
									<div id="menuItemsList" style="display: none;"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
</div>
<!-- END content area -->

<!-- Edit Menu Item Modal -->
<div class="modal fade" id="editMenuItemModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title"><%= typeof t !== 'undefined' ? t('menus.editMenuItem') : 'Edit Menu Item' %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<form id="editMenuItemForm">
					<input type="hidden" id="editItemId">
					<div class="mb-3">
						<label for="editItemTitle" class="form-label"><%= typeof t !== 'undefined' ? t('menus.itemTitle') : 'Title' %> <span class="text-danger">*</span></label>
						<input type="text" class="form-control" id="editItemTitle" required>
					</div>
					
					<div class="mb-3">
						<label for="editParentItem" class="form-label"><%= typeof t !== 'undefined' ? t('menus.parentItem') : 'Parent Item' %></label>
						<select class="form-select" id="editParentItem">
							<option value=""><%= typeof t !== 'undefined' ? t('menus.noParent') : 'No Parent (Top Level)' %></option>
						</select>
						<div class="form-text"><%= typeof t !== 'undefined' ? t('menus.changeParentHint') : 'Move this item under another parent or to the top level.' %></div>
					</div>
					
					<div class="mb-3">
						<label for="editItemType" class="form-label"><%= typeof t !== 'undefined' ? t('menus.itemType') : 'Type' %></label>
						<select class="form-select" id="editItemType">
							<option value=""><%= typeof t !== 'undefined' ? t('menus.parentMenuItem') : 'Parent Menu Item (No Link)' %></option>
							<option value="page"><%= typeof t !== 'undefined' ? t('menus.page') : 'Page' %></option>
							<option value="file"><%= typeof t !== 'undefined' ? t('menus.file') : 'File' %></option>
							<option value="external"><%= typeof t !== 'undefined' ? t('menus.externalLink') : 'External Link' %></option>
