		// Validate title
		if (!title) {
			showToast({ message: 'Please enter a title for the menu item', type: 'error' });
			return;
		}
		
		let link = '';
		
		// Get link based on type and validate
		switch(type) {
			case '':
				// Parent menu item - no link needed
				link = '';
				break;
			case 'page':
				link = document.getElementById('itemPageKey').value || '';
				if (!link) {
					showToast({ message: 'Please select a page', type: 'error' });
					return;
				}
				break;
			case 'file':
				link = window.uploadedFilePath || '';
				if (!link) {
					showToast({ message: 'Please upload a file first', type: 'error' });
					return;
				}
				break;
			case 'external':
				link = document.getElementById('itemLink').value.trim();
				if (!link) {
					showToast({ message: 'Please enter an external URL', type: 'error' });
					return;
				}
				break;
		}
		
		const activeStatus = document.getElementById('itemActive').checked;
		
		const formData = {
			title: title,
			type: type,
			link: link,
			sort: parseInt(document.getElementById('itemSort').value),
			active: activeStatus,
			parentId: document.getElementById('parentItem').value || null
		};
		
		fetch(`/admin/menus/${menuId}/items`, {
			method: 'POST',
			headers: getCsrfHeaders({
				'Content-Type': 'application/json',
				'Accept': 'application/json',
				'X-Requested-With': 'XMLHttpRequest'
			}),
			body: JSON.stringify(formData)
		})
		.then(async response => {
			// Check if response is JSON
			const contentType = response.headers.get('content-type');
			if (!contentType || !contentType.includes('application/json')) {
				if (response.status === 403) {
					showToast({ message: 'Access denied. You do not have permission to add menu items.', type: 'error' });
					return { success: false, errors: ['Access denied'] };
				}
				showToast({ message: 'Server error. Please try again.', type: 'error' });
				return { success: false, errors: ['Server error'] };
			}
			return response.json();
		})
		.then(data => {
			if (!data) return;
			
			if (data.success) {
				// Show success message
				showToast({ message: 'Menu item added successfully!', type: 'success' });
				
				// Reload menu items
				fetch(`/admin/menus/${menuId}/items`)
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							menuItems = data.items;
							loadMenuItems();
							addMenuItemModal.hide();
						} else {
							console.error('Error reloading menu items:', data.errors);
							// Even if reload fails, the add was successful
							addMenuItemModal.hide();
							// Try to reload the page to ensure UI is in sync
							location.reload();
						}
					})
					.catch(error => {
						console.error('Error reloading menu items:', error);
						// Even if reload fails, the add was successful
						addMenuItemModal.hide();
						// Try to reload the page to ensure UI is in sync
						location.reload();
					});
			} else {
				const errorMessage = (data.errors && Array.isArray(data.errors)) 
					? data.errors.join(', ') 
					: (data.error || 'Unknown error occurred');
				showToast({ message: 'Error: ' + errorMessage, type: 'error' });
			}
		})
		.catch(error => {
			console.error('Error:', error);
			showToast({ message: 'Failed to add menu item', type: 'error' });
		});
	});
	
