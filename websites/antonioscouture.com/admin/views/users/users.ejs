<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('users.title') : 'Users Management' %></h4>
				<div class="panel-heading-btn">
					<a href="/admin/users/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> <%= typeof t !== 'undefined' ? t('users.addNewUser') : 'Add New User' %>
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong><%= typeof t !== 'undefined' ? t('messages.success') : 'Success!' %></strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<!-- BEGIN filters -->
				<div class="row mb-3">
					<div class="col-md-6">
						<div class="input-group">
							<span class="input-group-text">
								<i class="fa fa-search"></i>
							</span>
							<input type="text" class="form-control" id="keywordFilter" placeholder="<%= typeof t !== 'undefined' ? t('users.searchPlaceholder') : 'Search by username, email, or phone...' %>" />
						</div>
					</div>
					<div class="col-md-3">
						<select class="form-select" id="statusFilter">
							<option value="">All <%= typeof t !== 'undefined' ? t('common.status') : 'Status' %></option>
							<option value="active"><%= typeof t !== 'undefined' ? t('common.active') : 'Active' %></option>
							<option value="inactive"><%= typeof t !== 'undefined' ? t('common.inactive') : 'Inactive' %></option>
						</select>
					</div>
					<div class="col-md-3">
						<button type="button" class="btn btn-secondary" id="clearFilters">
							<i class="fa fa-times me-1"></i> <%= typeof t !== 'undefined' ? t('common.clearFilters') : 'Clear Filters' %>
						</button>
					</div>
				</div>
				<!-- END filters -->
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th class="sortable" data-sort="username">
									<%= typeof t !== 'undefined' ? t('users.username') : 'Username' %> <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="email">
									<%= typeof t !== 'undefined' ? t('common.email') : 'Email' %> <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="phone">
									<%= typeof t !== 'undefined' ? t('common.phone') : 'Phone' %> <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="role">
									<%= typeof t !== 'undefined' ? t('common.role') : 'Role' %> <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="status">
									<%= typeof t !== 'undefined' ? t('common.status') : 'Status' %> <i class="fa fa-sort"></i>
								</th>
								<th class="sortable" data-sort="created">
									<%= typeof t !== 'undefined' ? t('common.created') : 'Created' %> <i class="fa fa-sort"></i>
								</th>
								<th width="1%"><%= typeof t !== 'undefined' ? t('common.actions') : 'Actions' %></th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof users !== 'undefined' && users && users.length > 0) { %>
								<% users.forEach(function(user) { %>
									<tr data-user-id="<%= user.id %>">
										<td>
											<div class="d-flex align-items-center">
												<div class="flex-grow-1">
													<div class="fw-bold"><%= user.name %></div>
													<% if (user.notes) { %>
														<div class="fs-12px text-gray-500-darker"><%= user.notes %></div>
													<% } %>
												</div>
											</div>
										</td>
										<td>
											<% if (user.email) { %>
												<%= user.email %>
											<% } else { %>
												<span class="text-muted fst-italic"><%= typeof t !== 'undefined' ? t('users.noEmail') : 'No email' %></span>
											<% } %>
											<% if (!user.email || !user.password) { %>
												<br><small class="text-warning"><i class="fa fa-exclamation-triangle"></i> <%= typeof t !== 'undefined' ? t('users.cannotLogin') : 'Cannot login' %></small>
											<% } %>
										</td>
										<td>
											<% if (user.phone) { %>
												<%= user.phone %>
											<% } else { %>
												<span class="text-muted fst-italic"><%= typeof t !== 'undefined' ? t('users.noPhone') : 'No phone' %></span>
											<% } %>
										</td>
										<td>
											<% 
											const roleClass = {
												'Super Admin': 'bg-purple',
												'Admin': 'bg-danger',
												'Content Manager': 'bg-info',
												'Accounting': 'bg-warning',
												'Member': 'bg-secondary'
											}[user.role || 'Member'] || 'bg-secondary';
											%>
											<span class="badge <%= roleClass %>"><%= user.role || 'Member' %></span>
										</td>
										<td>
											<% 
											const statusText = typeof t !== 'undefined' ? t('common.active') : 'Active';
											const inactiveText = typeof t !== 'undefined' ? t('common.inactive') : 'Inactive';
											if (user.status === statusText) { 
											%>
												<span class="badge bg-success"><%= statusText %></span>
											<% } else { %>
												<span class="badge bg-secondary"><%= inactiveText %></span>
											<% } %>
										</td>
										<td>
											<% if (user.createdAt) { %>
												<%= new Date(user.createdAt).toLocaleDateString() %>
											<% } else { %>
												-
											<% } %>
										</td>
										<td>
											<div class="btn-group">
												<a href="/admin/users/<%= user.id %>/edit" class="btn btn-sm btn-primary">
													<i class="fa fa-edit"></i>
												</a>
												<button type="button" class="btn btn-sm btn-danger" onclick="deleteItem('/admin/users/<%= user.id %>', this)">
													<i class="fa fa-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="7" class="text-center text-muted py-4">
										<i class="fa fa-users fa-3x mb-3"></i>
										<h5><%= typeof t !== 'undefined' ? t('users.noUsersFound') : 'No Users Found' %></h5>
										<p><%= typeof t !== 'undefined' ? t('users.getStarted') : 'Get started by creating your first admin user.' %></p>
										<a href="/admin/users/create" class="btn btn-success">
											<i class="fa fa-plus"></i> <%= typeof t !== 'undefined' ? t('users.addNewUser') : 'Add New User' %>
										</a>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<!-- BEGIN delete confirmation modal -->
<div class="modal fade delete-modal" id="deleteModal" tabindex="-1">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">
					<i class="fa fa-exclamation-triangle me-2"></i>
					<%= typeof t !== 'undefined' ? t('users.confirmDeletion') : 'Confirm User Deletion' %>
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<div class="warning-icon">
					<i class="fa fa-exclamation-triangle"></i>
				</div>
				<h5><%= typeof t !== 'undefined' ? t('users.deleteUserConfirm') : 'Are you sure you want to delete this user?' %></h5>
				<p><%= typeof t !== 'undefined' ? t('users.deleteUserWarning') : 'This action cannot be undone. The user will be permanently removed from the system.' %></p>
				
				<div class="user-info">
					<div class="user-name" id="deleteUserName"></div>
					<div class="user-email" id="deleteUserEmail"></div>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-cancel" data-bs-dismiss="modal">
					<i class="fa fa-times me-1"></i> <%= typeof t !== 'undefined' ? t('common.cancel') : 'Cancel' %>
				</button>
				<form id="deleteForm" method="POST" style="display: inline;">
					<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
					<button type="submit" class="btn btn-delete" id="deleteConfirmBtn">
						<i class="fa fa-trash me-1"></i> <%= typeof t !== 'undefined' ? t('users.deleteUser') : 'Delete User' %>
					</button>
				</form>
			</div>
		</div>
	</div>
</div>
<!-- END delete confirmation modal -->

<!-- BEGIN page-js -->
<script>
	// Sorting functionality
	document.addEventListener('DOMContentLoaded', function() {
		const sortableHeaders = document.querySelectorAll('.sortable');
		let currentSort = { column: null, direction: 'asc' };
		
		sortableHeaders.forEach(header => {
			header.addEventListener('click', function() {
				const column = this.dataset.sort;
				const table = this.closest('table');
				const tbody = table.querySelector('tbody');
				const rows = Array.from(tbody.querySelectorAll('tr'));
				
				// Remove existing sort indicators
				sortableHeaders.forEach(h => {
					h.classList.remove('sort-asc', 'sort-desc');
					h.querySelector('i').className = 'fa fa-sort';
				});
				
				// Determine sort direction
				if (currentSort.column === column && currentSort.direction === 'asc') {
					currentSort.direction = 'desc';
					this.classList.add('sort-desc');
					this.querySelector('i').className = 'fa fa-sort-desc';
				} else {
					currentSort.direction = 'asc';
					this.classList.add('sort-asc');
					this.querySelector('i').className = 'fa fa-sort-asc';
				}
				
				currentSort.column = column;
				
				// Sort rows
				rows.sort((a, b) => {
					let aValue = a.querySelector(`td:nth-child(${getColumnIndex(column)})`).textContent.trim();
					let bValue = b.querySelector(`td:nth-child(${getColumnIndex(column)})`).textContent.trim();
					
					// Handle special cases
					if (column === 'username') {
						aValue = a.querySelector('.fw-bold').textContent.trim();
						bValue = b.querySelector('.fw-bold').textContent.trim();
					} else if (column === 'status') {
						const activeText = '<%= typeof t !== 'undefined' ? t('common.active') : 'Active' %>';
						aValue = aValue === activeText ? '1' : '0';
						bValue = bValue === activeText ? '1' : '0';
					} else if (column === 'created') {
						aValue = aValue === '-' ? '0' : new Date(aValue).getTime();
						bValue = bValue === '-' ? '0' : new Date(bValue).getTime();
					}
					
					if (currentSort.direction === 'asc') {
						return aValue.localeCompare(bValue);
					} else {
						return bValue.localeCompare(aValue);
					}
				});
				
				// Re-append sorted rows
				rows.forEach(row => tbody.appendChild(row));
			});
		});
		
		function getColumnIndex(column) {
			const columnMap = {
				'username': 1,
				'email': 2,
				'phone': 3,
				'role': 4,
				'status': 5,
				'created': 6
			};
			return columnMap[column] || 1;
		}
	});
	
	// Delete confirmation
	function confirmDelete(userId, userName, userEmail) {
		document.getElementById('deleteUserName').textContent = userName;
		document.getElementById('deleteUserEmail').textContent = userEmail;
		document.getElementById('deleteForm').action = `/admin/users/${userId}`;
		
		const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
		deleteModal.show();
	}
	
	// Auto-hide alerts after 5 seconds
	document.addEventListener('DOMContentLoaded', function() {
		const alerts = document.querySelectorAll('.alert');
		alerts.forEach(alert => {
			setTimeout(() => {
				const bsAlert = new bootstrap.Alert(alert);
				bsAlert.close();
			}, 5000);
		});
	});
	
	// Filtering functionality
	document.addEventListener('DOMContentLoaded', function() {
		const keywordFilter = document.getElementById('keywordFilter');
		const statusFilter = document.getElementById('statusFilter');
		const clearFiltersBtn = document.getElementById('clearFilters');
		const table = document.querySelector('table');
		const tbody = table.querySelector('tbody');
		const rows = Array.from(tbody.querySelectorAll('tr'));
		
		// Function to apply filters
		function applyFilters() {
			const keyword = keywordFilter.value.toLowerCase().trim();
			const status = statusFilter.value.toLowerCase();
			
			rows.forEach(row => {
				if (row.querySelector('td[colspan]')) return; // Skip "no users found" row
				
				const username = row.querySelector('.fw-bold')?.textContent.toLowerCase() || '';
				const email = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
				const phone = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
				const statusCell = row.querySelector('td:nth-child(5)')?.textContent.trim().toLowerCase() || '';
				
				const matchesKeyword = !keyword || 
					username.includes(keyword) || 
					email.includes(keyword) ||
					phone.includes(keyword);
				
				const matchesStatus = !status || statusCell === status;
				
				if (matchesKeyword && matchesStatus) {
					row.style.display = '';
				} else {
					row.style.display = 'none';
				}
			});
			
			// Show/hide "no users found" message
			const visibleRows = rows.filter(row => 
				!row.querySelector('td[colspan]') && row.style.display !== 'none'
			);
			
			const noUsersRow = tbody.querySelector('tr td[colspan]');
			if (noUsersRow) {
				const noUsersTr = noUsersRow.closest('tr');
				if (visibleRows.length === 0 && (keyword || status)) {
					noUsersTr.style.display = '';
					noUsersTr.querySelector('td').innerHTML = `
						<i class="fa fa-search fa-3x mb-3"></i>
						<h5><%= typeof t !== 'undefined' ? t('users.noUsersFound') : 'No Users Found' %></h5>
						<p><%= typeof t !== 'undefined' ? t('users.noUsersMatchFilters') : 'No users match your current filters.' %></p>
						<button type="button" class="btn btn-secondary" onclick="clearAllFilters()">
							<i class="fa fa-times me-1"></i> <%= typeof t !== 'undefined' ? t('common.clearFilters') : 'Clear Filters' %>
						</button>
					`;
				} else {
					noUsersTr.style.display = 'none';
				}
			}
		}
		
		// Function to clear all filters
		function clearAllFilters() {
			keywordFilter.value = '';
			statusFilter.value = '';
			applyFilters();
		}
		
		// Event listeners
		keywordFilter.addEventListener('input', applyFilters);
		statusFilter.addEventListener('change', applyFilters);
		clearFiltersBtn.addEventListener('click', clearAllFilters);
		
		// Make clearAllFilters available globally
		window.clearAllFilters = clearAllFilters;
	});
</script>
<!-- END page-js --> 