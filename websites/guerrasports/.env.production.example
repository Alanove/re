# Production environment — copy to .env.production on the server (never commit secrets).

NODE_ENV=production

# Server
PORT=3007
APP_URL=https://guerrasports.com

# Session (use a long random secret)
SESSION_SECRET=change-me-to-a-long-random-string

# Database (production MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_WAIT_FOR_CONNECTIONS=true
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# Email
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=sales@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=sales@example.com

# Optional: bump after deploy to bust cached CSS/JS
# ASSET_VERSION=1
