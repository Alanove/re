<div class="container-fluid p-0 mb-3">
    <div id="header-carousel" class="carousel slide carousel-fade mb-30 mb-lg-0" data-interval="false">
        <ol class="carousel-indicators">
            <% if (typeof slides !=='undefined' && slides && slides.length> 0) { %>
                <% slides.forEach((slide, index)=> { %>
                    <li data-target="#header-carousel" data-slide-to="<%= index %>"
                        class="<%= index === 0 ? 'active' : '' %>"></li>
                    <% }); %>
                        <% } %>
        </ol>
        <div class="carousel-inner">
            <% if (typeof slides !=='undefined' && slides && slides.length> 0) { %>
                <% slides.forEach((slide, index)=> { %>
                    <div class="carousel-item position-relative <%= index === 0 ? 'active' : '' %>" data-slide-duration-sec="<%= (slide.durationSeconds && slide.durationSeconds > 0) ? Math.min(600, slide.durationSeconds) : 5 %>">
                        <% const posterSrc=slide.posterImage ? (slide.posterImage.startsWith('http') ||
                            slide.posterImage.startsWith('/') ? slide.posterImage : '/images/slide/' +
                            slide.posterImage) : (slide.image ? (slide.image.startsWith('http') ||
                            slide.image.startsWith('/') ? slide.image : '/images/slide/' + slide.image) : '' );
                            %>
                        <% if (slide.mediaType==='video' && slide.videoUrl) { %>
                            <% const videoSrc=slide.videoUrl.startsWith('http') || slide.videoUrl.startsWith('/') ?
                                slide.videoUrl : '/images/slide/' + slide.videoUrl; %>
                                    <%# Same as CMS: real <source> in HTML. Production loads app.min.js; defer-only injection broke if minify/deploy drifted. JS in app.js only plays + handles slide changes. %>
                                    <video class="position-absolute w-100 h-100 hero-carousel-video" style="object-fit: cover;"
                                        muted loop playsinline preload="metadata" poster="<%= posterSrc %>"
                                        <% if (index === 0) { %>fetchpriority="high"<% } %>>
                                        <source src="<%= videoSrc %>" type="video/mp4" />
                                        Your browser does not support the video tag.
                                    </video>
                                    <% } else { %>
                                        <% const imgSrc=slide.image.startsWith('http') || slide.image.startsWith('/') ?
                                            slide.image : '/images/slide/' + slide.image; %>
                                            <img class="position-absolute w-100 h-100" src="<%= imgSrc %>"
                                                style="object-fit: cover;" alt="<%= slide.alt || slide.title %>">
                                            <% } %>
                                                <div
                                                    class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                                                    <div class="p-3" style="max-width: 700px;">
                                                        <% if (slide.title) { %>
                                                            <h1
                                                                class="display-4 text-white mb-3 animate__animated animate__fadeInDown">
                                                                <%- typeof formatTrademarks !== 'undefined' ? formatTrademarks(slide.title) : slide.title %>
                                                            </h1>
                                                            <% } %>
                                                                <% if (slide.subtitle) { %>
                                                                    <p
                                                                        class="mx-md-5 px-5 animate__animated animate__bounceIn">
                                                                        <%- typeof formatTrademarks !== 'undefined' ? formatTrademarks(slide.subtitle) : slide.subtitle %>
                                                                    </p>
                                                                    <% } %>
                                                                        <% if (slide.link && slide.buttonText) { %>
                                                                            <a class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp"
                                                                                href="<%= slide.link %>">
                                                                                <%- typeof formatTrademarks !== 'undefined' ? formatTrademarks(slide.buttonText) : slide.buttonText %>
                                                                            </a>
                                                                            <% } %>
                                                    </div>
                                                </div>
                    </div>
                    <% }); %>
                        <% } else { %>
                            <div class="carousel-item position-relative active" style="height: 430px;">
                                <img class="position-absolute w-100 h-100" src="/MultiShop/img/carousel-1.jpg"
                                    style="object-fit: cover;">
                                <div
                                    class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                                    <div class="p-3" style="max-width: 700px;">
                                        <h1 class="display-4 text-white mb-3 animate__animated animate__fadeInDown">
                                            Welcome to Guerra Sports</h1>
                                        <p class="mx-md-5 px-5 animate__animated animate__bounceIn">Discover premium
                                            sports equipment and apparel</p>
                                        <a class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp"
                                            href="/shop">Shop Now</a>
                                    </div>
                                </div>
                            </div>
                            <% } %>
        </div>
    </div>
</div>
<!-- Carousel End -->

<!-- Featured Products Start -->
<%# --- Catch of the Day / featured products section (commented out) --- %>
<% if (typeof featuredProducts !=='undefined' && featuredProducts && featuredProducts.length> 0) { %>
    <div class="container-fluid pt-5 pb-3">
        <div class="section-header-row d-flex justify-content-between align-items-baseline mx-xl-5 mb-4">
            <h2 class="section-title position-relative text-uppercase mb-0"><span class="bg-secondary pr-3">New Products</span></h2>
            <a href="/products?featured=true" class="section-view-all-link text-decoration-none">View All</a>
        </div>
        <div class="swiper product-carousel px-xl-5">
            <div class="swiper-wrapper">
            <% featuredProducts.forEach(function(product) { %>
                <div class="swiper-slide">
                <div class="product-item product-item-home bg-light mb-4">
                    <div class="product-img position-relative overflow-hidden">
                        <% if (product.images && product.images.length> 0) { %>
                            <a href="/shop/product/<%= product.slug %>">
                                <img class="img-fluid w-100 product-card-img" src="<%= product.images[0].thumb_url || product.images[0].image_url %>"
                                    alt="<%= product.name %>" data-default-src="<%= product.images[0].image_url %>">
                            </a>
                            <% } else { %>
                                <a href="/shop/product/<%= product.slug %>">
                                    <img class="img-fluid w-100 product-card-img" src="<%= siteImage %>"
                                        alt="<%= product.name %>" data-default-src="<%= siteImage %>">
                                </a>
                                <% } %>
                                    <div class="product-action">
                                        <a class="btn btn-outline-dark btn-square add-to-wishlist-btn" href="#"
                                            data-product-id="<%= product.id %>"><i class="far fa-heart"></i></a>
                                        <a class="btn btn-outline-dark btn-square add-to-cart-btn" href="#"
                                            data-product-id="<%= product.id %>"
                                            data-has-variants="<%= !!product.has_variants %>"
                                            data-slug="<%= product.slug %>"><i class="fa fa-shopping-cart"></i></a>
                                    </div>
                    </div>
                    <div class="text-left py-3 px-2 product-card-body">
                        <a class="product-card-title text-decoration-none text-truncate d-block" href="/shop/product/<%= product.slug %>">
                            <%= product.name %>
                        </a>
                        <% if (product.short_description && product.short_description.trim()) { %>
                            <p class="product-card-desc text-truncate mb-1"><%= product.short_description.trim() %></p>
                        <% } %>
                        <div class="d-flex align-items-center justify-content-start mt-1 money product-card-price">
                            <%- include('partials/product-listing-price', { product, customClass: '', multi_price_display: (typeof ecommerceSettings !== 'undefined' && ecommerceSettings && ecommerceSettings.multi_price_display) ? ecommerceSettings.multi_price_display : '' }) %>
                        </div>
                        <% if (product.color_options && product.color_options.length > 0) { %>
                            <div class="product-color-swatches d-flex justify-content-start align-items-center pl-0 pr-0">
                                <% const maxSwatches = 3; const opts = product.color_options; const showOpts = opts.slice(0, maxSwatches); const rest = opts.length - maxSwatches; %>
                                <% showOpts.forEach(function(opt) { %>
                                    <button type="button" class="product-color-swatch border-0" aria-label="<%= opt.value %>"
                                        style="background-color: <%= opt.color_code || '#ddd' %>;"
                                        data-image-url="<%= opt.image_url %>"
                                        <% if (opt.value_id) { %>data-attribute-value-id="<%= opt.value_id %>"<% } %>
                                        data-option-value="<%= opt.value %>"
                                        title="<%= opt.value %>">
                                        <img src="<%= opt.swatch_image_url || opt.image_url %>" alt="" class="product-color-swatch-img" width="90" height="90">
                                    </button>
                                <% }); %>
                                <% if (rest > 0) { %><span class="product-color-more text-muted ml-1"><%= rest %>+</span><% } %>
                            </div>
                        <% } %>
                    </div>
                </div>
                </div>
                <% }); %>
            </div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
    </div>
    <% } %>

