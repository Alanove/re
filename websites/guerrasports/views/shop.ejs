<%
  var listingBaseUrl = '/shop';
  if (typeof isOnSalePage !== 'undefined' && isOnSalePage) listingBaseUrl = '/on-sale';
  else if (typeof isProductsPage !== 'undefined' && isProductsPage) listingBaseUrl = '/products';
%>
<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="/">Home</a>
                <span class="breadcrumb-item active">
                    <% if (typeof isOnSalePage !== 'undefined' && isOnSalePage && typeof listingTitle !== 'undefined' && listingTitle) { %>
                        <%= listingTitle %>
                    <% } else { %>
                        <%= typeof t !=='undefined' ? t('ecommerce.productCatalog') : 'Shop' %>
                    <% } %>
                </span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->

<!-- Shop Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <% if (typeof showCategoriesGrid !=='undefined' && showCategoriesGrid) { %>
            <!-- Categories Grid View – same section structure as index/contact -->
            <div class="col-12 shop-by-category-section">
                <div class="section-header-row d-flex justify-content-between align-items-baseline mb-4">
                    <h2 class="section-title position-relative text-uppercase mb-0">
                        <span class="bg-secondary pr-3">
                            <%= typeof t !=='undefined' ? t('ecommerce.shopByCategory') : 'Shop by Category' %>
                        </span>
                    </h2>
                </div>
                <div class="shop-categories-grid row pb-3">
                    <% if (categories && categories.length> 0) { %>
                        <% categories.forEach(function(category) { %>
                            <div class="col-6 col-md-4 col-lg-3 mb-4">
                                <a class="shop-category-card text-decoration-none d-block h-100" href="/shop/category/<%= category.slug %>">
                                    <div class="shop-category-card__img-wrap bg-light overflow-hidden">
                                        <% if (category.image_url && category.image_url.trim() !== '' ) { %>
                                            <img class="shop-category-card__img" src="<%= typeof categoryListingImageUrl !== 'undefined' ? categoryListingImageUrl(category) : (category.thumb_url || category.image_url) %>" alt="<%= category.name %>">
                                        <% } else { %>
                                            <div class="shop-category-card__placeholder d-flex align-items-center justify-content-center">
                                                <i class="fa fa-folder fa-3x text-muted"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="shop-category-card__body text-center py-3">
                                        <h6 class="shop-category-card__name text-dark mb-0 text-uppercase">
                                            <%= category.name %>
                                        </h6>
                                        <% if (category.description) { %>
                                            <small class="text-muted d-block mt-1 text-truncate" style="max-width: 100%;" title="<%= category.description %>">
                                                <%= category.description.substring(0, 50) %><%= category.description.length > 50 ? '...' : '' %>
                                            </small>
                                        <% } %>
                                    </div>
                                </a>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="col-12">
                            <div class="alert alert-info text-center">
                                <h5>
                                    <%= typeof t !=='undefined' ? t('ecommerce.noCategoriesFound') : 'No categories available' %>
                                </h5>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
            <% } else { %>
                <!-- Mobile Filter Toggle Button -->
                <div class="col-12 d-md-none mb-3">
                    <button type="button" class="btn btn-primary btn-block mobile-filter-toggle-btn" id="mobileFilterToggle">
                        <i class="fa fa-filter"></i>&nbsp;&nbsp;Filter
                        <i class="fa fa-chevron-down ml-2" id="mobileFilterIcon"></i>
                    </button>
                </div>

                <!-- Mobile Filter Content (hidden on desktop) -->
                <div class="col-12 d-md-none mobile-filter-content" id="mobileFilterContent" style="display: none;">
                        <!-- Category Filter -->
                    <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">
                            <%= typeof t !=='undefined' ? t('ecommerce.categories.title') : 'Categories' %>
                        </span></h5>
                    <div class="bg-light p-4 mb-30">
                        <ul class="list-unstyled">
                            <li><a href="<%= listingBaseUrl %>" class="text-dark <%= !currentCategory ? 'font-weight-bold' : '' %>">
                                    <%= typeof t !=='undefined' ? t('ecommerce.allCategories') : 'All Categories' %>
                                </a></li>
                            <% if (typeof filterCategories !== 'undefined' && filterCategories && filterCategories.length> 0) { %>
                                <% filterCategories.forEach(function(category) { %>
                                    <li class="mt-2">
                                        <a href="/shop/category/<%= category.slug %>"
                                            class="text-dark <%= currentCategory === category.slug ? 'font-weight-bold' : '' %>">
                                            <%= category.name %>
                                        </a>
                                        <% if (category.children && category.children.length> 0) { %>
                                            <ul class="list-unstyled ml-3 mt-1">
                                                <% category.children.forEach(function(child) { %>
                                                    <li>
                                                        <a href="/shop/category/<%= child.slug %>"
                                                            class="text-dark <%= currentCategory === child.slug ? 'font-weight-bold' : '' %>">
                                                            <%= child.name %>
                                                        </a>
                                                    </li>
                                                    <% }); %>
                                            </ul>
                                            <% } %>
                                    </li>
                                    <% }); %>
                                        <% } %>
                        </ul>
                    </div>

                    <!-- Price Filter -->
                    <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">
                            <%= typeof t !=='undefined' ? t('ecommerce.filterByPrice') : 'Filter by Price' %>
                        </span></h5>
                    <div class="bg-light">
                        <% var actionUrl = listingBaseUrl; 
                            if (typeof currentCategory !=='undefined' && currentCategory) {
                            actionUrl='/shop/category/' + currentCategory; } if (typeof currentBrand !=='undefined' &&
                            currentBrand) { if (typeof currentCategory !=='undefined' && currentCategory) {
                            actionUrl='/shop/category/' + currentCategory + '/brand/' + currentBrand; } else {
                            actionUrl='/shop/brand/' + currentBrand; } } %>
                            <form method="GET" action="<%= actionUrl %>" id="price-filter-form">
                                <% if (filters.search) { %>
                                    <input type="hidden" name="search" value="<%= filters.search %>">
                                    <% } %>
                                    <div class="price-slider-container">
                                        <div class="price-values">
                                            <span id="price-min-display-mobile">
                                                $<%= formatMoneyAmount(filters.min_price || (typeof priceRange !== 'undefined' && priceRange.min) || 0) %>
                                            </span>
                                            <span id="price-max-display-mobile">
                                                $<%= formatMoneyAmount(filters.max_price || (typeof priceRange !== 'undefined' && priceRange.max) || 1000) %>
                                            </span>
                                        </div>
                                        
                                        <input id="price-slider-mobile" type="text" class="span2" value="" 
                                               data-slider-min="<%= (typeof priceRange !== 'undefined' && priceRange.min) || 0 %>" 
                                               data-slider-max="<%= (typeof priceRange !== 'undefined' && priceRange.max) || 1000 %>" 
                                               data-slider-step="1" 
                                               data-slider-value="[<%= filters.min_price || (typeof priceRange !== 'undefined' && priceRange.min) || 0 %>,<%= filters.max_price || (typeof priceRange !== 'undefined' && priceRange.max) || 1000 %>]"/>
                                        
                                        <input type="hidden" name="min_price" id="min_price_mobile" value="<%= filters.min_price || '' %>">
                                        <input type="hidden" name="max_price" id="max_price_mobile" value="<%= filters.max_price || '' %>">
                                    </div>

                            </form>
                    </div>

                    <!-- Featured Filter -->
                    <!-- <div class="bg-light p-4 mb-30">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="featured-filter-mobile"
                                <%=filters.featured==='true' ? 'checked' : '' %> onchange="toggleFeaturedFilter()">
                            <label class="custom-control-label" for="featured-filter-mobile">
                                <%= typeof t !=='undefined' ? t('ecommerce.featuredProducts') : 'Featured Products' %>
                            </label>
                        </div>
                    </div> -->

                    <!-- Attribute Filters -->
                    <% if (typeof attributeFilters !=='undefined' && attributeFilters && attributeFilters.length> 0) {
                        %>
                        <% attributeFilters.forEach(function(attr) { %>
                            <% if (attr.values && attr.values.length> 0) { %>
                            <h5 class="section-title position-relative text-uppercase mb-3">
                                <span class="bg-secondary pr-3">
                                    <%= attr.name %>
                                </span>
                            </h5>
                            <div class="bg-light p-4 mb-30">
                                <% attr.values.forEach(function(value) { %>
                                    <div
                                        class="custom-control custom-checkbox d-flex align-items-center justify-content-between mb-3">
                                        <div class="d-flex align-items-center">
                                            <input type="checkbox" class="custom-control-input attribute-filter"
                                                id="attr-mobile-<%= attr.slug %>-<%= value.id %>"
                                                data-attr="<%= attr.slug %>" data-value="<%= value.value %>"
                                                <% 
                                                const attrFilterValue = filters[attr.slug];
                                                const isChecked = attrFilterValue && (
                                                    Array.isArray(attrFilterValue) 
                                                        ? attrFilterValue.includes(value.value)
                                                        : String(attrFilterValue).split(',').includes(value.value)
                                                );
                                                %>
                                                <%= isChecked ? 'checked' : '' %>
                                            onchange="updateAttributeFilters()">
                                            <label class="custom-control-label ml-2"
                                                for="attr-mobile-<%= attr.slug %>-<%= value.id %>">
                                                <% if (value.color_code) { %>
                                                    <span class="d-inline-block mr-2"
                                                        style="width: 20px; height: 20px; background-color: <%= value.color_code %>; border: 1px solid #ddd; border-radius: 3px;"></span>
                                                    <% } %>
                                                <%= value.value %>
                                            </label>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } %>
                        <% }); %>
                    <% } %>
                </div>
                <!-- End Mobile Filter Content -->

                <!-- Shop Sidebar Start -->
                <div class="col-lg-3 col-md-4 shop-sidebar d-none d-md-block">
                    <!-- Desktop Sidebar Content (hidden on mobile) -->
                    <div class="desktop-sidebar-content">
                        <!-- Category Filter -->
                        <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">
                                <%= typeof t !=='undefined' ? t('ecommerce.categories.title') : 'Categories' %>
                            </span></h5>
                        <div class="bg-light p-4 mb-30">
                            <ul class="list-unstyled">
                                <li><a href="<%= listingBaseUrl %>" class="text-dark <%= !currentCategory ? 'font-weight-bold' : '' %>">
                                        <%= typeof t !=='undefined' ? t('ecommerce.allCategories') : 'All Categories' %>
                                    </a></li>
<% if (typeof filterCategories !== 'undefined' && filterCategories && filterCategories.length> 0) { %>
                                    <% filterCategories.forEach(function(category) { %>
                                        <li class="mt-2">
                                            <a href="/shop/category/<%= category.slug %>"
                                                class="text-dark <%= currentCategory === category.slug ? 'font-weight-bold' : '' %>">
                                                <%= category.name %>
                                            </a>
                                            <% if (category.children && category.children.length> 0) { %>
                                                <ul class="list-unstyled ml-3 mt-1">
                                                    <% category.children.forEach(function(child) { %>
                                                        <li>
                                                            <a href="/shop/category/<%= child.slug %>"
                                                                class="text-dark <%= currentCategory === child.slug ? 'font-weight-bold' : '' %>">
                                                                <%= child.name %>
                                                            </a>
                                                        </li>
                                                        <% }); %>
                                                </ul>
                                                <% } %>
                                        </li>
                                        <% }); %>
                                            <% } %>
                            </ul>
                        </div>

                        <!-- Price Filter -->
                        <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">
                                <%= typeof t !=='undefined' ? t('ecommerce.filterByPrice') : 'Filter by Price' %>
                            </span></h5>
                        <div class="bg-light p-4 mb-30">
                            <% var actionUrlDesktop = listingBaseUrl; 
                                if (typeof currentCategory !=='undefined' && currentCategory) {
                                actionUrlDesktop='/shop/category/' + currentCategory; } if (typeof currentBrand !=='undefined' &&
                                currentBrand) { if (typeof currentCategory !=='undefined' && currentCategory) {
                                actionUrlDesktop='/shop/category/' + currentCategory + '/brand/' + currentBrand; } else {
                                actionUrlDesktop='/shop/brand/' + currentBrand; } } %>
                                <form method="GET" action="<%= actionUrlDesktop %>" id="price-filter-form-desktop">
                                    <% if (filters.search) { %>
                                        <input type="hidden" name="search" value="<%= filters.search %>">
                                        <% } %>
                                            <div class="price-slider-container">
                                                <div class="price-values">
                                                    <span id="price-min-display-desktop">
                                                        $<%= formatMoneyAmount(filters.min_price || (typeof priceRange !== 'undefined' && priceRange.min) || 0) %>
                                                    </span>
                                                    <span id="price-max-display-desktop">
                                                        $<%= formatMoneyAmount(filters.max_price || (typeof priceRange !== 'undefined' && priceRange.max) || 1000) %>
                                                    </span>
                                                </div>
                                                
                                                <input id="price-slider-desktop" type="text" class="span2" value="" 
                                                       data-slider-min="<%= (typeof priceRange !== 'undefined' && priceRange.min) || 0 %>" 
                                                       data-slider-max="<%= (typeof priceRange !== 'undefined' && priceRange.max) || 1000 %>" 
                                                       data-slider-step="1" 
                                                       data-slider-value="[<%= filters.min_price || (typeof priceRange !== 'undefined' && priceRange.min) || 0 %>,<%= filters.max_price || (typeof priceRange !== 'undefined' && priceRange.max) || 1000 %>]"/>

                                                <input type="hidden" name="min_price" id="min_price_desktop" value="<%= filters.min_price || '' %>">
                                                <input type="hidden" name="max_price" id="max_price_desktop" value="<%= filters.max_price || '' %>">
                                            </div>
                                </form>
                        </div>

                        <!-- Featured Filter -->
                        <!-- <div class="bg-light p-4 mb-30">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="featured-filter-desktop"
                                    <%=filters.featured==='true' ? 'checked' : '' %> onchange="toggleFeaturedFilter()">
                                <label class="custom-control-label" for="featured-filter-desktop">
                                    <%= typeof t !=='undefined' ? t('ecommerce.featuredProducts') : 'Featured Products' %>
                                </label>
                            </div>
                        </div> -->

                        <!-- Attribute Filters -->
                        <% if (typeof attributeFilters !=='undefined' && attributeFilters && attributeFilters.length> 0) {
                            %>
                            <% attributeFilters.forEach(function(attr) { %>
                                <% if (attr.values && attr.values.length> 0) { %>
                                <h5 class="section-title position-relative text-uppercase mb-3">
                                    <span class="bg-secondary pr-3">
                                        <%= attr.name %>
                                    </span>
                                </h5>
                                <div class="bg-light p-4 mb-30">
                                    <% attr.values.forEach(function(value) { %>
                                        <div
                                            class="custom-control custom-checkbox d-flex align-items-center justify-content-between mb-3">
                                            <div class="d-flex align-items-center">
                                                <input type="checkbox" class="custom-control-input attribute-filter"
                                                    id="attr-desktop-<%= attr.slug %>-<%= value.id %>"
                                                    data-attr="<%= attr.slug %>" data-value="<%= value.value %>"
                                                    <% 
                                                    const attrFilterValueDesktop = filters[attr.slug];
                                                    const isCheckedDesktop = attrFilterValueDesktop && (
                                                        Array.isArray(attrFilterValueDesktop) 
                                                            ? attrFilterValueDesktop.includes(value.value)
                                                            : String(attrFilterValueDesktop).split(',').includes(value.value)
                                                    );
                                                    %>
                                                    <%= isCheckedDesktop ? 'checked' : '' %>
                                                onchange="updateAttributeFilters()">
                                                <label class="custom-control-label ml-2"
                                                    for="attr-desktop-<%= attr.slug %>-<%= value.id %>">
                                                    <% if (value.color_code) { %>
                                                        <span class="d-inline-block mr-2"
                                                            style="width: 20px; height: 20px; background-color: <%= value.color_code %>; border: 1px solid #ddd; border-radius: 3px;"></span>
                                                        <% } %>
                                                    <%= value.value %>
                                                </label>
                                            </div>
                                        </div>
                                        <% }); %>
                                </div>
                                <% } %>
                            <% }); %>
                        <% } %>
                    </div>
                    <!-- End Desktop Sidebar Content -->
                </div>
                <!-- Shop Sidebar End -->

                <!-- Shop Product Start -->
                <div class="col-lg-9 col-md-8">
                    <!-- Search Bar -->
                    <div class="row pb-3">
                        <div class="col-12 pb-1">
                            <% var searchActionUrl = listingBaseUrl; if (typeof currentCategory !== 'undefined' && currentCategory) { searchActionUrl = '/shop/category/' + currentCategory; } if (typeof currentBrand !== 'undefined' && currentBrand) { searchActionUrl = (typeof currentCategory !== 'undefined' && currentCategory) ? '/shop/category/' + currentCategory + '/brand/' + currentBrand : '/shop/brand/' + currentBrand; } %>
                            <form method="GET" action="<%= searchActionUrl %>" class="mb-3">
                                <% if (filters.category) { %>
                                    <input type="hidden" name="category" value="<%= filters.category %>">
                                    <% } %>
                                        <div class="input-group">
                                            <input type="text" class="form-control" name="search"
                                                placeholder="<%= typeof t !== 'undefined' ? t('ecommerce.searchProducts') : 'Search products...' %>"
                                                value="<%= filters.search || '' %>">
                                            <div class="input-group-append">
                                                <button class="btn btn-primary" type="submit"><i
                                                        class="fa fa-search"></i></button>
                                            </div>
                                        </div>
                            </form>
                        </div>
                    </div>

                    <% var currentCategorySubcategories = [];
                       var sameLevelCategories = [];
                       if (typeof currentCategory !== 'undefined' && currentCategory && typeof filterCategories !== 'undefined' && filterCategories && filterCategories.length > 0) {
                         for (var ci = 0; ci < filterCategories.length; ci++) {
                           var cat = filterCategories[ci];
                           if (cat.slug === currentCategory) {
                             if (cat.children && cat.children.length > 0) currentCategorySubcategories = cat.children;
                             sameLevelCategories = filterCategories.slice();
                             break;
                           }
                           if (cat.children) {
                             for (var cj = 0; cj < cat.children.length; cj++) {
                               if (cat.children[cj].slug === currentCategory) {
                                 if (cat.children[cj].children && cat.children[cj].children.length > 0) currentCategorySubcategories = cat.children[cj].children;
                                 sameLevelCategories = cat.children.slice();
                                 break;
                               }
                             }
                             if (sameLevelCategories.length > 0 || currentCategorySubcategories.length > 0) break;
                           }
                         }
                       }
                       var mobileCategoryLinks = sameLevelCategories.concat(currentCategorySubcategories);
                    %>
                    <% if (mobileCategoryLinks && mobileCategoryLinks.length > 0) { %>
                    <div class="row">
                        <div class="col-12 d-md-none mb-3">
                            <div class="d-flex flex-wrap align-items-center">
                                <% mobileCategoryLinks.forEach(function(item) { %>
                                    <a href="/shop/category/<%= item.slug %>" class="mr-3 mb-2 mobile-category-link<%= item.slug === currentCategory ? ' mobile-category-link--selected' : ' text-dark' %>"><%= item.name %></a>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                    <% } %>

                    <div class="row pb-3">
                        <div class="col-12 pb-1">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div>
                                    <span class="text-muted">
                                        <%= typeof t !=='undefined' ? t('ecommerce.showing') : 'Showing' %>
                                            <%= ((pagination.page - 1) * pagination.limit) + 1 %> -
                                                <%= Math.min(pagination.page * pagination.limit, pagination.total) %>
                                                    <%= typeof t !=='undefined' ? t('ecommerce.of') : 'of' %>
                                                        <%= pagination.total %>
                                                            <%= typeof t !=='undefined' ? t('ecommerce.productsLabel')
                                                                : 'products' %>
                                    </span>
                                </div>
                                <div class="ml-2">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-light dropdown-toggle"
                                            data-toggle="dropdown">
                                            <%= typeof t !=='undefined' ? t('ecommerce.sortBy') : 'Sorting' %>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-right">
                                            <% var sortBaseUrl = listingBaseUrl; if (typeof currentCategory !== 'undefined' && currentCategory) { sortBaseUrl = '/shop/category/' + currentCategory; } if (typeof currentBrand !== 'undefined' && currentBrand) { sortBaseUrl = (typeof currentCategory !== 'undefined' && currentCategory) ? '/shop/category/' + currentCategory + '/brand/' + currentBrand : '/shop/brand/' + currentBrand; }
                                            function buildFilterUrl(sortBy, sortOrder) { const params = new URLSearchParams({ sort_by: sortBy, sort_order: sortOrder }); if (filters.search) params.set('search', filters.search); if (filters.min_price) params.set('min_price', filters.min_price); if (filters.max_price) params.set('max_price', filters.max_price); if (filters.featured) params.set('featured', filters.featured); return sortBaseUrl + '?' + params.toString(); } %>
                                                <a class="dropdown-item"
                                                    href="<%= buildFilterUrl('created_at', 'DESC') %>">
                                                    <%= typeof t !=='undefined' ? t('ecommerce.latest') : 'Latest' %>
                                                </a>
                                                <a class="dropdown-item" href="<%= buildFilterUrl('price', 'ASC') %>">
                                                    <%= typeof t !=='undefined' ? t('ecommerce.priceLowToHigh')
                                                        : 'Price: Low to High' %>
                                                </a>
                                                <a class="dropdown-item" href="<%= buildFilterUrl('price', 'DESC') %>">
                                                    <%= typeof t !=='undefined' ? t('ecommerce.priceHighToLow')
                                                        : 'Price: High to Low' %>
                                                </a>
                                                <a class="dropdown-item" href="<%= buildFilterUrl('name', 'ASC') %>">
                                                    <%= typeof t !=='undefined' ? t('ecommerce.nameAZ') : 'Name: A-Z' %>
                                                </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row pb-3">
                        <% if (products && products.length> 0) { %>
                            <% products.forEach(function(product) { %>
                                <div class="col-lg-4 col-md-6 col-sm-12 pb-1">
                                    <div class="product-item product-item-home bg-light mb-4">
                                        <div class="product-img position-relative overflow-hidden">
                                            <%- include('partials/product-sale-badge', { product }) %>
                                            <% if (product.images && product.images.length> 0) { %>
                                                <a href="/shop/product/<%= product.slug %>">
                                                    <img class="img-fluid w-100 product-card-img" src="<%= product.images[0].thumb_url || product.images[0].image_url %>"
                                                        alt="<%= product.name %>" data-default-src="<%= product.images[0].image_url %>">
                                                </a>
                                                <% } else { %>
                                                    <a href="/shop/product/<%= product.slug %>">
                                                        <img class="img-fluid w-100 product-card-img" src="<%= siteImage %>"
                                                            alt="<%= product.name %>" data-default-src="<%= siteImage %>">
                                                    </a>
                                                    <% } %>
                                                        <% if (product.is_featured) { %>
                                                            <span class="badge badge-primary position-absolute"
                                                                style="top: 10px; right: 10px;">
                                                                <%= typeof t !=='undefined' ? t('ecommerce.featured')
                                                                    : 'Featured' %>
                                                            </span>
                                                            <% } %>
                                                                <div class="product-action">
                                                                    <a class="btn btn-outline-dark btn-square add-to-wishlist-btn"
                                                                        href="#" data-product-id="<%= product.id %>"
                                                                        title="<%= typeof t !== 'undefined' ? t('ecommerce.addToWishlist') : 'Add to Wishlist' %>">
                                                                        <i class="far fa-heart"></i>
                                                                    </a>
                                                                    <a class="btn btn-outline-dark btn-square add-to-cart-btn"
                                                                        href="#" data-product-id="<%= product.id %>"
                                                                        data-has-variants="<%= !!product.has_variants %>"
                                                                        data-slug="<%= product.slug %>"
                                                                        title="<%= typeof t !== 'undefined' ? t('ecommerce.addToCart') : 'Add to Cart' %>">
                                                                        <i class="fa fa-shopping-cart"></i>
                                                                    </a>
                                                                </div>
                                        </div>
                                        <div class="text-left py-3 px-2 product-card-body">
                                            <a class="product-card-title text-decoration-none text-truncate d-block"
                                                href="/shop/product/<%= product.slug %>">
                                                <%= product.name %>
                                            </a>
                                            <% if (product.short_description && product.short_description.trim()) { %>
                                                <p class="product-card-desc text-truncate mb-1"><%= product.short_description.trim() %></p>
                                            <% } %>
                                            <div class="d-flex align-items-center justify-content-start mt-1 money product-card-price">
                                                <%- include('partials/product-listing-price', { product, customClass: '', multi_price_display: (typeof ecommerceSettings !== 'undefined' && ecommerceSettings && ecommerceSettings.multi_price_display) ? ecommerceSettings.multi_price_display : '' }) %>
                                            </div>
                                            <%- include('partials/product-listing-swatches', { product }) %>
                                            <% if (product.stock_quantity <=0) { %>
                                                <span class="badge badge-danger mt-2">
                                                    <%= typeof t !=='undefined' ? t('ecommerce.outOfStock')
                                                        : 'Out of Stock' %>
                                                </span>
                                                <% } else if (product.stock_quantity < 10) { %>
                                                    <span class="badge badge-warning mt-2">
                                                        <%= typeof t !=='undefined' ? t('ecommerce.lowStock')
                                                            : 'Low Stock' %>
                                                    </span>
                                                    <% } %>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <div class="col-12">
                                            <div class="alert alert-info text-center">
                                                <h5>
                                                    <%= typeof t !=='undefined' ? t('ecommerce.noProductsFound')
                                                        : 'No products found' %>
                                                </h5>
                                                <p>
                                                    <%= typeof t !=='undefined' ? t('ecommerce.tryDifferentFilters')
                                                        : 'Try adjusting your filters or search terms.' %>
                                                </p>
                                            </div>
                                        </div>
                                        <% } %>
                    </div>

                    <!-- Pagination -->
                    <% if (pagination.totalPages> 1) { %>
                        <div class="col-12 pb-1">
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-center mb-3">
                                    <% const currentPage=pagination.page; const totalPages=pagination.totalPages;
                                        let paginationBaseUrl = listingBaseUrl;
                                        if (typeof currentCategory !== 'undefined' && currentCategory) { paginationBaseUrl = '/shop/category/' + currentCategory; }
                                        if (typeof currentBrand !== 'undefined' && currentBrand) { paginationBaseUrl = (typeof currentCategory !== 'undefined' && currentCategory) ? '/shop/category/' + currentCategory + '/brand/' + currentBrand : '/shop/brand/' + currentBrand; }
                                        function buildPaginationUrl(pageNum) { const params = new URLSearchParams(); if (filters.search) params.set('search', filters.search); if (filters.min_price) params.set('min_price', filters.min_price); if (filters.max_price) params.set('max_price', filters.max_price); if (filters.featured) params.set('featured', filters.featured); if (filters.sort_by) params.set('sort_by', filters.sort_by); if (filters.sort_order) params.set('sort_order', filters.sort_order); params.set('page', pageNum.toString()); return paginationBaseUrl + '?' + params.toString(); } %>

                                        <% if (currentPage> 1) { %>
                                            <li class="page-item">
                                                <a class="page-link" href="<%= buildPaginationUrl(currentPage - 1) %>"
                                                    aria-label="Previous">
                                                    <span aria-hidden="true">&laquo;</span>
                                                    <span class="sr-only">Previous</span>
                                                </a>
                                            </li>
                                            <% } else { %>
                                                <li class="page-item disabled">
                                                    <a class="page-link" href="#" aria-label="Previous">
                                                        <span aria-hidden="true">&laquo;</span>
                                                        <span class="sr-only">Previous</span>
                                                    </a>
                                                </li>
                                                <% } %>

                                                    <% 
                                                        // Page numbers – show all available pages
                                                        for (let i=1; i <=totalPages; i++) { 
                                                    %>
                                                        <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                                            <a class="page-link" href="<%= buildPaginationUrl(i) %>">
                                                                <%= i %>
                                                            </a>
                                                        </li>
                                                        <% } %>

                                                            <% if (currentPage < totalPages) { %>
                                                                <li class="page-item">
                                                                    <a class="page-link"
                                                                        href="<%= buildPaginationUrl(currentPage + 1) %>"
                                                                        aria-label="Next">
                                                                        <span aria-hidden="true">&raquo;</span>
                                                                        <span class="sr-only">Next</span>
                                                                    </a>
                                                                </li>
                                                                <% } else { %>
                                                                    <li class="page-item disabled">
                                                                        <a class="page-link" href="#" aria-label="Next">
                                                                            <span aria-hidden="true">&raquo;</span>
                                                                            <span class="sr-only">Next</span>
                                                                        </a>
                                                                    </li>
                                                                    <% } %>
                                </ul>
                            </nav>
                        </div>
                        <% } %>
                </div>
                <!-- Shop Product End -->

    <%- include('partials/variant-selection-modal') %>
    <%- include('partials/confirmation-modal') %>
                <% } %>
    </div>
</div>
<!-- Shop End -->

<script>
    // Mobile filter toggle functionality
    document.addEventListener('DOMContentLoaded', function () {
        const mobileFilterToggle = document.getElementById('mobileFilterToggle');
        const mobileFilterContent = document.getElementById('mobileFilterContent');
        const mobileFilterIcon = document.getElementById('mobileFilterIcon');

        if (mobileFilterToggle && mobileFilterContent) {
            mobileFilterToggle.addEventListener('click', function () {
                const isVisible = mobileFilterContent.style.display !== 'none';
                
                if (isVisible) {
                    mobileFilterContent.style.display = 'none';
                    mobileFilterIcon.classList.remove('fa-chevron-up');
                    mobileFilterIcon.classList.add('fa-chevron-down');
                } else {
                    mobileFilterContent.style.display = 'block';
                    mobileFilterIcon.classList.remove('fa-chevron-down');
                    mobileFilterIcon.classList.add('fa-chevron-up');
                }
            });
        }
    });

    // Attribute filter functions
    function updateAttributeFilters() {
        const params = new URLSearchParams(window.location.search);

        // Get all attribute types
        const attributeTypes = {};
        document.querySelectorAll('.attribute-filter').forEach(checkbox => {
            const attr = checkbox.getAttribute('data-attr');
            const value = checkbox.getAttribute('data-value');

            if (!attributeTypes[attr]) {
                attributeTypes[attr] = [];
            }

            if (checkbox.checked) {
                attributeTypes[attr].push(value);
            }
        });

        // Update URL params
        Object.keys(attributeTypes).forEach(attr => {
            if (attributeTypes[attr].length > 0) {
                params.set(attr, attributeTypes[attr].join(','));
            } else {
                params.delete(attr);
            }
        });

        // Reset to page 1 when filters change
        params.set('page', '1');

        // Build SEO-friendly URL
        const path = window.location.pathname;
        window.location.href = path + '?' + params.toString();
    }

    function toggleFeaturedFilter() {
        const params = new URLSearchParams(window.location.search);
        const checkbox = document.getElementById('featured-filter');
        const path = window.location.pathname;

        if (checkbox.checked) {
            params.set('featured', 'true');
        } else {
            params.delete('featured');
        }

        params.set('page', '1');

        // Build SEO-friendly URL
        window.location.href = path + '?' + params.toString();
    }

    // Add to cart: handled by /js/app.js (variant drawer + simple products)

    document.addEventListener('DOMContentLoaded', function () {
        // Add to wishlist functionality
        const addToWishlistButtons = document.querySelectorAll('.add-to-wishlist-btn');
        addToWishlistButtons.forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const productId = this.getAttribute('data-product-id');
                // Add to wishlist via API
                fetch('/api/customer/wishlist/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'CSRF-Token': '<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>'
                    },
                    body: JSON.stringify({
                        product_id: parseInt(productId)
                    })
                })
                    .then(response => {
                        if (!response.ok) {
                            return response.json().then(data => {
                                throw new Error(data.error || 'Failed to add product to wishlist');
                            });
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            showConfirmationModal('Product added to wishlist!', function() {
                                window.location.href = '/wishlist';
                            }, {
                                title: 'Success',
                                confirmText: 'Go to Wishlist',
                                showCancel: true,
                                cancelText: 'Continue Shopping',
                                confirmClass: 'btn-success'
                            });
                        } else {
                            showAlert('Error: ' + (data.error || data.message || 'Failed to add product to wishlist'), 'Error');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showAlert('Error: ' + error.message, 'Error');
                    });
            });
        });
    });
</script>
<script>
(function() {
  function handleSwatchClick(e) {
    var swatch = e.target.closest('.product-color-swatch');
    if (!swatch) return;
    e.preventDefault();
    e.stopPropagation();
    var url = swatch.getAttribute('data-image-url');
    if (!url) {
      var innerImg = swatch.querySelector('.product-color-swatch-img');
      if (innerImg && innerImg.src) url = innerImg.src;
    }
    if (!url) return;
    var item = swatch.closest('.product-item');
    if (!item) return;
    var img = item.querySelector('.product-img .product-card-img');
    if (img) img.src = url;
    var container = swatch.closest('.product-color-swatches');
    if (container) {
      container.querySelectorAll('.product-color-swatch').forEach(function(s) { s.classList.remove('selected'); });
      swatch.classList.add('selected');
    }
  }
  function initSelectedSwatches() {
    document.querySelectorAll('.product-item .product-color-swatches').forEach(function(container) {
      var first = container.querySelector('.product-color-swatch:not([data-gallery-photo="1"])');
      if (first) first.classList.add('selected');
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      document.addEventListener('click', handleSwatchClick);
      initSelectedSwatches();
    });
  } else {
    document.addEventListener('click', handleSwatchClick);
    initSelectedSwatches();
  }
})();
</script>