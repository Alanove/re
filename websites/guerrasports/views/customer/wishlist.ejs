<!-- Wishlist Page -->

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5 px-md-3 px-2">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="/">Home</a>
                <% if (user) { %>
                    <a class="breadcrumb-item text-dark" href="/customer/account">Account</a>
                <% } %>
                <span class="breadcrumb-item active"><%= typeof t !== 'undefined' ? t('ecommerce.customer.wishlist') : 'Wishlist' %></span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->

<!-- Wishlist Start -->
<div class="container-fluid pb-5">
    <div class="row px-xl-5 px-md-3 px-2">
        <% if (typeof user !== 'undefined' && user) { %>
        <div class="col-lg-3 mb-5">
            <%- include('../partials/account-sidebar') %>
        </div>
        <% } %>

        <!-- Wishlist Content -->
        <div class="<%= (typeof user !== 'undefined' && user) ? 'col-lg-9' : 'col-lg-12' %>">
            <div class="bg-light">
                <h4 class="mb-4"><%= typeof t !== 'undefined' ? t('ecommerce.customer.wishlist') : 'My Wishlist' %></h4>
                
                <% if (wishlist && wishlist.length > 0) { %>
                    <!-- Desktop Table View -->
                    <div class="table-responsive d-none d-lg-block">
                        <table class="table table-light table-borderless table-hover text-center mb-0">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Products</th>
                                    <th>Price</th>
                                    <th>Actions</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody class="align-middle">
                                <% wishlist.forEach(function(item) { %>
                                    <tr>
                                        <td class="align-middle">
                                            <div class="d-flex align-items-center" style="text-align: left;">
                                                <img src="<%= item.image_url || '/images/no-image.jpg' %>" alt="<%= item.product_name %>" style="width: 60px; height: 60px; object-fit: cover;">
                                                <div class="ml-3 d-flex flex-column">
                                                    <a href="/shop/product/<%= item.product_slug || item.slug %>" class="h6 text-dark mb-1"><%= item.product_name %></a>
                                                    <% if (item.variant_name) { %>
                                                        <small class="text-muted"><%= item.variant_name %></small>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="align-middle money">
                                            <%- include('../partials/price', { price: item.price }) %>
                                        </td>
                                        <td class="align-middle">
                                            <button class="btn btn-sm btn-primary add-to-cart-btn" 
                                                    data-product-id="<%= item.product_id %>"
                                                    data-variant-id="<%= item.variant_id || '' %>"
                                                    data-has-variants="<%= !!item.has_variants %>">
                                                <i class="fa fa-shopping-cart mr-1"></i> Add to Cart
                                            </button>
                                        </td>
                                        <td class="align-middle">
                                            <button class="btn btn-sm btn-danger" onclick="removeFromWishlist(<%= item.product_id %>)">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Mobile Card View -->
                    <div class="d-lg-none">
                        <% wishlist.forEach(function(item) { %>
                            <div class="card mb-3 wishlist-item-mobile">
                                <div class="card-body">
                                    <div class="d-flex align-items-start mb-3">
                                        <img src="<%= item.image_url || '/images/no-image.jpg' %>" alt="<%= item.product_name %>" class="wishlist-item-img-mobile" style="width: 80px; height: 80px; object-fit: cover; margin-right: 15px;">
                                        <div class="flex-grow-1">
                                            <a href="/shop/product/<%= item.product_slug || item.slug %>" class="h6 text-dark d-block mb-1"><%= item.product_name %></a>
                                            <% if (item.variant_name) { %>
                                                <small class="text-muted d-block mb-2"><%= item.variant_name %></small>
                                            <% } %>
                                            <div class="money mb-3">
                                                <%- include('../partials/price', { price: item.price }) %>
                                            </div>
                                        </div>
                                        <button class="btn btn-sm btn-danger" onclick="removeFromWishlist(<%= item.product_id %>)">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </div>
                                    <button class="btn btn-block btn-primary add-to-cart-btn" 
                                            data-product-id="<%= item.product_id %>"
                                            data-variant-id="<%= item.variant_id || '' %>"
                                            data-has-variants="<%= !!item.has_variants %>">
                                        <i class="fa fa-shopping-cart mr-1"></i> Add to Cart
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <i class="fa fa-heart fa-3x text-muted mb-3"></i>
                        <p class="text-muted"><%= typeof t !== 'undefined' ? t('ecommerce.customer.noWishlist') : 'Your wishlist is empty' %></p>
                        <a href="/shop" class="btn btn-primary">
                            <%= typeof t !== 'undefined' ? t('ecommerce.productCatalog') : 'Start Shopping' %>
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<!-- Wishlist End -->

<%- include('../partials/confirmation-modal') %>
<%- include('../partials/variant-selection-modal') %>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Add to Cart from Wishlist
    const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');
    addToCartButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const productId = this.getAttribute('data-product-id');
            const variantId = this.getAttribute('data-variant-id');
            const hasVariants = this.getAttribute('data-has-variants') === 'true';

            // If it has variants but none selected yet, open selection modal
            if (hasVariants && !variantId) {
                openVariantModal(productId);
                return;
            }
            
            fetch('/api/cart/add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
                },
                body: JSON.stringify({
                    product_id: parseInt(productId),
                    variant_id: variantId ? parseInt(variantId) : null,
                    quantity: 1
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (data.meta && typeof window.MetaPixel !== 'undefined') {
                        window.MetaPixel.trackAddToCart(data.meta);
                    }
                    showConfirmationModal('Product added to cart!', function() {
                        window.location.href = '/cart';
                    }, {
                        title: 'Success',
                        confirmText: 'Go to Cart',
                        showCancel: true,
                        cancelText: 'Stay on Wishlist',
                        confirmClass: 'btn-success'
                    });
                } else {
                    alert('Error: ' + (data.error || 'Failed to add product to cart'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error adding to cart');
            });
        });
    });
});

function removeFromWishlist(productId) {
    showConfirmationModal('Remove this item from your wishlist?', function() {
        fetch('/api/customer/wishlist/remove', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
            },
            body: JSON.stringify({
                product_id: productId
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Error: ' + (data.error || 'Failed to remove from wishlist'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error removing from wishlist');
        });
    });
}
</script>



