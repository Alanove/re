<!-- Reset Password Page -->

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="/">Home</a>
                <a class="breadcrumb-item text-dark" href="/customer/login"><%= typeof t !== 'undefined' ? t('ecommerce.customer.login') : 'Login' %></a>
                <span class="breadcrumb-item active"><%= typeof t !== 'undefined' ? t('ecommerce.customer.resetPassword') : 'Reset Password' %></span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->

<!-- Reset Password Start -->
<div class="container-fluid pb-5">
    <div class="row px-xl-5 justify-content-center">
        <div class="col-lg-6">
            <div class="bg-light">
                <h3 class="mb-4 text-center"><%= typeof t !== 'undefined' ? t('ecommerce.customer.resetPassword') : 'Reset Password' %></h3>
                
                <div id="messageAlert" class="alert d-none" role="alert"></div>
                
                <form id="resetPasswordForm">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="token" value="<%= token %>">
                    
                    <div class="form-group">
                        <label><%= typeof t !== 'undefined' ? t('ecommerce.customer.newPassword') : 'New Password' %></label>
                        <input class="form-control" type="password" name="password" required minlength="6">
                    </div>
                    <div class="form-group">
                        <label><%= typeof t !== 'undefined' ? t('ecommerce.customer.confirmPassword') : 'Confirm Password' %></label>
                        <input class="form-control" type="password" name="confirmPassword" required minlength="6">
                    </div>
                    
                    <div class="form-group mb-0">
                        <button type="submit" class="btn btn-primary w-100">
                            <%= typeof t !== 'undefined' ? t('ecommerce.customer.resetPassword') : 'Reset Password' %>
                        </button>
                    </div>
                </form>
                
                <div id="loginLinkContainer" class="text-center mt-3 d-none">
                    <a href="/customer/login" class="btn btn-primary"><%= typeof t !== 'undefined' ? t('ecommerce.customer.login') : 'Login' %></a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Reset Password End -->

<script>
document.getElementById('resetPasswordForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const password = formData.get('password');
    const confirmPassword = formData.get('confirmPassword');
    const messageAlert = document.getElementById('messageAlert');
    
    // Reset alert
    messageAlert.classList.add('d-none');
    messageAlert.classList.remove('alert-success', 'alert-danger');
    
    if (password !== confirmPassword) {
        messageAlert.textContent = 'Passwords do not match';
        messageAlert.classList.add('alert-danger');
        messageAlert.classList.remove('d-none');
        return;
    }
    
    const submitBtn = e.target.querySelector('button[type="submit"]');
    const originalText = submitBtn.innerHTML;
    
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...';
    
    fetch('/api/customer/reset-password', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'CSRF-Token': formData.get('_csrf')
        },
        body: JSON.stringify({
            token: formData.get('token'),
            password: password,
            confirmPassword: confirmPassword,
            _csrf: formData.get('_csrf')
        })
    })
    .then(response => response.json())
    .then(data => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        
        if (data.success) {
            messageAlert.textContent = data.message || 'Password has been reset successfully. Please login.';
            messageAlert.classList.add('alert-success');
            messageAlert.classList.remove('d-none');
            
            // Hide form and show login link
            document.getElementById('resetPasswordForm').classList.add('d-none');
            document.getElementById('loginLinkContainer').classList.remove('d-none');
        } else {
            messageAlert.textContent = 'Error: ' + (data.error || 'Failed to reset password');
            messageAlert.classList.add('alert-danger');
            messageAlert.classList.remove('d-none');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        messageAlert.textContent = 'An error occurred. Please try again.';
        messageAlert.classList.add('alert-danger');
        messageAlert.classList.remove('d-none');
    });
});
</script>
