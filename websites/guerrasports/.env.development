# Development Environment Configuration

# Node Environment
NODE_ENV=development

# Debug: set to true to show verbose logs in terminal (cart, checkout, session, CSRF, logger). Set false to quiet.
# Enable in dev to diagnose admin login (CSRF token, session, auth).
DEBUG=true

# Server Configuration
PORT=3003

# HTTPS (development): set USE_HTTPS=true and paths to PEM key/cert to run over HTTPS.
# Generate self-signed cert: openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes -subj "/CN=localhost"
# USE_HTTPS=false
# HTTPS_KEY_PATH=cert/key.pem
# HTTPS_CERT_PATH=cert/cert.pem

# Session Configuration
SESSION_SECRET=lw-njs-cms-admin-secret-change-in-production

# Cookie Configuration
COOKIE_DOMAIN=

# Cloudflare Turnstile Configuration (Development - Test Keys)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sa
DB_PASSWORD=P@55w0rd
DB_NAME=guerra_652026
#DB_NAME=gs1
DB_WAIT_FOR_CONNECTIONS=true
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

SMTP_HOST=mail.guerrasports.com
SMTP_PORT=465
SMTP_USER=sales@guerrasports.com
SMTP_PASSWORD=itp^,Ik%@GXE
SMTP_FROM=sales@guerrasports.com
# mail.guerrasports.com presents a cert for *.server.dynamic-lb.com — Node rejects the connection until hosting fixes the cert
SMTP_REJECT_UNAUTHORIZED=false
TEST_EMAIL=alanove@gmail.com

# Content Security Policy Configuration
# Default script sources (comma-separated) - used as base configuration
CSP_SCRIPT_SRC_DEFAULT='self','unsafe-inline',https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com,https://code.jquery.com,https://stackpath.bootstrapcdn.com,https://challenges.cloudflare.com,https://www.googletagmanager.com,https://connect.facebook.net

# Default style sources (comma-separated) - used as base configuration
CSP_STYLE_SRC_DEFAULT='self','unsafe-inline',https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com,https://fonts.googleapis.com

# Default frame sources (comma-separated) - used as base configuration
CSP_FRAME_SRC_DEFAULT='self',https://*.google.com,https://*.googleapis.com,https://*.gstatic.com,https://www.youtube.com,https://*.youtube.com,https://challenges.cloudflare.com

# Default object sources (comma-separated) - used as base configuration
CSP_OBJECT_SRC_DEFAULT='none'

# Default base URI (comma-separated) - used as base configuration
CSP_BASE_URI_DEFAULT='self'

# Default image sources (comma-separated) - used as base configuration
CSP_IMG_SRC_DEFAULT='self',data:,https:

# Default font sources (comma-separated) - used as base configuration
CSP_FONT_SRC_DEFAULT='self',data:,https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com,https://fonts.gstatic.com

# Default connect sources (comma-separated) - used as base configuration
CSP_CONNECT_SRC_DEFAULT='self',https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com,https://challenges.cloudflare.com,https://www.google-analytics.com,https://*.google-analytics.com,https://*.analytics.google.com,https://www.googletagmanager.com,https://*.googletagmanager.com,https://connect.facebook.net,https://www.facebook.com

# Override variables (optional) - these override the defaults if set
# CSP_SCRIPT_SRC=
# CSP_STYLE_SRC=
# CSP_FRAME_SRC=
# CSP_OBJECT_SRC=
# CSP_BASE_URI=
# CSP_IMG_SRC=
# CSP_FONT_SRC=
# CSP_CONNECT_SRC=

# Helmet HSTS Configuration
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Aramex Configuration (JSON API - all required; no hardcoded fallbacks)
ARAMEX_USERNAME=info@guerrasports.com
# Password must be quoted so # is not treated as start of comment
ARAMEX_PASSWORD="Aramexguerra25#"
ARAMEX_VERSION=v1.0
ARAMEX_ACCOUNT_NUMBER=72478367
ARAMEX_ACCOUNT_PIN=316198
ARAMEX_ACCOUNT_ENTITY=BEY
ARAMEX_ACCOUNT_COUNTRY_CODE=LB
ARAMEX_TEST_MODE=false
IS_ARAMEX_ENABLED=true
# Show actual credentials in Admin Test shipping error debug (remove after fixing ERR75)
ARAMEX_DEBUG_CREDENTIALS=true
# Set ARAMEX_LOGGING=true to log Aramex API request/response in terminal (leave unset/false to quiet)
# ARAMEX_LOGGING=false


