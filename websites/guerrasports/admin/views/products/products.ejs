<!-- BEGIN content area -->
<div class="row">
	<div class="col-xl-12">
		<!-- BEGIN panel -->
		<div class="panel panel-inverse">
			<div class="panel-heading">
				<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('ecommerce.products.title') : 'Products' %></h4>
				<div class="panel-heading-btn">
					<a href="/admin/products/create" class="btn btn-xs btn-success">
						<i class="fa fa-plus"></i> <%= typeof t !== 'undefined' ? t('ecommerce.products.addNewProduct') : 'Add New Product' %>
					</a>
				</div>
			</div>
			<div class="panel-body">
				<% if (typeof success !== 'undefined' && success) { %>
					<div class="alert alert-success alert-dismissible fade show" role="alert">
						<strong><%= typeof t !== 'undefined' ? t('messages.success') : 'Success!' %></strong> <%= success %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<% if (typeof error !== 'undefined' && error) { %>
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						<strong>Error!</strong> <%= error %>
						<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					</div>
				<% } %>
				
				<!-- BEGIN filters -->
				<form method="GET" action="/admin/products" id="filters-form">
					<div class="row mb-3">
						<div class="col-md-3">
							<div class="input-group">
								<span class="input-group-text">
									<i class="fa fa-search"></i>
								</span>
								<input type="text" class="form-control" name="search" id="searchFilter" 
								       placeholder="<%= typeof t !== 'undefined' ? t('common.search') : 'Search products...' %>" 
								       value="<%= typeof filters !== 'undefined' && filters.search ? filters.search : '' %>" />
							</div>
						</div>
						<div class="col-md-2">
							<select class="form-select" name="category_id" id="categoryFilter">
								<option value="">All <%= typeof t !== 'undefined' ? t('ecommerce.categories.title') : 'Categories' %></option>
								<% if (typeof categories !== 'undefined' && categories) { %>
									<% categories.forEach(function(category) { %>
										<option value="<%= category.id %>" <%= typeof filters !== 'undefined' && filters.category_id == category.id ? 'selected' : '' %>>
											<%= category.name %>
										</option>
									<% }); %>
								<% } %>
							</select>
						</div>
						<div class="col-md-2">
							<select class="form-select" name="status" id="statusFilter">
								<option value="">All <%= typeof t !== 'undefined' ? t('common.status') : 'Status' %></option>
								<option value="published" <%= typeof filters !== 'undefined' && filters.status === 'published' ? 'selected' : '' %>>
									<%= typeof t !== 'undefined' ? t('ecommerce.products.published') : 'Published' %>
								</option>
								<option value="draft" <%= typeof filters !== 'undefined' && filters.status === 'draft' ? 'selected' : '' %>>
									<%= typeof t !== 'undefined' ? t('ecommerce.products.draft') : 'Draft' %>
								</option>
							</select>
						</div>
						<div class="col-md-2">
							<select class="form-select" name="is_featured" id="featuredFilter">
								<option value="">All Products</option>
								<option value="true" <%= typeof filters !== 'undefined' && filters.is_featured === true ? 'selected' : '' %>>
									<%= typeof t !== 'undefined' ? t('ecommerce.products.featured') : 'Featured' %> Only
								</option>
							</select>
						</div>
						<div class="col-md-3">
							<button type="submit" class="btn btn-primary me-1">
								<i class="fa fa-filter"></i> <%= typeof t !== 'undefined' ? t('common.filter') : 'Filter' %>
							</button>
							<a href="/admin/products" class="btn btn-secondary">
								<i class="fa fa-times"></i> <%= typeof t !== 'undefined' ? t('common.clearFilters') : 'Clear' %>
							</a>
						</div>
					</div>
				</form>
				<!-- END filters -->
				
				<div class="table-responsive">
					<table class="table table-striped table-bordered align-middle">
						<thead>
							<tr>
								<th width="80">Image</th>
								<th><%= typeof t !== 'undefined' ? t('ecommerce.products.productName') : 'Product Name' %></th>
								<th><%= typeof t !== 'undefined' ? t('ecommerce.products.sku') : 'SKU' %></th>
								<th><%= typeof t !== 'undefined' ? t('ecommerce.products.price') : 'Price' %></th>
								<th><%= typeof t !== 'undefined' ? t('ecommerce.products.stock') : 'Stock' %></th>
								<th>Category</th>
								<th><%= typeof t !== 'undefined' ? t('common.status') : 'Status' %></th>
								<th width="100"><%= typeof t !== 'undefined' ? t('common.actions') : 'Actions' %></th>
							</tr>
						</thead>
						<tbody>
							<% if (typeof products !== 'undefined' && products && products.length > 0) { %>
								<% products.forEach(function(product) { %>
									<tr data-product-id="<%= product.id %>">
										<td>
											<% if (product.images && product.images.length > 0) { %>
												<img src="<%= product.images[0].image_url %>" alt="<%= product.name %>" 
												     class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
											<% } else { %>
												<div class="bg-light d-flex align-items-center justify-content-center" 
												     style="width: 60px; height: 60px;">
													<i class="fa fa-image text-muted"></i>
												</div>
											<% } %>
										</td>
										<td>
											<div class="fw-bold"><%= product.name %></div>
											<% if (product.is_featured) { %>
												<span class="badge bg-warning text-dark">
													<i class="fa fa-star"></i> <%= typeof t !== 'undefined' ? t('ecommerce.products.featured') : 'Featured' %>
												</span>
											<% } %>
										</td>
										<td>
											<% if (product.sku) { %>
												<%= product.sku %>
											<% } else { %>
												<span class="text-muted">-</span>
											<% } %>
										</td>
										<td>
											<% if (product.sale_price && product.sale_price < product.price) { %>
												<span class="text-decoration-line-through text-muted">$<%= parseFloat(product.price).toFixed(2) %></span><br>
												<span class="text-danger fw-bold">$<%= parseFloat(product.sale_price).toFixed(2) %></span>
											<% } else { %>
												$<%= parseFloat(product.price).toFixed(2) %>
											<% } %>
										</td>
										<td>
											<% if (product.stock_quantity <= 0) { %>
												<span class="badge bg-danger"><%= typeof t !== 'undefined' ? t('ecommerce.outOfStock') : 'Out of Stock' %></span>
											<% } else if (product.stock_quantity < 10) { %>
												<span class="badge bg-warning"><%= product.stock_quantity %> <%= typeof t !== 'undefined' ? t('ecommerce.left') : 'left' %></span>
											<% } else { %>
												<span class="badge bg-success"><%= product.stock_quantity %></span>
											<% } %>
										</td>
										<td>
											<% if (product.category_name) { %>
												<%= product.category_name %>
											<% } else { %>
												<span class="text-muted">-</span>
											<% } %>
										</td>
										<td>
											<% if (product.status === 'published') { %>
												<span class="badge bg-success"><%= typeof t !== 'undefined' ? t('ecommerce.products.published') : 'Published' %></span>
											<% } else if (product.status === 'draft') { %>
												<span class="badge bg-secondary"><%= typeof t !== 'undefined' ? t('ecommerce.products.draft') : 'Draft' %></span>
											<% } else { %>
												<span class="badge bg-warning"><%= product.status %></span>
											<% } %>
											<% if (!product.is_active) { %>
												<br><span class="badge bg-danger mt-1"><%= typeof t !== 'undefined' ? t('ecommerce.products.inactive') : 'Inactive' %></span>
											<% } %>
										</td>
										<td>
											<div class="btn-group">
												<a href="/admin/products/<%= product.id %>/edit" class="btn btn-xs btn-primary" title="<%= typeof t !== 'undefined' ? t('common.edit') : 'Edit' %>">
													<i class="fa fa-edit"></i>
												</a>
												<button type="button" class="btn btn-xs btn-secondary copy-product-btn"
												        data-product-id="<%= product.id %>"
												        title="<%= typeof t !== 'undefined' ? t('ecommerce.products.copyProduct') : 'Copy Product' %>">
													<i class="fa fa-copy"></i>
												</button>
												<a href="/admin/reviews?product_id=<%= product.id %>" class="btn btn-xs btn-info" title="<%= typeof t !== 'undefined' ? t('reviews.title') : 'Reviews' %>">
													<i class="fa fa-star"></i>
												</a>
												<button type="button" class="btn btn-xs btn-danger delete-product-btn" 
												        data-product-id="<%= product.id %>" 
												        title="<%= typeof t !== 'undefined' ? t('common.delete') : 'Delete' %>">
													<i class="fa fa-trash"></i>
												</button>
											</div>
										</td>
									</tr>
								<% }); %>
							<% } else { %>
								<tr>
									<td colspan="8" class="text-center py-4">
										<i class="fa fa-box-open fa-3x text-muted mb-3"></i>
										<p class="text-muted"><%= typeof t !== 'undefined' ? t('common.noData') : 'No products found' %></p>
										<a href="/admin/products/create" class="btn btn-primary">
											<i class="fa fa-plus"></i> <%= typeof t !== 'undefined' ? t('ecommerce.products.addNewProduct') : 'Add New Product' %>
										</a>
									</td>
								</tr>
							<% } %>
						</tbody>
					</table>
				</div>
				
				<!-- BEGIN pagination -->
				<% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
					<div class="d-flex justify-content-between align-items-center mt-3">
						<div>
							<%= typeof t !== 'undefined' ? (t('common.showing') || t('ecommerce.showing')) : 'Showing' %> 
							<%= ((pagination.page - 1) * pagination.limit) + 1 %> - 
							<%= Math.min(pagination.page * pagination.limit, pagination.total) %> 
							<%= typeof t !== 'undefined' ? t('common.of') : 'of' %> 
							<%= pagination.total %> 
							<%= typeof t !== 'undefined' ? t('common.items') : 'items' %>
						</div>
						<nav>
							<ul class="pagination mb-0">
								<% 
									const currentPage = pagination.page;
									const totalPages = pagination.totalPages;
									const queryParams = new URLSearchParams();
									if (typeof filters !== 'undefined') {
										if (filters.search) queryParams.set('search', filters.search);
										if (filters.category_id) queryParams.set('category_id', filters.category_id);
										if (filters.status) queryParams.set('status', filters.status);
										if (filters.is_featured) queryParams.set('is_featured', filters.is_featured);
									}
									
									// Previous button
									if (currentPage > 1) {
										queryParams.set('page', (currentPage - 1).toString());
								%>
									<li class="page-item">
										<a class="page-link" href="?<%= queryParams.toString() %>">
											<i class="fa fa-chevron-left"></i>
										</a>
									</li>
								<% } else { %>
									<li class="page-item disabled">
										<span class="page-link"><i class="fa fa-chevron-left"></i></span>
									</li>
								<% } %>

								<% 
									// Page numbers
									let startPage = Math.max(1, currentPage - 2);
									let endPage = Math.min(totalPages, currentPage + 2);
									
									for (let i = startPage; i <= endPage; i++) {
										queryParams.set('page', i.toString());
								%>
									<li class="page-item <%= i === currentPage ? 'active' : '' %>">
										<a class="page-link" href="?<%= queryParams.toString() %>"><%= i %></a>
									</li>
								<% } %>

								<% 
									// Next button
									if (currentPage < totalPages) {
										queryParams.set('page', (currentPage + 1).toString());
								%>
									<li class="page-item">
										<a class="page-link" href="?<%= queryParams.toString() %>">
											<i class="fa fa-chevron-right"></i>
										</a>
									</li>
								<% } else { %>
									<li class="page-item disabled">
										<span class="page-link"><i class="fa fa-chevron-right"></i></span>
									</li>
								<% } %>
							</ul>
						</nav>
					</div>
				<% } %>
				<!-- END pagination -->
			</div>
		</div>
		<!-- END panel -->
	</div>
</div>
<!-- END content area -->

<script>
document.addEventListener('DOMContentLoaded', function() {
	// Delete product button handlers
	document.querySelectorAll('.delete-product-btn').forEach(btn => {
		btn.addEventListener('click', function() {
			const productId = this.getAttribute('data-product-id');
			deleteItem(`/admin/products/${productId}`, this, '<%= typeof t !== 'undefined' ? t('ecommerce.products.deleteProduct') : 'Delete Product' %>');
		});
	});

	document.querySelectorAll('.copy-product-btn').forEach(btn => {
		btn.addEventListener('click', function() {
			const productId = this.getAttribute('data-product-id');
			const confirmMessage = '<%= typeof t !== 'undefined' ? t('ecommerce.products.copyProductConfirm') : 'Create a copy of this product? Images, variants, attributes, and stock will be duplicated.' %>';
			if (!confirm(confirmMessage)) return;

			const csrfToken = typeof getCsrfToken === 'function' ? getCsrfToken() : '';
			const button = this;
			button.disabled = true;
			fetch(`/admin/products/${productId}/copy`, {
				method: 'POST',
				headers: typeof getCsrfHeaders === 'function'
					? getCsrfHeaders({ 'Content-Type': 'application/json' })
					: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
				body: JSON.stringify({ _csrf: csrfToken })
			})
			.then(response => response.json())
			.then(data => {
				if (data.success && data.redirect) {
					window.location.href = data.redirect;
				} else {
					alert(data.error || 'Failed to copy product');
					button.disabled = false;
				}
			})
			.catch(error => {
				console.error('Error copying product:', error);
				alert('Failed to copy product');
				button.disabled = false;
			});
		});
	});
});
</script>
