<!-- BEGIN breadcrumb -->
<ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="/admin/dashboard">
			<%= typeof t !=='undefined' ? t('common.home') : 'Home' %>
		</a></li>
	<li class="breadcrumb-item active">
		<%= typeof t !=='undefined' ? t('siteSettings.title') : 'Settings' %>
	</li>
</ol>
<!-- END breadcrumb -->

<form method="POST" action="/admin/site-settings/update" enctype="multipart/form-data" id="siteSettingsForm">
	<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
	<!-- BEGIN row -->
	<div class="row">
		<!-- BEGIN col-9 -->
		<div class="col-xl-9">
			<!-- BEGIN panel - Basic Information -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-1">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('siteSettings.basicInformation') : 'Basic Information' %>
					</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<% if (typeof error !=='undefined' && error) { %>
						<div class="alert alert-danger">
							<i class="fa fa-exclamation-triangle"></i>
							<%= error %>
						</div>
						<% } %>
							<% if (typeof success !=='undefined' && success) { %>
								<div class="alert alert-success">
									<i class="fa fa-check-circle"></i>
									<%= success %>
								</div>
								<% } %>

									<div class="row mb-15px">
										<label class="form-label col-form-label col-md-3">
											<%= typeof t !=='undefined' ? t('siteSettings.siteTitle') : 'Site Title' %>
												<span class="text-danger">*</span>
										</label>
										<div class="col-md-9">
											<input type="text" class="form-control" id="siteTitle" name="siteTitle"
												value="<%= settings.siteTitle %>" required />
											<small class="fs-12px text-gray-500-darker">
												<%= typeof t !=='undefined' ? t('siteSettings.siteTitleHelp')
													: 'The main title of your website' %>
											</small>
										</div>
									</div>

									<div class="row mb-15px">
										<label class="form-label col-form-label col-md-3">
											<%= typeof t !=='undefined' ? t('siteSettings.siteSlogan') : 'Site Slogan'
												%>
										</label>
										<div class="col-md-9">
											<input type="text" class="form-control" id="siteSlogan" name="siteSlogan"
												value="<%= settings.siteSlogan || '' %>" />
											<small class="fs-12px text-gray-500-darker">
												<%= typeof t !=='undefined' ? t('siteSettings.siteSloganHelp')
													: 'A short slogan or catchphrase for your website' %>
											</small>
										</div>
									</div>

									<div class="row mb-15px">
										<label class="form-label col-form-label col-md-3">
											<%= typeof t !=='undefined' ? t('siteSettings.siteDescription')
												: 'Site Description' %>
										</label>
										<div class="col-md-9">
											<textarea class="form-control" id="siteDescription" name="siteDescription"
												rows="3"
												placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.siteDescriptionPlaceholder') : 'Enter a brief description of your website...' %>"><%= settings.siteDescription || '' %></textarea>
											<small class="fs-12px text-gray-500-darker">
												<%= typeof t !=='undefined' ? t('siteSettings.siteDescriptionHelp')
													: 'A brief description of your website for search engines' %>
											</small>
										</div>
									</div>

									<div class="row mb-15px">
										<label class="form-label col-form-label col-md-3">
											<%= typeof t !=='undefined' ? t('siteSettings.siteUrl') : 'Site URL' %>
										</label>
										<div class="col-md-9">
											<input type="url" class="form-control" id="siteUrl" name="siteUrl"
												value="<%= settings.siteUrl %>" />
											<small class="fs-12px text-gray-500-darker">
												<%= typeof t !=='undefined' ? t('siteSettings.siteUrlHelp')
													: 'The main URL of your website (e.g., https://example.com)' %>
											</small>
										</div>
									</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Contact Information -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-2">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('siteSettings.contactInformation') : 'Contact Information' %>
					</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.contactEmail') : 'Contact Email' %>
						</label>
						<div class="col-md-9">
							<input type="email" class="form-control" id="contactEmail" name="contactEmail"
								value="<%= settings.contactEmail %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.contactEmailHelp')
									: 'Primary contact email address' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.contactPhone') : 'Contact Phone' %>
						</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="contactPhone" name="contactPhone"
								value="<%= settings.contactPhone %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.contactPhoneHelp')
									: 'Primary contact phone number' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.contactWhatsapp') : 'Contact WhatsApp' %>
						</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="contactWhatsapp" name="contactWhatsapp"
								value="<%= settings.contactWhatsapp %>" placeholder="+1234567890" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.contactWhatsappHelp')
									: 'WhatsApp number with country code (e.g. +1234567890)' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.address') : 'Address' %>
						</label>
						<div class="col-md-9">
							<textarea class="form-control" id="address" name="address" rows="2"
								placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.addressPlaceholder') : 'Enter your business address...' %>"><%= settings.address || '' %></textarea>
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.addressHelp')
									: 'Your business or office address' %>
							</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Social Media -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-3">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('siteSettings.socialMedia') : 'Social Media' %>
					</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.facebook') : 'Facebook' %>
						</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="facebook" name="facebook"
								value="<%= settings.socialMedia.facebook %>"
								placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.facebookPlaceholder') : 'https://facebook.com/yourpage' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.facebookHelp') : 'Your Facebook page URL'
									%>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.twitter') : 'Twitter' %>
						</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="twitter" name="twitter"
								value="<%= settings.socialMedia.twitter %>"
								placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.twitterPlaceholder') : 'https://twitter.com/yourhandle' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.twitterHelp') : 'Your Twitter profile URL'
									%>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.instagram') : 'Instagram' %>
						</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="instagram" name="instagram"
								value="<%= settings.socialMedia.instagram %>"
								placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.instagramPlaceholder') : 'https://instagram.com/yourprofile' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.instagramHelp')
									: 'Your Instagram profile URL' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.linkedin') : 'LinkedIn' %>
						</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="linkedin" name="linkedin"
								value="<%= settings.socialMedia.linkedin %>"
								placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.linkedinPlaceholder') : 'https://linkedin.com/company/yourcompany' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.linkedinHelp')
									: 'Your LinkedIn company page URL' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.youtube') : 'YouTube' %>
						</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="youtube" name="youtube"
								value="<%= settings.socialMedia.youtube %>"
								placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.youtubePlaceholder') : 'https://youtube.com/@yourchannel' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.youtubeHelp') : 'Your YouTube channel URL'
									%>
							</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - SEO Settings -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-4">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('siteSettings.seoSettings') : 'SEO Settings' %>
					</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.defaultTitle') : 'Default Title' %>
						</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="defaultTitle" name="defaultTitle"
								value="<%= settings.seo.defaultTitle %>" maxlength="60" />
							<div class="character-count" id="defaultTitleCount">0/60</div>
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.defaultTitleHelp')
									: 'Default page title for SEO (max 60 characters)' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.defaultDescription') : 'Default Description'
								%>
						</label>
						<div class="col-md-9">
							<textarea class="form-control" id="defaultDescription" name="defaultDescription" rows="3"
								maxlength="160"
								placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.defaultDescriptionPlaceholder') : 'Enter default meta description...' %>"><%= settings.seo.defaultDescription || '' %></textarea>
							<div class="character-count" id="defaultDescriptionCount">0/160</div>
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.defaultDescriptionHelp')
									: 'Default meta description for SEO (max 160 characters)' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.defaultKeywords') : 'Default Keywords' %>
						</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="defaultKeywords" name="defaultKeywords"
								value="<%= settings.seo.defaultKeywords %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.defaultKeywordsHelp')
									: 'Default keywords for SEO (comma-separated)' %>
							</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Google Maps -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-4">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('siteSettings.googleMapsLocation') : 'Google Maps Location' %>
					</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.googleMapsEmbedUrl') : 'Google Maps Embed URL'
								%>
						</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="googleMapsEmbedUrl" name="googleMapsEmbedUrl"
								value="<%= settings.googleMaps && settings.googleMaps.embedUrl ? settings.googleMaps.embedUrl : '' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.googleMapsEmbedUrlHelp')
									: 'Google Maps embed URL for the contact page map' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.googleMapsDirectionsUrl')
								: 'Google Maps Directions URL' %>
						</label>
						<div class="col-md-9">
							<input type="url" class="form-control" id="googleMapsDirectionsUrl"
								name="googleMapsDirectionsUrl"
								value="<%= settings.googleMaps && settings.googleMaps.directionsUrl ? settings.googleMaps.directionsUrl : '' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.googleMapsDirectionsUrlHelp')
									: 'Google Maps directions URL for "Get Directions" button' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.latitude') : 'Latitude' %>
						</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="googleMapsLatitude" name="googleMapsLatitude"
								value="<%= settings.googleMaps && settings.googleMaps.latitude ? settings.googleMaps.latitude : '' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.latitudeHelp')
									: 'Location latitude (e.g., 33.8969865)' %>
							</small>
						</div>
					</div>

					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.longitude') : 'Longitude' %>
						</label>
						<div class="col-md-9">
							<input type="text" class="form-control" id="googleMapsLongitude" name="googleMapsLongitude"
								value="<%= settings.googleMaps && settings.googleMaps.longitude ? settings.googleMaps.longitude : '' %>" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.longitudeHelp')
									: 'Location longitude (e.g., 35.5462693)' %>
							</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Analytics -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-analytics">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('siteSettings.analytics') : 'Analytics' %>
					</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<div class="row mb-15px">
						<label class="form-label col-form-label col-md-3">
							<%= typeof t !=='undefined' ? t('siteSettings.analyticsScript') : 'Analytics Script' %>
						</label>
						<div class="col-md-9">
							<textarea class="form-control font-monospace" id="analyticsScript" name="analyticsScript"
								rows="8" placeholder="<%= typeof t !== 'undefined' ? t('siteSettings.analyticsScriptPlaceholder') : 'Paste your Google Analytics, Google Tag Manager or other tracking script here (e.g. <script>...</script>)' %>"><%= typeof settings.analyticsScript !== 'undefined' ? (settings.analyticsScript || '') : '' %></textarea>
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.analyticsScriptHelp')
									: 'Script will be injected in the &lt;head&gt; of every page. Include full &lt;script&gt; tags.' %>
							</small>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

		</div>
		<!-- END col-9 -->

		<!-- BEGIN col-3 -->
		<div class="col-xl-3">
			<!-- BEGIN panel - Images -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-6">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('siteSettings.images') : 'Images' %>
					</h4>
					<div class="panel-heading-btn">
						<a href="javascript:;" class="btn btn-xs btn-icon btn-default" data-toggle="panel-expand"><i
								class="fa fa-expand"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-success" data-toggle="panel-reload"><i
								class="fa fa-redo"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-warning" data-toggle="panel-collapse"><i
								class="fa fa-minus"></i></a>
						<a href="javascript:;" class="btn btn-xs btn-icon btn-danger" data-toggle="panel-remove"><i
								class="fa fa-times"></i></a>
					</div>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<!-- Logo -->
					<div class="mb-15px">
						<label class="form-label">
							<%= typeof t !=='undefined' ? t('siteSettings.logo') : 'Logo' %>
						</label>
						<div class="image-upload-container">
							<div class="image-preview" id="logoPreview">
								<img src="<%= settings.logo %>" alt="Logo" class="img-fluid"
									style="max-height: 100px;" />
							</div>
							<input type="file" class="form-control" id="logoFile" name="logoFile" accept="image/*" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.logoHelp')
									: 'Upload your company logo (recommended: 200x100px)' %>
							</small>
							<% if (settings.logo && settings.logo !=='/images/logo.jpg' ) { %>
								<button type="button" class="btn btn-sm btn-danger mt-2 delete-site-image-btn"
									data-image-type="logo">
									<i class="fa fa-trash"></i>
									<%= typeof t !=='undefined' ? t('siteSettings.deleteLogo') : 'Delete Logo' %>
								</button>
								<% } %>
						</div>
					</div>

					<!-- Favicon -->
					<div class="mb-15px">
						<label class="form-label">
							<%= typeof t !=='undefined' ? t('siteSettings.favicon') : 'Favicon' %>
						</label>
						<div class="image-upload-container">
							<div class="image-preview" id="faviconPreview">
								<img src="<%= settings.favicon %>" alt="Favicon" class="img-fluid"
									style="max-height: 32px;" />
							</div>
							<input type="file" class="form-control" id="faviconFile" name="faviconFile"
								accept="image/*" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.faviconHelp')
									: 'Upload your favicon (recommended: 32x32px)' %>
							</small>
							<% if (settings.favicon && settings.favicon !=='/images/favicon.ico' ) { %>
								<button type="button" class="btn btn-sm btn-danger mt-2 delete-site-image-btn"
									data-image-type="favicon">
									<i class="fa fa-trash"></i>
									<%= typeof t !=='undefined' ? t('siteSettings.deleteFavicon') : 'Delete Favicon' %>
								</button>
								<% } %>
						</div>
					</div>

					<!-- Site Image -->
					<div class="mb-15px">
						<label class="form-label">
							<%= typeof t !=='undefined' ? t('siteSettings.siteImage') : 'Site Image' %>
						</label>
						<div class="image-upload-container">
							<div class="image-preview" id="siteImagePreview">
								<% if (settings.siteImage) { %>
									<img src="<%= settings.siteImage %>" alt="Site Image" class="img-fluid"
										style="max-height: 150px;" />
									<% } else { %>
										<div class="placeholder-image">
											<%= typeof t !=='undefined' ? t('siteSettings.noImageUploaded')
												: 'No image uploaded' %>
										</div>
										<% } %>
							</div>
							<input type="file" class="form-control" id="siteImageFile" name="siteImageFile"
								accept="image/*" />
							<small class="fs-12px text-gray-500-darker">
								<%= typeof t !=='undefined' ? t('siteSettings.siteImageHelp')
									: 'Upload a general site image (recommended: 1200x630px)' %>
							</small>
							<% if (settings.siteImage && settings.siteImage !=='/images/site-image.jpg' ) { %>
								<button type="button" class="btn btn-sm btn-danger mt-2 delete-site-image-btn"
									data-image-type="siteImage">
									<i class="fa fa-trash"></i>
									<%= typeof t !=='undefined' ? t('siteSettings.deleteSiteImage')
										: 'Delete Site Image' %>
								</button>
								<% } %>
						</div>
					</div>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->

			<!-- BEGIN panel - Actions -->
			<div class="panel panel-inverse" data-sortable-id="form-stuff-7">
				<!-- BEGIN panel-heading -->
				<div class="panel-heading">
					<h4 class="panel-title">
						<%= typeof t !=='undefined' ? t('siteSettings.actions') : 'Actions' %>
					</h4>
				</div>
				<!-- END panel-heading -->
				<!-- BEGIN panel-body -->
				<div class="panel-body">
					<button type="submit" class="btn btn-primary btn-lg w-100 mb-2">
						<i class="fa fa-save"></i>
						<%= typeof t !=='undefined' ? t('siteSettings.saveAllSettings') : 'Save All Settings' %>
					</button>
					<a href="/admin/dashboard" class="btn btn-default btn-lg w-100">
						<i class="fa fa-arrow-left"></i>
						<%= typeof t !=='undefined' ? t('siteSettings.backToDashboard') : 'Back to Dashboard' %>
					</a>
				</div>
				<!-- END panel-body -->
			</div>
			<!-- END panel -->
		</div>
		<!-- END col-3 -->
	</div>
	<!-- END row -->
</form>