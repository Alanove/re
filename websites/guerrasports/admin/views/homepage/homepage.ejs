<ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="/admin/dashboard"><%= typeof t !== 'undefined' ? t('common.home') : 'Home' %></a></li>
	<li class="breadcrumb-item active"><%= typeof t !== 'undefined' ? t('homepage.title') : 'Homepage' %></li>
</ol>

<form method="POST" action="/admin/homepage" enctype="multipart/form-data">
	<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
	<div class="row">
		<div class="col-xl-9">
			<% if (typeof error !== 'undefined' && error) { %>
				<div class="alert alert-danger"><%= error %></div>
			<% } %>
			<% if (typeof success !== 'undefined' && success) { %>
				<div class="alert alert-success"><%= success %></div>
			<% } %>

			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('homepage.bannerSection') : 'Shop banner' %></h4>
				</div>
				<div class="panel-body">
					<p class="text-muted"><%= typeof t !== 'undefined' ? t('homepage.bannerHelp') : 'The picture under Shop by Category on the home page.' %></p>
					<% if (settings.bannerImage) { %>
						<div class="mb-3">
							<img src="<%= settings.bannerImage %>" alt="" class="img-fluid rounded border" style="max-height: 180px; object-fit: cover;">
							<div class="form-text"><%= typeof t !== 'undefined' ? t('homepage.currentImage') : 'Current image' %></div>
						</div>
					<% } %>
					<div class="mb-3">
						<label for="banner_image" class="form-label"><%= typeof t !== 'undefined' ? t('homepage.bannerImage') : 'Banner image' %></label>
						<input type="file" class="form-control" id="banner_image" name="banner_image" accept="image/*">
						<div class="form-text"><%= typeof t !== 'undefined' ? t('homepage.bannerImageHelp') : 'JPEG, PNG, GIF, or WebP. Max 10MB. Leave empty to keep the current image.' %></div>
					</div>
					<% if (settings.bannerImage && settings.bannerImage !== '/images/Firefly-2.jpg') { %>
						<div class="form-check mb-3">
							<input class="form-check-input" type="checkbox" id="remove_banner_image" name="remove_banner_image" value="1">
							<label class="form-check-label" for="remove_banner_image"><%= typeof t !== 'undefined' ? t('homepage.useDefaultImage') : 'Remove the custom image and use the default' %></label>
						</div>
					<% } %>
					<div class="mb-3">
						<label for="banner_text" class="form-label"><%= typeof t !== 'undefined' ? t('homepage.bannerText') : 'Button text' %></label>
						<input type="text" class="form-control" id="banner_text" name="banner_text" maxlength="255" value="<%= settings.bannerText || '' %>">
					</div>
					<div class="mb-3">
						<label for="banner_link" class="form-label"><%= typeof t !== 'undefined' ? t('homepage.bannerLink') : 'Button link' %></label>
						<input type="text" class="form-control" id="banner_link" name="banner_link" maxlength="500" value="<%= settings.bannerLink || '' %>" placeholder="/products">
						<div class="form-text"><%= typeof t !== 'undefined' ? t('homepage.bannerLinkHelp') : 'A site path such as /products, or a full http(s) URL.' %></div>
					</div>
				</div>
			</div>

			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('homepage.newArrivalsSection') : 'New Arrivals' %></h4>
				</div>
				<div class="panel-body">
					<div class="mb-3">
						<label for="new_arrivals_title" class="form-label"><%= typeof t !== 'undefined' ? t('homepage.newArrivalsTitle') : 'Section title' %></label>
						<input type="text" class="form-control" id="new_arrivals_title" name="new_arrivals_title" maxlength="255" value="<%= settings.newArrivalsTitle || '' %>">
						<div class="form-text"><%= typeof t !== 'undefined' ? t('homepage.newArrivalsTitleHelp') : 'Heading for the featured products on the home page.' %></div>
					</div>
				</div>
			</div>

			<div class="panel panel-inverse">
				<div class="panel-heading">
					<h4 class="panel-title"><%= typeof t !== 'undefined' ? t('homepage.saleSection') : 'Sale' %></h4>
				</div>
				<div class="panel-body">
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" id="sale_enabled" name="sale_enabled" value="1" <%= settings.saleEnabled ? 'checked' : '' %>>
						<label class="form-check-label" for="sale_enabled"><%= typeof t !== 'undefined' ? t('homepage.saleEnabled') : 'Show sale section on the home page' %></label>
						<div class="form-text"><%= typeof t !== 'undefined' ? t('homepage.saleEnabledHelp') : 'When off, the home page block is hidden. /on-sale still lists products that are on sale.' %></div>
					</div>
					<div class="mb-3">
						<label for="sale_title" class="form-label"><%= typeof t !== 'undefined' ? t('homepage.saleTitle') : 'Section title' %></label>
						<input type="text" class="form-control" id="sale_title" name="sale_title" maxlength="255" value="<%= settings.saleTitle || '' %>">
						<div class="form-text"><%= typeof t !== 'undefined' ? t('homepage.saleTitleHelp') : 'Heading for products currently on sale. View All links to /on-sale.' %></div>
					</div>
					<div class="mb-3">
						<label for="sale_meta_title" class="form-label"><%= typeof t !== 'undefined' ? t('homepage.saleMetaTitle') : 'On Sale page title' %></label>
						<input type="text" class="form-control" id="sale_meta_title" name="sale_meta_title" maxlength="255" value="<%= settings.saleMetaTitle || '' %>" placeholder="<%= settings.saleTitle || 'Sale' %>">
						<div class="form-text"><%= typeof t !== 'undefined' ? t('homepage.saleMetaTitleHelp') : 'Browser title for /on-sale. Leave empty to use the section title.' %></div>
					</div>
					<div class="mb-0">
						<label for="sale_meta_description" class="form-label"><%= typeof t !== 'undefined' ? t('homepage.saleMetaDescription') : 'On Sale page description' %></label>
						<textarea class="form-control" id="sale_meta_description" name="sale_meta_description" rows="3" maxlength="500"><%= settings.saleMetaDescription || '' %></textarea>
						<div class="form-text"><%= typeof t !== 'undefined' ? t('homepage.saleMetaDescriptionHelp') : 'Meta description for /on-sale. Leave empty to use the default description.' %></div>
					</div>
				</div>
			</div>

			<div class="mb-4">
				<button type="submit" class="btn btn-primary">
					<i class="fa fa-save me-1"></i> <%= typeof t !== 'undefined' ? t('common.save') : 'Save' %>
				</button>
			</div>
		</div>
	</div>
</form>
