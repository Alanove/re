<%- include('../partials/header') %>

	<!-- BEGIN content area -->
	<div class="row">
		<div class="col-xl-12">
			<div class="panel panel-inverse">
				<div class="panel-heading d-flex justify-content-between align-items-center flex-wrap gap-2">
					<h4 class="panel-title mb-0">
						<%= typeof t !== 'undefined' ? t('newsletter.title') : 'Newsletter Subscribers' %>
					</h4>
					<a href="/admin/newsletter/export-csv" class="btn btn-success btn-sm" download>
						<%= typeof t !== 'undefined' ? t('newsletter.exportToCsv') : 'Export to CSV' %>
					</a>
				</div>
				<div class="panel-body">
					<div class="table-responsive">
						<table class="table table-striped table-bordered align-middle">
							<thead>
								<tr>
									<th width="60">#</th>
									<th>Email</th>
									<th width="180"><%= typeof t !== 'undefined' ? t('common.created') : 'Subscribed' %></th>
								</tr>
							</thead>
							<tbody>
								<% if (typeof subscribers !== 'undefined' && subscribers && subscribers.length > 0) { %>
									<% subscribers.forEach(function(sub, idx) { %>
										<tr>
											<td><%= (typeof page !== 'undefined' && page ? (page - 1) * 20 : 0) + idx + 1 %></td>
											<td><%= sub.email %></td>
											<td><%= sub.created_at %></td>
										</tr>
									<% }); %>
								<% } else { %>
									<tr>
										<td colspan="3" class="text-center text-muted py-4">
											<%= typeof t !== 'undefined' ? t('newsletter.noSubscribers') : 'No subscribers yet.' %>
										</td>
									</tr>
								<% } %>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>

<%- include('../partials/footer') %>
