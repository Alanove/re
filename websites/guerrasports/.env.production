# Server Configuration
# IMPORTANT: Set this in your production environment
PORT=3007

# HTTPS (production): set USE_HTTPS=true and paths to PEM key/cert to run over HTTPS.
# USE_HTTPS=false
# HTTPS_KEY_PATH=cert/key.pem
# HTTPS_CERT_PATH=cert/cert.pem

# Session Configuration
# IMPORTANT: Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters long
