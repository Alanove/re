{
  "name": "lw-njs-cms",
  "version": "1.0.0",
  "description": "TypeScript Node.js CMS Project",
  "main": "dist/src/app.js",
  "scripts": {
    "build": "tsc && npm run js:minify",
    "start": "node dist/src/app.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:debug": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only --inspect=9229 src/app.ts",
    "dev:debug-brk": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only --inspect-brk=9299 ./src/app.ts",
    "start:test": "cross-env NODE_ENV=testing ts-node-dev --respawn --transpile-only src/app.ts",
    "start:prod": "cross-env NODE_ENV=production node dist/src/app.js",
    "start:debug": "node --inspect dist/src/app.js",
    "scss": "sass public/css/styles.scss public/css/styles.css --style=compressed --watch --no-source-map",
    "scss:once": "sass public/css/styles.scss public/css/styles.css --style=compressed --no-source-map",
    "scss-dev": "sass public/css/styles.scss public/css/styles.css --style=expanded --watch",
    "scss-admin": "sass admin/public/css/admin.scss admin/public/css/admin.css --style=compressed --watch --no-source-map",
    "scss-admin-dev": "sass admin/public/css/admin.scss admin/public/css/admin.css --style=expanded --watch",
    "scss-all": "npm run scss && npm run scss-admin",
    "scss-all-dev": "npm run scss-dev && npm run scss-admin-dev",
    "js:minify": "terser public/js/app.js -c passes=2 -m -o public/js/app.min.js --comments false",
    "prestart:prod": "npm run js:minify",
    "clean": "node scripts/clean.js",
    "prebuild": "npm run clean",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "install:playwright": "playwright install",
    "generate-test-images": "node scripts/generate-test-images.js",
    "cert:dev": "node scripts/generate-dev-cert.js",
    "clients:ocr": "node scripts/clients-ocr.js",
    "import-apartments": "ts-node admin/scripts/import-apartments-csv.ts",
    "fix-variants": "ts-node scripts/fix_missing_variants.ts",
    "stock:100": "ts-node scripts/set-stock-100.ts",
    "clean:carts": "ts-node scripts/clean-old-carts.ts",
    "clean:carts:dry": "ts-node scripts/clean-old-carts.ts --dry-run",
    "clean:page-photos": "ts-node scripts/clean-orphan-page-photos.ts",
    "clean:page-photos:fix": "ts-node scripts/clean-orphan-page-photos.ts --fix",
    "clean:page-photos:dry": "ts-node scripts/clean-orphan-page-photos.ts --fix --dry-run",
    "clean:page-photos:prod": "cross-env NODE_ENV=production ts-node scripts/clean-orphan-page-photos.ts",
    "clean:page-photos:fix:prod": "cross-env NODE_ENV=production ts-node scripts/clean-orphan-page-photos.ts --fix",
    "clean:order-shipments": "ts-node scripts/clean-order-shipments.ts",
    "clean:order-shipments:dry": "ts-node scripts/clean-order-shipments.ts --dry-run",
    "thumbs:regenerate": "ts-node scripts/regenerate-image-thumbs.ts",
    "thumbs:regenerate:dry": "ts-node scripts/regenerate-image-thumbs.ts --dry-run",
    "thumbs:regenerate:production": "cross-env NODE_ENV=production ts-node scripts/regenerate-image-thumbs.ts",
    "thumbs:regenerate:production:dry": "cross-env NODE_ENV=production ts-node scripts/regenerate-image-thumbs.ts --dry-run",
    "generate:images:production": "ts-node scripts/generate-images-production.ts",
    "generate:images:production:dry": "ts-node scripts/generate-images-production.ts --dry-run",
    "clean:packages": "npm prune",
    "clean:packages:full": "rimraf node_modules && npm install",
    "import-1": "ts-node data-migration/2025-02-01-simple-import-pages.ts",
    "migrate": "ts-node data-migration/run-migrations.ts run",
    "migrate:production": "cross-env NODE_ENV=production ts-node data-migration/run-migrations.ts run",
    "migrate:production:built": "cross-env NODE_ENV=production node dist/data-migration/run-migrations.js run",
    "migrate:status": "ts-node data-migration/run-migrations.ts status",
    "migrate:status:production": "cross-env NODE_ENV=production ts-node data-migration/run-migrations.ts status",
    "migrate:status:production:built": "cross-env NODE_ENV=production node dist/data-migration/run-migrations.js status",
    "migrate:mark-applied": "ts-node data-migration/run-migrations.ts mark-applied",
    "migrate:mark-applied:production": "cross-env NODE_ENV=production ts-node data-migration/run-migrations.ts mark-applied",
    "migrate:check": "ts-node data-migration/check-and-mark-migrations.ts",
    "migrate:ecommerce": "ts-node data-migration/2025-01-15-ecommerce-schema.ts",
    "migrate:variant-values": "ts-node data-migration/2026-01-07-enhance-variant-values.ts",
    "migrate:brands": "ts-node data-migration/2026-01-08-create-brands-table.ts",
    "migrate:performance": "ts-node data-migration/2026-01-28-performance-indexes.ts",
    "migrate:performance:prod": "cross-env NODE_ENV=production ts-node data-migration/2026-01-28-performance-indexes.ts",
    "migrate:thumb-columns:production": "cross-env NODE_ENV=production ts-node data-migration/2026-03-21-add-image-thumb-url-columns.ts",
    "migrate:page-photos-thumb": "ts-node data-migration/2026-03-22-add-page-photos-thumb-url.ts",
    "migrate:page-photos-thumb:production": "cross-env NODE_ENV=production ts-node data-migration/2026-03-22-add-page-photos-thumb-url.ts",
    "migrate:pages-page-image-thumb": "ts-node data-migration/2026-03-23-add-pages-page-image-thumb.ts",
    "migrate:pages-page-image-thumb:production": "cross-env NODE_ENV=production ts-node data-migration/2026-03-23-add-pages-page-image-thumb.ts",
    "migrate:include-in-auto-ads:production": "cross-env NODE_ENV=production ts-node data-migration/2026-06-14-add-include-in-auto-ads-to-products.ts",
    "migrate:product-images": "ts-node data-migration/2026-07-02-migrate-product-images-to-folders.ts",
    "migrate:product-images:production": "cross-env NODE_ENV=production ts-node data-migration/2026-07-02-migrate-product-images-to-folders.ts",
    "migrate:product-images:production:built": "cross-env NODE_ENV=production node dist/data-migration/2026-07-02-migrate-product-images-to-folders.js",
    "init:payment-methods": "ts-node data-migration/2025-01-15-init-payment-methods.ts",
    "seed:ecommerce": "ts-node tests/seed-ecommerce-test-data.ts",
    "seed:ecommerce-full": "ts-node tests/seed-comprehensive-ecommerce-data.ts",
    "seed:brands": "ts-node scripts/seed-test-brands.ts",
    "brands:ocr": "ts-node scripts/brands-ocr.ts",
    "add-brands-from-folder": "ts-node scripts/add-brands-from-folder.ts",
    "add-brands-from-folder:prod": "cross-env NODE_ENV=production ts-node scripts/add-brands-from-folder.ts",
    "test:email": "ts-node tests/test-email.ts",
    "test:email:prod": "cross-env NODE_ENV=production ts-node tests/test-email.ts",
    "prebuild:migrate": "npm run migrate && npm run migrate:variant-values && npm run migrate:brands && npm run migrate:performance",
    "prebuild:seed": "npm run seed:ecommerce",
    "postbuild:test": "npm run test",
    "build:full": "npm run prebuild:migrate && npm run build && npm run postbuild:test",
    "aramex:fetch-countries": "ts-node scripts/aramex-fetch-countries.ts",
    "aramex:test:countries": "ts-node src/aramex/tests/test-fetch-countries.ts",
    "aramex:test:states": "ts-node src/aramex/tests/test-fetch-states.ts",
    "aramex:test:cities": "ts-node src/aramex/tests/test-fetch-cities.ts",
    "aramex:test:cities-us": "ts-node src/aramex/tests/test-fetch-cities-us.ts",
    "aramex:test:rate": "ts-node src/aramex/tests/test-calculate-rate.ts",
    "aramex:test:rate-international": "ts-node src/aramex/tests/test-calculate-rate-international.ts",
    "aramex:test:create-shipment": "ts-node src/aramex/tests/test-create-shipment.ts",
    "aramex:test:track": "ts-node src/aramex/tests/test-track-shipment.ts",
    "aramex:test:create-pickup": "ts-node src/aramex/tests/test-create-pickup.ts",
    "aramex:test:all": "npm run aramex:test:countries && npm run aramex:test:states && npm run aramex:test:cities && npm run aramex:test:rate"
  },
  "dependencies": {
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.13.5",
    "bcrypt": "^5.1.1",
    "csurf": "^1.11.0",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.4.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^5.3.5",
    "helmet": "^7.1.0",
    "mammoth": "^1.9.1",
    "multer": "^2.0.1",
    "mysql2": "^3.15.1",
    "nodemailer": "^6.9.0",
    "officegen": "^0.6.5",
    "pptx2json": "^0.0.10",
    "sharp": "^0.33.0",
    "soap": "^1.0.0",
    "tesseract.js": "^5.0.0-alpha.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cheerio": "^1.0.0",
    "@types/express": "^4.17.21",
    "@types/express-mysql-session": "^3.0.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.21",
    "cheerio": "^1.1.2",
    "cross-env": "^7.0.3",
    "fs-extra": "^11.3.2",
    "rimraf": "^5.0.0",
    "sass": "^1.93.2",
    "selfsigned": "^2.4.1",
    "terser": "^5.46.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "cms",
    "typescript",
    "nodejs",
    "express"
  ],
  "author": "CMS Project",
  "license": "MIT"
}
