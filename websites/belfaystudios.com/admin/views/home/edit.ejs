<%
	const s = section;
	const val = function (v) { return v === undefined || v === null ? '' : v; };
	const fieldClass = function (name) { return errors[name] ? 'form-control is-invalid' : 'form-control'; };
	const hasIntro = ['services', 'latestPosts', 'contact'].indexOf(sectionKey) !== -1;
	const hasRichText = ['about', 'studios', 'team'].indexOf(sectionKey) !== -1;
	const serviceItems = s.items || [];
	const members = s.members || [];
	const slogans = (s.slogans || []).join('\n');
%>
<form method="POST" action="/admin/home/<%= sectionKey %>/edit?_csrf=<%= encodeURIComponent(csrfToken) %>" enctype="multipart/form-data" novalidate>
	<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
	<input type="hidden" name="key" value="home" />
	<div class="row">
		<div class="col-xl-8">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title"><%= sectionLabel %></h4></div>
				<div class="panel-body">
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" id="enabled" name="enabled" value="1" <%= s.enabled ? 'checked' : '' %> />
						<label class="form-check-label" for="enabled">Show this section on the home page</label>
					</div>

					<% if (sectionKey === 'hero') { %>
						<div class="mb-3">
							<label class="form-label" for="eyebrow">Small line above the slogans</label>
							<input type="text" class="<%= fieldClass('eyebrow') %>" id="eyebrow" name="eyebrow" value="<%= val(s.eyebrow) %>" maxlength="120" placeholder="Arabic dubbing &amp; voice over studios" />
							<%- include('../partials/field-error', { name: 'eyebrow' }) %>
						</div>
						<div class="mb-3">
							<label class="form-label" for="slogans">Slogans</label>
							<textarea class="<%= fieldClass('slogans') %>" id="slogans" name="slogans" rows="7" maxlength="2000"><%= slogans %></textarea>
							<small class="text-muted">One slogan per line, up to <%= slogansMax %>. They fade in one after another. The first one is the page heading for search engines.</small>
							<%- include('../partials/field-error', { name: 'slogans' }) %>
						</div>
						<div class="row g-2 mb-3">
							<div class="col-md-6"><label class="form-label" for="primaryLabel">Main button label</label><input type="text" class="<%= fieldClass('primaryLabel') %>" id="primaryLabel" name="primaryLabel" value="<%= val(s.primaryCta && s.primaryCta.label) %>" maxlength="80" /></div>
							<div class="col-md-6"><label class="form-label" for="primaryUrl">Main button link</label><input type="text" class="<%= fieldClass('primaryUrl') %>" id="primaryUrl" name="primaryUrl" value="<%= val(s.primaryCta && s.primaryCta.url) %>" placeholder="/#OurServices" /><%- include('../partials/field-error', { name: 'primaryUrl' }) %></div>
							<div class="col-md-6"><label class="form-label" for="secondaryLabel">Second button label</label><input type="text" class="<%= fieldClass('secondaryLabel') %>" id="secondaryLabel" name="secondaryLabel" value="<%= val(s.secondaryCta && s.secondaryCta.label) %>" maxlength="80" /></div>
							<div class="col-md-6"><label class="form-label" for="secondaryUrl">Second button link</label><input type="text" class="<%= fieldClass('secondaryUrl') %>" id="secondaryUrl" name="secondaryUrl" value="<%= val(s.secondaryCta && s.secondaryCta.url) %>" placeholder="/#ContactUs" /><%- include('../partials/field-error', { name: 'secondaryUrl' }) %></div>
						</div>
					<% } else { %>
						<div class="mb-3">
							<label class="form-label" for="title">Heading <span class="text-danger">*</span></label>
							<input type="text" class="<%= fieldClass('title') %>" id="title" name="title" value="<%= val(s.title) %>" maxlength="120" required />
							<%- include('../partials/field-error', { name: 'title' }) %>
						</div>
					<% } %>

					<% if (hasIntro) { %>
						<div class="mb-3">
							<label class="form-label" for="intro">Introduction</label>
							<textarea class="<%= fieldClass('intro') %>" id="intro" name="intro" rows="3" maxlength="400"><%= val(s.intro) %></textarea>
							<%- include('../partials/field-error', { name: 'intro' }) %>
						</div>
					<% } %>

					<% if (hasRichText) { %>
						<div class="mb-3">
							<label class="form-label" for="content">Text</label>
							<textarea class="form-control rich-text" id="content" name="content" rows="10" data-editor-height="340px"><%= val(s.content) %></textarea>
							<%- include('../partials/field-error', { name: 'content' }) %>
						</div>
					<% } %>

					<% if (sectionKey === 'about') { %>
						<div class="mb-3">
							<label class="form-label" for="highlight">Highlight line</label>
							<input type="text" class="<%= fieldClass('highlight') %>" id="highlight" name="highlight" value="<%= val(s.highlight) %>" maxlength="160" placeholder="We are Dubbing Masters." />
							<%- include('../partials/field-error', { name: 'highlight' }) %>
						</div>
						<div class="row g-2 mb-3">
							<div class="col-md-4">
								<label class="form-label" for="statValue">Highlight number</label>
								<input type="text" class="<%= fieldClass('statValue') %>" id="statValue" name="statValue" value="<%= val(s.statValue) %>" placeholder="25+" maxlength="20" />
							</div>
							<div class="col-md-8">
								<label class="form-label" for="statLabel">Highlight number label</label>
								<input type="text" class="<%= fieldClass('statLabel') %>" id="statLabel" name="statLabel" value="<%= val(s.statLabel) %>" placeholder="years of Arabic dubbing" maxlength="60" />
							</div>
						</div>
					<% } %>

					<% if (sectionKey === 'studios') { %>
						<div class="mb-3">
							<label class="form-label" for="quote">Quote</label>
							<input type="text" class="<%= fieldClass('quote') %>" id="quote" name="quote" value="<%= val(s.quote) %>" maxlength="200" placeholder="We can discuss budget but not quality." />
							<%- include('../partials/field-error', { name: 'quote' }) %>
						</div>
					<% } %>

					<% if (sectionKey === 'latestPosts') { %>
						<div class="mb-3" style="max-width:220px">
							<label class="form-label" for="limit">Posts to show</label>
							<input type="number" class="<%= fieldClass('limit') %>" id="limit" name="limit" value="<%= val(s.limit) %>" min="1" max="<%= latestPostsMax %>" />
							<%- include('../partials/field-error', { name: 'limit' }) %>
						</div>
						<p class="text-muted small">The newest published posts under the blog page are shown. Write posts under <a href="/admin/pages">Pages &amp; Blog</a>.</p>
					<% } %>

					<% if (sectionKey === 'services') { %>
						<h5 class="mt-4">Services</h5>
						<p class="text-muted small">Up to <%= servicesMax %>. Icons use <a href="https://fonts.google.com/icons" target="_blank" rel="noopener">Material Symbols</a> names such as <code>mic</code> or <code>subtitles</code>.</p>
						<div data-repeater data-max="<%= servicesMax %>" data-repeater-name="items">
							<div data-repeater-list>
								<% serviceItems.forEach(function (item, i) { %>
									<%- include('service-row', { item: item, i: i }) %>
								<% }) %>
							</div>
							<template data-repeater-template><%- include('service-row', { item: { title: '', text: '', icon: '' }, i: 99 }) %></template>
							<button type="button" class="btn btn-default btn-sm" data-repeater-add><i class="fa fa-plus me-1" aria-hidden="true"></i> Add service</button>
						</div>
					<% } %>

					<% if (sectionKey === 'team') { %>
						<h5 class="mt-4">Team members</h5>
						<p class="text-muted small">Up to <%= teamMax %>. The bio appears over the photo on hover, keyboard focus or tap. Use the arrows to change the order.</p>
						<div data-repeater data-max="<%= teamMax %>" data-repeater-name="members">
							<div data-repeater-list>
								<% members.forEach(function (member, i) { %>
									<%- include('team-member-row', { member: member, i: i }) %>
								<% }) %>
							</div>
							<template data-repeater-template><%- include('team-member-row', { member: { name: '', role: '', photo: '', bio: '' }, i: 99 }) %></template>
							<button type="button" class="btn btn-default btn-sm" data-repeater-add><i class="fa fa-plus me-1" aria-hidden="true"></i> Add member</button>
							<span class="text-muted small ms-2" data-repeater-count></span>
						</div>
					<% } %>
				</div>
			</div>
		</div>

		<div class="col-xl-4">
			<div class="panel panel-inverse admin-sticky">
				<div class="panel-heading"><h4 class="panel-title">Save</h4></div>
				<div class="panel-body">
					<% if (sectionImage) { %>
						<label class="form-label" for="imageFile"><%= sectionImage.label %></label>
						<%- include('../partials/media-picker', { id: 'imageFile', field: 'imageFile', kind: 'image', current: s.image || '', valueName: 'image', label: 'background image', hint: sectionImage.hint }) %>
						<%- include('../partials/field-error', { name: 'image' }) %>
						<div class="mb-3"></div>
					<% } %>
					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-success flex-fill"><i class="fa fa-save me-1"></i> Save section</button>
						<a href="/admin/home" class="btn btn-default">Back</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
