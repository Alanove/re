<% if (blogRoot) { %>
<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">Blog page</h4>
	</div>
	<div class="panel-body p-0">
		<table class="table align-middle mb-0">
			<tbody>
				<tr>
					<td style="width:56px">
						<% if (blogRoot.heroImage) { %>
							<img src="<%= thumbUrl(blogRoot.heroImage) %>" alt="" class="rounded admin-thumb" loading="lazy" data-fallback-src="<%= blogRoot.heroImage %>" />
						<% } else { %>
							<div class="admin-thumb admin-thumb-empty rounded"><i class="fa fa-image text-muted"></i></div>
						<% } %>
					</td>
					<td>
						<a href="/admin/blog/<%= blogRoot.id %>/edit" class="fw-bold"><%= blogRoot.title %></a>
						<div class="small text-muted">Lists the posts below, newest first. This page cannot be deleted.</div>
					</td>
					<td><a href="<%= blogRoot.url %>" target="_blank" rel="noopener" class="small"><%= blogRoot.url %></a></td>
					<td>
						<% if (blogRoot.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %>
					</td>
					<td class="text-nowrap" style="width:1%">
						<a href="/admin/blog/<%= blogRoot.id %>/edit" class="btn btn-sm btn-primary" title="Edit blog page"><i class="fa fa-edit"></i></a>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>

<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title">Posts</h4>
		<div class="panel-heading-btn">
			<a href="/admin/blog/create" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add post</a>
		</div>
	</div>
	<div class="panel-body">
		<div class="row g-2 mb-3">
			<div class="col-md-6">
				<div class="input-group">
					<span class="input-group-text"><i class="fa fa-search"></i></span>
					<input type="search" class="form-control" placeholder="Filter by title or URL" data-table-filter="#posts-table" aria-label="Filter posts" />
				</div>
			</div>
		</div>
		<div class="table-responsive">
			<table class="table table-striped table-bordered align-middle" id="posts-table">
				<thead>
					<tr>
						<th style="width:56px">Image</th>
						<th>Title</th>
						<th>URL</th>
						<th>Status</th>
						<th class="text-center">Gallery</th>
						<th>Created</th>
						<th style="width:1%">Actions</th>
					</tr>
				</thead>
				<tbody>
					<% posts.forEach(function (post) { %>
						<tr data-filter-text="<%= (post.title + ' ' + post.url).toLowerCase() %>">
							<td>
								<% if (post.heroImage) { %>
									<img src="<%= thumbUrl(post.heroImage) %>" alt="" class="rounded admin-thumb" loading="lazy" data-fallback-src="<%= post.heroImage %>" />
								<% } else { %>
									<div class="admin-thumb admin-thumb-empty rounded"><i class="fa fa-image text-muted"></i></div>
								<% } %>
							</td>
							<td><a href="/admin/blog/<%= post.id %>/edit" class="fw-bold"><%= post.title %></a></td>
							<td><a href="<%= post.url %>" target="_blank" rel="noopener" class="small"><%= post.url %></a></td>
							<td>
								<% if (post.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %>
							</td>
							<td class="text-center"><%= post.imageCount %></td>
							<td class="text-nowrap small"><%= new Date(post.createdAt).toLocaleDateString('en-GB') %></td>
							<td class="text-nowrap">
								<a href="/admin/blog/<%= post.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
								<button type="button" class="btn btn-sm btn-danger" title="Delete"
									data-delete-url="/admin/pages/<%= post.id %>"
									data-delete-title="Delete post"
									data-delete-message="Delete “<%= post.title %>” and its gallery?">
									<i class="fa fa-trash"></i>
								</button>
							</td>
						</tr>
					<% }) %>
					<% if (posts.length === 0) { %>
						<tr><td colspan="7" class="text-center text-muted py-4">No posts yet. <a href="/admin/blog/create">Write the first post</a>.</td></tr>
					<% } %>
				</tbody>
			</table>
		</div>
	</div>
</div>
<% } else { %>
<div class="panel panel-inverse">
	<div class="panel-heading"><h4 class="panel-title">Blog</h4></div>
	<div class="panel-body text-muted">This site has no blog page, so posts cannot be written yet.</div>
</div>
<% } %>
