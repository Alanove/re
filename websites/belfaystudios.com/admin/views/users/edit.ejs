<%
	const action = isCreate ? '/admin/users/create' : '/admin/users/' + user.id + '/edit';
	const fieldClass = function (name) { return errors[name] ? 'form-control is-invalid' : 'form-control'; };
%>
<form method="POST" action="<%= action %>" novalidate autocomplete="off">
	<input type="hidden" name="_csrf" value="<%= csrfToken %>" />
	<div class="row">
		<div class="col-xl-8">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Account</h4></div>
				<div class="panel-body">
					<div class="row g-3">
						<div class="col-md-6">
							<label class="form-label" for="name">Name <span class="text-danger">*</span></label>
							<input type="text" class="<%= fieldClass('name') %>" id="name" name="name" value="<%= user.name %>" required />
							<%- include('../partials/field-error', { name: 'name' }) %>
						</div>
						<div class="col-md-6">
							<label class="form-label" for="email">Email <span class="text-danger">*</span></label>
							<input type="email" class="<%= fieldClass('email') %>" id="email" name="email" value="<%= user.email %>" required autocomplete="off" />
							<%- include('../partials/field-error', { name: 'email' }) %>
						</div>
						<div class="col-md-6">
							<label class="form-label" for="password"><%= isCreate ? 'Password' : 'New password' %><% if (isCreate) { %> <span class="text-danger">*</span><% } %></label>
							<input type="password" class="<%= fieldClass('password') %>" id="password" name="password" autocomplete="new-password" <%= isCreate ? 'required' : '' %> />
							<small class="text-muted">At least 12 characters with upper and lower case letters and a number.<% if (!isCreate) { %> Leave empty to keep the current password.<% } %></small>
							<%- include('../partials/field-error', { name: 'password' }) %>
						</div>
						<div class="col-md-6">
							<label class="form-label" for="confirmPassword">Confirm password</label>
							<input type="password" class="<%= fieldClass('confirmPassword') %>" id="confirmPassword" name="confirmPassword" autocomplete="new-password" />
							<%- include('../partials/field-error', { name: 'confirmPassword' }) %>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-xl-4">
			<div class="panel panel-inverse">
				<div class="panel-heading"><h4 class="panel-title">Access</h4></div>
				<div class="panel-body">
					<div class="mb-3">
						<label class="form-label" for="role">Role</label>
						<select class="form-select" id="role" name="role">
							<option value="editor" <%= user.role === 'editor' ? 'selected' : '' %>>Editor — content only</option>
							<option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Administrator — content, users and settings</option>
						</select>
						<%- include('../partials/field-error', { name: 'role' }) %>
					</div>
					<div class="form-check form-switch mb-3">
						<input class="form-check-input" type="checkbox" id="active" name="active" value="1" <%= user.active ? 'checked' : '' %> />
						<label class="form-check-label" for="active">Account active</label>
					</div>
					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-success flex-fill"><i class="fa fa-save me-1"></i> <%= isCreate ? 'Create user' : 'Save user' %></button>
						<a href="/admin/users" class="btn btn-default">Cancel</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</form>
