<%
	const telHref = function (value) { return 'tel:' + String(value || '').replace(/[^+\d]/g, ''); };
	const mapSrc = function (office) { return office.mapQuery ? 'https://www.google.com/maps?q=' + encodeURIComponent(office.mapQuery) + '&output=embed' : ''; };
	const firstMapped = offices.find(function (office) { return office.mapQuery; }) || offices[0];
	const activeId = firstMapped ? firstMapped.id : '';
%>
<%- include('partials/page-hero') %>
<section class="contact-page">
	<div class="container contact-page__grid">
		<div class="contact-page__form">
			<div class="form-panel form-panel--elevated">
				<p class="contact-page__eyebrow">Send us a request</p>
				<h2 class="form-panel__title">How can we help?</h2>
				<p class="form-panel__intro">Share your project, timing and languages, or apply as a voice talent.</p>
				<%- include('partials/contact-form') %>
			</div>
		</div>

		<% if (offices.length) { %>
			<aside class="contact-page__offices" aria-labelledby="offices-title">
				<div class="contact-map" data-contact-map>
					<div class="contact-map__head">
						<p class="contact-page__eyebrow">Our offices</p>
						<h2 class="contact-map__title" id="offices-title">Find us</h2>
					</div>
					<div class="contact-map__tabs" role="tablist" aria-label="Offices"<%- offices.length < 2 ? ' hidden' : '' %>>
						<% offices.forEach(function (office) { const selected = office.id === activeId; %>
							<button class="contact-map__tab<%= selected ? ' is-active' : '' %>" type="button" role="tab" id="office-tab-<%= office.id %>" aria-controls="office-panel-<%= office.id %>" aria-selected="<%= selected %>" tabindex="<%= selected ? '0' : '-1' %>" data-map-src="<%= mapSrc(office) %>"><%= office.country %></button>
						<% }) %>
					</div>
					<div class="contact-map__frame"<%- firstMapped && firstMapped.mapQuery ? '' : ' hidden' %> data-map-frame>
						<iframe src="<%= firstMapped ? mapSrc(firstMapped) : '' %>" title="Map of <%= settings.siteName %> offices" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen data-map-iframe></iframe>
					</div>
					<% offices.forEach(function (office) { const selected = office.id === activeId; %>
						<div class="contact-map__panel" role="tabpanel" id="office-panel-<%= office.id %>" aria-labelledby="office-tab-<%= office.id %>"<%- selected ? '' : ' hidden' %>>
							<p class="contact-map__office">
								<span class="material-symbols-outlined" aria-hidden="true">location_on</span>
								<span><strong><%= office.country %></strong><% if (office.role) { %> · <%= office.role %><% } %></span>
							</p>
							<ul class="contact-map__lines">
								<% if (office.address) { %><li><span class="material-symbols-outlined" aria-hidden="true">home_pin</span><%= office.address %></li><% } %>
								<% if (office.poBox) { %><li><span class="material-symbols-outlined" aria-hidden="true">markunread_mailbox</span>P.O. Box <%= office.poBox %></li><% } %>
								<% office.phones.forEach(function (phone) { %>
									<li><span class="material-symbols-outlined" aria-hidden="true">call</span><a href="<%= telHref(phone) %>"><%= phone %></a></li>
								<% }) %>
								<% if (office.fax) { %><li><span class="material-symbols-outlined" aria-hidden="true">fax</span><%= office.fax %></li><% } %>
								<% office.emails.forEach(function (email) { %>
									<li><span class="material-symbols-outlined" aria-hidden="true">mail</span><a href="mailto:<%= email %>"><%= email %></a></li>
								<% }) %>
							</ul>
							<% if (office.mapQuery) { %>
								<a class="contact-map__directions" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(office.mapQuery) %>" target="_blank" rel="noopener noreferrer">
									Open in Google Maps <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
								</a>
							<% } %>
						</div>
					<% }) %>
				</div>
			</aside>
		<% } %>
	</div>
</section>
