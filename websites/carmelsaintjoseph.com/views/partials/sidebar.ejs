<%
	const sidebarItems = Array.isArray(locals.sideItems)
		? locals.sideItems
		: (locals.sectionRoot && locals.sectionRoot.children ? locals.sectionRoot.children : []);
	const sidebarTitle = typeof locals.sideTitle === 'string'
		? locals.sideTitle
		: (locals.sectionRoot ? locals.sectionRoot.title : '');
%>
<% if (sidebarItems && sidebarItems.length) { %>
	<div class="content-text sideMenu">
		<% if (sidebarTitle) { %><h3 class="sideMenuTitle"><%= sidebarTitle %></h3><% } %>
		<div class="sideMenuList">
			<%- include('sidebar-items', { items: sidebarItems, currentUrl: page && page.url ? page.url : '', root: true }) %>
		</div>
	</div>
<% } %>
<%- include('pronote') %>
<%- include('marquee') %>
