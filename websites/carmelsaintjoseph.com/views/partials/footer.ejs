<footer>
	<div class="footer">
		<div class="container">
			<div class="row">
				<div class="col-lg-4 mb-5 mb-lg-0">
					<h4>Se Connecter A PRONOTE</h4>
					<div class="d-flex flex-row">
						<div class="mr-3">
							<a href="https://pronote.carmelsaintjoseph.edu.lb/parent.html" target="_blank" rel="noopener" title="Pronote Espace Parents">
								<img src="/uploads/legacy/site/pronote-parents.webp" class="img-fluid" alt="Pronote Espace Parents" width="120" height="80" />
							</a>
						</div>
						<div>
							<a href="https://pronote.carmelsaintjoseph.edu.lb/eleve.html" target="_blank" rel="noopener" title="Pronote Espace Eleves">
								<img src="/uploads/legacy/site/pronote-eleves.webp" class="img-fluid" alt="Pronote Espace Eleves" width="120" height="80" />
							</a>
						</div>
					</div>
				</div>
				<div class="col-lg-4 mb-5 mb-lg-0">
					<h4>Informations De Contact</h4>
					<% if (primaryOffice) { %>
						<ul class="fa-ul mb-0">
							<li><span class="fa-li"><i class="fal fa-map-marker-alt"></i></span>
								<% if (primaryOffice.mapQuery) { %>
									<a target="_blank" rel="noopener" href="https://www.google.com/maps/dir/Current+Location/<%= encodeURIComponent(primaryOffice.mapQuery) %>"><b>Carmel Saint Joseph</b> Mechref - Damour</a>
								<% } else { %>
									<%= primaryOffice.address %>
								<% } %>
							</li>
							<% primaryOffice.phones.forEach(function (phone) { %>
								<li><span class="fa-li"><i class="fal fa-phone"></i></span><a href="tel:<%= phone.replace(/\s+/g, '') %>"><%= phone %></a></li>
							<% }) %>
							<% if (primaryOffice.fax) { %>
								<li><span class="fa-li"><i class="fal fa-fax"></i></span><%= primaryOffice.fax %></li>
							<% } %>
						</ul>
					<% } %>
				</div>
				<div class="col-lg-4">
					<h4>Lien Google</h4>
					<% if (primaryOffice && primaryOffice.mapQuery) { %>
						<iframe
							title="Carte Carmel Saint Joseph"
							src="https://www.google.com/maps?q=<%= encodeURIComponent(primaryOffice.mapQuery) %>&output=embed"
							style="border:0;width:100%;height:200px"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
					<% } %>
				</div>
			</div>
		</div>
	</div>
	<div class="copyright">
		<div class="container">
			<p class="mb-0">
				Copyright &copy; <%= year %> <%= settings.copyright || settings.siteName %>
				<a href="/site-map" class="float-right">Site Map</a>
			</p>
		</div>
	</div>
</footer>
<a id="back-to-top" href="#" class="btn btn-primary back-to-top" role="button" title="Haut de page">
	<span class="far fa-arrow-up"></span>
</a>
