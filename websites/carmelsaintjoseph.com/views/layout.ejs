<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
	<title><%= seo.title %></title>
	<meta name="description" content="<%= seo.description %>" />
	<% if (seo.keywords) { %><meta name="keywords" content="<%= seo.keywords %>" /><% } %>
	<link rel="canonical" href="<%= seo.canonical %>" />
	<meta property="og:title" content="<%= seo.title %>" />
	<meta property="og:description" content="<%= seo.description %>" />
	<meta property="og:url" content="<%= seo.canonical %>" />
	<meta property="og:type" content="<%= seo.type || 'website' %>" />
	<meta property="og:site_name" content="<%= settings.siteName %>" />
	<% if (seo.image) { %><meta property="og:image" content="<%= absoluteUrl(seo.image) %>" /><% } %>
	<% if (settings.favicon) { %><link rel="icon" href="<%= settings.favicon %>" /><% } %>
	<link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
	<link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700&display=swap" rel="stylesheet" />
	<link href="/plugins/fontawesome-pro-5.6.3-web/css/all.min.css" rel="stylesheet" />
	<% if (typeof bodyClass !== 'undefined' && bodyClass === 'home') { %>
		<link href="/plugins/revolution-slider/revolution/css/settings.min.css" rel="stylesheet" />
		<link href="/plugins/revolution-slider/revolution/css/layers.min.css" rel="stylesheet" />
		<link href="/plugins/revolution-slider/revolution/css/navigation.min.css" rel="stylesheet" />
	<% } %>
	<link rel="stylesheet" href="/plugins/cube-portfolio/cubeportfolio/css/cubeportfolio.min.css" />
	<link rel="stylesheet" href="/skins/site.min.css" />
	<link rel="stylesheet" href="/css/adjust.css" />
	<link rel="stylesheet" href="/admin/editor/rte-content.css" />
	<link rel="stylesheet" href="/captcha/captcha.css" />
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
	<div class="wrapper">
		<%- include('partials/header') %>
		<div class="contentHolder">
			<%- body %>
			<%- include('partials/footer') %>
		</div>
	</div>
	<script src="/plugins/jquery/jquery.min.js"></script>
	<script src="/plugins/bootstrap-4.1.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="/plugins/modernizr/modernizr.min.js"></script>
	<script src="/plugins/cube-portfolio/cubeportfolio/js/jquery.cubeportfolio.min.js"></script>
	<% if (typeof bodyClass !== 'undefined' && bodyClass === 'home') { %>
		<script src="/plugins/revolution-slider/revolution/js/jquery.themepunch.tools.min.js"></script>
		<script src="/plugins/revolution-slider/revolution/js/jquery.themepunch.revolution.min.js"></script>
	<% } %>
	<script src="/js/legacy-shim.js"></script>
	<script src="/js/site.js"></script>
	<script src="/js/carmel.js"></script>
	<script src="/captcha/captcha.js" defer></script>
</body>
</html>
