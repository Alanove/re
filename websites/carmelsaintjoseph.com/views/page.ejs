<% if (page.heroImage) { %>
	<div class="header-img">
		<div class="imgHeader" style="background-image: url('<%= page.heroImage %>')"></div>
	</div>
<% } %>
<div id="content">
	<div class="container">
		<div class="row">
			<div class="col-lg-8">
				<div class="content-text">
					<div class="title"><h1><%= page.header || page.title %></h1></div>
					<div class="text rte-content">
						<%- page.content %>
						<% if (page.key === 'site-map') { %>
							<%- include('partials/site-map', { nodes: typeof sitemapTree !== 'undefined' ? sitemapTree : [], nested: false }) %>
						<% } %>
						<% if (gallery && gallery.length) { %>
							<div class="galleryContainer mt-4">
								<div id="grid-container" class="cbp-l-grid-masonry-projects">
									<% gallery.forEach(function (image) { %>
										<div class="cbp-item">
											<div class="cbp-caption">
												<div class="cbp-item-wrapper details">
													<a href="<%= image.src %>" class="cbp-lightbox zoomer" data-title="<%= image.caption %>">
														<span class="overlay-zoom">
															<img src="<%= thumbUrl(image.src) || image.src %>" alt="<%= image.caption || page.title %>" width="<%= image.width || '' %>" height="<%= image.height || '' %>" />
															<span class="zoom-icon"></span>
														</span>
													</a>
												</div>
											</div>
										</div>
									<% }) %>
								</div>
							</div>
						<% } %>
					</div>
				</div>
			</div>
			<div class="col-lg-4 mt-4 mt-lg-0">
				<%- include('partials/sidebar') %>
			</div>
		</div>
	</div>
</div>
