<% if (page.heroImage) { %>
	<div class="header-img">
		<div class="imgHeader" style="background-image: url('<%= page.heroImage %>')"></div>
	</div>
<% } %>
<div id="content">
	<div class="container">
		<div class="row">
			<div class="col-lg-8">
				<div class="content-text">
					<div class="title<%= typeof listingParent !== 'undefined' && listingParent ? ' d-flex' : '' %>">
						<h1><%= page.header || page.title %></h1>
						<% if (typeof listingParent !== 'undefined' && listingParent) { %>
							<a href="<%= listingParent.url %>" class="ml-auto align-self-start mt-8px"><i class="fal fa-angle-double-left mr-1"></i>Retour</a>
						<% } %>
					</div>
					<div class="text rte-content">
						<%- page.content %>
						<% if (page.key === 'site-map') { %>
							<%- include('partials/site-map', { nodes: typeof sitemapTree !== 'undefined' ? sitemapTree : [], nested: false }) %>
						<% } %>
						<% if (typeof childPosts !== 'undefined' && childPosts.length) { %>
							<% childPosts.forEach(function (post) { %>
								<div class="post-block clearfix">
									<% if (post.heroImage) { %>
										<div class="post-thumb mr-md-4">
											<a href="<%= post.url %>" title="<%= post.title %>">
												<img src="<%= thumbUrl(post.heroImage) || post.heroImage %>" class="img-fluid" alt="<%= post.title %>" />
											</a>
										</div>
									<% } %>
									<div class="post-content">
										<h2 class="post-title">
											<a href="<%= post.url %>" title="<%= post.title %>"><%= post.header || post.title %></a>
										</h2>
										<% if (post.summary) { %><div class="text"><%= post.summary %></div><% } %>
									</div>
								</div>
							<% }) %>
							<% if (typeof childListPages !== 'undefined' && childListPages > 1) { %>
								<nav aria-label="Page navigation">
									<ul class="pagination justify-content-center">
										<% for (let p = 1; p <= childListPages; p++) { %>
											<li>
												<a href="?p=<%= p %>" class="page-link<%= p === childListPage ? ' paging-current' : '' %>"><%= p %></a>
											</li>
										<% } %>
										<% if (childListPage < childListPages) { %>
											<li>
												<a href="?p=<%= childListPage + 1 %>" class="page-link paging-next">&raquo;</a>
											</li>
										<% } %>
									</ul>
								</nav>
							<% } %>
						<% } %>
						<% if (gallery && gallery.length) { %>
							<div class="galleryContainer mt-4">
								<div id="grid-container" class="cbp-l-grid-masonry-projects">
									<% gallery.forEach(function (image) { %>
										<div class="cbp-item">
											<div class="cbp-caption">
												<div class="cbp-item-wrapper details">
													<a href="<%= image.src %>" class="cbp-lightbox zoomer" data-title="<%= image.caption %>">
														<span class="overlay-zoom">
															<img src="<%= thumbUrl(image.src) || image.src %>" alt="<%= image.caption || page.title %>" />
															<span class="zoom-icon"></span>
														</span>
													</a>
												</div>
											</div>
										</div>
									<% }) %>
								</div>
							</div>
						<% } %>
					</div>
				</div>
			</div>
			<div class="col-lg-4 mt-4 mt-lg-0">
				<%- include('partials/sidebar') %>
			</div>
		</div>
	</div>
</div>
