<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title"><%= collection.label %></h4>
		<div class="panel-heading-btn">
			<% if (root) { %>
				<a href="<%= collection.basePath %>/<%= root.id %>/edit" class="btn btn-xs btn-default me-1"><i class="fa fa-cog"></i> Page settings</a>
				<a href="<%= collection.basePath %>/create" class="btn btn-xs btn-success"><i class="fa fa-plus"></i> Add <%= collection.singular %></a>
			<% } %>
		</div>
	</div>
	<div class="panel-body">
		<% if (!root) { %>
			<div class="alert alert-warning mb-0">The News page does not exist yet. Run <code>npm run import:legacy</code> to create it.</div>
		<% } else { %>
			<p class="text-muted">
				Stories, campaigns and updates, newest first. The latest stories also appear on the home page.
				Public page: <a href="<%= root.url %>" target="_blank" rel="noopener"><%= root.url %></a><% if (root.status !== 'published') { %> <span class="badge bg-secondary">Draft: hidden from visitors</span><% } %>
			</p>
			<div class="row g-2 mb-3">
				<div class="col-md-6">
					<div class="input-group">
						<span class="input-group-text"><i class="fa fa-search"></i></span>
						<input type="search" class="form-control" placeholder="Filter by title" data-table-filter="#news-table" aria-label="Filter news stories" />
					</div>
				</div>
			</div>
			<div class="table-responsive">
				<table class="table table-striped table-bordered align-middle" id="news-table">
					<thead>
						<tr>
							<th style="width:56px" data-sort="off">Photo</th>
							<th>Title</th>
							<th>Published</th>
							<th>Status</th>
							<th class="text-center">Gallery</th>
							<th style="width:1%" data-sort="off">Actions</th>
						</tr>
					</thead>
					<tbody>
						<% entries.forEach(function (entry) { %>
							<tr data-filter-text="<%= entry.title.toLowerCase() %>">
								<td>
									<% if (entry.heroImage) { %>
										<img src="<%= thumbUrl(entry.heroImage) %>" alt="" class="rounded admin-thumb" loading="lazy" data-fallback-src="<%= entry.heroImage %>" />
									<% } else { %>
										<div class="admin-thumb admin-thumb-empty rounded"><i class="fa fa-image text-muted"></i></div>
									<% } %>
								</td>
								<td data-sort-value="<%= entry.title %>">
									<a href="<%= collection.basePath %>/<%= entry.id %>/edit" class="fw-bold"><%= entry.title %></a>
									<div class="small"><a href="<%= entry.url %>" target="_blank" rel="noopener" class="text-muted"><%= entry.url %></a></div>
								</td>
								<td class="text-nowrap small" data-sort-value="<%= entry.createdAt %>"><%= new Date(entry.createdAt).toLocaleDateString('en-GB') %></td>
								<td>
									<% if (entry.status === 'published') { %><span class="badge bg-success">Published</span><% } else { %><span class="badge bg-secondary">Draft</span><% } %>
								</td>
								<td class="text-center"><%= entry.imageCount %></td>
								<td class="text-nowrap">
									<a href="<%= collection.basePath %>/<%= entry.id %>/edit" class="btn btn-sm btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
									<button type="button" class="btn btn-sm btn-danger" title="Delete"
										data-delete-url="<%= collection.basePath %>/<%= entry.id %>"
										data-delete-title="Delete <%= collection.singular %>"
										data-delete-message="Delete “<%= entry.title %>” and its photos?">
										<i class="fa fa-trash"></i>
									</button>
								</td>
							</tr>
						<% }) %>
						<% if (entries.length === 0) { %>
							<tr><td colspan="6" class="text-center text-muted py-4">No stories yet. <a href="<%= collection.basePath %>/create">Add the first <%= collection.singular %></a>.</td></tr>
						<% } %>
					</tbody>
				</table>
			</div>
		<% } %>
	</div>
</div>
