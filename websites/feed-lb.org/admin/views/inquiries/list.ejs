<div class="panel panel-inverse">
	<div class="panel-heading">
		<h4 class="panel-title"><%= activeType === 'donation' ? 'Donation pledges' : activeType === 'contact' ? 'Contact form messages' : 'Inquiries and donation pledges' %></h4>
	</div>
	<div class="panel-body pb-0">
		<div class="btn-group btn-group-sm" role="group" aria-label="Filter inquiries">
			<% filters.forEach(function (filter) { %>
				<a href="/admin/inquiries<%= filter.value ? '?type=' + filter.value : '' %>" class="btn <%= filter.value === activeType ? 'btn-primary' : 'btn-default' %>"<% if (filter.value === activeType) { %> aria-current="page"<% } %>><%= filter.label %></a>
			<% }) %>
		</div>
	</div>
	<div class="panel-body p-0 mt-3">
		<table class="table table-hover align-middle mb-0">
			<thead><tr><th>From</th><th>Type</th><th>Details</th><th>Received</th><th>Email sent</th><th style="width:1%"></th></tr></thead>
			<tbody>
				<% inquiries.forEach(function (item) { %>
					<tr class="<%= item.read ? '' : 'fw-bold' %>">
						<td><a href="/admin/inquiries/<%= item.id %>"><%= item.name %></a><div class="small text-muted fw-normal"><%= item.email %></div></td>
						<td><% if (item.type === 'donation') { %><span class="badge bg-success">Pledge</span><% } else { %><span class="badge bg-secondary">Message</span><% } %></td>
						<td>
							<% if (item.pledge) { %><%= item.pledge %><% } else { %><%= item.topic %><% } %>
							<% if (item.productName) { %><div class="small text-muted">Product: <%= item.productName %></div><% } %>
						</td>
						<td class="text-nowrap small" data-sort-value="<%= item.createdAt %>"><%= new Date(item.createdAt).toLocaleString('en-GB') %></td>
						<td><% if (item.emailed) { %><span class="badge bg-success">Yes</span><% } else { %><span class="badge bg-light text-dark">Stored only</span><% } %></td>
						<td class="text-nowrap">
							<a href="/admin/inquiries/<%= item.id %>" class="btn btn-sm btn-primary" title="Open"><i class="fa fa-eye"></i></a>
							<button type="button" class="btn btn-sm btn-danger" title="Delete" data-delete-url="/admin/inquiries/<%= item.id %>" data-delete-title="Delete inquiry" data-delete-message="Delete the <%= item.type === 'donation' ? 'pledge' : 'inquiry' %> from <%= item.name %>?"><i class="fa fa-trash"></i></button>
						</td>
					</tr>
				<% }) %>
				<% if (inquiries.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4"><%= activeType === 'donation' ? 'No donation pledges yet.' : 'No inquiries yet.' %></td></tr><% } %>
			</tbody>
		</table>
	</div>
</div>
