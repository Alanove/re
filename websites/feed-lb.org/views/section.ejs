<%
	const visible = function (nodes) { return nodes.filter(function (node) { return node.kind !== 'footer'; }); };
	const leaves = visible(page.children).filter(function (child) { return !(child.kind === 'section' && child.children.length); });
	const groups = visible(page.children).filter(function (child) { return child.kind === 'section' && child.children.length; });
	const card = function (child, headingLevel) {
		return include('partials/activity-card', { child: child, headingLevel: headingLevel });
	};
%>
<%- include('partials/page-hero') %>
<section class="section">
	<div class="container">
		<% if (page.content) { %>
			<div class="prose prose--intro"><%- page.content %></div>
		<% } %>
		<% if (leaves.length) { %>
			<ul class="section-cards">
				<% leaves.forEach(function (child) { %><li><%- card(child, 2) %></li><% }) %>
			</ul>
		<% } %>
		<% groups.forEach(function (group) { %>
			<section class="section-group" aria-labelledby="group-<%= group.id %>">
				<div class="section-head section-head--split">
					<h2 class="section-title" id="group-<%= group.id %>"><%= group.title %></h2>
					<a class="btn btn--outline btn--sm" href="<%= group.url %>">View all<span class="visually-hidden"> <%= group.title %></span></a>
				</div>
				<% if (group.summary) { %><p class="section-head__intro section-head__intro--start"><%= group.summary %></p><% } %>
				<ul class="section-cards">
					<% visible(group.children).forEach(function (child) { %><li><%- card(child, 3) %></li><% }) %>
				</ul>
			</section>
		<% }) %>
		<%- include('partials/gallery') %>
	</div>
</section>
<%- include('partials/cta-band-section') %>
