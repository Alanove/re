	};
	const socialLabels = { whatsapp: 'WhatsApp', instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', youtube: 'YouTube' };
	const socialItems = [];
	if (locals.whatsappUrl) { socialItems.push({ key: 'whatsapp', url: locals.whatsappUrl }); }
	['instagram', 'facebook', 'linkedin', 'youtube'].forEach(function (key) {
		if (settings.social[key]) { socialItems.push({ key: key, url: settings.social[key] }); }
	});
	const socialClass = locals.socialClass || 'social-links';
	const withLabels = Boolean(locals.socialLabels);
%>
<% if (socialItems.length) { %>
	<ul class="<%= socialClass %>">
		<% socialItems.forEach(function (item) { %>
			<li>
				<a class="social-link social-link--<%= item.key %>" href="<%= item.url %>" target="_blank" rel="noopener noreferrer"<%- withLabels ? '' : ' aria-label="' + (item.key === 'whatsapp' ? 'Chat with ' + settings.siteName + ' on WhatsApp' : settings.siteName + ' on ' + socialLabels[item.key]) + '"' %>>
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" fill-rule="<%= item.key === 'instagram' ? 'evenodd' : 'nonzero' %>" d="<%= socialIcons[item.key] %>"/></svg>
					<% if (withLabels) { %><span><%= item.key === 'whatsapp' ? 'Chat on WhatsApp' : socialLabels[item.key] %></span><% } %>
				</a>
			</li>
		<% }) %>
	</ul>
<% } %>
