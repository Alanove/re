{
  "name": "@local/captcha",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted proof-of-work captcha for CMS sites: no third-party keys, no usage limits",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test test/*.test.mjs",
    "demo": "node esbuild.config.mjs && node demo/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
